  caution:"#ffb0b0",avoid:"#ff1a1a"}},
 "midnight-blue":{label:"Midnight Blue",dark:true,vars:{bg:"#0a1428",
  panel:"#12203c",panelw:"#1a2c50",band:"#22386a",line:"#2a4a7a",line2:"#22386a",
  txt:"#cfe0ff",dim:"#8aa6d0",acc:"#4a90ff",acc2:"#7db4ff",onacc:"#04122a",
