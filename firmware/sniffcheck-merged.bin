  caution:"#fe8019",avoid:"#fb4934"}},
 "solarized-light":{label:"Solarized Light",dark:false,vars:{bg:"#fdf6e3",
  panel:"#eee8d5",panelw:"#e4dcc3",band:"#d9d2b9",line:"#586e75",line2:"#93a1a1",
  txt:"#073642",dim:"#657b83",acc:"#b58900",acc2:"#cb4b16",onacc:"#fdf6e3",
  purple:"#6c71c4",sh:"#93a1a1",trk:"#ffffff",code:"#f5efdc",wifi:"#268bd2",
  ble:"#6c71c4",track:"#cb4b16",drone:"#d33682",safe:"#859900",ok:"#b58900",
