<header>
  <img alt="SniffCheck" src="/logo.png" onerror="this.remove()">
  <span id="constat" class="constat" title="Not connected to a SniffCheck device">
    <span class="cdot"></span><span class="ctext">offline</span></span>
  <span class="sub" id="srcinfo"></span>
  <button class="tbtn" id="refbtn" style="display:none;margin-left:auto"
    title="Pull the latest results from the device (after a scan or walk)">Refresh</button>
  <button class="tbtn" id="addcap" style="display:none"
    title="Add a SniffCheck capture, or import a Biscuit/Wigle/Kismet/wardriver scan">Import</button>
</header>

<div id="top">
  <div id="bar">
    <div class="trow">
      <input id="q" type="search" placeholder="Search SSID, name, vendor, MACâ€¦"
        autocomplete="off" autocapitalize="off" spellcheck="false">
      <button class="tbtn" id="ftog">Filters</button>
      <button class="tbtn" id="exp">Export</button>
      <a class="tbtn" id="dash" href="/" title="Back to the SniffCheck AP dashboard">Dashboard</a>
    </div>
    <div id="filters">
      <div id="quickchips" class="chips"></div>
      <select id="f-kind"></select>
      <select id="f-vendor"></select>
      <select id="f-class"></select>
      <select id="f-grade"></select>
      <select id="f-threat"></select>
      <select id="f-band"></select>
      <select id="f-channel"></select>
      <div id="catchips" class="chips"></div>
      <button class="fclr" id="fclr">Clear all filters</button>
    </div>
    <div id="count"></div>
  </div>
  <nav id="nav"></nav>
  <button id="navtog" type="button" title="Hide tabs" aria-label="Hide tabs">^ hide tabs</button>
</div>

<main>
  <div id="drop">
    <b>Drop a capture file here</b> or tap to pick one.<br>
    <span class="small">SniffCheck exports (.jsonl / .ndjson / .json) aggregate straight into
    this view. Biscuit, Wigle, Kismet and wardriver scans (.json / .jsonl / .csv / .log)
    are carved and re-decoded by a connected SniffCheck, then added to the cross-scan view.
    Everything stays in this browser tab.</span>
    <input type="file" id="fpick"
      accept=".json,.jsonl,.ndjson,.txt,.csv,.log,application/json" multiple>
  </div>
  <div id="app">
    <section id="s-banner"><h2>RF Env Summary</h2><div id="smhost"></div></section>
    <section id="s-wifi"><h2>Wi-Fi networks<span class="seg" id="wtog"></span></h2><div id="wifi"></div></section>
    <section id="s-ble"><h2>BLE devices<span class="seg" id="btog"></span></h2><div id="ble"></div></section>
    <section id="s-clusters"><h2>Device clusters</h2><div id="clusters"></div></section>
    <section id="s-trackers"><h2>Trackers</h2><div id="trackers"></div></section>
    <section id="s-drones"><h2>Drones (Remote ID)</h2><div id="drones"></div></section>
    <section id="s-alerts"><h2>Notifications</h2><div id="alerts"></div></section>
    <section id="s-privacy"><h2>Privacy analyzers</h2><div id="privacy"></div></section>
    <section id="s-channel"><h2>Channel analyzer</h2><div id="channel"></div></section>
    <section id="s-raw"><h2>Raw records</h2><div id="raw"></div></section>
  </div>
</main>

<script id="sc-data" type="application/json"><!--SC_DATA_ISLAND--></script>

<script>
"use strict";
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"']/g,
  c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

function parseCapture(text){
  text=text.trim();
  if(text[0]==="["){
    try{
      const a=JSON.parse(text);
      if(Array.isArray(a))
        return {recs:a.filter(r=>r&&typeof r==="object"),bad:0};
    }catch(e){}
  }
  const recs=[];let bad=0;
  for(let ln of text.split("\n")){
    ln=ln.trim();
    if(!ln||ln==="["||ln==="]")continue;
    if(ln[0]===",")ln=ln.slice(1).trim();
    if(ln.endsWith(","))ln=ln.slice(0,-1).trim();
    if(!ln||ln==="["||ln==="]")continue;
    if(ln[0]==="["&&ln.endsWith("]"))ln=ln.slice(1,-1).trim();
    try{
      const o=JSON.parse(ln);
      if(o&&typeof o==="object")recs.push(o);else bad++;
    }catch(e){bad++;}
  }
  return {recs,bad};
}

const KIND={wifi_ap:"wifi",ble_device:"ble",tracker:"track",drone_rid:"drone"};

function latest(map,key,rec){
  const cur=map.get(key);
  const newer=!cur||(rec._sess||0)>(cur.rec._sess||0)||
    ((rec._sess||0)===(cur.rec._sess||0)&&(rec.ts_us||0)>=(cur.rec.ts_us||0));
  if(newer)map.set(key,{rec,n:(cur?cur.n:0)+1});
  else cur.n++;
}

const PRES_KINDS={wifi_ap:["wifi",r=>r.bssid],ble_device:["ble",r=>r.addr],
  tracker:["track",r=>r.addr],drone_rid:["drone",r=>r.addr]};

function buildModel(recs,bad){
  const m={bad,total:recs.length,header:null,footer:null,codebook:null,
    wifi:new Map(),ble:new Map(),clusters:[],trackers:new Map(),
    drones:new Map(),alerts:new Map(),twins:new Map(),logs:{},unknown:new Map(),
    addrStats:null,envInd:null,lawEnf:null,medResp:null,chanAct:null,pcap:null,maxScan:0,
    pres:new Map(),slots:[]};

  const presRaw=new Map(),slotSet=new Set();
  for(const r of recs){
    const t=r.type;
    if(typeof r.scan_index==="number"&&r.scan_index>m.maxScan)
      m.maxScan=r.scan_index;
    if(typeof r.scan_index==="number"){
      const sk=(r._sess||0)+":"+r.scan_index;
      slotSet.add(sk);
      const pk=PRES_KINDS[t],mac=pk&&pk[1](r);

      if(mac&&!(t==="wifi_ap"&&typeof r.last_seen_scan==="number"&&
                r.last_seen_scan<r.scan_index)){
        const key=pk[0]+"|"+String(mac).toUpperCase();
        let e=presRaw.get(key);
        if(!e){e={kind:pk[0],mac,at:new Map()};presRaw.set(key,e);}
        const prev=e.at.get(sk);
        if(prev===undefined||prev===null||
           (typeof r.rssi==="number"&&r.rssi>prev))
          e.at.set(sk,typeof r.rssi==="number"?r.rssi:null);
      }
    }
    switch(t){
    case "header":   if(!m.header)m.header=r;break;
    case "footer":   m.footer=r;break;
    case "codebook": m.codebook=(r.enums&&typeof r.enums==="object")?r.enums:null;break;
    case "wifi_ap":  latest(m.wifi,r.bssid||"?",r);break;
    case "ble_device":latest(m.ble,r.addr||"?",r);break;
    case "device_cluster":m.clusters.push(r);break;
    case "ble_addr_stats":m.addrStats=r;break;
    case "environment_indicators":m.envInd=r;break;
    case "law_enforcement_presence":m.lawEnf=r;break;
    case "medical_responder_presence":m.medResp=r;break;
    case "channel_activity":m.chanAct=r;break;
    case "pcap_capture":m.pcap=r;break;
    case "tracker":  latest(m.trackers,(r.addr||"?")+"|"+(r.tracker_kind||""),r);break;
    case "drone_rid":latest(m.drones,(r.addr||"?")+"|"+(r.id||""),r);break;
    // Pair-level Evil Twin findings. Keyed by the unordered pair
    // rather than finding_id, because finding_id carries the scan index: the
    // same pair re-observed each scan would otherwise pile up as new findings.
    case "wifi_twin_finding":{
      const a=r.target_ref||"",b=r.peer_ref||"";
      const k=(a<b?a+"|"+b:b+"|"+a)+"|"+(r.trigger||"");
      const cur=m.twins.get(k);
      if(cur){cur.n++;if((r.ts_us||0)>=(cur.rec.ts_us||0))cur.rec=r;}
      else m.twins.set(k,{rec:r,n:1});
      break;}
    case "alert":{
      // Twin alerts group by PAIR, not by rule+target. Both members
      // of one pair raise the same rule, so keying on target alone showed a
      // single relationship as two unexplained notifications. Pair grouping is
      // what makes "six alerts" legible as one conclusion seen six times.
      let k;
      if(r.peer_ref&&r.target_ref){
        const a=r.target_ref,b=r.peer_ref;
        k=(r.rule_id||"?")+"|pair:"+(a<b?a+"|"+b:b+"|"+a);
      }else k=(r.rule_id||"?")+"|"+(r.target_ref||"");
      const cur=m.alerts.get(k);
      if(cur){cur.n++;if((r.ts_us||0)>=(cur.rec.ts_us||0))cur.rec=r;}
      else m.alerts.set(k,{rec:r,n:1});
      break;}
    case "probe_req_log":case "seq_fingerprint_log":
    case "ie_signature_log":case "anqp_log":

      {const cur=m.logs[t];
       if(!cur||r.detail||!cur.detail)m.logs[t]=r;}
      break;
    case "station_log":

      {const cur=m.logs[t];
       const rn=Array.isArray(r.stations)?r.stations.length:0;
       const cn=cur&&Array.isArray(cur.stations)?cur.stations.length:0;
       if(!cur||rn>=cn)m.logs[t]=r;}
      break;
    case "csi":

      {const cur=m.logs[t];
       if(!cur||(r.ran&&!cur.ran))m.logs[t]=r;}
      break;
    default:
      m.unknown.set(t||"(untyped)",(m.unknown.get(t||"(untyped)")||0)+1);
    }
  }

  m.ruleMsg={};
  for(const {rec} of m.alerts.values())
    if(rec.rule_id&&rec.message)m.ruleMsg[rec.rule_id]=rec.message;
  m.t0=m.header&&m.header.session?m.header.session.start_us:
       (recs.length?recs[0].ts_us:0);

  m.slots=[...slotSet].map(k=>k.split(":").map(Number))
    .sort((a,b)=>a[0]-b[0]||a[1]-b[1]).map(a=>a.join(":"));
  const slotIdx=new Map(m.slots.map((k,i)=>[k,i]));
  for(const [key,e] of presRaw){
    const slots=[...e.at.keys()].map(k=>slotIdx.get(k)).sort((a,b)=>a-b);
    const rssiBy={};
    for(const [k,v] of e.at)if(v!=null)rssiBy[slotIdx.get(k)]=v;
    m.pres.set(key,{kind:e.kind,mac:e.mac,slots,rssiBy});
  }
  return m;
}

let M=null;

function cb(en,v){
  if(v===undefined||v===null)return "â€”";
  const t=M.codebook&&M.codebook[en];
  return (t&&t[String(v)]!==undefined)?t[String(v)]:String(v);
}

function fVendor(r){return r.vendor||r.company_name||"";}
function fName(r){return r.ssid||r.name||"";}
// A surfacable name: a hidden SSID (the literal "<hidden>") is not a real name,
// so cluster labels prefer any actual member name over it.
function realName(s){return (s&&s!=="<hidden>")?s:"";}
function fMac(r){return r.bssid||r.addr||"";}
function fClass(r){return r.device_class!=null?cb("device_class",r.device_class):"";}
function fThreat(r){return r.threat_level!=null?cb("threat_level",r.threat_level):"";}

const CAT_BUCKETS=[
  ["Phones & mobile",      ["PHONE","MOBILE","TABLET"]],
  ["Computers",            ["LAPTOP"]],
  ["Wearables",            ["WEAR"]],
  ["Cameras & surveillance",["CAMERA"]],
  ["Surveillance OUI (hint)",["CAM-OUI?"]],
  ["Cars",                 ["VEHICLE","AUTO"]],
  ["Drones",               ["DRONE"]],
  ["Trackers & beacons",   ["TRACKER","BEACON"]],
  ["Audio",                ["AUDIO"]],
  ["Smart home / IoT",     ["IOT-HUB","IOT"]],
  ["Network infrastructure",["ENT-AP","CONSUMER","INFRA","STDS"]],
  ["Access & payment",     ["LOCK","POS"]],
  ["Maker / dev boards",   ["MAKER","DEV-MOD"]],
  ["Medical",              ["MEDICAL"]],
  ["Investigation / attack",["INVEST","ATTACK"]],
];
const CLASS_TO_CAT={};
CAT_BUCKETS.forEach(([cat,labels])=>labels.forEach(l=>CLASS_TO_CAT[l]=cat));
function fCat(r){return CLASS_TO_CAT[fClass(r)]||"";}

const ICON_BY_CAT={
  "Phones & mobile":      ["ic-phone","phone / mobile"],
  "Computers":            ["ic-laptop","computer"],
  "Wearables":            ["ic-watch","wearable"],
  "Cameras & surveillance":["ic-camera","camera / surveillance"],
  "Surveillance OUI (hint)":["ic-camera","possible surveillance OUI"],
  "Cars":                 ["ic-car","vehicle"],
  "Drones":               ["ic-drone","drone"],
  "Trackers & beacons":   ["ic-tracker","tracker / beacon"],
  "Audio":                ["ic-audio","audio device"],
  "Smart home / IoT":     ["ic-home","smart home / IoT"],
  "Network infrastructure":["ic-router","network infrastructure"],
  "Access & payment":     ["ic-reader","access / payment"],
  "Maker / dev boards":   ["ic-chip","maker / dev board"],
  "Medical":              ["ic-responder","medical"],
  "Investigation / attack":["ic-alert","investigation / attack"],
};

const ICON_BY_KIND={
  wifi: ["ic-wifi","Wi-Fi network"],
  ble:  ["ic-ble","BLE device"],
  track:["ic-tracker","tracker"],
  drone:["ic-drone","drone"],
  alert:["ic-alert","notification"],
};
function iconSpan(pair){
  return pair?'<span class="dicon" role="img" aria-label="'+esc(pair[1])+
    '" title="'+esc(pair[1])+'"><svg class="ic"><use href="#'+esc(pair[0])+
    '"/></svg></span>':"";
}

function catIcon(r,kind){

  const a=r&&(r.bssid||r.addr);
  const pe=a&&PSIDX.get(String(a).toUpperCase());
  if(pe)return iconSpan(["ic-police","public safety / law enforcement"+
    (pe.device_type&&pe.device_type!=="unknown"?" ("+pe.device_type+")":"")]);
  const c=fCat(r);

  if(c==="Network infrastructure"){
    const g=fGrade(r);
    if(g==="ent")return iconSpan(["ic-router-ent","enterprise access point"]);
    if(g==="con")return iconSpan(["ic-router","consumer router"]);
  }
  return iconSpan((c&&ICON_BY_CAT[c])||ICON_BY_KIND[kind]);
}

function fGrade(r){
  const f=r.eui_flags||0;
  if((f&0x0002)||fClass(r)==="ENT-AP")return "ent";
  if((f&0x0004)||fClass(r)==="CONSUMER")return "con";
  return "";
}

// Friendly labels for firmware device_type codes (public-safety + medical), so
// surfaced identities read plainly instead of as raw enum strings.
const SAFETY_LABEL={
  body_camera:"law-enforcement body camera",
  taser:"conducted-energy weapon (Taser)",
  in_car_camera:"in-car / fleet camera",
  radio:"public-safety radio",
  vehicle_gateway:"police vehicle gateway",
  rugged_device:"rugged field device",
  other_public_safety:"public-safety device",
  ambulance_gateway:"ambulance gateway",
  ems_tablet:"EMS tablet",
  medical_monitor:"patient monitor",
  radio_accessory:"responder radio accessory",
  ems_camera:"EMS camera",
  air_ambulance:"air-ambulance system",
  hospital_ems:"hospital / EMS device",
  other_medical_responder:"medical-responder device"
};
function safetyLabel(t){return SAFETY_LABEL[t]||String(t||"").replace(/_/g," ");}

// Derive a human identity for a record from raw scan fields, tiered most- to
// least-specific. Returns {name, source, hi} or null. `hi` marks high-signal
// awareness (public-safety / medical) surfaced even when a name already exists.
// Everything here is read from the device's own decoded fields â€” never invented.
function surfacedIdentity(r,kind){
  const up=fMac(r)&&String(fMac(r)).toUpperCase();
  const ps=up&&PSIDX.get(up);
  if(ps&&ps.device_type&&ps.device_type!=="unknown")
    return {name:safetyLabel(ps.device_type),hi:true,
      source:"law-enforcement presence analysis"+(ps.label?" ("+ps.label+")":"")};
  const mr=up&&MRIDX.get(up);
  if(mr&&mr.device_type&&mr.device_type!=="unknown")
    return {name:safetyLabel(mr.device_type),hi:true,
      source:"medical-responder presence analysis"+(mr.label?" ("+mr.label+")":"")};
  if(kind==="ble"){
    if(r.fastpair_name)   return {name:r.fastpair_name,   source:"Google Fast Pair payload"};
    if(r.uuid16_name)     return {name:r.uuid16_name,     source:"BLE service UUID (16-bit)"};
    if(r.uuid128_name)    return {name:r.uuid128_name,    source:"BLE service UUID (128-bit)"};
    if(r.uuid32_name)     return {name:r.uuid32_name,     source:"BLE service UUID (32-bit)"};
    if(r.ms_subtype_name) return {name:r.ms_subtype_name, source:"Microsoft advertising payload"};
    if(r.apple_category)  return {name:r.apple_category,  source:"Apple Continuity payload"};
    if(r.name_rule_name)  return {name:r.name_rule_name,  source:"device-name rule match"};
    if(r.mfg_rule_name)   return {name:r.mfg_rule_name,   source:"manufacturer-data rule match"};
    if(r.phone_model)     return {name:r.phone_model,     source:"model inference"};
  }
  // last-resort awareness for a still-nameless device: its class, then vendor.
  if(!fName(r)){
    const cls=fClass(r);
    if(cls)  return {name:CLASS_TO_CAT[cls]||cls,source:"device-class classification"};
    const v=fVendor(r);
    if(v)    return {name:v,source:"OUI vendor lookup"};
  }
  return null;
}

// The awareness "evidence card": shown whenever an identity was surfaced,
// stating plainly what was surfaced and from where â€” so the RF picture is clear
// without opening the raw record.
function idSurfCard(si){
  if(!si)return "";
  return '<div class="idsurf'+(si.hi?" hi":"")+'">'+
    '<svg class="ic"><use href="#ic-privacy"/></svg>'+
    '<span><b>Surfaced from raw scan:</b> '+esc(si.name)+
    ' <span class="dim">â€” '+esc(si.source)+
    '. Shown to build RF awareness without digging into raw data.</span></span></div>';
}

const THREAT_CLS={none:"p0",low:"p1",medium:"p2",high:"p3"};
const SEV_CLS={low:"p1",medium:"p2",high:"p3"};
function threatPill(v){
  const lbl=cb("threat_level",v);
  const cls=THREAT_CLS[lbl]||(typeof v==="number"&&v<=3?"p"+v:"pu");
  return '<span class="pill '+cls+'">'+esc(lbl)+'</span>';
}
function sevPill(s){
  return '<span class="pill '+(SEV_CLS[s]||"pu")+'">'+esc(s||"?")+'</span>';
}
function scoreColor(v){
  return v>=80?"var(--safe)":v>=60?"var(--ok)":v>=40?"var(--caution)":"var(--avoid)";
}
function identBar(v){
  if(typeof v!=="number")return '<span class="dim">id â€”</span>';
  return '<span><span class="bar"><i style="width:'+Math.max(0,Math.min(100,v))+
    '%;background:'+scoreColor(v)+'"></i></span><span class="sig" style="color:'+
    scoreColor(v)+'">'+v+"</span></span>";
}

function rssiHtml(v){
  if(typeof v!=="number")return '<span class="dim">rssi â€”</span>';
  const lvl=v>=-50?4:v>=-60?3:v>=-70?2:1;
  let bars="";for(let i=1;i<=4;i++)bars+="<i"+(i<=lvl?' class="on"':"")+"></i>";
  return '<span class="sigbar" title="RSSI '+v+' dBm"><span class="bars">'+bars+
    '</span><span class="rssi">rssi '+v+"</span></span>";
}

function presenceOf(kind,mac){
  if(!M||!mac)return null;
  const p=M.pres.get(kind+"|"+String(mac).toUpperCase());
  if(!p||!p.slots.length)return null;
  const total=M.slots.length;
  const latestSeen=p.slots.includes(total-1);
  const cov=total?p.slots.length/total:0;
  return{kind,mac,seen:p.slots.length,total,first:p.slots[0],
    last:p.slots[p.slots.length-1],latestSeen,slots:p.slots,rssiBy:p.rssiBy,
    conf:total>1?Math.round(100*(0.75*cov+0.25*(latestSeen?1:0))):null};
}

function slotLabel(i){
  const k=M&&M.slots[i];if(k==null)return "?";
  const [s,x]=String(k).split(":");
  return SESSIONS.length>1?"c"+(Number(s)+1)+"#"+x:"#"+x;
}

function presStrip(p){
  if(!p||p.total<2)return "";
  const on=new Set(p.slots);
  const N=p.total,cap=48,step=N>cap?N/cap:1,cells=Math.min(N,cap);
  let h="";
  for(let i=0;i<cells;i++){
    const a=Math.floor(i*step),b=Math.max(Math.floor((i+1)*step),a+1);
    let hit=false;
    for(let s=a;s<b;s++)if(on.has(s)){hit=true;break;}
    h+="<i"+(hit?' class="on"':"")+"></i>";
  }
  return '<span class="pstrip" title="presence across '+p.total+
    ' scans (oldest â†’ newest)">'+h+"</span>";
}

function presLine(kind,mac){
  const p=presenceOf(kind,mac);
  if(!p||p.total<2)return "";
  const tag=p.seen===p.total?"stable":
    !p.latestSeen?"not in latest scan":
    p.seen===1?"new this scan":"intermittent";
  return '<div class="pres">'+presStrip(p)+
    '<span class="dim">seen '+p.seen+"/"+p.total+" scans Â· "+tag+"</span>"+
    '<span title="multi-scan presence consistency">'+identBar(p.conf)+
    "</span></div>";
}

function presDetail(kind,mac){
  const p=presenceOf(kind,mac);
  if(!p||p.total<2)return "";
  return '<div class="small dim">multi-scan: seen '+p.seen+" of "+p.total+
    " passes Â· presence consistency "+p.conf+"/100 Â· scans ["+
    esc(p.slots.map(slotLabel).join(", "))+"]</div>";
}

function fmtTs(us){
  if(typeof us!=="number")return "â€”";
  let s=Math.max(0,Math.round((us-(M.t0||0))/1e6));
  const h=Math.floor(s/3600);s%=3600;
  const mm=String(Math.floor(s/60)).padStart(2,"0");
  return h+":"+mm+":"+String(s%60).padStart(2,"0");
}
function fmtDist(dm){
  if(typeof dm!=="number")return "â€”";
  const mtr=dm/10;
  const band=mtr<2?"immediate":mtr<10?"near":mtr<30?"mid":"far";
  return mtr.toFixed(1)+" m <span class='dim'>("+band+")</span>";
}
function ssidDisp(s){
  return s? esc(s) : '<span class="hid">(hidden network)</span>';
}
function nameDisp(s){
  return s? esc(s) : '<span class="hid">(no name)</span>';
}
function ruleList(ids){
  if(!Array.isArray(ids)||!ids.length)return '<span class="dim">none</span>';
  return ids.map(id=>esc(M.ruleMsg[id]?M.ruleMsg[id]+" ["+id+"]":id)).join("<br>");
}
function anchorId(kind,mac){
  return "dev-"+kind+"-"+String(mac).replace(/[^0-9a-fA-F]/g,"");
}
function span(cls,txt){return '<span'+(cls?' class="'+cls+'"':"")+">"+txt+"</span>";}
function kindBadge(k,lbl){return '<span class="kb">'+esc(lbl)+'</span>';}
function sourceBadge(r){
  if(!r)return "";

  if(r._radioSibling)return '<span class="rawtag" title="raw radio merged into one logical network">raw radio</span>';
  if(r.suppressed)return '<span class="rawtag" title="noise-suppressed advertiser (hidden from the Lite list)">suppressed</span>';
  if(r.source==="walk")return '<span class="pill p1">seen on walk</span>';
  if(r.source==="byos"){

    const s=Array.isArray(r.sources)?r.sources:null;
    if(s&&s.length>1){
      return s.map(function(x){return '<span class="pill p1">seen by '+esc(x&&x.id!=null?x.id:"?")+'</span>';}).join("");
    }
    if(s&&s.length===1&&s[0]&&s[0].id&&s[0].id!=="local")
      return '<span class="pill p1">BYOS import Â· '+esc(s[0].id)+'</span>';
    return '<span class="pill p1">BYOS import</span>';
  }
  return "";
}

// Render a capture timestamp in the viewer's LOCAL timezone. `ts` is only a real
// Unix epoch once the device clock has been set (the cluster pushes it via
// /api/cluster/time); before that it can be a small uptime value, so treat anything
// under 1e9 (< 2001) as "no real time" and show a dash rather than a bogus 1970 date.
function fmtLocalTs(ts){
  return (typeof ts==="number"&&ts>1e9)
    ? esc(new Date(ts*1000).toLocaleString())
    : '<span class="dim">â€”</span>';
}
function sourcesTable(s){
  if(!Array.isArray(s)||!s.length)return '<span class="dim">none</span>';
  let h='<table class="mono" style="border-collapse:collapse;font-size:12px"><tr><th style="text-align:left;padding:1px 8px 1px 0">source</th><th style="text-align:left;padding:1px 8px 1px 0">rssi</th><th style="text-align:left;padding:1px 8px 1px 0">lat,lon</th><th style="text-align:left;padding:1px 0">ts</th></tr>';
  for(const x of s){
    const id=x&&x.id!=null?esc(x.id):"?";
    const rssi=x&&x.rssi!=null?esc(x.rssi)+" dBm":'<span class="dim">â€”</span>';
    const pos=(x&&x.lat!=null&&x.lon!=null)?esc(x.lat)+", "+esc(x.lon):'<span class="dim">â€”</span>';
    const ts=fmtLocalTs(x&&x.ts);
    h+='<tr><td style="padding:1px 8px 1px 0">'+id+'</td><td style="padding:1px 8px 1px 0">'+rssi+'</td><td style="padding:1px 8px 1px 0">'+pos+'</td><td style="padding:1px 0">'+ts+'</td></tr>';
  }
  return h+'</table>';
}
function empty(msg){return '<div class="empty">'+esc(msg)+"</div>";}

const ENUM_FIELDS={device_class:"device_class",threat_level:"threat_level"};
function kvGrid(rec){
  let h='<div class="kv">';
  for(const [k,v] of Object.entries(rec)){
    if(k==="type"||k[0]==="_"||v===undefined)continue;
    let val;
    if(k==="sources"&&Array.isArray(v))val=sourcesTable(v);
    else if(v===null)val='<span class="dim">null</span>';
    else if(typeof v==="object")
      val='<span class="mono">'+esc(JSON.stringify(v))+'</span>';
    else if(ENUM_FIELDS[k])val=esc(v)+' <span class="dim">('+esc(cb(ENUM_FIELDS[k],v))+')</span>';
    else if(k==="ts_us")val=esc(v)+' <span class="dim">('+fmtTs(v)+')</span>';
    else if(k==="ts")val=fmtLocalTs(v);   // real wall-clock epoch (brain-stamped) -> local time
    else if(k==="threat_rule_ids")val=ruleList(v);
    else val=esc(v);
    h+="<div><b>"+esc(k)+":</b><span>"+val+"</span></div>";
  }
  return h+"</div>";
}

const F={q:"",kind:"",cat:[],vendor:"",cls:"",grade:"",threat:"",band:"",channel:""};
function fActiveVal(v){return Array.isArray(v)?v.length>0:!!v;}
function filterActive(){return Object.values(F).some(fActiveVal);}
function activeCount(){let n=0;for(const k in F)if(fActiveVal(F[k]))n++;return n;}

function match(r,kind){
  if(F.kind&&F.kind!==kind)return false;
  if(F.band){if(kind!=="wifi")return false;
    if((r.band_5g?"5":"2.4")!==F.band)return false;}
  if(F.channel){if(kind!=="wifi"||String(r.channel)!==F.channel)return false;}
  if(F.cat.length&&!F.cat.includes(fCat(r)))return false;
  if(F.vendor&&fVendor(r)!==F.vendor)return false;
  if(F.cls&&fClass(r)!==F.cls)return false;
  if(F.grade&&fGrade(r)!==F.grade)return false;
  if(F.threat&&fThreat(r)!==F.threat)return false;
  if(F.q){
    const hay=(fName(r)+" "+fVendor(r)+" "+fMac(r)+" "+fClass(r)).toLowerCase();
    if(!hay.includes(F.q))return false;
  }
  return true;
}

let FW=[],FB=[],FT=[],FD=[],FC=[],FA=[],MATCHED=new Set();
function applyFilter(){
  FW=[...M.wifi.values()].map(x=>x.rec).filter(r=>match(r,"wifi"));
  FB=[...M.ble.values()].map(x=>x.rec).filter(r=>match(r,"ble"));
  FT=[...M.trackers.values()].map(x=>x.rec).filter(r=>match(r,"track"));
  FD=[...M.drones.values()].map(x=>x.rec).filter(r=>match(r,"drone"));
  MATCHED=new Set();
  for(const r of [...FW,...FB,...FT,...FD]){
    const mac=fMac(r);if(mac)MATCHED.add(mac.toLowerCase());}
  FC=M.clusters.filter(c=>(c.members||[]).some(
    mb=>MATCHED.has(String(mb.mac||"").toLowerCase())));
  FA=[...M.alerts.values()].filter(a=>{
    if(!filterActive())return true;
    const ref=String(a.rec.target_ref||"").toLowerCase();
    if(MATCHED.has(ref))return true;
    if(F.q&&(a.rec.message||"").toLowerCase().includes(F.q))return true;
    return false;
  });
  buildClusterIndex();
  renderBanner();renderWifi();renderBle();renderClusters();renderTrackers();
  renderDrones();renderAlerts();renderPrivacy();renderChannel();renderRaw();renderNav();
  updateBar();
}

const WIFI_SORTS=[["threat","Threat"],["rssi","Signal"],["ident","Identity"],
  ["name","Name"],["vendor","Vendor"]];
const BLE_SORTS=[["threat","Threat"],["rssi","Signal"],["dist","Distance"],
  ["ident","Identity"],["name","Name"],["vendor","Vendor"]];
let sortWifi="threat",sortBle="threat";

let showAllWifi=false,showAllBle=false;

function segHtml(on){
  return '<button type="button" class="segb'+(on?" on":"")+'" data-v="1">Show all</button>'+
    '<button type="button" class="segb'+(on?"":" on")+'" data-v="0">Show trimmed</button>';
}
function wireSeg(id,html,setOn,rerender){
  const box=$(id);if(!box)return;
  box.innerHTML=html;
  box.querySelectorAll("button").forEach(b=>{b.onclick=()=>{
    setOn(b.dataset.v==="1");rerender();};});
}

function expandWifiRows(reps){
  if(!showAllWifi)return reps;
  const out=[];
  for(const r of reps){
    out.push(r);
    const sibs=r.radio_siblings;
    if(Array.isArray(sibs))for(const s of sibs){
      out.push(Object.assign({},r,{bssid:s.bssid,rssi:s.rssi,
        band_5g:s.band_5g,channel:s.channel,
        radio_siblings:undefined,radio_count:undefined,
        _radioSibling:true,_siblingOf:r.bssid}));
    }
  }
  return out;
}
function sortRows(rows,key){
  const cmp={
    threat:(a,b)=>(b.threat_level||0)-(a.threat_level||0)||(b.rssi??-999)-(a.rssi??-999),
    rssi:(a,b)=>(b.rssi??-999)-(a.rssi??-999),
    ident:(a,b)=>(b.identity_score||0)-(a.identity_score||0),
    dist:(a,b)=>(a.distance_dm??1e9)-(b.distance_dm??1e9),
    name:(a,b)=>(fName(a)||"ï¿¿").localeCompare(fName(b)||"ï¿¿"),
    vendor:(a,b)=>(fVendor(a)||"ï¿¿").localeCompare(fVendor(b)||"ï¿¿"),
  }[key];
  if(cmp)rows.sort(cmp);
}
function sortBar(opts,cur,id){
  return '<div class="sortbar">sort by<select id="'+id+'">'+
    opts.map(([v,l])=>'<option value="'+v+'"'+(v===cur?" selected":"")+">"+
      esc(l)+"</option>").join("")+"</select></div>";
}

function whyText(r){
  if((r.threat_level||0)<=0)return "";
  const ids=Array.isArray(r.threat_rule_ids)?r.threat_rule_ids:[];
  const msgs=ids.map(id=>M.ruleMsg[id]).filter(Boolean);
  if(msgs.length)return msgs.join(" ");
  return r.advisor||r.message||"";
}
function whyHtml(r){
  const t=whyText(r);
  return t? '<div class="why">'+esc(t)+"</div>" : "";
}

const TRIAGE_GROUPS=[["avoid","Avoid","ic-alert"],["caution","Needs a look",""],["","Safe",""]];
function triageBucket(lvl){lvl=lvl||0;return lvl>=3?0:lvl>=1?1:2;}

function cardList(rows,grouped,cardFn){
  if(!grouped)return rows.map(cardFn).join("");
  let h="",last=-1;
  rows.forEach(r=>{
    const g=triageBucket(r.threat_level);
    if(g!==last){
      const [cls,lbl,gi]=TRIAGE_GROUPS[g];
      const n=rows.reduce((a,x)=>a+(triageBucket(x.threat_level)===g),0);
      h+='<div class="grphdr '+cls+'">'+(gi?'<svg class="ic"><use href="#'+gi+
        '"/></svg> ':"")+esc(lbl)+' â€” '+n+"</div>";
      last=g;
    }
    h+=cardFn(r);
  });
  return h;
}

function clusterParts(){
  const net=[],bt=[],veh=[];
  for(const c of FC){
    if((c.cluster_kind||"physical")==="vehicle"){veh.push(c);continue;}
    ((c.members||[]).some(mb=>mb.layer==="wifi")?net:bt).push(c);
  }
  return{veh,net,bt,
    mr:dedupeRadioGroups(
      FW.filter(r=>Array.isArray(r.radio_siblings)&&r.radio_siblings.length)),
    sb:FB.filter(r=>r&&r.suppressed)};
}

function dedupeRadioGroups(rows){
  const setOf=r=>{
    const s=new Set([String(r.bssid||"").toUpperCase()]);
    for(const sb of r.radio_siblings)if(sb&&sb.bssid)
      s.add(String(sb.bssid).toUpperCase());
    return s;
  };
  const withSets=rows.map((r,i)=>({r,i,s:setOf(r)}));
  withSets.sort((a,b)=>b.s.size-a.s.size||a.i-b.i);
  const kept=[];
  for(const c of withSets){
    let dup=false;
    for(const k of kept){
      if(c.s.size<=k.s.size&&[...c.s].every(m=>k.s.has(m))){dup=true;break;}
    }
    if(!dup)kept.push(c);
  }
  kept.sort((a,b)=>a.i-b.i);
  return kept.map(c=>c.r);
}
let CLIDX=new Map();
let PV=[],PVIDX=new Map();
let PSIDX=new Map();
let MRIDX=new Map();
function buildClusterIndex(){
  CLIDX=new Map();
  const P=clusterParts();

  const put=(mac,slot,g,i)=>{
    if(!mac)return;
    const k=String(mac).toUpperCase();
    let e=CLIDX.get(k);if(!e){e={};CLIDX.set(k,e);}
    if(!e[slot])e[slot]={g,i};
  };
  [["v",P.veh],["n",P.net],["b",P.bt]].forEach(([g,arr])=>
    arr.forEach((c,i)=>(c.members||[]).forEach(mb=>put(mb.mac,"nic",g,i))));
  P.sb.forEach((r,i)=>put(r.addr,"nic","sb",i));
  P.mr.forEach((r,i)=>{put(r.bssid,"radio","mr",i);
    (r.radio_siblings||[]).forEach(s=>put(s.bssid,"radio","mr",i));});
  buildPrivClusters();
  buildPsIndex();
  buildRescanChains();
  RC.forEach((c,i)=>c.members.forEach(mb=>put(mb.mac,"chain","rc",i)));
}

let RC=[];
function buildRescanChains(){
  RC=[];
  if(!M||M.slots.length<2)return;
  const groups=new Map();
  const add=(key,ev,base,kind,mac,rec)=>{
    let g=groups.get(key);
    if(!g){g={ev,base,members:[]};groups.set(key,g);}
    g.members.push({kind,mac,rec});
  };
  for(const {rec:r} of M.ble.values()){
    const sub=String(r.addr_subtype||"").toLowerCase();
    if(!r.addr||sub==="public")continue;
    const comp=r.company_name||r.vendor||"";
    if(r.name)
      add("b1|"+r.name+"|"+comp,
        "same advertised name"+(comp?" + maker":""),75,"ble",r.addr,r);
    else if(r.fastpair_model_id)
      add("b2|"+r.fastpair_model_id,
        "same Fast Pair model (product-level identifier)",55,"ble",r.addr,r);
    else if(comp&&r.device_class!=null&&r.uuid16_flags)
      add("b3|"+comp+"|"+r.device_class+"|"+r.uuid16_flags,
        "same maker + device class + service flags (weak)",40,"ble",r.addr,r);
  }
  for(const {rec:r} of M.wifi.values()){
    if(!r.bssid||!r.ssid||r.ie_pattern_hash==null)continue;
    add("w|"+r.ssid+"|"+r.ie_pattern_hash+"|"+(r.auth||""),
      "same SSID + IE fingerprint + auth",60,"wifi",r.bssid,r);
  }
  for(const g of groups.values()){
    if(g.members.length<2)continue;
    const ms=g.members.map(mb=>Object.assign({},mb,
      {p:presenceOf(mb.kind,mb.mac)})).filter(mb=>mb.p);
    if(ms.length<2)continue;
    ms.sort((a,b)=>a.p.first-b.p.first||a.p.last-b.p.last);
    const cnt={};let overlap=0;
    for(const mb of ms)for(const s of mb.p.slots)cnt[s]=(cnt[s]||0)+1;
    for(const s in cnt)if(cnt[s]>1)overlap++;
    const rotation=overlap===0;
    const conf=Math.max(10,Math.min(95,
      g.base+(rotation?Math.min(20,5*(ms.length-1)):-20)));
    // A cross-scan cluster means ONE device observed across scans. Only keep
    // same-device address-rotation chains (no concurrent overlap) that span at
    // least two scans and clear a >70 confidence bar. Concurrent product groups
    // (separate units heard at once) and weak matches are excluded here â€” they
    // still appear as individual devices and in the other cluster tabs.
    const scanSpan=Object.keys(cnt).length;
    if(!rotation||scanSpan<2||conf<=70)continue;
    RC.push({members:ms,evidence:g.ev,rotation,overlap,conf});
  }
  RC.sort((a,b)=>b.conf-a.conf);
}

function buildPsIndex(){
  PSIDX=new Map();
  if(M&&M.lawEnf)for(const e of M.lawEnf.evidence||[])
    if(e.target)PSIDX.set(String(e.target).toUpperCase(),e);
  MRIDX=new Map();
  if(M&&M.medResp)for(const e of M.medResp.evidence||[])
    if(e.target)MRIDX.set(String(e.target).toUpperCase(),e);
}

// Pull a human identifier out of a raw analyzer row so a privacy cluster can
// show a name/vendor instead of just the MAC. Tiered: name(3) > vendor(1).
function privIdent(rec){
  if(!rec)return null;
  if(rec.name)return{t:3,s:String(rec.name)};
  const v=rec.vendor||rec.mac_vendor||rec.ie_vendor||rec.company_name;
  if(v)return{t:1,s:String(v)};
  if(rec.camera)return{t:1,s:"camera-vendor device"};
  return null;
}
function buildPrivClusters(){
  const by=new Map();
  const add=(mac,label,html,ident)=>{
    if(!mac)return;
    let e=by.get(mac);if(!e){e={mac,items:[],ident:null};by.set(mac,e);}
    e.items.push([label,html]);
    if(ident&&(!e.ident||ident.t>e.ident.t))e.ident=ident;
  };
  for(const p of PRIV){
    const rec=M.logs[p.k];if(!rec)continue;
    if(p.k==="station_log"){
      for(const s of rec.stations||[])add(s.mac,p.label,stationRow(s),privIdent(s));
    }else if(p.row){
      for(const r of rec.detail||[])add(r.src_mac,p.label,p.row(r),privIdent(r));
    }
  }
  PV=[...by.values()];
  PVIDX=new Map(PV.map((e,i)=>[String(e.mac).toUpperCase(),i]));
}

function clusterLink(mac){
  const e=mac&&CLIDX.get(String(mac).toUpperCase());
  if(!e)return "";
  const btn=(ref,ic,lb)=>ref?
    '<button class="clink" type="button" title="'+lb+' â€” view"'+
    ' aria-label="'+lb+' â€” view" onclick="event.stopPropagation();'+
    "gotoCluster('"+ref.g+"',"+ref.i+')">'+
    '<svg class="ic"><use href="#'+ic+'"/></svg></button>':"";
  return btn(e.nic,"ic-nic","Part of a NIC cluster")+
    btn(e.radio,"ic-radio","Part of a radio cluster")+
    btn(e.chain,"ic-chain","Part of a multi-scan chain");
}

function privacyLink(mac){
  const i=mac!=null?PVIDX.get(String(mac).toUpperCase()):undefined;
  if(i===undefined)return "";
  return '<button class="clink" type="button" title="Privacy findings â€” view"'+
    ' aria-label="Privacy findings â€” view" onclick="event.stopPropagation();'+
    "gotoCluster('pv',"+i+')">'+
    '<svg class="ic"><use href="#ic-privacy"/></svg></button>';
}

function devLink(mac){
  if(!mac)return "";
  if(M.wifi.has(mac))
    return '<button class="plink" type="button" onclick="event.stopPropagation();'+
      "gotoDevice('s-wifi','"+anchorId("wifi",mac)+'\')">view Wi-Fi result</button>';
  if(M.ble.has(mac))
    return '<button class="plink" type="button" onclick="event.stopPropagation();'+
      "gotoDevice('s-ble','"+anchorId("ble",mac)+'\')">view BLE result</button>';
  return "";
}
function pvLink(mac){
  const i=mac!=null?PVIDX.get(String(mac).toUpperCase()):undefined;
  if(i===undefined)return "";
  return '<button class="plink" type="button" onclick="event.stopPropagation();'+
    "gotoCluster('pv',"+i+')">privacy cluster</button>';
}
function privLinks(mac){return devLink(mac)+pvLink(mac);}

// The gotoDevice() call for a MAC, or null when it resolves to no result card.
// Same resolution as devLink, exposed so a whole card can be the hyperlink.
function devGoto(mac){
  if(!mac)return null;
  if(M.wifi.has(mac))return "gotoDevice('s-wifi','"+anchorId("wifi",mac)+"')";
  if(M.ble.has(mac))return "gotoDevice('s-ble','"+anchorId("ble",mac)+"')";
  return null;
}
// A uniform, fixed-size cluster-member card that mirrors the Wi-Fi/BLE result
// card and IS the hyperlink: tapping it jumps to that device's full result and
// closes the popup (wired in openClusterModal). o = {mac,kind:'wifi'|'ble',name,
// rssi,band,radio}. rssi/band default from the stored record when omitted.
function memberCard(o){
  const w=o.kind==="wifi";
  const e=o.mac?(w?M.wifi.get(o.mac):M.ble.get(o.mac)):null;
  const rec=e&&e.rec;
  const icon=rec?catIcon(rec,o.kind):iconSpan([w?"ic-wifi":"ic-ble",w?"Wi-Fi":"BLE"]);
  const rssi=o.rssi!==undefined?o.rssi:(rec&&typeof rec.rssi==="number"?rec.rssi:null);
  const band=o.band!==undefined?o.band:(w&&rec?(rec.band_5g?"5G":"2.4G"):null);
  const sig=typeof rssi==="number"?
    '<span class="mcsig"><svg class="ic"><use href="#ic-signal"/></svg>'+esc(rssi)+"</span>":"";
  const inner='<span class="mchd">'+
    '<span class="lyr '+(w?"w":"b")+'">'+(w?"WIFI":"BLE")+"</span>"+
    '<span class="mcname">'+esc(o.name||o.mac||"?")+"</span>"+sig+
    '<span class="dicon">'+icon+"</span></span>"+
    '<span class="mcbody"><span class="mmac mono">'+esc(o.mac||"?")+"</span>"+
    (band?'<span class="mcband">'+esc(band)+"</span>":"")+
    (o.radio?'<span class="mctag">radio</span>':"")+"</span>";
  const cls="mcard "+(w?"k-wifi":"k-ble");
  const go=devGoto(o.mac);
  return go?
    '<button class="'+cls+'" type="button" onclick="event.stopPropagation();'+go+
      '">'+inner+"</button>":
    '<div class="'+cls+'">'+inner+"</div>";
}

function devCard(kind,id,name,pill,meta,why,icon){
  return '<div class="dcard k-'+kind+'"'+(id?' id="'+id+'"':"")+">"+
    '<div class="dch"><span class="dleft">'+(icon||"")+
    '<span class="dname">'+name+'</span></span>'+
    '<span class="dright">'+(pill||"")+
    '<button class="draw" type="button" aria-expanded="false" '+
    'title="View raw data" aria-label="View raw data">â–¾</button>'+
    "</span></div>"+
    '<div class="dmeta">'+meta+'</div>'+(why||"")+
    '<div class="ddet" hidden></div></div>';
}
function vendCell(r){
  return r&&fVendor(r)? '<span class="vend">'+esc(fVendor(r))+"</span>"
                      : '<span class="dim">unknown vendor</span>';
}

function dcell(l,v){
  return '<span class="dc"><span class="dcl">'+esc(l)+
    '</span><span class="dcv">'+v+"</span></span>";
}
function stdCard(kind,id,r,addr,nameHtml,rowA,rowB){
  const vend=fVendor(r);
  const si=surfacedIdentity(r,kind);
  const named=!!fName(r);
  const nm=(si&&!named)?
    '<span class="surf" title="identity surfaced from raw scan">'+esc(si.name)+
      '<svg class="ic sfx"><use href="#ic-privacy"/></svg></span>':nameHtml;
  const watched=!!watchMatch(r,kind);
  return '<div class="dcard k-'+kind+(watched?" watched":"")+'"'+(id?' id="'+id+'"':"")+">"+
    '<div class="dch"><span class="dleft">'+catIcon(r,kind)+
    '<span class="daddr" title="'+esc(si&&!named?si.name:(fName(r)||addr))+'">'+nm+"</span></span>"+
    '<span class="dright">'+watchPill(r,kind)+clusterLink(addr)+privacyLink(addr)+threatPill(r.threat_level)+
    '<button class="draw" type="button" aria-expanded="false" '+
    'title="View details" aria-label="View details">â–¾</button></span></div>'+
    '<div class="dvend" title="'+esc(vend||"")+'">'+
    (vend?esc(vend):'<span class="dim">unknown vendor</span>')+sourceBadge(r)+"</div>"+
    '<div class="drow">'+rowA.map(c=>dcell(c[0],c[1])).join("")+"</div>"+
    '<div class="drow">'+rowB.map(c=>dcell(c[0],c[1])).join("")+"</div>"+
    presLine(kind,addr)+
    '<div class="ddet" hidden></div></div>';
}

function wireCards(el,rows,detail){
  el.querySelectorAll(".dcard").forEach((c,i)=>{
    const det=c.querySelector(".ddet");
    const btn=c.querySelector(".draw");
    c.querySelector(".dch").onclick=()=>{
      if(det.dataset.f!=="1"){det.innerHTML=detail(rows[i]);det.dataset.f="1";}
      det.hidden=!det.hidden;
      if(btn){btn.classList.toggle("open",!det.hidden);
        btn.setAttribute("aria-expanded",String(!det.hidden));}
    };
  });
}

function iconLegend(){
  const seen=new Set(),items=[];
  const add=(id,lb)=>{if(!seen.has(id)){seen.add(id);items.push([id,lb]);}};
  Object.values(ICON_BY_CAT).forEach(([id,lb])=>add(id,lb));
  add("ic-police","public safety / law enforcement");
  add("ic-router-ent","enterprise access point");
  add("ic-nic","in a NIC cluster (tap to view)");
  add("ic-radio","in a radio cluster (tap to view)");
  add("ic-privacy","privacy findings (tap to view)");
  add("ic-chain","in a multi-scan chain â€” same device across scans (tap to view)");
  return '<details class="iclg"><summary>icon legend</summary><div class="wrap">'+
    items.map(([id,lb])=>'<span class="it"><svg class="ic"><use href="#'+id+
      '"/></svg>'+esc(lb)+"</span>").join("")+"</div></details>";
}

function topVendLine(rows){
  const vc={};
  for(const r of rows){const v=fVendor(r);if(v)vc[v]=(vc[v]||0)+1;}
  const varr=Object.entries(vc).sort((a,b)=>b[1]-a[1]).slice(0,5);
  if(!varr.length)return "";
  return '<div class="topvl">top vendors: '+
    varr.map(([v,n])=>"<b>"+esc(v)+"</b>&hairsp;Ã—"+n).join(" Â· ")+"</div>";
}

function renderWifi(){
  const el=$("wifi");
  wireSeg("wtog",segHtml(showAllWifi),v=>showAllWifi=v,renderWifi);
  if(!FW.length){el.innerHTML=empty(filterActive()?
    "No Wi-Fi networks match the filter.":"No wifi_ap records.");return;}
  const rows=expandWifiRows(FW.slice());sortRows(rows,sortWifi);
  el.innerHTML=iconLegend()+topVendLine(rows)+
    sortBar(WIFI_SORTS,sortWifi,"sw")+'<div class="dlist">'+
    cardList(rows,sortWifi==="threat",r=>
      stdCard("wifi",anchorId("wifi",r.bssid),r,r.bssid||"?",ssidDisp(r.ssid),
        [["signal",rssiHtml(r.rssi)],["auth",esc(r.auth||"open")],
         ["type","Wi-Fi"],["device",esc(fClass(r)||"â€”")]],
        [["bssid",'<span class="mono">'+esc(r.bssid||"?")+"</span>"],
         ["confidence",identBar(r.identity_score)],
         ["band",r.band_5g?"5 GHz":"2.4 GHz"],["channel",esc(r.channel??"?")]])
    )+"</div>";
  $("sw").onchange=e=>{sortWifi=e.target.value;renderWifi();};
  wireCards(el,rows,wifiDetail);
}
function wifiDetail(r){
  const seen=M.wifi.get(r.bssid)||{n:1};
  return whyHtml(r)+idSurfCard(surfacedIdentity(r,"wifi"))+
    '<div class="small"><b>BSSID:</b> <span class="mono">'+esc(r.bssid||"?")+
    "</span> Â· <b>vendor:</b> "+esc(fVendor(r)||"unknown")+"</div>"+
    '<div class="small dim">class '+esc(cb("device_class",r.device_class))+
    " Â· "+seen.n+" record(s) Â· scans "+(r.first_seen_scan??"?")+"â€“"+
    (r.last_seen_scan??"?")+" Â· hits "+(r.hit_count??"?")+"</div>"+
    presDetail("wifi",r.bssid)+
    twinPairsForAp(r.bssid)+
    '<div class="ev"><b>threat rules:</b> '+ruleList(r.threat_rule_ids)+"</div>"+
    kvGrid(r);
}

// Every pair this AP took part in, including the ones that were
// CLEARED. A cleared pair raises no notification, so without this it is
// invisible, and "examined and found innocent" looks exactly like "never
// considered" â€” the ambiguity that made the Xfinity field report unauditable.
function twinPairsForAp(bssid){
  if(!bssid||!M.twins||!M.twins.size)return "";
  const me=bssid.toLowerCase();
  let h="";
  for(const {rec} of M.twins.values()){
    const t=(rec.target_ref||"").toLowerCase(),p=(rec.peer_ref||"").toLowerCase();
    if(t!==me&&p!==me)continue;
    const other=t===me?rec.peer_ref:rec.target_ref;
    const cleared=rec.decision==="no_twin_evidence";
    h+='<div class="ev"><b>'+(cleared?"paired and cleared:":"pair finding:")+
       "</b> "+macLink(other,"wifi")+
       (cleared?" â€” no impersonation evidence":
                " â€” "+esc(rec.decision||"?"))+"</div>"+
       twinEvidenceHtml(rec);
  }
  return h;
}

function renderBle(){
  const el=$("ble");
  wireSeg("btog",segHtml(showAllBle),v=>showAllBle=v,renderBle);
  const base=FB.filter(r=>showAllBle||!r.suppressed);
  if(!base.length){el.innerHTML=empty(filterActive()?
    "No BLE devices match the filter.":
    (FB.length?"All BLE devices here were noise-suppressed â€” use Show all to see them.":
     "No ble_device records."));return;}
  const rows=base.slice();sortRows(rows,sortBle);
  el.innerHTML=iconLegend()+topVendLine(rows)+
    sortBar(BLE_SORTS,sortBle,"sb")+'<div class="dlist">'+
    cardList(rows,sortBle==="threat",r=>
      stdCard("ble",anchorId("ble",r.addr),r,r.addr||"?",
        r.name?esc(r.name):'<span class="hid">unknown name</span>',
        [["signal",rssiHtml(r.rssi)],["addr type",esc(r.addr_subtype||"â€”")],
         ["type","BLE"],["device",esc(fClass(r)||"â€”")]],
        [["address",'<span class="mono">'+esc(r.addr||"?")+"</span>"],
         ["confidence",identBar(r.identity_score)],
         ["band","2.4 GHz"],["distance",fmtDist(r.distance_dm)]])
    )+"</div>";
  $("sb").onchange=e=>{sortBle=e.target.value;renderBle();};
  wireCards(el,rows,bleDetail);
}
function bleDetail(r){
  const ids=[];
  if(r.mfg_rule_name)ids.push("mfg rule: "+r.mfg_rule_name);
  if(r.apple)ids.push("Apple subtype "+r.apple.subtype+
    (r.apple.evidence?" ("+r.apple.evidence+")":""));
  if(r.ms_subtype_name)ids.push("MS: "+r.ms_subtype_name);
  if(r.fastpair_name)ids.push("FastPair: "+r.fastpair_name);
  if(r.uuid16_name)ids.push("uuid16: "+r.uuid16_name);
  if(r.uuid32_name)ids.push("uuid32: "+r.uuid32_name);
  if(r.uuid128_name)ids.push("uuid128: "+r.uuid128_name);
  if(r.name_rule_name)ids.push("name rule: "+r.name_rule_name);

  if(r.apple_category)ids.push("Apple category: "+r.apple_category);

  if(r.phone_model)ids.push("phone model: "+r.phone_model+
    (r.phone_model_confidence?" ("+r.phone_model_confidence+")":""));
  else if(r.phone_model_confidence==="inferred")
    ids.push("phone model: unknown ("+(r.apple_category||"type")+", inferred)");
  else if(r.phone_model_confidence==="make_only")
    ids.push("phone model: unknown (make only)");
  return whyHtml(r)+idSurfCard(surfacedIdentity(r,"ble"))+
    '<div class="small"><b>address:</b> <span class="mono">'+esc(r.addr||"?")+
    (r.addr_subtype?" ("+esc(r.addr_subtype)+")":"")+
    "</span> Â· <b>vendor:</b> "+esc(fVendor(r)||"unknown")+
    (r.class_source?' Â· <b>class source:</b> '+esc(r.class_source):"")+"</div>"+
    (ids.length?'<div class="ev"><b>identity evidence:</b> '+
    esc(ids.join(" Â· "))+"</div>":"")+
    presDetail("ble",r.addr)+
    '<div class="ev"><b>threat rules:</b> '+ruleList(r.threat_rule_ids)+"</div>"+
    kvGrid(r);
}

// 74g â€” compact local charts built from the already-filtered result arrays.
// Pure string builders (SVG/CSS), each carrying its own numeric text equivalent
// so a chart never replaces the underlying rows. Items may carry an `act` string
// (see summaryAct) that makes the mark a drill-in to a filtered result list.
function chStack(title,segs){
  const tot=segs.reduce((s,x)=>s+x.n,0);
  if(!tot)return "";
  const on=segs.filter(s=>s.n>0);
  const bars=on.map(s=>
    '<span class="seg'+(s.act?" clk":"")+'" style="width:'+(100*s.n/tot).toFixed(2)+
    '%;background:'+s.color+'"'+(s.act?' data-act="'+esc(s.act)+'" role="button" tabindex="0"':"")+
    ' title="'+esc(s.label+": "+s.n+(s.act?" â€” tap to filter":""))+'"></span>').join("");
  const leg=on.map(s=>
    '<span class="k'+(s.act?" clk":"")+'"'+(s.act?' data-act="'+esc(s.act)+'" role="button" tabindex="0"':"")+
    '><i style="background:'+s.color+'"></i>'+esc(s.label)+" <b>"+s.n+"</b></span>").join("");
  return '<div class="chart"><h4>'+esc(title)+'</h4>'+
    '<div class="chstack" role="img" aria-label="'+esc(title+": "+
      on.map(s=>s.label+" "+s.n).join(", "))+'">'+bars+"</div>"+
    '<div class="chleg">'+leg+"</div></div>";
}
function chBars(title,rows,max){
  rows=rows.filter(r=>r.n>0).sort((a,b)=>b.n-a.n);
  if(!rows.length)return "";
  if(max)rows=rows.slice(0,max);
  const top=rows[0].n;
  const body=rows.map(r=>{
    const inner='<span class="rl" title="'+esc(r.label)+'">'+esc(r.label)+
      '</span><span class="rb"><i style="width:'+(100*r.n/top).toFixed(1)+
      '%;background:'+(r.color||"var(--acc)")+'"></i></span><span class="rn">'+r.n+"</span>";
    return r.act?
      '<button type="button" class="chrow clk" data-act="'+esc(r.act)+'">'+inner+"</button>":
      '<div class="chrow">'+inner+"</div>";
  }).join("");
  return '<div class="chart"><h4>'+esc(title)+'</h4>'+body+"</div>";
}
function chHist(title,bins){
  const tot=bins.reduce((s,b)=>s+b.n,0);
  if(!tot)return "";
  const top=Math.max.apply(null,bins.map(b=>b.n))||1;
  const cols=bins.map(b=>
    '<div class="col'+(b.act?" clk":"")+'"'+(b.act?' data-act="'+esc(b.act)+'" role="button" tabindex="0"':"")+
    ' title="'+esc(b.label+": "+b.n)+'">'+
    '<span class="cn">'+b.n+'</span>'+
    '<span class="bar" style="height:'+(b.n?Math.max(6,100*b.n/top):0).toFixed(1)+
    '%;background:'+b.color+'"></span>'+
    '<span class="cl">'+esc(b.label)+"</span></div>").join("");
  return '<div class="chart"><h4>'+esc(title)+'</h4>'+
    '<div class="chhist" role="img" aria-label="'+esc(title+": "+
      bins.map(b=>b.label+" "+b.n).join(", "))+'">'+cols+"</div></div>";
}
// ---- individual chart blocks (each toggleable/movable on the Summary) ----
function chartComposition(){
  return chStack("Result composition",[
    {label:"Wi-Fi",n:FW.length,color:"var(--wifi)",act:FW.length?"wifi":""},
    {label:"BLE",n:FB.length,color:"var(--ble)",act:FB.length?"ble":""},
    {label:"Trackers",n:FT.length,color:"var(--track)",act:FT.length?"track":""},
    {label:"Drones",n:FD.length,color:"var(--drone)",act:FD.length?"drone":""}]);
}
function chartThreat(){
  const all=[...FW,...FB,...FT,...FD];
  const tc=[0,0,0,0];
  for(const r of all){const t=Math.min(r.threat_level||0,3);tc[t]++;}
  const col=["var(--safe)","var(--ok)","var(--caution)","var(--avoid)"];
  return chStack("Threat distribution",tc.map((n,i)=>{
    const lb=cb("threat_level",i);
    return {label:lb,n:n,color:col[i],act:n?"t:"+lb:""};
  }));
}
function chartSignal(){
  const all=[...FW,...FB,...FT,...FD];
  const sb=[{label:"â‰¥-50",n:0,color:"var(--safe)"},
    {label:"-50â€“-60",n:0,color:"var(--ok)"},
    {label:"-60â€“-70",n:0,color:"var(--caution)"},
    {label:"-70â€“-80",n:0,color:"var(--avoid)"},
    {label:"<-80",n:0,color:"var(--dim)"}];
  for(const r of all){const v=r.rssi;if(typeof v!=="number")continue;
    sb[v>=-50?0:v>=-60?1:v>=-70?2:v>=-80?3:4].n++;}
  return chHist("Signal strength (dBm)",sb);
}
function chartChannels(){
  const chc={};
  for(const r of FW)if(r.channel!=null)chc[r.channel]=(chc[r.channel]||0)+1;
  return chBars("Wi-Fi channel activity",Object.keys(chc).map(c=>({label:"ch "+c,
    n:chc[c],color:Number(c)>14?"var(--ble)":"var(--wifi)",act:"ch:"+c})),10);
}
function chartCategories(){
  const cat={};
  for(const r of [...FW,...FB]){const c=fCat(r);if(c)cat[c]=(cat[c]||0)+1;}
  return chBars("Device categories",Object.keys(cat).map(c=>({label:c,n:cat[c],
    color:"var(--acc)",act:"cat:"+c})),8);
}
// ---- Summary mini result lists (drill straight to a device row) ----
function smMiniList(title,rows){
  if(!rows.length)return "";
  return '<div class="smlist"><h4>'+esc(title)+'</h4>'+rows.map(r=>
    '<button type="button" class="smlrow" data-act="dev:'+esc(r.tab)+":"+esc(r.anchor)+
    '"><svg class="li" style="--c:'+r.color+'"><use href="#'+r.ic+'"/></svg>'+
    '<span class="ln">'+esc(r.name)+'</span><span class="lv">'+esc(r.val)+
    "</span></button>").join("")+"</div>";
}
function smRowFor(r,kind){
  const isW=kind==="wifi";
  return {tab:isW?"s-wifi":"s-ble",anchor:anchorId(kind,isW?r.bssid:r.addr),
    ic:isW?"ic-wifi":"ic-ble",color:isW?"var(--wifi)":"var(--ble)",
    name:(isW?(r.ssid||r.bssid):(r.name||r.fastpair_name||r.addr))||"?",
    rssi:typeof r.rssi==="number"?r.rssi:-999,r};
}
function blkTopSignal(){
  const rows=[...FW.map(r=>smRowFor(r,"wifi")),...FB.map(r=>smRowFor(r,"ble"))]
    .filter(x=>x.rssi>-999).sort((a,b)=>b.rssi-a.rssi).slice(0,6)
    .map(x=>({...x,val:x.rssi+" dBm"}));
  return smMiniList("Strongest signals",rows);
}
function blkTopThreat(){
  const rows=[...FW.map(r=>({...smRowFor(r,"wifi"),tl:r.threat_level||0})),
    ...FB.map(r=>({...smRowFor(r,"ble"),tl:r.threat_level||0}))]
    .filter(x=>x.tl>0).sort((a,b)=>b.tl-a.tl||b.rssi-a.rssi).slice(0,6)
    .map(x=>({...x,val:cb("threat_level",x.tl)}));
  if(!rows.length)return "";
  return smMiniList("Top threats",rows);
}
// ---- Summary blocks (each returns HTML; "" when it has no data to show) ----
function blkVerdict(){
  const all=[...FW,...FB,...FT,...FD];
  if(!all.length)return "";                 // nothing to judge â€” skip the hero
  let worst=0;
  for(const r of all)worst=Math.max(worst,r.threat_level||0);
  const lbl=cb("threat_level",worst);
  const cls=THREAT_CLS[lbl]||"p"+Math.min(worst,3);
  const VMAP={p0:"var(--safe)",p1:"var(--ok)",p2:"var(--caution)",p3:"var(--avoid)"};
  return '<div class="hero"><div class="hero-side">'+
    '<div class="verdict" style="background:'+(VMAP[cls]||"var(--dim)")+
    '">worst threat: '+esc(lbl).toUpperCase()+"</div></div></div>";
}
function blkTiles(){
  let ap24=0,ap5=0;for(const r of FW)r.band_5g?ap5++:ap24++;
  let alerts=0;for(const a of FA)alerts+=a.n;
  const scans=M.slots.length>1?M.slots.length:
    (M.footer&&M.footer.counters?M.footer.counters.scans_completed:M.maxScan);
  const cp=clusterParts();
  const clustersAll=FC.length+cp.sb.length+cp.mr.length+PV.length;
  const tile=(n,l,c,ic,act)=>'<button class="tile" type="button" data-act="'+act+
    '" style="--c:'+c+'"><span class="n">'+
    (ic?'<svg class="ic"><use href="#'+ic+'"/></svg>':"")+n+
    '</span><span class="l">'+l+"</span></button>";
  return '<div class="tiles">'+
    tile(FW.length,"Wi-Fi","var(--wifi)","ic-wifi","wifi")+
    tile(FB.length,"BLE","var(--ble)","ic-ble","ble")+
    tile(FT.length,"trackers","var(--track)","ic-tracker","track")+
    (FD.length?tile(FD.length,"drones","var(--drone)","ic-drone","drone"):"")+
    tile(clustersAll,"clusters","var(--acc)","ic-nic","clusters")+
    tile(alerts,"notifications","var(--avoid)","ic-alert","alerts")+
    tile(scans??"?","scans","var(--dim)","","scans")+
    tile(PV.length,"privacy","var(--acc2)","ic-privacy","privacy")+
    tile(ap24,"2.4 GHz APs","var(--wifi)","ic-router","ap24")+
    tile(ap5,"5 GHz APs","var(--wifi)","ic-router","ap5")+"</div>";
}
function blkChannels(){
  const chc={};
  for(const r of FW)if(r.channel!=null)chc[r.channel]=(chc[r.channel]||0)+1;
  const chans=Object.keys(chc).map(Number).sort((a,b)=>a-b);
  if(!chans.length)return "";
  return '<div class="chansum"><span class="chlbl">Channels:</span>'+
    chans.map(c=>'<button class="fchip" type="button" data-act="ch:'+c+'">ch '+c+
      ' <span class="chn">'+chc[c]+"</span></button>").join("")+"</div>";
}
function blkEnv(){
  const ei=M.envInd;
  if(!ei||filterActive())return "";
  const NOTE="Estimated from passive RF identifiers. This is an assumption "+
    "based on confidence-scored evidence, not a confirmed count.";
  const cw=c=>c>=70?"strong":c>=50?"med":"weak";
  const bb=[];
  if(ei.public_safety_count_high)bb.push(["ic-police","Public safety",
    (ei.public_safety_count_low===ei.public_safety_count_high?
      "~"+ei.public_safety_count_high:
      ei.public_safety_count_low+"â€“"+ei.public_safety_count_high),
    ei.public_safety_conf]);
  if(ei.camera_count)bb.push(["ic-camera","Cameras",ei.camera_count,ei.camera_conf]);
  if(ei.medical_count)bb.push(["ic-responder","Medical/EMS",ei.medical_count,ei.medical_conf]);
  if(!bb.length)return "";
  return '<div class="envb">'+bb.map(([ic,lb,ct,cf])=>
    '<div class="b" title="'+esc(lb+" â€” "+NOTE)+
    '"><svg class="ic" role="img" aria-label="'+esc(lb)+'"><use href="#'+esc(ic)+
    '"/></svg><span>'+esc(lb)+'</span><span class="ct">'+esc(String(ct))+
    '</span><span class="cf">'+cw(cf||0)+"</span></div>").join("")+"</div>";
}
function blkCrowd(){
  if(filterActive())return "";
  const catCount={};
  for(const r of FW){const c=fCat(r);if(c)catCount[c]=(catCount[c]||0)+1;}
  for(const r of FB){const c=fCat(r);if(c)catCount[c]=(catCount[c]||0)+1;}
  const deviceDensity=FW.length+FB.length;
  if(deviceDensity<=0)return "";
  const persons=["Phones & mobile","Wearables","Computers"];
  const mobilePressure=persons.reduce((s,c)=>s+(catCount[c]||0),0);
  // Dense residential (townhouses, apartments) routinely hears dozens of neighbour
  // networks + devices, so the bands are deliberately loose.
  const lvl=n=>n===0?"Quiet":n<=15?"Light":n<=50?"Moderate":n<=120?"Busy":"Crowded";
  const dtone=n=>n<=15?"safe":n<=50?"ok":n<=120?"caution":"avoid";
  const tone=dtone(deviceDensity),dens=lvl(deviceDensity);
  const rows=[["RF crowd density",dens,"c-"+tone],
    ["Total devices",deviceDensity+" seen"],["Mobile devices","~"+mobilePressure]];
  const evid=CAT_BUCKETS.map(([c])=>c).filter(c=>catCount[c]).map(c=>{
    const p=ICON_BY_CAT[c];
    return '<span class="e" title="'+esc(p[1])+'"><svg class="ic" role="img" aria-label="'+
      esc(p[1])+'"><use href="#'+esc(p[0])+'"/></svg><span>'+catCount[c]+"</span></span>";
  }).join("");
  return '<div class="crowd tone-'+tone+'"><div class="ttl">RF environment estimate'+
    '<span class="tt">'+esc(dens)+'</span></div>'+
    '<div class="est">'+rows.map(([k,v,cc])=>
      '<div class="r"><b>'+esc(k)+'</b><span class="v'+(cc?" "+cc:"")+'">'+esc(v)+
      "</span></div>").join("")+"</div>"+
    (evid?'<div class="evid">'+evid+"</div>":"")+
    '<div class="disc">Estimated from devices heard this scan â€” not a confirmed '+
    "count. MAC randomization and hidden devices mean the real number is likely "+
    "higher.</div></div>";
}
function blkCrossScan(){
  if(!(M.slots.length>1)||filterActive())return "";
  const tot=M.slots.length;
  let stable=0,transient=0,newest=0;
  for(const p of M.pres.values()){
    const n=p.slots.length;
    if(n>=Math.max(2,Math.ceil(tot*0.8)))stable++;
    if(n===1){transient++;if(p.slots[0]===tot-1)newest++;}
  }
  const rot=RC.filter(c=>c.rotation).length;
  const rows=[
    ["Scans aggregated",tot+(SESSIONS.length>1?
      " (across "+SESSIONS.length+" captures)":"")],
    ["Stable devices",stable+" seen in â‰¥80% of scans","c-safe"],
    ["Transient devices",transient+" seen only once"+
      (newest?" ("+newest+" new in the latest scan)":""),"c-caution"],
    ["Address-rotation chains",rot+(RC.length>rot?
      " (+"+(RC.length-rot)+" concurrent product groups)":""),"c-rot"]];
  return '<div class="crowd tone-info"><div class="ttl">Scan Timeline'+
    '<span class="tt">'+tot+' scans</span></div>'+
    '<div class="est">'+rows.map(([k,v,cc])=>
      '<div class="r"><b>'+esc(k)+'</b><span class="v'+(cc?" "+cc:"")+'">'+
      esc(String(v))+"</span></div>").join("")+"</div>"+
    '<div class="disc">Devices seen in every pass are established here; '+
    "transient and address-rotating devices deserve a closer look. "+
    "MAC-randomization chains appear under Clusters â†’ Cross Scan.</div></div>";
}
function blkPcap(){
  if(filterActive()||!(M.pcap&&M.pcap.ran!==false&&M.pcap.status))return "";
  const p=M.pcap;
  return '<div class="stats"><div><b>Packet capture</b>'+esc(p.status)+
    " Â· "+(p.packets??0)+" pkts"+
    (p.dropped?" Â· "+p.dropped+" dropped":"")+
    (p.bytes?" Â· "+Math.round(p.bytes/1024)+" KB":"")+
    (Array.isArray(p.channels)&&p.channels.length?" Â· ch "+p.channels.join(","):"")+
    ' <a class="mono" href="'+esc(p.download||"/api/pcap/latest")+
    '">download .pcap</a></div></div>';
}
// Privacy exposure at a glance â€” how many devices leaked a re-linkable identifier,
// broken down by leak type, with the worst offenders drilling into the privacy
// clusters. Logs are aggregate (not device-scoped), so it hides under a filter.
function blkPrivacy(){
  if(filterActive())return "";
  const arr=(k,f)=>{const r=M.logs[k];const d=r&&(r.detail||r.stations);
    return Array.isArray(d)?(f?d.filter(f):d):[];};
  const probe=arr("probe_req_log").length;
  const link=arr("seq_fingerprint_log",r=>r.linked).length+
             arr("ie_signature_log",r=>r.mismatch).length+
             arr("anqp_log",r=>r.universal).length;
  const cam=arr("station_log",s=>s.camera).length;
  if(!PV.length&&!probe&&!link&&!cam)return "";
  const newN=PV.filter(e=>!ackHas(e.mac)).length,rev=PV.length-newN;
  const rows=[
    ["Devices leaking identity",newN+" new"+(rev?" Â· "+rev+" reviewed":""),
      newN?"c-caution":"c-safe"],
    ...(probe?[["Probe-request names",probe+" broadcast"]]:[]),
    ...(link?[["Linkable despite random MAC",link+" device"+(link===1?"":"s"),"c-caution"]]:[]),
    ...(cam?[["Camera-vendor MACs",cam+" â€” hidden-camera check","c-avoid"]]:[])];
  const top=PV.map((e,i)=>({e,i}))
    .sort((a,b)=>(ackHas(a.e.mac)?1:0)-(ackHas(b.e.mac)?1:0)||
      b.e.items.length-a.e.items.length).slice(0,4);
  const ev=top.length?'<div class="evid">'+top.map(({e,i})=>{
    const nm=String(e.ident?e.ident.s:e.mac).slice(0,18);
    return '<button type="button" class="e clk" title="'+esc((e.ident?e.ident.s:e.mac)+
      " â€” "+e.items.length+" leak"+(e.items.length>1?"s":"")+" â€” view")+
      '" onclick="event.stopPropagation();gotoCluster(\'pv\','+i+')">'+
      '<svg class="ic"><use href="#ic-privacy"/></svg><span>'+esc(nm)+" Â·"+e.items.length+
      "</span></button>";}).join("")+"</div>":"";
  return '<div class="crowd tone-'+(newN?"caution":"safe")+'"><div class="ttl">Privacy exposure'+
    '<span class="tt">'+(newN||PV.length)+" device"+((newN||PV.length)===1?"":"s")+"</span></div>"+
    '<div class="est">'+rows.map(([k,v,cc])=>'<div class="r"><b>'+esc(k)+
      '</b><span class="v'+(cc?" "+cc:"")+'">'+esc(String(v))+"</span></div>").join("")+"</div>"+
    ev+
    '<div class="disc">Passive identifiers that can re-link a device across randomized '+
    "MACs, or reveal remembered networks. Tap a device to inspect it.</div>"+
    '<div class="smmore"><button type="button" class="fchip" data-act="privacy">'+
    "Open Privacy analyzers â†’</button></div></div>";
}
// Identity grouping at a glance â€” separate addresses that evidence ties to one
// device/product (NIC + radio + rotation-chain clusters), worst rotation chains
// drilling into the Clusters section.
function blkClusters(){
  if(filterActive())return "";
  const P=clusterParts();
  const nic=P.net.length+P.bt.length,radio=P.mr.length,chains=RC.length,veh=P.veh.length;
  const total=nic+radio+chains+veh;
  if(!total)return "";
  const rows=[
    ["Identity (NIC) clusters",nic+" â€” Wi-Fi "+P.net.length+" Â· BLE "+P.bt.length],
    ...(radio?[["Multi-radio access points",radio+" grouped"]]:[]),
    ...(chains?[["Address-rotation chains",chains+" same-device","c-rot"]]:[]),
    ...(veh?[["Vehicles",veh+" grouped"]]:[])];
  const top=RC.slice(0,4);
  const ev=top.length?'<div class="evid">'+top.map((c,i)=>
    '<button type="button" class="e clk" title="'+esc(c.evidence+" â€” "+c.conf+
      "% confidence, "+c.members.length+" addresses â€” view")+
    '" onclick="event.stopPropagation();gotoCluster(\'rc\','+i+')">'+
    '<svg class="ic"><use href="#ic-chain"/></svg><span>'+c.members.length+" addrs Â·"+
    c.conf+"%</span></button>").join("")+"</div>":"";
  return '<div class="crowd tone-info"><div class="ttl">Clusters'+
    '<span class="tt">'+total+" group"+(total===1?"":"s")+"</span></div>"+
    '<div class="est">'+rows.map(([k,v,cc])=>'<div class="r"><b>'+esc(k)+
      '</b><span class="v'+(cc?" "+cc:"")+'">'+esc(String(v))+"</span></div>").join("")+"</div>"+
    ev+
    '<div class="disc">Separate addresses that evidence says belong to one device. '+
    (chains?"Rotation chains defeat MAC randomization â€” worth a closer look. ":"")+
    "Tap a chain to inspect it.</div>"+
    '<div class="smmore"><button type="button" class="fchip" data-act="clusters">'+
    "Open Clusters â†’</button></div></div>";
}

// ---- Watchlist: user-entered MACs / names flagged when detected ----
// Viewer-side (this browser). Never hides data â€” it only adds a flag.
const WATCH_KEY="sc-watchlist";
function watchGet(){try{const a=JSON.parse(localStorage.getItem(WATCH_KEY));
  return Array.isArray(a)?a:[];}catch(e){return [];}}
function watchSet(a){try{localStorage.setItem(WATCH_KEY,JSON.stringify(a));}catch(e){}}
function normMac(s){return String(s||"").replace(/[^0-9a-fA-F]/g,"").toUpperCase();}
function watchAdd(type,val){
  val=String(val||"").trim();if(!val)return false;
  if(type==="mac"){const m=normMac(val);if(m.length!==12)return false;val=m;}
  const a=watchGet();
  if(a.some(w=>w.t===type&&String(w.v).toUpperCase()===val.toUpperCase()))return true;
  a.push({t:type,v:val});watchSet(a);return true;
}
function watchDel(i){const a=watchGet();a.splice(i,1);watchSet(a);}
// Match a record; return the matched entry or null. MAC is exact; name is a
// case-insensitive substring of the SSID (Wi-Fi) or device name (BLE/etc).
function watchMatch(r,kind){
  const wl=watchGet();if(!wl.length||!r)return null;
  const mac=normMac(kind==="wifi"?r.bssid:r.addr);
  const nm=String((kind==="wifi"?(r.ssid||""):
    (r.name||r.fastpair_name||""))||"").toLowerCase();
  for(const w of wl){
    if(w.t==="mac"&&mac&&normMac(w.v)===mac)return w;
    if(w.t==="name"&&w.v&&nm&&nm.indexOf(String(w.v).toLowerCase())>=0)return w;
  }
  return null;
}
function watchPill(r,kind){
  return watchMatch(r,kind)?'<span class="pill watch" title="On your watchlist">'+
    "â˜… watch</span>":"";
}
function blkWatch(){
  const wl=watchGet();
  const hits=[];
  for(const r of FW){if(watchMatch(r,"wifi"))hits.push({...smRowFor(r,"wifi"),
    val:"Wi-Fi"});}
  for(const r of FB){if(watchMatch(r,"ble"))hits.push({...smRowFor(r,"ble"),
    val:"BLE"});}
  let h='<div class="smlist watch"><h4>Watchlist'+(hits.length?" â€” "+hits.length+
    " here now":wl.length?" â€” none detected":"")+"</h4>";
  if(hits.length)
    h+=hits.map(r=>'<button type="button" class="smlrow" data-act="dev:'+esc(r.tab)+
      ":"+esc(r.anchor)+'"><svg class="li" style="--c:var(--acc)"><use href="#'+r.ic+
      '"/></svg><span class="ln">'+esc(r.name)+'</span><span class="lv">'+esc(r.val)+
      "</span></button>").join("");
  else h+='<div class="chempty">'+(wl.length?
    "None of your "+wl.length+" watched item"+(wl.length>1?"s":"")+" are in this scan.":
    "Add a MAC or a device / network name to get flagged when it shows up.")+"</div>";
  h+='<div class="wlman"><button type="button" class="wladd" data-wl="manage">'+
    "Manage watchlist</button></div></div>";
  return h;
}

// ---- Dog Park cluster control (movable summary card) ----
// Native controls for a SniffCheck cluster master: arm status, Adv rescan /
// Sniff Walk, and a live results waterfall streamed from the arms. Polls the
// master's /api/cluster/* + /api/captures/live.jsonl. Feature-detects the
// cluster: on a plain capture / offline viewer the card stays hidden. Lives in
// the summary registry so it drags/reorders like any other summary card.
const DP_OBS={wifi_ap:1,ble_device:1,tracker:1,drone_rid:1};
const DP_CAMCLASS=new Set([12]); // device_class camera / surveillance
let DP={started:false,cluster:null,status:null,seen:null,law:null,rows:[],sentinel:null,places:null,sc:0};
function dpMac(o){return String(o.bssid||o.addr||o.mac||"").toUpperCase();}
function dpIdOf(o){return o.ssid||o.name||o.bssid||o.addr||o.mac||"â€”";}
function dpKey(o){return (o.bssid||o.addr||o.mac||"")+"|"+(o.ts_us||o.ts_wall||"")+"|"+o.type;}
function dpArmOf(o){return o.source_id||o.arm||o.node||null;}
function dpTypeIcon(o){
  const f=o.eui_flags||0;
  if(o.type==="wifi_ap"){
    if(f&0x0002)return iconSpan(["ic-router-ent","enterprise access point"]);
    if(f&0x0004)return iconSpan(["ic-router","consumer router"]);
    return iconSpan(["ic-wifi","Wi-Fi network"]);
  }
  if(o.type==="tracker")return iconSpan(["ic-tracker","tracker / beacon"]);
  if(o.type==="drone_rid")return iconSpan(["ic-drone","drone"]);
  return iconSpan(["ic-ble","BLE device"]);
}
function dpSig(rssi){
  if(typeof rssi!=="number")return "";
  const on=rssi>=-55?4:rssi>=-67?3:rssi>=-78?2:rssi>=-88?1:0;
  let b="";for(let i=1;i<=4;i++)b+='<i class="'+(i<=on?"on":"")+'"></i>';
  return '<span class="sigbar" title="'+rssi+' dBm"><span class="bars">'+b+
    '</span><span class="rssi">'+rssi+"</span></span>";
}
function dpTime(o){
  // Prefer the brain-stamped real epoch (o.ts, seconds); fall back to legacy wall-ms, and
  // never treat o.ts_us (device uptime Âµs) as an epoch (that rendered a bogus 2025 date).
  const ms=(o.ts&&o.ts>1e9)?o.ts*1000:(o.ts_wall||0);
  return ms?new Date(ms).toLocaleTimeString():"";
}
function dpRowHtml(o){
  const mac=dpMac(o),arm=dpArmOf(o);
  let flags="";
  if(mac&&DP.law.has(mac))flags+=iconSpan(["ic-police","law-enforcement presence"]);
  if(DP_CAMCLASS.has(o.device_class))flags+=iconSpan(["ic-camera","camera / surveillance"]);
  return '<div class="dprow">'+dpTypeIcon(o)+flags+
    '<span class="dpnm">'+esc(dpIdOf(o))+(arm?' <span class="dparm">Â·'+esc(arm)+"</span>":"")+"</span>"+
    dpSig(o.rssi)+'<span class="dpt">'+esc(dpTime(o))+"</span></div>";
}
function dpVis(){const w=$("dpwrap");if(w)w.style.display="";
  const sw=$("sentwrap");if(sw)sw.style.display=(DP.cluster===false)?"none":"";}
function dpPaintCtrl(){
  const a=$("dp-arms"),c=$("dp-ctrl");if(!a||!c)return;
  if(DP.cluster===false){
    a.textContent="no cluster master detected â€” open this report from a SniffCheck cluster head";
    c.innerHTML="";return;}
  const s=DP.status;
  if(!s){a.textContent="connectingâ€¦";return;}
  a.innerHTML=(s.arms||[]).map(x=>{
    const st=["idle","scanning","walking"][x.state]||"?";
    return '<span class="dparmpill"><b>Arm '+x.i+"</b> "+esc(x.band||"")+" Â· "+
      '<b style="color:'+(x.online?"var(--safe)":"var(--avoid)")+'">'+
      (x.online?"online":"offline")+"</b> Â· "+esc(st)+" Â· W"+x.wifi+" B"+x.ble+"</span>";
  }).join("")||"no arms yet";
  const walking=!!s.walking;
  c.innerHTML='<button type="button" class="dpbtn" id="dp-scan">Adv rescan</button>'+
    '<button type="button" class="dpbtn" id="dp-walk">'+(walking?"Stop walk":"Start walk")+"</button>";
  $("dp-scan").onclick=()=>fetch("/api/cluster/scan",{method:"POST"}).then(()=>setTimeout(dpPoll,300)).catch(()=>{});
  $("dp-walk").onclick=()=>fetch("/api/cluster/walk?start="+(walking?0:1),{method:"POST"}).then(()=>setTimeout(dpPoll,300)).catch(()=>{});
}
function dpPaintLog(){
  const l=$("dp-log");if(!l)return;
  const near=(l.scrollHeight-l.scrollTop-l.clientHeight)<48;
  l.innerHTML=DP.rows.map(dpRowHtml).join("")||'<div class="chempty">Waiting for arm resultsâ€¦</div>';
  if(near)l.scrollTop=l.scrollHeight;
}
function dpIngest(t){
  const ls=t.split("\n");
  for(let i=0;i<ls.length;i++){const s=ls[i].trim();if(!s||s[0]!=="{")continue;
    let o;try{o=JSON.parse(s);}catch(e){continue;}
    if(o.type==="law_enforcement_presence"&&Array.isArray(o.entries)){
      for(const e of o.entries){const m=String(e.mac||e.bssid||e.addr||"").toUpperCase();if(m)DP.law.add(m);}
      continue;
    }
    if(!DP_OBS[o.type])continue;const k=dpKey(o);if(DP.seen.has(k))continue;DP.seen.add(k);DP.rows.push(o);
  }
  if(DP.rows.length>400)DP.rows=DP.rows.slice(-400);
}
function dpSchedule(ms){clearTimeout(DP.t);if(DP.paused)return;DP.t=setTimeout(dpPoll,ms);}
// Suspend/resume the whole cluster polling loop (Dog Park / ePup / Environments / Health /
// Sentinel / Activity) during a manual Refresh, and visibly disable their controls so it's
// clear they're paused. Clearing the timers alone isn't enough â€” an in-flight dpPoll would
// repaint the controls and re-arm the loop; DP.paused makes dpSchedule a no-op and makes the
// in-flight cycle bail before it repaints or grabs another socket.
function dpBusy(on){
  DP.paused=on;
  if(on){clearTimeout(DP.t);clearTimeout(accT);}
  ["dpwrap","epwrap","hcard","ss-card","act-card"].forEach(id=>{
    const w=$(id);if(w)w.classList.toggle("dp-busy",on);});
}
function dpPoll(){
  if(DP.paused)return;   // suspended during a manual Refresh so it doesn't starve the sockets
  fetch("/api/cluster/status",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{if(DP.paused)return;   // Refresh started mid-flight â€” abort before repaint/socket
      DP.cluster=true;DP.status=j;accStart();dpVis();dpPaintCtrl();epPaint();envPaint();healthPaint();
      DP.sc=(DP.sc|0)+1;
      if(DP.sc%2){epSentFetch();epHowlFetch();}  // sentinel + tracker safety â€” every other cycle (~4 s)
      else envFetch();                    // environments change rarely too â€” alternate cycle
      if(DP.sc%3===0)actFetch();          // activity log â€” every third cycle (~6 s)
      if(!epTimeSynced||DP.sc%30===0)epTimeSync();   // keep the head's clock set (survives its reboot)
      // Pull only NEW records past our cursor, not the whole ring every 2s. The full-ring
      // firehose held an HTTP socket for seconds on a large session, starving the ESP32's
      // few sockets so Refresh (and other requests) could never connect. ?since is skipped
      // server-side; X-SC-Total advances the cursor; X-SC-Session resets it on a reboot.
      return fetch("/api/captures/live.jsonl?since="+(DP.cur|0),{cache:"no-store"}).then(r=>{
        const tot=parseInt(r.headers.get("X-SC-Total"),10),sess=r.headers.get("X-SC-Session")||"";
        if(sess&&DP.sess&&sess!==DP.sess){DP.cur=0;if(DP.seen)DP.seen.clear();DP.rows=[];}
        if(sess)DP.sess=sess;
        if(Number.isFinite(tot))DP.cur=tot;
        return r.text();
      });})
    .then(t=>{if(t!=null){dpIngest(t);dpPaintLog();}dpSchedule(2000);})
    .catch(()=>{if(DP.cluster===null)DP.cluster=false;dpVis();epPaint();dpSchedule(DP.cluster?2000:15000);});
}
function dpStart(){
  if(DP.started)return;DP.started=true;
  DP.seen=new Set();DP.law=new Set();DP.rows=[];
  dpPoll();epSentFetch();epHowlFetch();envFetch();epTimeSync();
}
function blkDogpark(){
  return '<div class="dpwrap" id="dpwrap">'+
    '<div class="dphead"><svg class="ic dpico"><use href="#ic-radio"/></svg>'+
    'Dog Park <span class="dparms" id="dp-arms">connectingâ€¦</span></div>'+
    '<div class="dpctrl" id="dp-ctrl"></div>'+
    '<div class="dplog" id="dp-log"></div></div>';
}

// ---- ePup learning brain (movable summary card, B9) ----
// Surfaces the cluster brain's ePup summary + place recognition ("where am I")
// from the same /api/cluster/status poll the Dog Park card uses. Self-hides on a
// plain capture / non-cluster viewer, like the Dog Park card. The classify input
// (naming the current place) posts to /api/cluster/epup/label.
function epStat(label,v){
  return '<span class="epstat"><b>'+(v==null?"â€”":v)+'</b>'+label+'</span>';
}
function epPlace(p){
  if(!p)return "";
  let msg,tone,ic="ic-home";
  if(p.cur<0){msg="Not enough Wi-Fi landmarks here to place you yet.";tone="dim";}
  else if(p.is_new){msg="Somewhere new â€” first time the ePup has seen this place.";tone="new";}
  else if(p.known){msg=(p.label?'â€œ'+esc(p.label)+'â€ â€” ':"")+
    "I know this place. Visit #"+p.scans+" Â· "+p.sim+"% match.";tone="known";}
  else{msg="Getting to know this placeâ€¦ visit #"+p.scans+" ("+p.sim+"% match).";tone="fam";}
  return '<div class="epplace tone-'+tone+'"><svg class="ic"><use href="#'+ic+'"/></svg>'+
    '<span>'+msg+"</span></div>";
}
// Classify input (naming the current place). Built ONCE and preserved across the 2 s
// poll so it never clobbers what the user is typing; epPaint only re-syncs the hint.
function epClassSync(p){
  const box=$("ep-class");if(!box)return;
  if(!p||p.cur<0){box.style.display="none";box.innerHTML="";box.dataset.built="";return;}
  box.style.display="";
  if(box.dataset.built!=="1"){
    box.innerHTML='<div class="epclass"><input id="ep-lin" maxlength="15" autocomplete="off" '+
      'placeholder="Name this place"><button id="ep-lbtn" type="button">Name</button></div>';
    box.dataset.built="1";
    const send=()=>{const v=($("ep-lin").value||"").trim();if(!v)return;
      fetch("/api/cluster/epup/label",{method:"POST",body:v})
        .then(()=>{$("ep-lin").value="";setTimeout(dpPoll,300);}).catch(()=>{});};
    $("ep-lbtn").onclick=send;
    $("ep-lin").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();send();}};
  }
  const lin=$("ep-lin");
  if(lin&&document.activeElement!==lin)
    lin.placeholder=p.label?("Rename â€œ"+p.label+"â€"):"Name this place";
}
function epPaint(){
  const w=$("epwrap");if(!w)return;
  if(DP.cluster===false){w.style.display="none";return;}
  w.style.display="";
  const e=DP.status&&DP.status.epup,sub=$("ep-sub"),body=$("ep-body");
  if(!e){if(sub)sub.textContent="connectingâ€¦";if(body)body.innerHTML="";epSpriteFor(null);epClassSync(null);return;}
  if(sub)sub.textContent=esc(e.title)+" Â· L"+e.level+" Â· "+e.confidence+"% learned";
  let h='<div class="epstats">'+epStat("scans",e.scans)+epStat("unique",e.unique)+
    epStat("wifi/win",e.wifi)+epStat("ble/win",e.ble)+epStat("new",e.new)+"</div>";
  h+=epPlace(e.place);
  h+='<button class="epmore" id="ep-more" type="button">'+(epStatsOpen?"Hide stats":"ePup stats")+"</button>";
  if(epStatsOpen)h+=epStatsHtml(e);
  body.innerHTML=h;
  const mb=$("ep-more");if(mb)mb.onclick=()=>{epStatsOpen=!epStatsOpen;epPaint();};
  epSpriteFor(e);
  epClassSync(e.place);
}
// Detailed ePup stats: what drives the level, environments learned, boots alive, etc.
// Level follows an integer-sqrt curve over scan windows folded; "% learned" is those
// same windows measured against the 40,000-window "fully learned" horizon.
let epStatsOpen=false;
function epStatsHtml(e){
  const lvl=e.level|0, scans=e.scans|0, MAT=40000;
  const nextAt=(lvl+1)*(lvl+1), toNext=Math.max(0,nextAt-scans);
  const p=e.place||{};
  const row=(k,v,note)=>'<div class="epdrow"><b>'+k+'</b><span>'+v+"</span>"+
    (note?'<i>'+note+"</i>":"")+"</div>";
  let h='<div class="epdetail">';
  h+=row("Title",esc(e.title),"grows with scans folded");
  h+=row("Level","L"+lvl,"âˆš of "+scans.toLocaleString()+" scans Â· next at "+nextAt.toLocaleString()+" ("+toNext.toLocaleString()+" to go)");
  h+=row("Learned",e.confidence+"%",scans.toLocaleString()+" of "+MAT.toLocaleString()+" windows");
  h+=row("Environments",(p.count|0)+" learned",p.cur>=0?("here: visit #"+(p.scans|0)):"no place fix yet");
  if(typeof e.boots==="number")h+=row("Boots alive",e.boots,"power-ups since born");
  h+=row("Devices seen",(e.unique|0).toLocaleString()+" unique","Bloom estimate");
  h+=row("Per window",(e.wifi|0)+" Wi-Fi Â· "+(e.ble|0)+" BLE","~"+(e.ema|0)+" avg Â· "+(e.new|0)+" new");
  h+="</div>";
  return h;
}
// Pick the mascot animation from the ePup's live state. Priority (highest first):
//   stand  â€” ALERT: sentinel armed with a recent flagged detection (heads-up posture)
//   dig    â€” brand-new environment (first time the ePup has seen this place)
//   sniff  â€” actively scanning: on a walk, or a fresh scan window just folded
//   sit    â€” idle in a KNOWN, familiar place (relaxed)
//   stand  â€” idle everywhere else (unknown place / connecting)
// Only re-set the class when the state actually changes, so the CSS animation isn't
// restarted every 2 s poll. Scan freshness is derived by watching e.scans tick up.
let epPrevScans=-1, epScanBumpTs=0;
const EP_SCAN_FRESH_MS=8000;   // "actively scanning" window after a new scan folds
function epSpriteFor(e){
  const spr=$("ep-sprite");if(!spr)return;
  const p=e&&e.place;
  const now=Date.now();
  if(e&&typeof e.scans==="number"){
    if(epPrevScans>=0&&e.scans>epPrevScans)epScanBumpTs=now;
    epPrevScans=e.scans;
  }
  const s=DP.sentinel;
  const alert = !!(s&&s.armed&&(s.recent|0)>0);          // hostile-gadget hit this pass
  const walking = !!(DP.status&&DP.status.walking);
  const scanning = walking || (now-epScanBumpTs)<EP_SCAN_FRESH_MS;
  let anim;
  if(alert)                             anim="stand";  // alert â€” on guard
  else if(p&&p.cur>=0&&p.is_new)        anim="dig";    // new area â€” digging in
  else if(scanning)                     anim="sniff";  // on a walk / actively scanning
  else if(p&&p.known)                   anim="sit";    // familiar place â€” relaxed
  else                                  anim="stand";  // idle, somewhere new/unknown
  if(spr.dataset.anim!==anim){spr.className="epsprite "+anim;spr.dataset.anim=anim;}
}
function blkEpup(){
  return '<div class="epwrap" id="epwrap">'+
    '<div class="ephead"><svg class="ic epico"><use href="#ic-chip"/></svg>'+
    'ePup <span class="epsub" id="ep-sub">learningâ€¦</span></div>'+
    '<div class="epsprite stand" id="ep-sprite" title="ePup" role="img" aria-label="ePup mascot"></div>'+
    '<div class="epbody" id="ep-body"></div>'+
    '<div id="ep-class"></div></div>';
}

// ---- Sentinel block (own card, separated from ePup) with tracker safety (Bark/Howl) ----
// #ep-sent hosts the flagged-signature watchlist controls (painted by epSentPaint);
// #ep-howl hosts the tracker safety-sound controls (painted by epHowlPaint).
function blkSentinel(){
  return '<div class="epwrap" id="sentwrap" style="display:none">'+
    '<div class="ephead"><svg class="ic epico"><use href="#ic-alert"/></svg>Guard Dog</div>'+
    '<div class="epsent" id="ep-sent" hidden style="border-top:none;margin-top:0;padding-top:0"></div>'+
    '<div class="epsent" id="ep-howl" hidden></div></div>';
}

// ---- Hostile-gadget sentinel controls (105i), hosted in the ePup card ----
// The head owns the sentinel (flagged-signature watchlist) on /api/cluster/sentinel;
// this mirrors the Dog Park dashboard's Sentinel card so the report page can arm/
// disarm it, toggle categories, and manage flagged (BYOI) devices. The add-form
// inputs are built ONCE and never clobbered by the ~4 s poll; only the live
// state (armed, counts, category/BYOI rows) is re-rendered.
const EP_SENT_ICONS=["ic-tracker","ic-ble","ic-wifi","ic-router","ic-camera","ic-police","ic-drone"];
function epSentPost(obj){
  return fetch("/api/cluster/sentinel",{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify(obj)}).then(()=>setTimeout(epSentFetch,150)).catch(()=>{});
}
function epSentFetch(){
  fetch("/api/cluster/sentinel",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{DP.sentinel=j;epSentPaint();sentStatPaint();}).catch(()=>{});
}
function epSentCatRow(c){
  return '<label class="epsrow"><input type="checkbox" data-scat="'+c.id+'"'+(c.alert?" checked":"")+">"+
    iconSpan([c.icon||"ic-alert",c.label])+"<span>"+esc(c.label)+'</span>'+
    '<span class="hits">'+(c.hits|0)+" seen</span></label>";
}
function epSentByoiRow(b){
  return '<div class="epsrow"><input type="checkbox" data-sen="'+b.i+'"'+(b.enabled?" checked":"")+
    ' title="alert on this device">'+iconSpan([b.icon||"ic-tracker",b.name])+
    "<span"+(b.enabled?"":' style="opacity:.5"')+">"+esc(b.name)+"</span>"+
    '<span class="hits">'+esc(b.mac)+(b.pref_len<6?"/"+(b.pref_len*8):"")+" Â· "+(b.hits|0)+"</span>"+
    '<button class="epsdel" type="button" data-sdel="'+b.i+'" title="Remove">&#10005;</button></div>';
}
// Friendly labels for the device-type dropdown in the add-device popup.
const SENT_ICON_LABEL={"ic-tracker":"Tracker / gadget","ic-ble":"BLE device","ic-wifi":"Wi-Fi device",
  "ic-router":"Router / AP","ic-camera":"Camera","ic-police":"Law enforcement","ic-drone":"Drone"};
function epSentPaint(){
  const w=$("ep-sent");if(!w)return;
  const d=DP.sentinel;
  if(DP.cluster===false||!d||!d.cats){w.hidden=true;return;}
  w.hidden=false;
  if(w.dataset.built!=="1"){
    w.innerHTML='<div class="epshd"><svg class="ic"><use href="#ic-alert"/></svg>Watch List</div>'+
      '<label class="epsent-arm"><input type="checkbox" id="eps-arm"> <b id="eps-armt">Guard Dog</b>'+
      ' <span class="epsub">master switch</span></label>'+
      '<div class="epsbody" id="eps-body"><div class="epscount" id="eps-count"></div>'+
      '<div class="epsbtns">'+
      '<button id="eps-sigbtn" type="button"><svg class="ic"><use href="#ic-alert"/></svg>Alert signatures</button>'+
      '<button id="eps-addbtn" type="button"><svg class="ic"><use href="#ic-tracker"/></svg>Add device</button>'+
      '<button id="eps-hitbtn" type="button"><svg class="ic"><use href="#ic-signal"/></svg>Flagged results</button>'+
      '</div>'+
      '<div class="epslbl">Your flagged devices:</div><div id="eps-byoi"></div></div>';
    w.dataset.built="1";
    $("eps-arm").onchange=()=>epSentPost({armed:$("eps-arm").checked?1:0});
    $("eps-sigbtn").onclick=epSentSigOpen;
    $("eps-addbtn").onclick=epSentAddOpen;
    $("eps-hitbtn").onclick=epSentHitsOpen;
  }
  const armed=d.armed!==false;   // default on if an older head omits the field
  const arm=$("eps-arm");if(arm&&document.activeElement!==arm)arm.checked=armed;
  $("eps-armt").textContent="Guard Dog "+(armed?"armed":"disarmed");
  $("eps-body").classList.toggle("off",!armed);
  const last=d.last&&d.last.label?(" Â· last: "+esc(d.last.label)):"";
  const life=(d.life!=null)?(" Â· <b>"+(d.life|0)+"</b> lifetime Â· "+(d.life_uniq|0)+" unique"+
    ((d.returning|0)?" Â· "+(d.returning|0)+" returning":"")):"";
  $("eps-count").innerHTML="<b>"+(d.total|0)+"</b> this session"+life+last;
  const by=$("eps-byoi");
  by.innerHTML=(d.byoi&&d.byoi.length)?d.byoi.map(epSentByoiRow).join("")
    :'<div class="epsub">none yet â€” tap â€œAdd deviceâ€ to flag one</div>';
  by.querySelectorAll("input[data-sen]").forEach(cb=>cb.onchange=()=>
    epSentPost({byoi_en:{i:+cb.dataset.sen,on:cb.checked?1:0}}));
  by.querySelectorAll("button[data-sdel]").forEach(b=>b.onclick=()=>
    epSentPost({byoi_del:+b.dataset.sdel}));
}

// ---- Tracker safety-sound (Bark / Howl), hosted in the Sentinel block ----
// The head rings DULT / Find My tags via /api/cluster/tracker/{sound,burst}. The brain
// reports currently-ringable trackers in /api/cluster/tracker's "nearby" array (harvested,
// non-Tile), so we render one Bark button per tag plus a Howl-all button. Transmits.
let DP_TRK=null;
function epHowlFetch(){
  fetch("/api/cluster/tracker",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{DP_TRK=j;epHowlPaint();}).catch(()=>{});
}
function epTrkPost(url,body){
  return fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},
    body:body?JSON.stringify(body):undefined}).then(()=>setTimeout(epHowlFetch,300)).catch(()=>{});
}
function epBark(t){
  if(!confirm("Bark at "+t.mac+"?\n\nThis TRANSMITS a non-owner anti-stalking sound. Best-effort â€” only DULT / Find My tags respond, and an accepted command is not proof of audible sound."))return;
  epTrkPost("/api/cluster/tracker/sound",{mac:t.mac,addr_type:t.at|0,proto:0,action:0});
}
function epHowl(list){
  if(!list.length){alert("No ringable trackers seen yet. Start a walk or rescan first.");return;}
  if(!confirm("Howl: ring up to "+list.length+" nearby tracker(s), one at a time?\n\nThis TRANSMITS. You can Stop anytime."))return;
  epTrkPost("/api/cluster/tracker/burst",{targets:list.map(t=>({mac:t.mac,addr_type:t.at|0,proto:0}))});
}
function epHowlPaint(){
  const w=$("ep-howl");if(!w)return;
  const d=DP_TRK;
  if(DP.cluster===false||!d){w.hidden=true;return;}
  w.hidden=false;
  const b=d.burst||{},s3=d.s3||{},near=Array.isArray(d.nearby)?d.nearby:[];
  const busy=s3.busy?'<b style="color:var(--avoid)">transmittingâ€¦</b>':"idle";
  const last=(s3.last&&s3.last!=="none")?" Â· last: "+esc(s3.last):"";
  let h='<div class="epshd"><svg class="ic"><use href="#ic-tracker"/></svg>Trackers</div>'+
    '<div class="epscount">'+near.length+" ringable tracker(s) nearby Â· "+busy+last+"</div>"+
    '<div class="epslbl">Rings Find My / DULT tags (Tiles are detect-only). Transmits a non-owner safety sound â€” best-effort.</div>'+
    '<div class="epsbtns">';
  h+=b.active?'<button id="ep-howlstop" type="button"><svg class="ic"><use href="#ic-alert"/></svg>Stop howl ('+(b.done|0)+"/"+(b.total|0)+')</button>'
            :'<button id="ep-howlgo" type="button"><svg class="ic"><use href="#ic-signal"/></svg>Howl (ring all)</button>';
  h+="</div>";
  if(near.length){h+='<div class="epslbl">Bark a single tag:</div>';
    near.forEach((t,i)=>{h+='<div class="epsrow">'+iconSpan(["ic-tracker",t.mac])+"<span>"+esc(t.mac)+"</span>"+
      '<button class="epsdel" type="button" data-bark="'+i+'" title="Bark" '+
      'style="margin-left:auto;color:var(--acc);font-weight:800;font-size:12px">Bark</button></div>';});}
  const aud=Array.isArray(s3.audit)?s3.audit.slice(0,5):[];
  if(aud.length)h+='<div class="epsub" style="margin-top:6px">Recent: '+
    aud.map(a=>esc(a.mac)+"â†’"+esc(a.result)).join(" Â· ")+"</div>";
  w.innerHTML=h;
  const go=$("ep-howlgo");if(go)go.onclick=()=>epHowl(near);
  const st=$("ep-howlstop");if(st)st.onclick=()=>epTrkPost("/api/cluster/tracker/burst/stop",null);
  w.querySelectorAll("button[data-bark]").forEach(btn=>btn.onclick=()=>epBark(near[+btn.dataset.bark]));
}

// ---- Cluster health card (S4d): "how is everything performing" ----
// Live per-node traffic / uptime / errors for brain + arms + S3, from the same
// /api/cluster/status poll (its 2 s cadence IS the heartbeat). Toggle via Customize.
function fmtDur(s){s=s|0;if(s<0)return"â€”";const h=(s/3600)|0,m=((s%3600)/60)|0;
  return h?h+"h"+m+"m":(m?m+"m":s+"s");}
function fmtAgo(d){d=d|0;if(d<0)return"";return d<60?d+"s ago":((d/60)|0)+"m ago";}
function hNode(name,online,ic,rows){
  return '<div style="flex:1 1 132px;min-width:132px;background:var(--panel2,var(--panel));'+
    'border:2px solid var(--line);border-radius:10px;padding:8px 10px">'+
    '<div style="display:flex;align-items:center;gap:6px;font-weight:800;font-size:12px;margin-bottom:6px">'+
    '<span style="width:8px;height:8px;border-radius:50%;flex:0 0 auto;background:'+
    (online?"#3ad17a":"var(--dim)")+'"></span>'+
    '<svg class="ic"><use href="#'+ic+'"/></svg>'+esc(name)+'</div>'+
    '<div class="epstats" style="gap:4px 12px">'+rows.map(r=>
      '<span class="epstat"><b>'+r[1]+'</b>'+r[0]+'</span>').join("")+'</div></div>';
}
function blkHealth(){
  return '<div class="smlist" id="hcard"><h4>Cluster health Â· '+
    '<span style="font-weight:600;text-transform:none;color:var(--dim)">heartbeat 2s</span></h4>'+
    '<div id="h-grid" style="display:flex;flex-wrap:wrap;gap:8px"></div></div>';
}
function healthPaint(){
  const g=$("h-grid");if(!g)return;
  const c=$("hcard");if(DP.cluster===false){if(c)c.style.display="none";return;}
  if(c)c.style.display="";
  const st=DP.status||{},h=st.health||{},arms=st.arms||[],s3=h.s3||{};
  let html=hNode("Brain",true,"ic-chip",[["up",fmtDur(h.up)],["merges",h.merges|0],
    ["heap",((h.heap|0)/1024|0)+"K"],["bus rst",h.busrst|0]]);
  arms.forEach(a=>{const miss=Math.max(0,(a.polls|0)-(a.ok|0));
    html+=hNode("Arm "+a.i,!!a.online,"ic-radio",[["state",["idle","scan","walk"][a.state|0]||"?"],
      ["seq",a.seq|0],["polls",a.polls|0],["miss",miss]]);});
  html+=hNode("S3 node",!!s3.online,"ic-router",[["up",fmtDur(s3.up)],["SD recs",s3.recs|0],
    ["flagged",s3.flagged|0],["push âœ“/âœ—",(h.s3push|0)+"/"+(h.s3fail|0)]]);
  g.innerHTML=html;
}

// ---- Sentinel lifetime stats card (S4d): the watchlist scoreboard ----
function blkSentStat(){
  return '<div class="smlist" id="ss-card"><h4>Guard Dog stats</h4><div id="ss-body"></div></div>';
}
function sentStatPaint(){
  const b=$("ss-body");if(!b)return;
  const c=$("ss-card"),d=DP.sentinel;
  if(DP.cluster===false||!d){if(c)c.style.display="none";return;}
  if(c)c.style.display="";
  const st=(l,v)=>'<span class="epstat"><b>'+(v==null?"â€”":v)+'</b>'+l+'</span>';
  const cf=d.last&&d.last.conf;
  b.innerHTML='<div class="epstats">'+st("this session",d.total|0)+st("lifetime",d.life|0)+
    st("unique devices",d.life_uniq|0)+st("returning",d.returning|0)+'</div>'+
    (d.last&&d.last.label?'<div class="epsub" style="margin-top:4px">last: '+esc(d.last.label)+
      (cf===2?" Â· high confidence":cf===1?" Â· low confidence (name)":"")+'</div>':'');
}

// ---- Activity / ePup history log card (S4d): the cluster's running event log ----
function actFetch(){
  fetch("/api/cluster/log",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{DP.log=j.log||[];activityPaint();}).catch(()=>{});
}
function blkActivity(){
  return '<div class="smlist" id="act-card"><h4>Activity log</h4>'+
    '<div id="act-body"><div class="epsub">â€¦</div></div></div>';
}
function activityPaint(){
  const b=$("act-body");if(!b)return;
  const c=$("act-card");if(DP.cluster===false){if(c)c.style.display="none";return;}
  if(c)c.style.display="";
  const log=DP.log||[];
  if(!log.length){b.innerHTML='<div class="epsub">no events yet</div>';return;}
  const nowUp=(DP.status&&DP.status.health&&DP.status.health.up)|0;
  b.innerHTML=log.slice(0,12).map(e=>
    '<div style="display:flex;justify-content:space-between;gap:8px;font-size:11px;padding:2px 0;'+
    'border-top:1px solid var(--line)">'+
    '<span>'+esc(e.s)+'</span>'+
    '<span class="dim" style="white-space:nowrap">'+fmtAgo(nowUp-(e.t|0))+'</span></div>').join("");
}

// ---- Generic popup sheet (mirrors the cluster #clov modal, own overlay #epov) ----
// Reused by the sentinel popups (signatures / add-device / flagged-results) and the
// environments editor so opening one never disturbs the report layout underneath.
let epSheetWired=false;
function epSheetClose(){const ov=$("epov");if(ov)ov.hidden=true;}
function openSheet(title,bodyHtml,wire){
  const ov=$("epov"),sh=$("epsheet");if(!ov||!sh)return;
  sh.innerHTML='<div class="clhd"><h3>'+esc(title)+'</h3>'+
    '<button class="clx" type="button" aria-label="Close">âœ•</button></div>'+
    '<div class="clbody">'+bodyHtml+'</div>';
  sh.querySelector(".clx").onclick=epSheetClose;
  if(!epSheetWired){epSheetWired=true;
    ov.addEventListener("click",e=>{if(e.target===ov)epSheetClose();});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&!ov.hidden)epSheetClose();});
  }
  if(wire)wire(sh);
  ov.hidden=false;sh.scrollTop=0;
}

// Alert-signatures popup: toggle which built-in attack-tool signatures raise an alert.
function epSentSigOpen(){
  const d=DP.sentinel;if(!d||!d.cats)return;
  const body='<div class="epslbl">Choose which known attack-tool signatures raise a sentinel alert. '+
    'Matching is evidence-based on observed device names/vendors â€” nothing is hidden or dropped.</div>'+
    '<div id="sig-list">'+d.cats.map(epSentCatRow).join("")+'</div>';
  openSheet("Alert signatures",body,sh=>{
    sh.querySelectorAll("input[data-scat]").forEach(cb=>cb.onchange=()=>{
      const m=(DP.sentinel&&DP.sentinel.mask)||0,id=+cb.dataset.scat;
      epSentPost({mask:cb.checked?(m|(1<<id)):(m&~(1<<id))});});
  });
}

// Add-device popup: flag one device or a whole vendor (OUI) by MAC + name + type.
function epSentAddOpen(){
  const opts=EP_SENT_ICONS.map(i=>'<option value="'+i+'">'+esc(SENT_ICON_LABEL[i]||i.replace("ic-",""))+'</option>').join("");
  const body='<div class="epslbl">Flag a specific device or a whole vendor so the sentinel alerts whenever it appears.</div>'+
    '<div class="epsform">'+
    '<label>MAC address<input class="mac" id="add-mac" placeholder="aa:bb:cc:dd:ee:ff" autocomplete="off"></label>'+
    '<label>Name<input id="add-nm" placeholder="e.g. suspicious tracker" autocomplete="off"></label>'+
    '<label>Device type<select id="add-ic">'+opts+'</select></label>'+
    '<label>Scope<select id="add-sc"><option value="6">This device only</option><option value="3">Whole vendor (OUI)</option></select></label>'+
    '<button id="add-go" type="button">Add device</button>'+
    '<div class="epsub" id="add-msg"></div></div>';
  openSheet("Add device",body,sh=>{
    const go=()=>{const mac=sh.querySelector("#add-mac").value.trim();
      if(!mac){sh.querySelector("#add-msg").textContent="Enter a MAC address.";return;}
      epSentPost({byoi_add:{mac:mac,name:sh.querySelector("#add-nm").value.trim()||"flagged",
        icon:sh.querySelector("#add-ic").value,pref_len:+sh.querySelector("#add-sc").value}});
      epSheetClose();};
    sh.querySelector("#add-go").onclick=go;
    sh.querySelector("#add-mac").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();go();}};
  });
}

// Flagged-results popup: the head's timestamped detection history (GPS greyed for now).
function fmtStamp(ts,up){
  if(ts&&ts>1700000000){const d=new Date(ts*1000);
    return d.toLocaleDateString()+" "+d.toLocaleTimeString();}
  const s=up|0,h=(s/3600)|0,m=((s%3600)/60)|0;   // clock not set: relative uptime
  return "at uptime "+(h?h+"h ":"")+m+"m";
}
function epSentHitsOpen(){
  openSheet("Flagged detections",'<div id="hit-list"><div class="epsub">Loadingâ€¦</div></div>',sh=>{
    fetch("/api/cluster/sentinel/hits",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();}).then(j=>{
      const el=sh.querySelector("#hit-list");if(!el)return;
      const hits=(j&&j.hits)||[];
      if(!hits.length){el.innerHTML='<div class="epsub">No flagged detections recorded yet.</div>';return;}
      el.innerHTML=hits.map(h=>'<div class="hitcard">'+
        '<div class="hithd">'+iconSpan([h.kind==="flagged"?"ic-tracker":"ic-alert",h.kind])+
        '<span class="hitnm">'+esc(h.name)+'</span>'+
        '<span class="hitkind">'+esc(h.kind)+'</span></div>'+
        '<div class="hitmeta"><span class="mono">'+esc(h.mac)+'</span>'+
        '<span class="hitts">'+esc(fmtStamp(h.ts,h.up))+'</span></div>'+
        '<div class="hitgps" title="GPS logging is not wired up yet">'+
        iconSpan(["ic-home","location"])+'<span>GPS location â€” coming soon</span></div>'+
        '</div>').join("");
    }).catch(()=>{const el=sh.querySelector("#hit-list");
      if(el)el.innerHTML='<div class="epsub">Could not load detections.</div>';});
  });
}

// ---- Environments (Phase-95 place memory) â€” a clusters-style tile view (105k) ----
// Surfaces the brain's remembered places from /api/cluster/places: each tile is a place
// (current / known / new), tap opens a detail popup where the user reads the place's
// stats and renames it (full access to the brain's environment logic). Self-hides on a
// plain capture / non-cluster viewer like the other cluster cards.
function blkEnviron(){
  return '<div class="envwrap" id="envwrap">'+
    '<div class="ephead"><svg class="ic epico"><use href="#ic-home"/></svg>'+
    'Environments <span class="epsub" id="env-sub">learningâ€¦</span>'+
    '<button type="button" id="env-learn" class="envlearn">Learn this place</button></div>'+
    '<div class="envgrid" id="env-grid"></div></div>';
}
function envFetch(){
  fetch("/api/cluster/places",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{DP.places=j;envPaint();}).catch(()=>{});
}
function envTone(p){return p.current?"cur":(p.known?"known":"new");}
function envName(p){return p.label?esc(p.label):("Environment "+(p.idx+1));}
function envTileHtml(p){
  const state=p.current?"here now":(p.known?"known":"learning");
  return '<button class="envtile tone-'+envTone(p)+'" type="button" data-eidx="'+p.idx+'">'+
    '<div class="envtn">'+envName(p)+'</div>'+
    '<div class="envtb"><span>'+state+'</span><span>'+(p.scans|0)+' visits</span>'+
    '<span>'+(p.landmarks|0)+' landmarks</span></div></button>';
}
function envPaint(){
  const w=$("envwrap");if(!w)return;
  if(DP.cluster===false){w.style.display="none";return;}
  w.style.display="";
  const g=$("env-grid"),sub=$("env-sub");if(!g)return;
  const ps=(DP.places&&DP.places.places)||[];
  if(sub)sub.textContent=ps.length?(ps.length+" place"+(ps.length>1?"s":"")+" remembered"):"no places learned yet";
  g.innerHTML=ps.length?ps.map(envTileHtml).join(""):
    '<div class="epsub">The brain hasnâ€™t fingerprinted a place yet â€” it needs a couple of persistent Wi-Fi landmarks nearby.</div>';
  g.querySelectorAll("button[data-eidx]").forEach(b=>b.onclick=()=>envOpen(+b.dataset.eidx));
  const lb=$("env-learn");if(lb)lb.onclick=envLearnSheet;
}
function envOpen(idx){
  const ps=(DP.places&&DP.places.places)||[];const p=ps.find(x=>x.idx===idx);if(!p)return;
  const state=p.current?"You are here now":(p.known?"A known / familiar place":"Still learning this place");
  const tone=p.current?"fam":(p.known?"known":"new");
  const body='<div class="envdet">'+
    '<div class="epplace tone-'+tone+'"><svg class="ic"><use href="#ic-home"/></svg><span>'+state+'</span></div>'+
    '<div class="kv2">'+
      '<div><b>'+(p.scans|0)+'</b>visits</div>'+
      '<div><b>'+(p.landmarks|0)+'</b>landmarks</div>'+
      '<div><b>'+(p.known?"known":"learning")+'</b>status</div>'+
      '<div><b>#'+p.idx+'</b>place index</div>'+
    '</div>'+
    '<div class="epslbl">Landmarks <span class="epsub" id="env-q"></span></div>'+
    '<div id="env-lms"><div class="epsub">loadingâ€¦</div></div>'+
    '<div class="epslbl">Name this environment</div>'+
    '<div class="envclass"><input id="env-lin" maxlength="15" autocomplete="off" placeholder="'+
      (p.label?("Rename â€œ"+esc(p.label)+"â€"):"e.g. Home, Office, Gym")+'">'+
      '<button id="env-lbtn" type="button">Save</button></div>'+
    '<div class="epsub" id="env-msg">Letters, numbers, spaces, - and _ (max 15).</div>'+
    '<button id="env-forget" type="button" class="envdanger">Forget this environment</button></div>';
  openSheet(envName(p),body,sh=>{
    envLoadLandmarks(sh,idx);
    const send=()=>{const v=(sh.querySelector("#env-lin").value||"").trim();if(!v)return;
      fetch("/api/cluster/place/label",{method:"POST",headers:{"Content-Type":"application/json"},
        body:JSON.stringify({idx:idx,label:v})})
        .then(()=>{sh.querySelector("#env-msg").textContent="Saved.";
          setTimeout(()=>{envFetch();epSheetClose();},450);}).catch(()=>{
          sh.querySelector("#env-msg").textContent="Could not save.";});};
    sh.querySelector("#env-lbtn").onclick=send;
    sh.querySelector("#env-lin").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();send();}};
    sh.querySelector("#env-forget").onclick=()=>{
      if(!confirm("Forget this environment and all its landmarks? This canâ€™t be undone."))return;
      envPost({idx:idx,op:"forget",unit:"0"}).then(()=>{envFetch();epSheetClose();});};
  });
}
// POST a landmark/environment edit op {idx,op:pin|unpin|delete|forget,unit}.
function envPost(o){return fetch("/api/cluster/place/landmark",
  {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(o)}).catch(()=>{});}
// Load a place's real landmark records into the open sheet, with pin/remove per landmark.
function envLoadLandmarks(sh,idx){
  fetch("/api/cluster/place/detail?idx="+idx,{cache:"no-store"}).then(r=>r.json()).then(d=>{
    const q=d.quality|0,qel=sh.querySelector("#env-q");
    if(qel)qel.textContent=q?("Â· spatial confidence "+q+"%"+(q<60?" (learned from one spot)":"")):"";
    const el=sh.querySelector("#env-lms");if(!el)return;
    const lms=(d.landmarks||[]).slice().sort((a,b)=>(b.scans|0)-(a.scans|0));
    el.innerHTML=lms.length?lms.map(l=>'<div class="envlm">'+
      '<span>'+(l.confirmed?"â˜…":"Â·")+' '+esc(l.name)+' <span class="epsub">'+(l.scans|0)+'Ã—</span>'+
        (l.pinned?' <span class="epsub">pinned</span>':'')+'</span>'+
      '<span><button type="button" class="envlmbtn" data-op="'+(l.pinned?"unpin":"pin")+'" data-u="'+l.unit+'">'+
        (l.pinned?"unpin":"pin")+'</button>'+
      '<button type="button" class="envlmbtn" data-op="delete" data-u="'+l.unit+'">remove</button></span></div>'
      ).join(""):'<div class="epsub">No landmarks yet â€” the ePup needs a few persistent Wi-Fi fixtures here.</div>';
    el.querySelectorAll("button[data-op]").forEach(b=>b.onclick=()=>
      envPost({idx:idx,op:b.dataset.op,unit:b.dataset.u}).then(()=>{envLoadLandmarks(sh,idx);envFetch();}));
  }).catch(()=>{});}
// Guided "Learn Environment": N scans spaced by a reposition delay, or stationary (lower confidence).
function envLearnSheet(){
  const body='<div class="envdet">'+
    '<div class="epsub">The ePup takes several scans to map the fixed Wi-Fi here and build landmarks for this place.</div>'+
    '<div class="epslbl">Number of scans</div><input id="lz-n" type="number" min="1" max="20" value="4">'+
    '<div class="epslbl">Seconds between scans (to reposition)</div><input id="lz-t" type="number" min="0" max="120" value="20">'+
    '<label class="envchk"><input id="lz-s" type="checkbox"> Iâ€™ll stay in one spot (no repositioning)</label>'+
    '<div class="epsub" id="lz-note">Repositioning between scans lets the ePup tell fixed landmarks from people passing through.</div>'+
    '<button id="lz-go" type="button" class="envlmbtn" style="margin:12px 0 0;width:100%">Start learning</button>'+
    '<div class="epsub" id="lz-msg"></div></div>';
  openSheet("Learn Environment",body,sh=>{
    const s=sh.querySelector("#lz-s");
    s.onchange=()=>{sh.querySelector("#lz-note").textContent=s.checked
      ?"Staying put means the ePup canâ€™t separate fixtures from passers-by, so this place is marked lower confidence."
      :"Repositioning between scans lets the ePup tell fixed landmarks from people passing through.";};
    sh.querySelector("#lz-go").onclick=()=>{
      const n=Math.max(1,Math.min(20,+sh.querySelector("#lz-n").value||4));
      const gap=Math.max(0,Math.min(120,+sh.querySelector("#lz-t").value||20));
      fetch("/api/cluster/learn",{method:"POST",headers:{"Content-Type":"application/json"},
        body:JSON.stringify({scans:n,reposition:!s.checked,fresh:true})}).then(()=>envRunLearn(n,gap,sh));};
  });
}
function envRunLearn(n,gap,sh){let done=0;const msg=sh&&sh.querySelector("#lz-msg");
  (function step(){
    if(done>=n){if(msg)msg.textContent="Done â€” landmarks saved.";setTimeout(envFetch,400);return;}
    fetch("/api/cluster/scan",{method:"POST"}).then(()=>{done++;
      if(msg)msg.textContent="Scan "+done+" of "+n+((done<n&&gap)?" â€” reposition now":"");
      setTimeout(step,done<n?Math.max(1,gap)*1000+2600:500);}).catch(()=>{if(msg)msg.textContent="Scan failed.";});})();
}

// One-shot browserâ†’head clock sync so flagged detections get real date/time stamps.
let epTimeSynced=false;
function epTimeSync(){
  fetch("/api/cluster/time",{method:"POST",body:String(Math.floor(Date.now()/1000))})
    .then(()=>{epTimeSynced=true;}).catch(()=>{});
}

// Block registry. `def` = on in the default (pre-charts) summary layout.
const SUMMARY_BLOCKS=[
  {id:"dogpark",   label:"Dog Park (cluster control)",def:false,render:blkDogpark},
  {id:"epup",      label:"ePup (learning brain)",  def:false, render:blkEpup},
  {id:"sentinel",  label:"Guard Dog (watch list & trackers)",def:true,render:blkSentinel},
  {id:"environ",   label:"Environments (place memory)",def:false,render:blkEnviron},
  {id:"health",    label:"Cluster health (nodes / traffic)",def:false,render:blkHealth},
  {id:"sentstat",  label:"Guard Dog stats (lifetime)",def:false,isList:true,render:blkSentStat},
  {id:"activity",  label:"Activity log (cluster history)",def:false,isList:true,render:blkActivity},
  {id:"verdict",   label:"Worst-threat verdict",   def:true,  render:blkVerdict},
  {id:"tiles",     label:"Count tiles",            def:true,  render:blkTiles},
  {id:"channels",  label:"Channel chips",          def:true,  render:blkChannels},
  {id:"env",       label:"Environment indicators", def:true,  render:blkEnv},
  {id:"crowd",     label:"RF environment estimate",def:true,  render:blkCrowd},
  {id:"crossscan", label:"Scan timeline (multi-scan)",def:true,render:blkCrossScan},
  {id:"pcap",      label:"Packet-capture status",  def:true,  render:blkPcap},
  {id:"c_comp",    label:"Chart: result composition",def:false,isChart:true,render:chartComposition},
  {id:"c_threat",  label:"Chart: threat distribution",def:false,isChart:true,render:chartThreat},
  {id:"c_signal",  label:"Chart: signal strength", def:false, isChart:true,render:chartSignal},
  {id:"c_chan",    label:"Chart: Wi-Fi channel activity",def:false,isChart:true,render:chartChannels},
  {id:"c_cat",     label:"Chart: device categories",def:false,isChart:true,render:chartCategories},
  {id:"top_signal",label:"List: strongest signals",def:false, isList:true,render:blkTopSignal},
  {id:"top_threat",label:"List: top threats",      def:false, isList:true,render:blkTopThreat},
  {id:"privsum",   label:"Privacy exposure",       def:false, render:blkPrivacy},
  {id:"clustersum",label:"Clusters (identity grouping)",def:false,render:blkClusters},
  {id:"watch",     label:"Watchlist (your flags)", def:false, isList:true,render:blkWatch},
];
const BLK={};SUMMARY_BLOCKS.forEach(b=>BLK[b.id]=b);
// Cluster-only summary blocks: live controls that only work against a SniffCheck cluster
// backend (/api/cluster/*) â€” Dog Park, ePup, Guard Dog / Watch List + tracker safety-sound,
// Environments, cluster health/stats/activity. A standalone node and an offline capture have
// no such backend, so these are suppressed entirely (not listed, not rendered) rather than
// shown as dead cards. Only a confirmed live cluster reveals them.
const CLUSTER_BLOCKS=new Set(["dogpark","epup","sentinel","environ","health","sentstat","activity"]);
function clusterOn(){return DP.cluster===true;}
// Probe once whether a live cluster backs this report, independent of which cards happen to
// be placed, so the cluster blocks stay hidden on a standalone node until one is confirmed.
let clusterProbed=false;
function clusterProbe(){
  if(clusterProbed||!deviceOnline())return;clusterProbed=true;
  fetch("/api/cluster/status",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{DP.cluster=true;DP.status=j;dpStart();renderBanner();})
    .catch(()=>{DP.cluster=false;});   // standalone / offline â€” leave cluster blocks hidden
}
const SM_KEY="sc-summary-layout";
// Default tab arrangement (v2). Any def:true block not placed here is folded into the
// first tab on load, so a newly added default block still shows up somewhere.
function defaultTabs(){return [
  {name:"Overview",         blocks:["verdict","tiles","crowd","env"]},
  {name:"Signals",          blocks:["channels","crossscan","pcap"]},
  {name:"Privacy & groups", blocks:["privsum","clustersum"]},
  {name:"Guard Dog",        blocks:["sentinel","watch"]},
];}
// Persisted {v:2,active,tabs:[{name,blocks:[id,...]}]}, reconciled with the registry so
// new/removed blocks never wipe the user's arrangement. Migrates the old flat
// [{id,on}] layout into a single "Summary" tab.
function summaryCfg(){
  let saved=null;
  try{saved=JSON.parse(localStorage.getItem(SM_KEY));}catch(e){}
  let tabs,hide=null;
  if(saved&&saved.v===2&&Array.isArray(saved.tabs)){
    tabs=saved.tabs.map(t=>({name:String(t&&t.name||"Tab").slice(0,24),
      blocks:Array.isArray(t&&t.blocks)?t.blocks.slice():[]}));
  }else if(Array.isArray(saved)){                       // v1 -> v2 migration
    tabs=[{name:"Summary",blocks:saved.filter(s=>s&&BLK[s.id]&&s.on).map(s=>s.id)}];
    hide=new Set(saved.filter(s=>s&&BLK[s.id]&&!s.on).map(s=>s.id)); // keep prior "off"
  }else{
    tabs=defaultTabs();
  }
  const seen=new Set();                                  // drop unknown ids, dedupe
  for(const t of tabs)t.blocks=t.blocks.filter(id=>BLK[id]&&!seen.has(id)&&seen.add(id));
  if(!tabs.length)tabs=[{name:"Summary",blocks:[]}];
  for(const b of SUMMARY_BLOCKS)                          // place any orphaned default block
    if(b.def&&!seen.has(b.id)&&!(hide&&hide.has(b.id))){tabs[0].blocks.push(b.id);seen.add(b.id);}
  let active=saved&&typeof saved.active==="number"?saved.active:0;
  if(active<0||active>=tabs.length)active=0;
  return {v:2,active,tabs};
}
function saveSummaryCfg(cfg){
  try{if(cfg)localStorage.setItem(SM_KEY,JSON.stringify(
      {v:2,active:cfg.active|0,tabs:cfg.tabs.map(t=>({name:t.name,blocks:t.blocks.slice()}))}));
    else localStorage.removeItem(SM_KEY);}catch(e){}
}
// Registry blocks not currently in any tab (i.e. hidden / available to add).
function offBlocks(cfg){
  const used=new Set();cfg.tabs.forEach(t=>t.blocks.forEach(id=>used.add(id)));
  return SUMMARY_BLOCKS.filter(b=>!used.has(b.id)&&
    (clusterOn()||!CLUSTER_BLOCKS.has(b.id))).map(b=>b.id);
}
// Render one tab's blocks (consecutive charts grouped into a responsive grid).
function renderTabBlocks(tab){
  let h="",run=[];
  const flush=()=>{if(run.length){const inner=run.join("");
    if(inner)h+='<div class="charts">'+inner+"</div>";run=[];}};
  for(const id of (tab?tab.blocks:[])){
    const def=BLK[id];if(!def)continue;
    if(CLUSTER_BLOCKS.has(id)&&!clusterOn())continue;   // no cluster backend â†’ don't render
    const html=def.render()||"";if(!html)continue;
    if(def.isChart)run.push(html);else{flush();h+=html;}
  }
  flush();
  if(!h)h='<div class="chempty">This tab is empty. Tap <b>Customize</b> to add blocks.</div>';
  return h;
}
function renderBanner(){
  const cfg=summaryCfg();
  let bar='<div class="smbar"><button class="smgear" id="smgear" type="button" '+
    'aria-haspopup="dialog" title="Customize the RF Env Summary">'+
    '<svg><use href="#ic-gear"/></svg>Customize</button></div>';
  let side='<div class="smtabs" role="tablist" aria-label="Summary tabs">';
  cfg.tabs.forEach((t,i)=>{side+='<button class="smtab'+(i===cfg.active?" act":"")+
    '" type="button" role="tab" aria-selected="'+(i===cfg.active?"true":"false")+
    '" data-tab="'+i+'">'+esc(t.name)+"</button>";});
  side+="</div>";
  let content=renderTabBlocks(cfg.tabs[cfg.active]);
  if(!filterActive()&&M.bad)
    content+='<div class="stats"><div><b>skipped lines</b>'+M.bad+"</div></div>";
  $("smhost").innerHTML=bar+'<div class="smwrap">'+side+
    '<div id="banner" class="smcontent">'+content+"</div></div>";
  $("smgear").onclick=openSummaryCfg;
  $("smhost").querySelectorAll(".smtab").forEach(b=>b.onclick=()=>{
    const c=summaryCfg();c.active=+b.dataset.tab;saveSummaryCfg(c);renderBanner();});
  wireSummaryActs();
}
// Route a summary drill-in to the right filtered result list / tab.
function goResults(){
  const t=FW.length?"s-wifi":FB.length?"s-ble":FT.length?"s-trackers":
    FD.length?"s-drones":"s-wifi";
  curTab=t;showTab();
}
function summaryAct(act){
  const go=t=>{curTab=t;showTab();};
  const simple={wifi:"s-wifi",ble:"s-ble",track:"s-trackers",drone:"s-drones",
    clusters:"s-clusters",alerts:"s-alerts",scans:"s-raw",privacy:"s-privacy"};
  if(simple[act]){go(simple[act]);return;}
  if(act==="ap24"){setQuick({kind:"wifi",band:"2.4"});go("s-wifi");return;}
  if(act==="ap5"){setQuick({kind:"wifi",band:"5"});go("s-wifi");return;}
  const i=act.indexOf(":");if(i<0)return;
  const k=act.slice(0,i),v=act.slice(i+1);
  if(k==="ch"){setQuick({kind:"wifi",channel:v});go("s-wifi");return;}
  if(k==="t"){setQuick({threat:v});goResults();return;}
  if(k==="cat"){setQuick({cat:[v]});goResults();return;}
  if(k==="kind"){setQuick({kind:v});goResults();return;}
  if(k==="dev"){const j=v.indexOf(":");if(j>0)gotoDevice(v.slice(0,j),v.slice(j+1));return;}
}
function wireSummaryActs(){
  $("banner").querySelectorAll("[data-act]").forEach(el=>{
    el.onclick=e=>{e.stopPropagation();summaryAct(el.dataset.act);};
    if(el.getAttribute("role")==="button")
      el.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();
        summaryAct(el.dataset.act);}};
  });
  $("banner").querySelectorAll("[data-wl=manage]").forEach(el=>
    el.onclick=openWatchlist);
  // Dog Park / ePup cards: start the shared live poller once (either card needs
  // it), then repaint from cached state (renderBanner rebuilds the containers each
  // pass, so re-attach handlers here).
  if($("dpwrap")||$("epwrap")||$("hcard")||$("ss-card")||$("act-card")){dpStart();}
  if($("dpwrap")){dpVis();dpPaintCtrl();dpPaintLog();}
  if($("epwrap")){epPaint();}
  if($("hcard")){healthPaint();}
  if($("ss-card")){sentStatPaint();}
  if($("act-card")){actFetch();activityPaint();}
}

// ---- watchlist manager sheet ----
let wlWired=false,wlov=null,wlsheet=null,wlType="mac";
function openWatchlist(){
  wlov=$("wlov");wlsheet=$("wlsheet");
  if(!wlWired){wlWired=true;
    wlov.addEventListener("click",e=>{if(e.target===wlov)wlov.hidden=true;});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&wlov&&!wlov.hidden)wlov.hidden=true;});}
  renderWatchlist();wlov.hidden=false;
}
// Re-render everything that shows a watchlist flag after the list changes.
function watchRefresh(){renderWatchlist();renderBanner();renderWifi();renderBle();}
function renderWatchlist(){
  const wl=watchGet();
  let h='<h3>Watchlist</h3><div class="smsub">Flag a device or network when it '+
    "shows up in a scan. Stored only in this browser. Matching never hides anything "+
    "â€” it just marks the row.</div>";
  h+='<div class="wlman"><span class="wlseg">'+
    '<button data-wt="mac" class="'+(wlType==="mac"?"on":"")+'">MAC</button>'+
    '<button data-wt="name" class="'+(wlType==="name"?"on":"")+'">Name</button></span>'+
    '<input id="wlin" placeholder="'+(wlType==="mac"?"AA:BB:CC:DD:EE:FF":
      "SSID or device name (partial ok)")+'" autocomplete="off">'+
    '<button class="wladd" data-wl="add">Add</button></div>';
  h+='<div class="wlstat" style="font-size:12px;color:var(--avoid);min-height:1.1em;'+
    'margin-top:6px"></div>';
  if(wl.length)h+=wl.map((w,i)=>'<div class="wlrow"><span class="wt">'+
    (w.t==="mac"?"MAC":"name")+'</span><span class="wv" title="'+esc(w.v)+'">'+
    esc(w.v)+'</span><button class="wx" data-del="'+i+'" aria-label="Remove">âœ•</button>'+
    "</div>").join("");
  else h+='<div class="chempty" style="margin-top:8px">No watchlist entries yet.</div>';
  h+='<div class="smact"><button class="prim" data-wl="done">Done</button></div>';
  wlsheet.innerHTML=h;
  wlsheet.querySelectorAll("[data-wt]").forEach(b=>b.onclick=()=>{
    wlType=b.dataset.wt;renderWatchlist();});
  const stat=wlsheet.querySelector(".wlstat");
  const doAdd=()=>{
    const inp=wlsheet.querySelector("#wlin"),v=inp.value;
    if(watchAdd(wlType,v)){inp.value="";watchRefresh();
      wlsheet.querySelector("#wlin").focus();}
    else{const s=wlsheet.querySelector(".wlstat");
      if(s)s.textContent=wlType==="mac"?
        "Enter a full MAC (12 hex digits).":"Enter a name.";}
  };
  wlsheet.querySelector("[data-wl=add]").onclick=doAdd;
  wlsheet.querySelector("#wlin").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();doAdd();}};
  wlsheet.querySelectorAll("[data-del]").forEach(b=>b.onclick=()=>{
    watchDel(+b.dataset.del);watchRefresh();});
  wlsheet.querySelector("[data-wl=done]").onclick=()=>{wlov.hidden=true;};
}

// ---- gear / customization sheet ----
let smWired=false,smov=null,smsheet=null;
function openSummaryCfg(){
  smov=$("smov");smsheet=$("smsheet");
  if(!smWired){smWired=true;
    smov.addEventListener("click",e=>{if(e.target===smov)smov.hidden=true;});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&smov&&!smov.hidden)smov.hidden=true;});}
  renderSummaryCfg();smov.hidden=false;
}
function renderSummaryCfg(){
  const cfg=summaryCfg();
  const apply=c=>{saveSummaryCfg(c);renderSummaryCfg();renderBanner();};
  let h='<h3>Customize summary</h3><div class="smsub">Group blocks into tabs to cut '+
    'scrolling. Rename a tab, use â†‘â†“ (or drag the grip) to reorder within a tab, and '+
    '"Move to" to send a block to another tab or hide it. Saved on this device.</div>';
  // ---- tab manager ----
  h+='<div class="smtabmgr">';
  cfg.tabs.forEach((t,i)=>{
    h+='<div class="smtabrow" draggable="true" data-ti="'+i+'">'+
      '<span class="smgrip" title="Drag to reorder tabs">â ¿</span>'+
      '<input data-tname="'+i+'" value="'+esc(t.name)+'" maxlength="24" aria-label="Tab name">'+
      '<button data-tmv="up:'+i+'"'+(i===0?" disabled":"")+' aria-label="Move tab up">â†‘</button>'+
      '<button data-tmv="down:'+i+'"'+(i===cfg.tabs.length-1?" disabled":"")+' aria-label="Move tab down">â†“</button>'+
      '<button data-tdel="'+i+'"'+(cfg.tabs.length<=1?" disabled":"")+' aria-label="Delete tab">âœ•</button>'+
      "</div>";
  });
  h+='</div><button class="smaddtab" data-addtab="1">+ Add tab</button>';
  // ---- per-tab block groups ----
  const tag=def=>def.isChart?'<span class="smtag">chart</span>':
    def.isList?'<span class="smtag">list</span>':"";
  const tabOpts=cur=>cfg.tabs.map((t,i)=>'<option value="'+i+'"'+(i===cur?" selected":"")+
    ">"+esc(t.name)+"</option>").join("");
  cfg.tabs.forEach((t,i)=>{
    h+='<div class="smgrp">'+esc(t.name)+"</div>";
    if(!t.blocks.length)h+='<div class="chempty" style="margin:0 0 8px">(empty)</div>';
    t.blocks.forEach((id,bi)=>{const def=BLK[id];if(!def)return;
      if(CLUSTER_BLOCKS.has(id)&&!clusterOn())return;   // don't surface cluster blocks off-cluster
      h+='<div class="smblk on" draggable="true" data-bid="'+id+'" data-ti="'+i+'" data-bi="'+bi+'">'+
        '<span class="smgrip" title="Drag to reorder">â ¿</span>'+
        '<span class="smname">'+esc(def.label)+'</span>'+tag(def)+
        '<span class="smmv"><button data-bmv="up"'+(bi===0?" disabled":"")+' aria-label="Move up">â†‘</button>'+
        '<button data-bmv="down"'+(bi===t.blocks.length-1?" disabled":"")+' aria-label="Move down">â†“</button></span>'+
        '<select class="smmove" data-move="'+id+'" aria-label="Move to tab">'+tabOpts(i)+
        '<option value="off">Hide</option></select></div>';
    });
  });
  const off=offBlocks(cfg);
  if(off.length){
    h+='<div class="smgrp off">Hidden â€” pick a tab to show</div>';
    off.forEach(id=>{const def=BLK[id];if(!def)return;
      h+='<div class="smblk off" data-bid="'+id+'">'+
        '<span class="smname">'+esc(def.label)+'</span>'+tag(def)+
        '<select class="smmove" data-move="'+id+'" aria-label="Add to tab">'+
        '<option value="off" selected>Hidden</option>'+tabOpts(-1)+"</select></div>";
    });
  }
  h+='<div class="smact"><button data-sm="reset">Reset to default</button>'+
    '<button class="prim" data-sm="done">Done</button></div>';
  smsheet.innerHTML=h;
  // ---- wiring ----
  smsheet.querySelectorAll("[data-tname]").forEach(inp=>inp.onchange=()=>{
    const c=summaryCfg(),i=+inp.dataset.tname;
    if(c.tabs[i]){c.tabs[i].name=(inp.value.trim()||"Tab").slice(0,24);apply(c);}});
  smsheet.querySelectorAll("[data-tmv]").forEach(b=>b.onclick=()=>{
    const[dir,is]=b.dataset.tmv.split(":"),i=+is,c=summaryCfg();
    const j=dir==="up"?i-1:i+1;if(j<0||j>=c.tabs.length)return;
    const t=c.tabs[i];c.tabs[i]=c.tabs[j];c.tabs[j]=t;
    if(c.active===i)c.active=j;else if(c.active===j)c.active=i;apply(c);});
  smsheet.querySelectorAll("[data-tdel]").forEach(b=>b.onclick=()=>{
    const c=summaryCfg(),i=+b.dataset.tdel;if(c.tabs.length<=1)return;
    const moved=c.tabs[i].blocks;c.tabs.splice(i,1);
    (c.tabs[i>0?i-1:0].blocks).push(...moved);          // fold blocks into a neighbour
    if(c.active>=c.tabs.length)c.active=c.tabs.length-1;apply(c);});
  smsheet.querySelector("[data-addtab]").onclick=()=>{
    const c=summaryCfg();c.tabs.push({name:"Tab "+(c.tabs.length+1),blocks:[]});apply(c);};
  smsheet.querySelectorAll("[data-bmv]").forEach(b=>b.onclick=()=>{
    const row=b.closest(".smblk"),ti=+row.dataset.ti,bi=+row.dataset.bi,c=summaryCfg();
    const t=c.tabs[ti];if(!t)return;const j=b.dataset.bmv==="up"?bi-1:bi+1;
    if(j<0||j>=t.blocks.length)return;
    const tmp=t.blocks[bi];t.blocks[bi]=t.blocks[j];t.blocks[j]=tmp;apply(c);});
  smsheet.querySelectorAll("[data-move]").forEach(sel=>sel.onchange=()=>{
    const id=sel.dataset.move,to=sel.value,c=summaryCfg();
    c.tabs.forEach(t=>{const k=t.blocks.indexOf(id);if(k>=0)t.blocks.splice(k,1);});
    if(to!=="off"&&c.tabs[+to])c.tabs[+to].blocks.push(id);apply(c);});
  smsheet.querySelectorAll("[data-sm]").forEach(b=>b.onclick=()=>{
    if(b.dataset.sm==="reset")apply(null);else smov.hidden=true;});
  // drag: reorder blocks within the same tab, and reorder tabs
  let dragBid=null,dragBti=null;
  smsheet.querySelectorAll(".smblk[data-ti]").forEach(el=>{
    el.ondragstart=e=>{dragBid=el.dataset.bid;dragBti=el.dataset.ti;
      el.classList.add("dragging");e.dataTransfer.effectAllowed="move";};
    el.ondragend=()=>{el.classList.remove("dragging");
      smsheet.querySelectorAll(".smblk").forEach(x=>x.classList.remove("dragover"));};
    el.ondragover=e=>{if(el.dataset.ti===dragBti){e.preventDefault();el.classList.add("dragover");}};
    el.ondragleave=()=>el.classList.remove("dragover");
    el.ondrop=e=>{e.preventDefault();
      if(dragBid==null||el.dataset.ti!==dragBti)return;
      const c=summaryCfg(),t=c.tabs[+dragBti];if(!t)return;
      const from=t.blocks.indexOf(dragBid),to=+el.dataset.bi;
      if(from<0||from===to)return;
      const m=t.blocks.splice(from,1)[0];t.blocks.splice(to,0,m);apply(c);};
  });
  let dragTi=null;
  smsheet.querySelectorAll(".smtabrow").forEach(el=>{
    el.ondragstart=e=>{dragTi=+el.dataset.ti;el.classList.add("dragging");
      e.dataTransfer.effectAllowed="move";};
    el.ondragend=()=>{el.classList.remove("dragging");
      smsheet.querySelectorAll(".smtabrow").forEach(x=>x.classList.remove("dragover"));};
    el.ondragover=e=>{e.preventDefault();el.classList.add("dragover");};
    el.ondragleave=()=>el.classList.remove("dragover");
    el.ondrop=e=>{e.preventDefault();const to=+el.dataset.ti;
      if(dragTi==null||dragTi===to)return;
      const c=summaryCfg(),m=c.tabs.splice(dragTi,1)[0];c.tabs.splice(to,0,m);
      c.active=to;apply(c);};
  });
}

function renderSession(){
  const h=M.header||{},d=h.device||{},s=h.session||{},
        f=M.footer,fc=f&&f.counters||{};
  const rows=[
    ...(SESSIONS.length>1?[["captures aggregated",
      SESSIONS.length+" â€” "+esc(SESSIONS.map(s=>String(s.label).split(" Â· ")[0])
        .join(", "))+" (header/footer shown for the first)"]]:[]),
    ["device",esc((d.model||"?")+" / "+(d.chip||"?")+" (hw "+(d.hw_rev||"?")+")")],
    ["firmware",esc((d.fw_version||"?")+" @ "+(d.fw_commit||"?"))],
    ["schema",esc(h.schema_version||"?")],
    ["session_id",esc(s.session_id||"?")],
    ["boot_count",esc(s.boot_count!==undefined?s.boot_count:"?")],
    ["advisor mode",esc(s.advisor_mode||"?")],
    ["records parsed",M.total+(M.bad?" ("+M.bad+" bad line"+(M.bad>1?"s":"")+" skipped)":"")],
    ["capture start",fmtTs(s.start_us)],
    ["capture end",f?fmtTs(f.session&&f.session.end_us)+
      " â€” "+esc(f.session&&f.session.end_reason||"?"):"(no footer â€” capture still live or clipped)"],
  ];
  if(f)rows.push(["session counters",
    "records "+(fc.records_written??"?")+", dropped "+(fc.events_dropped??"?")+
    ", scans "+(fc.scans_completed??"?")]);
  $("session").innerHTML='<div class="kv">'+rows.map(([k,v])=>
    "<div><b>"+esc(k)+":</b><span>"+v+"</span></div>").join("")+"</div>";
}

const EV_LABEL={
  nearby_mac_suffix:"nearby hardware address (same maker block)",
  conserved_nic_bytes:"shared NIC bytes (one radio's networks)",
  same_product_model:"same product make and model",
  l2l3_id:"same wired identity (LLDP/CDP)",
  name_match:"BLE name matches the Wi-Fi network name",
  fast_pair_model:"same Fast Pair model (same product, not same device)",
  shared_service_uuid:"shared service UUID (same product family)",
  ble_local_name:"same BLE local name (related, not same device)",
  remote_id_serial:"same Remote ID serial (same aircraft)",
  vehicle_make:"same vehicle make by name (Wi-Fi + BLE; not necessarily one car)",

  mac_adjacent:"nearby hardware address (same maker block)",
  same_physical_router:"shared NIC bytes (one radio's networks)",
  wps_vendor_model:"same product make and model"};
function evName(ev){
  const s=typeof ev==="number"?cb("cluster_evidence",ev):String(ev??"?");
  return EV_LABEL[s]||s;
}

const EV_CLASS={
  physical_strong:   {t:"same device",         c:"var(--safe)"},
  physical_candidate:{t:"candidate",           c:"var(--ok)"},
  relationship:      {t:"related",             c:"var(--wifi)"},
  product_family:    {t:"same product/family", c:"var(--ble)"},
  context:           {t:"context",             c:"var(--dim)"}};
function evClassOf(e){
  let s=e.evidence_class;
  if(s==null&&typeof e.evidence_class_i==="number")
    s=cb("cluster_evidence_class",e.evidence_class_i);
  return String(s??"");
}

const MATCH_CLASS={
  physical:      {t:"likely same device",  c:"var(--safe)"},
  candidate:     {t:"may be related",      c:"var(--ok)"},
  product_family:{t:"same product/family", c:"var(--ble)"},
  conflict:      {t:"probably separate",   c:"var(--avoid)"}};
function evClassBadge(e){

  if(e.corroborated){
    const c=MATCH_CLASS.physical.c;
    return ' <span class="ecl" style="color:'+c+';border-color:'+c+
      '">same device Â· corroborated</span>';
  }
  const mc=e.match_class&&MATCH_CLASS[e.match_class];
  if(mc)return ' <span class="ecl" style="color:'+mc.c+';border-color:'+mc.c+
    '">'+esc(mc.t)+"</span>";
  const info=EV_CLASS[evClassOf(e)];
  if(!info)return "";
  return ' <span class="ecl" style="color:'+info.c+';border-color:'+info.c+
    '">'+esc(info.t)+"</span>";
}
function renderClusters(){

  const P=clusterParts(),list=FC,mrAps=P.mr,supBle=P.sb;
  if(!list.length&&!mrAps.length&&!supBle.length&&!PV.length&&!RC.length){
    $("clusters").innerHTML=empty(filterActive()?
      "No clusters or merged radios match the filter.":
      "No device_cluster / merged-radio records (single-radio environment, or pre-1.6.0 capture).");
    return;
  }
  const bandChip=b=>'<span class="chip" style="padding:1px 6px">'+(b?"5G":"2.4G")+"</span>";
  function nameOf(layer,mac){
    if(layer==="wifi"){const w=M.wifi.get(mac);return w?(w.rec.ssid||null):null;}
    const b=M.ble.get(mac);return b?(b.rec.name||b.rec.vendor||null):null;
  }
  function vendorOf(layer,mac){
    const m=layer==="wifi"?M.wifi.get(mac):M.ble.get(mac);
    return m?(m.rec.vendor||m.rec.company_name||null):null;
  }
  // A NIC cluster grouped purely on hardware-address proximity + RF co-location
  // cannot, from RF alone, tell one multi-SSID radio apart from two identical
  // twin units bought together (consecutive MACs, side by side). Flag that only
  // when nothing stronger corroborates the merge: no related SSID base, no
  // product/name/wired-identity match. Related SSIDs or a stronger identifier
  // mean it is plainly one box, so no caveat there.
  const NIC_EV={conserved_nic_bytes:1,same_physical_router:1,
    nearby_mac_suffix:1,mac_adjacent:1};
  const STRONG_EV={same_product_model:1,wps_vendor_model:1,name_match:1,
    l2l3_id:1};
  function siblingCaveat(c){
    const kind=c.cluster_kind||"physical";
    if(kind!=="physical"&&kind!=="candidate")return "";
    const wifiN=(c.members||[]).filter(mb=>mb.layer==="wifi").length;
    if(wifiN<2)return "";
    let nic=false,strong=false,ssid=false;
    for(const e of c.edges||[]){
      if(e.merged===false)continue;
      const ev=String(e.evidence??"");
      if(NIC_EV[ev])nic=true;
      if(STRONG_EV[ev])strong=true;
      if(Array.isArray(e.candidate_evidence)&&
         e.candidate_evidence.indexOf("ssid_related")>=0)ssid=true;
    }
    if(!nic||strong||ssid)return "";
    return '<div class="sibcav"><b>Possible sibling units.</b> These networks '+
      'were grouped by matching hardware-address bytes and radio co-location '+
      'alone, with no shared network name or product identifier. That is what '+
      'one router with several SSIDs looks like â€” but two identical units of '+
      'the same model, bought together and sitting side by side, look the same '+
      'on RF. Treat as one device with low confidence.</div>';
  }
  function panelHtml(c){
    const members=c.members||[],total=c.member_total??members.length;

    let best=null;
    for(const e of c.edges||[]){
      if(e.merged===false)continue;
      if(!best||(e.confidence||0)>(best.confidence||0))best=e;
    }
    const kind=c.cluster_kind||"physical";
    const lead=kind==="physical"?"likely one physical device":
      kind==="vehicle"?"same vehicle make (Wi-Fi + BLE) Â· not necessarily one car":
      kind==="candidate"?"candidate link Â· not confirmed one device":
      "same product family Â· not one device";
    let h='<div class="card">'+
      (best?'<div class="why">grouped by: '+esc(evName(best.evidence))+"</div>":"")+
      '<div class="small dim">'+lead+" Â· "+total+
      " member"+(total>1?"s":"")+" Â· confidence "+esc(c.confidence??"?")+
      " Â· scan "+esc(c.scan_index??"?")+"</div>"+siblingCaveat(c)+'<div class="mgrid">';
    for(const mb of members){
      const w=mb.layer==="wifi";
      h+=memberCard({mac:mb.mac,kind:w?"wifi":"ble",
        name:nameOf(mb.layer,mb.mac)||mb.mac});
    }
    h+="</div>";
    if((c.edges||[]).length){
      const byRef={};
      for(const mb of members)byRef[(mb.layer||"?")+":"+mb.index]=mb;
      const endName=p=>{
        const mb=p&&byRef[(p.layer||"?")+":"+p.index];
        if(!mb)return esc((p&&p.layer)||"?")+"["+esc((p&&p.index)??"?")+"]";
        return esc(nameOf(mb.layer,mb.mac)||mb.mac||"?");
      };
      h+='<div class="ev" style="margin-top:8px"><b>evidence:</b><br>';
      for(const e of c.edges){

        const note=e.merged===false?
          ' <span class="dim">Â· shown, did not merge</span>':"";

        const facts=(e.candidate_evidence&&e.candidate_evidence.length)?
          ' <span class="dim">Â· via: '+esc(e.candidate_evidence.join(", "))+"</span>":"";
        const conf=(e.conflicts&&e.conflicts.length)?
          ' <span class="dim">Â· conflict: '+esc(e.conflicts.join(", "))+"</span>":"";
        h+=endName(e.a)+' <span class="dim">+</span> '+endName(e.b)+
          ' <span class="dim">â€”</span> '+esc(evName(e.evidence))+
          evClassBadge(e)+
          ' <span class="dim">(conf '+esc(e.confidence??"?")+")</span>"+facts+note+conf+"<br>";
      }
      h+="</div>";
    }
    return h+"</div>";
  }

  function repRec(c){
    for(const mb of c.members||[]){
      const m=mb.layer==="wifi"?M.wifi.get(mb.mac):M.ble.get(mb.mac);
      if(m)return{r:m.rec,kind:mb.layer==="wifi"?"wifi":"ble"};
    }
    return null;
  }
  function clusterIcon(c){const p=repRec(c);return p?catIcon(p.r,p.kind):"";}

  function mrPanel(r){
    const sibs=r.radio_siblings||[],total=r.radio_count??(sibs.length+1);
    const nm=realName(r.ssid)||"(hidden)";
    let h='<div class="card"><div class="small dim">'+esc(nm)+
      " Â· "+esc(total)+" radios merged into one logical network Â· scan "+
      esc(r.scan_index??"?")+'</div><div class="mgrid">';
    h+=memberCard({mac:r.bssid,kind:"wifi",name:nm,radio:true,
      rssi:r.rssi,band:r.band_5g?"5G":"2.4G"});
    for(const s of sibs)
      h+=memberCard({mac:s.bssid,kind:"wifi",name:nm,radio:true,
        rssi:s.rssi,band:s.band_5g?"5G":"2.4G"});
    return h+"</div></div>";
  }

  function sbPanel(r){
    let h='<div class="card"><div class="small dim">anonymous / ambient advertiser'+
      " Â· hidden from the on-device Lite list Â· scan "+esc(r.scan_index??"?")+
      '</div><div class="mgrid">'+
      memberCard({mac:r.addr,kind:"ble",name:r.name||r.vendor||r.addr,
        rssi:typeof r.rssi==="number"?r.rssi:null,band:null})+
      "</div><div>";
    if(r.addr_subtype!=null)h+='<span class="chip">'+esc(cb("addr_subtype",r.addr_subtype))+"</span>";
    if(r.vendor)h+='<span class="chip">'+esc(r.vendor)+"</span>";
    h+='<span class="chip dim">class '+esc(fClass(r)||"â€”")+"</span>";
    return h+"</div></div>";
  }

  const{net,bt,veh}=P;

  function repMac(c){
    for(const mb of c.members||[])if(mb.layer==="wifi"&&mb.mac)return mb.mac;
    for(const mb of c.members||[])if(mb.mac)return mb.mac;
    return "?";
  }

  function repName(c){
    const cnt=new Map();
    for(const mb of c.members||[]){
      if(mb.layer!=="wifi")continue;
      const s=realName(nameOf("wifi",mb.mac));
      if(s)cnt.set(s,(cnt.get(s)||0)+1);
    }
    let top=null,n=0;cnt.forEach((v,k)=>{if(v>n){n=v;top=k;}});
    if(top)return top;
    for(const mb of c.members||[])
      if(mb.layer!=="wifi"){const nm=realName(nameOf("ble",mb.mac));if(nm)return nm;}
    // No real member name anywhere â€” surface the MAC rather than "<hidden>".
    return repMac(c);
  }

  // Fixed-size cluster result card that mirrors the Wi-Fi/BLE .dcard look:
  // a type/signal icon + name + scan-type badge on top, the MAC and small
  // cluster-nature icons below. Tapping opens the detail popup (wired below);
  // the .cdet sibling is a hidden data holder cloned into that popup. `meta(c)`
  // returns {icon,name,kind,kcls,mac,ico} so every grid renders one way.
  function tgrid(arr,label,gid,meta,panel){
    if(!arr.length)return "";
    let h="";
    arr.forEach((c,i)=>{
      const m=meta(c);
      h+='<button class="ctile'+(m.kcls?" "+m.kcls:"")+'" data-g="'+gid+
        '" data-i="'+i+'" aria-haspopup="dialog" aria-expanded="false" title="'+
        esc(m.mac||m.name||"")+'"><span class="cthd">'+
        '<span class="dicon">'+(m.icon||"")+"</span>"+
        '<span class="ctname">'+esc(m.name||"?")+"</span>"+
        (m.kind?'<span class="ctkind">'+esc(m.kind)+"</span>":"")+"</span>"+
        '<span class="ctmac mono">'+esc(m.mac||"")+"</span>"+
        '<span class="ctico">'+(m.ico||"")+"</span></button>"+
        '<div class="cdet" data-g="'+gid+'" data-i="'+i+'">'+panel(c)+"</div>";
    });
    return '<h3 class="cgh">'+label+" ("+arr.length+')</h3><div class="cgrid">'+h+"</div>";
  }

  function pvIcon(e){
    const w=M.wifi.get(e.mac);if(w)return catIcon(w.rec,"wifi");
    const b=M.ble.get(e.mac);if(b)return catIcon(b.rec,"ble");
    return iconSpan(["ic-privacy","privacy findings"]);
  }
  function pvPanel(e){
    let h='<div class="card"><div class="small dim">privacy-analyzer findings '+
      "for this address Â· "+e.items.length+" item(s)</div>";
    const dl=devLink(e.mac);
    if(dl)h+='<div style="margin:5px 0">'+dl+"</div>";
    let last="";
    for(const[label,row]of e.items){
      if(label!==last){h+='<h3 class="cgh" style="margin:9px 0 4px">'+esc(label)+"</h3>";last=label;}
      h+=row;
    }
    return h+"</div>";
  }

  // Best human identifier for an address, tiered most- to least-identifying so a
  // real device name (3) outranks a UUID/service/category label (2), which
  // outranks a bare vendor (1), which outranks the raw MAC (0). Lets privacy
  // clusters read as devices instead of anonymous MACs.
  const bestIdent=mac=>{
    if(!mac)return{t:0,s:"?"};
    const w=M.wifi.get(mac);
    if(w){const r=w.rec;
      if(r.ssid)return{t:3,s:r.ssid};
      if(r.vendor)return{t:1,s:r.vendor};}
    const b=M.ble.get(mac);
    if(b){const r=b.rec;
      const nm=r.name||r.fastpair_name;
      if(nm)return{t:3,s:nm};
      const id=r.uuid16_name||r.uuid128_name||r.uuid32_name||r.ms_subtype_name||
               r.name_rule_name||r.apple_category||r.mfg_rule_name;
      if(id)return{t:2,s:id};
      const v=r.vendor||r.company_name;
      if(v)return{t:1,s:v};}
    return{t:0,s:mac};
  };
  const pvName=e=>{
    const b=bestIdent(e.mac);
    if(b.t>0)return{s:b.s,mono:false,title:e.mac};        // resolved to a known device
    if(e.ident&&e.ident.s)return{s:e.ident.s,mono:false,title:e.mac}; // analyzer-derived
    return{s:e.mac,mono:true,title:e.mac};                // no identifier â€” show MAC
  };

  function buildAggregates(){
    const up=s=>String(s||"").toUpperCase();
    const oui=a=>{const m=up(a).replace(/[^0-9A-F]/g,"");return m.length>=6?m.slice(0,6):"";};
    const nodes=[];
    const addNode=(family,g,i,ref,addrs,ssids)=>{
      const A=new Set(),S=new Set(),O=new Set();
      for(const a of addrs)if(a){A.add(up(a));const o=oui(a);if(o)O.add(o);}
      for(const s of ssids)if(s)S.add(s);
      nodes.push({family,g,i,ref,addrs:A,ssids:S,ouis:O});
    };
    [["v",veh],["n",net],["b",bt]].forEach(([g,arr])=>arr.forEach((c,i)=>{
      const addrs=[],ssids=[];
      for(const mb of c.members||[]){
        if(mb.mac)addrs.push(mb.mac);
        if(mb.layer==="wifi"){const w=M.wifi.get(mb.mac);if(w&&w.rec.ssid)ssids.push(w.rec.ssid);}
      }
      addNode("nic",g,i,c,addrs,ssids);
    }));
    mrAps.forEach((r,i)=>addNode("radio","mr",i,r,
      [r.bssid,...(r.radio_siblings||[]).map(s=>s.bssid)],[r.ssid]));
    PV.forEach((e,i)=>{const w=M.wifi.get(e.mac);
      addNode("priv","pv",i,e,[e.mac],[w&&w.rec.ssid]);});

    const parent=nodes.map((_,i)=>i);
    const find=x=>{while(parent[x]!==x){parent[x]=parent[parent[x]];x=parent[x];}return x;};
    const linked=(a,b)=>{
      for(const x of a.addrs)if(b.addrs.has(x))return "addr";
      let ssidHit=false;for(const s of a.ssids)if(b.ssids.has(s)){ssidHit=true;break;}
      if(ssidHit)for(const o of a.ouis)if(b.ouis.has(o))return "ssid";
      return "";
    };
    for(let a=0;a<nodes.length;a++)for(let b=a+1;b<nodes.length;b++){
      if(linked(nodes[a],nodes[b])){const ra=find(a),rb=find(b);if(ra!==rb)parent[ra]=rb;}
    }
    const comps=new Map();
    nodes.forEach((_,idx)=>{const r=find(idx);
      let c=comps.get(r);if(!c){c=[];comps.set(r,c);}c.push(idx);});
    const order={nic:0,radio:1,priv:2};
    const agg=[];
    comps.forEach(idxs=>{
      if(idxs.length<2)return;
      const ns=idxs.map(i=>nodes[i]),addrs=new Set(),ssids=new Set();
      ns.forEach(n=>{n.addrs.forEach(x=>addrs.add(x));n.ssids.forEach(s=>ssids.add(s));});
      let byAddr=false,bySsid=false;
      for(let a=0;a<ns.length;a++)for(let b=a+1;b<ns.length;b++){
        const l=linked(ns[a],ns[b]);
        if(l==="addr")byAddr=true;else if(l==="ssid")bySsid=true;
      }
      ns.sort((x,y)=>order[x.family]-order[y.family]||x.g.localeCompare(y.g)||x.i-y.i);
      agg.push({nodes:ns,addrs,ssids,byAddr,bySsid});
    });
    return agg;
  }
  const AGG=buildAggregates();

  const wOf=ad=>M.wifi.get(ad)||M.wifi.get(String(ad).toLowerCase());
  const bOf=ad=>M.ble.get(ad)||M.ble.get(String(ad).toLowerCase());

  const sibMeta=new Map();
  mrAps.forEach(r=>{
    const put=(bssid,b5,ch,rssi)=>{if(bssid)
      sibMeta.set(String(bssid).toUpperCase(),{band_5g:b5,channel:ch,rssi:rssi,ssid:r.ssid});};
    put(r.bssid,r.band_5g,r.channel,r.rssi);
    (r.radio_siblings||[]).forEach(s=>put(s.bssid,s.band_5g,s.channel,s.rssi));
  });

  const addrInfo=ad=>{
    const b=bOf(ad);
    if(b)return{type:"BLE",ly:"b",name:b.rec.name||b.rec.vendor||"",
      band:"2.4G",rssi:b.rec.rssi};
    const w=wOf(ad);
    if(w)return{type:"WiFi",ly:"w",name:w.rec.ssid||"",
      band:w.rec.band_5g?"5G":"2.4G",rssi:w.rec.rssi};
    const s=sibMeta.get(String(ad).toUpperCase());
    if(s)return{type:"Radio",ly:"w",name:s.ssid||"",
      band:s.band_5g?"5G":"2.4G",rssi:s.rssi};
    return{type:"",ly:"",name:"",band:"",rssi:undefined};
  };

  const aggRep=a=>{
    for(const ad of a.addrs){const w=wOf(ad);if(w)return{r:w.rec,kind:"wifi"};}
    for(const ad of a.addrs){const b=bOf(ad);if(b)return{r:b.rec,kind:"ble"};}
    return null;
  };
  const aggIcon=a=>{const p=aggRep(a);
    return p?catIcon(p.r,p.kind):iconSpan(["ic-nic","cluster"]);};
  const aggName=a=>{
    for(const s of a.ssids)if(realName(s))return s;
    for(const ad of a.addrs){const i=addrInfo(ad);if(realName(i.name))return i.name;}
    return [...a.addrs][0]||"?";
  };
  const famLabel=f=>f==="nic"?"NIC cluster":f==="radio"?"Radio cluster":"Privacy cluster";
  function aggPanel(a){
    const reasons=[];
    if(a.byAddr)reasons.push("shared hardware address");
    if(a.bySsid)reasons.push("shared SSID + vendor OUI");
    let h='<div class="card"><div class="small dim">'+a.nodes.length+
      " source clusters combined"+
      (reasons.length?" Â· linked by: "+esc(reasons.join(" + ")):"")+"</div><div>";
    for(const n of a.nodes)
      h+='<span class="chip"><b>'+famLabel(n.family)+"</b> "+
        '<button class="plink" type="button" onclick="event.stopPropagation();'+
        "gotoCluster('"+n.g+"',"+n.i+')">view</button></span>';
    h+='</div><div class="mgrid">';

    for(const ad of a.addrs){
      const d=addrInfo(ad);
      h+=memberCard({mac:ad,kind:d.ly==="b"?"ble":"wifi",name:d.name||ad,
        rssi:typeof d.rssi==="number"?d.rssi:null,
        band:d.band||null,radio:d.type==="Radio"});
    }
    return h+"</div></div>";
  }
  // Scan-type badge + color class from a representative record's layer.
  const kindOf=k=>k==="wifi"?{kind:"WIFI",kcls:"k-wifi"}:{kind:"BLE",kcls:"k-ble"};
  const nicMeta=c=>{const p=repRec(c),k=p?kindOf(p.kind):{kind:"",kcls:""};
    return{icon:clusterIcon(c),name:repName(c),mac:repMac(c),
      ico:iconSpan(["ic-nic","NIC cluster"]),...k};};
  const nicHtml=
    tgrid(veh,"Vehicle groups","v",nicMeta,panelHtml)+
    tgrid(net,"Network clusters","n",nicMeta,panelHtml)+
    tgrid(bt,"Bluetooth clusters","b",nicMeta,panelHtml)+
    tgrid(supBle,"Suppressed BLE","sb",
      r=>({icon:catIcon(r,"ble"),name:r.name||r.vendor||r.addr,mac:r.addr,
        kind:"BLE",kcls:"k-ble",ico:iconSpan(["ic-privacy","suppressed advertiser"])}),
      sbPanel)||
    empty("No NIC clusters in this capture.");
  const radioHtml=
    tgrid(mrAps,"Merged radios","mr",
      r=>({icon:catIcon(r,"wifi"),name:realName(r.ssid)||r.bssid,mac:r.bssid,
        kind:"RADIO",kcls:"k-wifi",ico:iconSpan(["ic-radio","radio cluster"])}),
      mrPanel)||
    empty("No merged-radio records in this capture.");
  const privHtml=
    tgrid(PV,"Privacy clusters","pv",
      e=>{const nm=pvName(e),p=M.wifi.get(e.mac)?"wifi":(M.ble.get(e.mac)?"ble":null),
        k=p?kindOf(p):{kind:"",kcls:""};
        return{icon:pvIcon(e),name:nm.s,mac:e.mac,
          ico:iconSpan(["ic-privacy","privacy cluster"]),...k};},
      pvPanel)||
    empty("No per-device privacy-analyzer rows in this capture.");
  const aggHtml=
    tgrid(AGG,"Aggregate clusters","ag",
      a=>{const p=aggRep(a),k=p?kindOf(p.kind):{kind:"MIXED",kcls:""};
        return{icon:aggIcon(a),name:aggName(a),mac:[...a.addrs][0]||"?",
          ico:iconSpan(["ic-nic","aggregate cluster"]),...k};},
      aggPanel)||
    empty("No clusters combine across families in this capture.");

  const rcName=c=>{
    const mb=c.members[0],r=mb.rec;
    return (mb.kind==="wifi"?realName(r.ssid):(r.name||r.vendor))||mb.mac;
  };
  // Cross-scan clusters: every chain of 2+ addresses linked by a persistent
  // identifier. Two shapes share one tab â€” rotation chains (one device whose
  // MAC changed between passes) draw as an address-change timeline; concurrent
  // chains (addresses heard in the same pass) draw as a kept-apart product
  // group. A type icon on each result tells the two apart.
  const rcIcon=c=>{const mb=c.members[0];return catIcon(mb.rec,mb.kind==="wifi"?"wifi":"ble");};
  const xcType=c=>c.rotation?["ic-rotate","address rotation"]:["ic-chain","product group"];
  function xcPanel(c){
    const rot=c.rotation,ico=iconSpan(xcType(c));
    const lbl=rot?"MAC randomization â€” one device changing address across scans":
      c.members.length+" concurrent units of one product (kept apart)";
    let h='<div class="card"><div class="xhead '+(rot?"rot":"grp")+'">'+ico+
      "<span>"+esc(lbl)+"</span></div>"+
      '<div class="why">linked by: '+esc(c.evidence)+"</div>"+
      '<div class="small dim">'+c.members.length+" addresses Â· confidence "+
      c.conf+" "+identBar(c.conf)+"</div>";
    if(rot){
      h+='<div class="tl">';
      c.members.forEach((mb,i)=>{
        const w=mb.kind==="wifi",nm=w?mb.rec.ssid:(mb.rec.name||mb.rec.vendor||"");
        const band=w?(mb.rec.band_5g?"5 GHz":"2.4 GHz"):"BLE";
        h+='<div class="hop"><span class="dot"></span><div class="body">'+
          memberCard({mac:mb.mac,kind:w?"wifi":"ble",name:nm||mb.mac,
            rssi:mb.rec&&typeof mb.rec.rssi==="number"?mb.rec.rssi:null,
            band:w?(mb.rec.band_5g?"5G":"2.4G"):null})+
          '<span class="rng">scans '+esc(slotLabel(mb.p.first))+"â€“"+
          esc(slotLabel(mb.p.last))+" Â· "+esc(band)+" Â· seen "+mb.p.seen+"/"+
          mb.p.total+"</span> "+presStrip(mb.p)+" "+
          (i<c.members.length-1?'<div class="small dim" style="margin-top:3px">'+
            "â†“ address changed</div>":"")+
          "</div></div>";
      });
      h+="</div>";
    }else{
      h+="<div>";
      for(const mb of c.members){
        const w=mb.kind==="wifi",nm=w?mb.rec.ssid:(mb.rec.name||mb.rec.vendor||"");
        h+='<div style="margin:4px 0">'+
          memberCard({mac:mb.mac,kind:w?"wifi":"ble",name:nm||mb.mac,
            rssi:mb.rec&&typeof mb.rec.rssi==="number"?mb.rec.rssi:null,
            band:w?(mb.rec.band_5g?"5G":"2.4G"):null})+" "+presStrip(mb.p)+
          ' <span class="dim">scans '+esc(slotLabel(mb.p.first))+"â€“"+
          esc(slotLabel(mb.p.last))+" ("+mb.p.seen+"/"+mb.p.total+")</span></div>";
      }
      h+="</div>"+'<div class="small dim" style="margin-top:6px">'+
        c.overlap+" scan pass"+(c.overlap>1?"es":"")+" heard 2+ of these addresses "+
        "at once, so they are kept apart as probable separate devices â€” nothing "+
        "is merged or hidden on identifier match alone.</div>";
    }
    return h+"</div>";
  }
  const rcHtml=M.slots.length<2?
    empty("Single scan loaded â€” use Import (or run more scan passes) to trace devices across scans."):
    (tgrid(RC,"Cross scan clusters","rc",
       c=>{const mb=c.members[0];return{icon:rcIcon(c),name:rcName(c),mac:mb.mac,
         ...kindOf(mb.kind),ico:iconSpan(xcType(c))};},
       xcPanel)||
     empty("No cross-scan matches â€” no device was seen in two scans under a "+
       "different address with >70 confidence of being the same unit."));
  const nicN=veh.length+net.length+bt.length+supBle.length;
  $("clusters").innerHTML=
    '<div class="ctabs">'+
    '<button class="ctab act" data-t="agg">Aggregate Cluster(s) <span class="tn">'+AGG.length+"</span></button>"+
    '<button class="ctab" data-t="multi">Cross Scan Cluster(s) <span class="tn">'+RC.length+"</span></button>"+
    '<button class="ctab" data-t="priv">Privacy Cluster(s) <span class="tn">'+PV.length+"</span></button>"+
    '<button class="ctab" data-t="nic">NIC Cluster(s) <span class="tn">'+nicN+"</span></button>"+
    '<button class="ctab" data-t="radio">Radio Cluster(s) <span class="tn">'+mrAps.length+"</span></button></div>"+
    '<div class="cltab" data-t="agg">'+aggHtml+"</div>"+
    '<div class="cltab" data-t="multi" style="display:none">'+rcHtml+"</div>"+
    '<div class="cltab" data-t="priv" style="display:none">'+privHtml+"</div>"+
    '<div class="cltab" data-t="nic" style="display:none">'+nicHtml+"</div>"+
    '<div class="cltab" data-t="radio" style="display:none">'+radioHtml+"</div>";
  const root=$("clusters");
  root.querySelectorAll(".ctab").forEach(b=>{
    b.onclick=()=>{
      root.querySelectorAll(".ctab").forEach(x=>x.classList.toggle("act",x===b));
      root.querySelectorAll(".cltab")
        .forEach(p=>p.style.display=p.dataset.t===b.dataset.t?"":"none");
    };
  });
  root.querySelectorAll(".ctile").forEach(b=>{
    b.onclick=()=>openClusterModal(b.dataset.g,b.dataset.i);
  });
}

// Cluster detail popup. Clones the (hidden) .cdet panel for a given tile into a
// modal sheet instead of expanding it inline, so opening one card never shifts
// the others. A member's "view result" link jumps to its Wi-Fi/BLE card and
// closes the popup; a cross-link to another cluster re-points the same popup.
let clWired=false;
function clModalClose(){const ov=$("clov");if(ov)ov.hidden=true;}
function openClusterModal(g,i){
  const root=$("clusters");if(!root)return;
  const det=root.querySelector('.cdet[data-g="'+g+'"][data-i="'+i+'"]');
  if(!det)return;
  const tile=root.querySelector('.ctile[data-g="'+g+'"][data-i="'+i+'"]');
  root.querySelectorAll(".ctile.open").forEach(x=>{
    x.classList.remove("open");x.setAttribute("aria-expanded","false");});
  if(tile){tile.classList.add("open");tile.setAttribute("aria-expanded","true");}
  const title=(tile&&tile.querySelector(".ctname"))?
    tile.querySelector(".ctname").textContent:"Cluster detail";
  const ov=$("clov"),sheet=$("clsheet");
  sheet.innerHTML='<div class="clhd"><h3>'+esc(title)+"</h3>"+
    '<button class="clx" type="button" aria-label="Close">âœ•</button></div>'+
    '<div class="clbody">'+det.innerHTML+"</div>";
  sheet.querySelector(".clx").onclick=clModalClose;
  if(!clWired){
    clWired=true;
    ov.addEventListener("click",e=>{if(e.target===ov)clModalClose();});
    // A "view result" link navigates to a device card, so drop the popup after.
    // A cross-cluster "view" link re-opens the popup on the other cluster, so
    // openClusterModal has already repainted the sheet â€” leave it open.
    // Capture phase: the member links call event.stopPropagation() in their own
    // handler, so a bubbling listener here would never see the click.
    sheet.addEventListener("click",e=>{
      const a=e.target.closest(".plink,.clink,.mcard");
      if(a&&/gotoDevice/.test(a.getAttribute("onclick")||""))clModalClose();
    },true);
    addEventListener("keydown",e=>{
      if(e.key==="Escape"&&!ov.hidden)clModalClose();});
  }
  ov.hidden=false;sheet.scrollTop=0;
}

function renderTrackers(){
  const el=$("trackers");
  if(!FT.length){el.innerHTML=empty(filterActive()?
    "No trackers match the filter.":"No tracker records.");return;}
  const rows=FT.slice();sortRows(rows,"threat");
  el.innerHTML='<div class="dlist">'+rows.map(r=>{
    const sep=r.find_my_separated?
      '<span class="pill p2">separated from owner</span>':"";
    const meta=vendCell(r)+kindBadge("track","Tracker")+
      span("",'<b>'+esc(r.tracker_kind||"?")+"</b>")+
      rssiHtml(r.rssi)+span("",fmtDist(r.distance_dm))+
      span("mono",esc(r.addr||"?"));

    const why=r.find_my_separated?
      '<div class="why">'+esc(whyText(r)||"Broadcasting in separated-from-owner"+
        " mode â€” it may be travelling with you rather than its owner.")+"</div>":
      whyHtml(r);
    return devCard("track",null,nameDisp(r.name),
      sep||threatPill(r.threat_level),meta,why+presLine("track",r.addr),
      catIcon(r,"track"));
  }).join("")+"</div>";
  wireCards(el,rows,kvGrid);
}

function copyText(t,btn){
  const done=()=>{btn.textContent="copied";setTimeout(()=>btn.textContent="copy lat,lon",900);};
  if(navigator.clipboard&&navigator.clipboard.writeText)
    navigator.clipboard.writeText(t).then(done,fallback);
  else fallback();
  function fallback(){
    const ta=document.createElement("textarea");
    ta.value=t;document.body.appendChild(ta);ta.select();
    try{document.execCommand("copy");done();}catch(e){}
    ta.remove();
  }
}
function coordHtml(latE7,lonE7){
  if(typeof latE7!=="number"||typeof lonE7!=="number")
    return '<span class="dim">â€”</span>';
  const t=(latE7/1e7).toFixed(6)+","+(lonE7/1e7).toFixed(6);
  return '<span class="mono">'+t+'</span> <button data-copy="'+t+
    '">copy lat,lon</button>';
}

function droneDetail(r){
  const d=r.drone||{}, o=r.operator||{};
  return '<div class="kv">'+
    "<div><b>drone position:</b><span>"+coordHtml(d.lat_e7,d.lon_e7)+
      (r.drone?' <span class="dim">alt '+esc(d.alt_m)+" m</span>":"")+"</span></div>"+
    "<div><b>operator position:</b><span>"+coordHtml(o.lat_e7,o.lon_e7)+"</span></div>"+
    "<div><b>speed / track:</b><span>"+
      (r.drone?esc(d.speed_mps)+" m/s Â· "+esc(d.track_deg)+"Â°":"â€”")+"</span></div>"+
    "<div><b>operator separation:</b><span>"+
      (typeof r.op_separation_m==="number"&&r.op_separation_m>=0?
        esc(r.op_separation_m)+" m":"â€”")+"</span></div>"+
    (r.operator_id?"<div><b>operator_id:</b><span>"+esc(r.operator_id)+"</span></div>":"")+
    (r.self_id?"<div><b>self_id:</b><span>"+esc(r.self_id)+"</span></div>":"")+
    "</div>"+kvGrid(r);
}
function renderDrones(){
  const el=$("drones");
  if(!FD.length){el.innerHTML=empty(filterActive()?
    "No drones match the filter.":"No drone_rid records.");return;}
  const rows=FD.slice();sortRows(rows,"threat");
  el.innerHTML='<div class="dlist">'+rows.map(r=>{
    const sep=(typeof r.op_separation_m==="number"&&r.op_separation_m>=0)?
      "operator "+r.op_separation_m+" m":null;
    const meta=vendCell(r)+kindBadge("drone","Drone")+
      span("",esc(r.ua_type_label||("ua_type "+(r.ua_type??"?"))))+
      (sep?span("",esc(sep)):"")+
      (r.drone&&r.drone.alt_m!=null?span("","alt "+esc(r.drone.alt_m)+" m"):"")+
      rssiHtml(r.rssi)+span("",fmtDist(r.distance_dm))+
      span("mono",esc(r.addr||"?"));
    return devCard("drone",null,esc(r.id||"(no UAS id)"),
      threatPill(r.threat_level||0),meta,
      whyHtml(r)+presLine("drone",r.addr),iconSpan(ICON_BY_KIND.drone));
  }).join("")+"</div>";
  wireCards(el,rows,droneDetail);

  el.onclick=e=>{
    const b=e.target.closest("button[data-copy]");
    if(b){e.stopPropagation();copyText(b.dataset.copy,b);}
  };
}

function subjLink(r){
  return macLink(r.target_ref||"",r.target_kind==="wifi_ap"?"wifi":"ble");
}
function macLink(ref,kind){
  if(/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/i.test(ref))
    return '<a class="mono" style="cursor:pointer" data-go="'+anchorId(kind,ref)+
      '" data-tab="s-'+kind+'">'+esc(ref)+"</a>";
  return ref?esc(ref):'<span class="dim">â€”</span>';
}

// ---- Evil Twin pair evidence on a notification ----------------------------
// An Evil Twin conclusion is about a PAIR, so the notification has to reach both
// members and show what the detector actually weighed. Everything here comes off
// the record; nothing is inferred in the browser.
const TWIN_TRIGGER_TEXT={
  open_security_downgrade:"an open network sharing a protected network's SSID",
  tier1_peer_score:"an unrelated-identity peer with a large signal gap",
  beacon_fingerprint_conflict:"a peer whose security/beacon profile disagrees",
  relationship_only_no_twin:"a related pair with no impersonation evidence"
};
const TWIN_REL_TEXT={
  likely_sibling_virtual_bssid:"coordinated virtual BSSIDs on one radio",
  likely_managed_ess_peer:"peers in one managed network",
  known_service_family_peer:"same service family",
  unrelated_same_ssid_peer:"unrelated identities",
  unknown_same_ssid_peer:"relationship unknown"
};
// Label, and whether the bit argues FOR impersonation or against it. A finding is
// only auditable if the suppressing evidence is as visible as the supporting kind.
const TWIN_EV_TEXT={
  exact_ssid_match:["identical SSID","for"],
  security_mismatch:["security profiles differ","for"],
  rssi_gap:["large signal gap","for"],
  rsn_mismatch:["encryption differs","for"],
  pmf_mismatch:["management-frame protection differs","for"],
  wps_mismatch:["WPS differs","for"],
  beacon_interval_conflict:["beacon timing differs","for"],
  suffix_delta:["distant MAC suffix","for"],
  conserved_mac_structure:["conserved MAC structure","against"],
  same_public_oui:["same vendor OUI","against"],
  both_laa:["both locally administered","against"],
  same_channel:["same channel","against"],
  same_beacon_interval:["matching beacon timing","against"],
  chain_ssid:["recognised public/chain SSID","against"]
};
function twinEvidenceHtml(f){
  if(!f)return "";
  const ev=f.evidence||{};
  const fors=[],againsts=[];
  for(const k in TWIN_EV_TEXT){
    if(!(k in ev))continue;               // absent key = not evaluated in that build
    if(!ev[k])continue;                   // false = evaluated, not present
    (TWIN_EV_TEXT[k][1]==="for"?fors:againsts).push(TWIN_EV_TEXT[k][0]);
  }
  let h="";
  const trig=TWIN_TRIGGER_TEXT[f.trigger]||f.trigger||"";
  const rel=TWIN_REL_TEXT[f.relationship_class]||f.relationship_class||"";
  if(trig)h+='<div class="ev"><b>triggered by:</b> '+esc(trig)+"</div>";
  if(rel) h+='<div class="ev"><b>relationship:</b> '+esc(rel)+"</div>";
  if(fors.length)
    h+='<div class="ev"><b>points to impersonation:</b> '+esc(fors.join(", "))+"</div>";
  if(againsts.length)
    h+='<div class="ev"><b>points away from it:</b> '+esc(againsts.join(", "))+"</div>";
  if(f.symmetric)
    h+='<div class="ev dim">Neither network can be named as the impostor from this '+
       "evidence â€” treat both as unconfirmed.</div>";
  return h;
}
// Find the pair record behind an alert, so the notification can show its evidence.
function twinFindingFor(r){
  if(!r||!r.peer_ref||!r.target_ref)return null;
  const a=r.target_ref,b=r.peer_ref,want=(a<b?a+"|"+b:b+"|"+a);
  for(const {rec} of M.twins.values()){
    const x=rec.target_ref||"",y=rec.peer_ref||"";
    if((x<y?x+"|"+y:y+"|"+x)===want)return rec;
  }
  return null;
}
// Notification display filter â€” tailor the noise without touching the capture.
// The raw records ("alert" in the schema) stay in the data/export; these prefs
// only change what's shown.
const ALERT_KEY="sc-alert-prefs";
let alertShowAll=false;
function alertPrefs(){
  try{const p=JSON.parse(localStorage.getItem(ALERT_KEY));
    if(p&&typeof p==="object")return {minSev:p.minSev||"all",
      muted:Array.isArray(p.muted)?p.muted:[]};}catch(e){}
  return {minSev:"all",muted:[]};
}
function alertPrefsSet(p){try{localStorage.setItem(ALERT_KEY,JSON.stringify(p));}catch(e){}}
function renderAlerts(){
  const el=$("alerts");
  if(!FA.length){el.innerHTML=empty(filterActive()?
    "No notifications match the filter.":"No notifications.");return;}
  const sevRank={high:3,medium:2,low:1};
  const rows=FA.slice().sort((a,b)=>
    (sevRank[b.rec.severity]||0)-(sevRank[a.rec.severity]||0));
  const prefs=alertPrefs();
  const minR=sevRank[prefs.minSev]||0;
  const muted=new Set(prefs.muted);
  const passes=a=>!(muted.has(a.rec.rule_id)||(sevRank[a.rec.severity]||0)<minR);
  const shown=alertShowAll?rows:rows.filter(passes);
  const hidden=rows.length-rows.filter(passes).length;
  // rules present, for the mute chips
  const rules=[];const seen=new Set();
  for(const a of rows){const id=a.rec.rule_id||"?";
    if(!seen.has(id)){seen.add(id);rules.push(id);}}
  let h='<div class="alfbar"><label for="alsev">Show severity</label>'+
    '<select id="alsev"><option value="all">all</option>'+
    '<option value="low">low +</option><option value="medium">medium +</option>'+
    '<option value="high">high only</option></select>'+
    '<div class="alfmutes">'+rules.map(id=>'<button class="almute'+
      (muted.has(id)?" muted":"")+'" data-rule="'+esc(id)+'" title="'+
      (muted.has(id)?"Muted â€” click to show":"Click to mute this rule")+'">'+
      esc(id)+"</button>").join("")+"</div></div>";
  if(hidden>0&&!alertShowAll)
    h+='<div class="alfnote">'+hidden+" notification"+(hidden>1?"s":"")+
      " hidden by your filter (still in the data/export). "+
      '<button data-al="showall">Show all</button></div>';
  else if(alertShowAll&&hidden>0)
    h+='<div class="alfnote">Showing all â€” '+hidden+" would be filtered. "+
      '<button data-al="applyfilter">Apply filter</button></div>';
  h+=shown.length?'<div class="dlist">'+shown.map(a=>{
    const r=a.rec;
    // A pair notification links BOTH members â€” the peer is half the
    // finding, and a conclusion you cannot navigate to is a conclusion you
    // cannot check.
    const meta=span("mono",esc(r.rule_id||"?"))+
      (r.target_ref?subjLink(r):"")+
      (r.peer_ref?span("dim","â†”")+macLink(r.peer_ref,"wifi"):"")+
      (a.n>1?span("",a.n+"Ã—"):"");
    let why=twinEvidenceHtml(twinFindingFor(r));
    if(!why&&Array.isArray(r.limitations)&&
       r.limitations.indexOf("legacy_unattributed_alert")>=0)
      why='<div class="ev dim">This capture predates pair evidence, so the peer '+
          "that triggered it was not recorded. It cannot be audited here.</div>";
    return devCard("alert",null,esc(r.message||r.rule_id||"notification"),
      sevPill(r.severity),meta,why||null,iconSpan(ICON_BY_KIND.alert));
  }).join("")+"</div>":
    '<div class="note">All '+rows.length+" notification"+(rows.length>1?"s":"")+
    " hidden by your filter.</div>";
  el.innerHTML=h;
  const sev=$("alsev");if(sev){sev.value=prefs.minSev;
    sev.onchange=()=>{const p=alertPrefs();p.minSev=sev.value;alertPrefsSet(p);
      alertShowAll=false;renderAlerts();};}
  el.querySelectorAll("[data-rule]").forEach(b=>b.onclick=()=>{
    const p=alertPrefs(),id=b.dataset.rule,i=p.muted.indexOf(id);
    if(i>=0)p.muted.splice(i,1);else p.muted.push(id);
    alertPrefsSet(p);renderAlerts();});
  el.querySelectorAll("[data-al]").forEach(b=>b.onclick=()=>{
    alertShowAll=b.dataset.al==="showall";renderAlerts();});
  // data-go links are handled by the delegated document listener (113f), so
  // links inside lazily-rendered card details work too.
}

// ---- privacy triage + per-device actions (viewer-side; never alters the data) ----
// Acknowledge = "I've reviewed this device"; stored in this browser so a repeat scan
// can surface only NEW privacy findings. Watch reuses the existing watchlist.
const PACK_KEY="sc-priv-ack";
function ackGet(){try{const a=JSON.parse(localStorage.getItem(PACK_KEY));
  return Array.isArray(a)?a:[];}catch(e){return [];}}
function ackSet(a){try{localStorage.setItem(PACK_KEY,JSON.stringify(a));}catch(e){}}
function ackHas(mac){const m=normMac(mac);return !!m&&ackGet().indexOf(m)>=0;}
function ackToggle(mac){const m=normMac(mac);if(!m)return;
  const a=ackGet(),i=a.indexOf(m);if(i>=0)a.splice(i,1);else a.push(m);ackSet(a);}
let privNewOnly=false;
function toast(msg){
  let t=$("toast");
  if(!t){t=document.createElement("div");t.id="toast";document.body.appendChild(t);}
  t.textContent=msg;t.classList.add("show");
  clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove("show"),3600);
}
function macWatched(mac){const m=normMac(mac);
  return watchGet().some(w=>w.t==="mac"&&normMac(w.v)===m);}
// Watch / Locate / Reviewed buttons for one leaking device.
function privActions(mac,rssi){
  if(!mac)return "";
  const watched=macWatched(mac),acked=ackHas(mac);
  const loc='<button type="button" class="pa" data-ploc="'+esc(mac)+'"'+
    ' title="Guided RSSI hunt â€” the arms help you home in on this device">locate</button>';
  return '<button type="button" class="pa'+(watched?" on":"")+'" data-pwatch="'+esc(mac)+
      '" title="Flag this MAC on your watchlist">'+(watched?"â˜… watching":"â˜† watch")+
      "</button>"+loc+
    '<button type="button" class="pa'+(acked?" done":"")+'" data-pack="'+esc(mac)+
      '" title="Mark reviewed â€” hidden under â€˜new onlyâ€™">'+
      (acked?"âœ“ reviewed":"mark reviewed")+"</button>";
}
// ---- Guided RSSI locate (cluster only): warmer/colder hunt driven by the arms ----
// The arms measure the target's signal strength; the browser turns the user's moves +
// signal change into direction. No compass/AoA â€” honest about being a gradient hunt.
let LOC=null;
function locBarPct(r){return r==null?0:Math.max(0,Math.min(100,Math.round((r+90)/60*100)));}
function locTrend(){const h=LOC.hist;if(h.length<3)return 0;
  return h[h.length-1]-h[Math.max(0,h.length-4)];}
function locateOpen(mac,kind,channel,name){
  const ov=$("locov");if(!ov)return;
  LOC={mac:mac,kind:kind==null?1:kind,channel:channel||0,name:name||mac,
    ema:null,hist:[],dirs:{},phase:"start",fails:0,found:false,age:255,samples:0,timer:null};
  if(!ov._w){ov._w=1;
    ov.addEventListener("click",e=>{if(e.target===ov)locateClose();});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&!ov.hidden)locateClose();});}
  ov.hidden=false;locateRender();
  fetch("/api/cluster/locate/start",{method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({mac:LOC.mac,kind:LOC.kind,channel:LOC.channel})})
   .then(r=>{if(!r.ok)throw 0;if(LOC){LOC.phase="hunt";locatePoll();}})
   .catch(()=>{if(LOC){LOC.phase="offline";locateRender();}});
}
function locatePoll(){
  if(!LOC||LOC.phase==="offline")return;
  fetch("/api/cluster/locate",{cache:"no-store"}).then(r=>r.json()).then(s=>{
    if(!LOC)return;
    LOC.found=!!s.found;LOC.age=s.age_ds;LOC.samples=s.samples;
    if(s.found&&s.age_ds<20){
      LOC.ema=LOC.ema==null?s.rssi:Math.round(LOC.ema*0.6+s.rssi*0.4);
      LOC.hist.push(LOC.ema);if(LOC.hist.length>30)LOC.hist.shift();LOC.fails=0;
    }else LOC.fails++;
    locateRender();
  }).catch(()=>{if(LOC)LOC.fails++;})
    .finally(()=>{if(LOC&&LOC.phase!=="offline")LOC.timer=setTimeout(locatePoll,700);});
}
const LOC_DIRS=[["forward","â–² Fwd"],["back","â–¼ Back"],["left","â—€ Left"],["right","â–¶ Right"]];
function locateRender(){
  const sh=$("locsheet");if(!sh||!LOC)return;
  let h='<div class="lochd"><span><b>Locate</b> '+esc(String(LOC.name).slice(0,22))+
    '</span><button class="locx" data-loc="close" aria-label="Stop">âœ•</button></div>';
  if(LOC.phase==="offline"){
    h+='<div class="locwarn">Live locate needs a running SniffCheck cluster. Join the '+
      "clusterâ€™s Wi-Fi and open this report there to hunt.</div>"+
      '<div class="locact"><button class="prim" data-loc="close">Close</button></div>';
    sh.innerHTML=h;locBind();return;
  }
  const rssi=LOC.ema,pct=locBarPct(rssi);
  const weak=LOC.fails>3||LOC.age>30||!LOC.found||rssi==null;
  const trend=locTrend();
  h+='<div class="locsig'+(weak?" weak":"")+'"><div class="locbar"><i style="width:'+
    pct+'%"></i></div><div class="locdbm">'+(rssi==null?"â€”":rssi+" dBm")+"</div></div>";
  if(weak){
    h+='<div class="locwarn">Weak / intermittent signal â€” this device isnâ€™t transmitting '+
      "often enough to lock reliably (probe-only or rotating-MAC devices are the hardest). "+
      "Move toward where you last saw it and keep watching."+
      (LOC.samples?" Â· samples: "+LOC.samples:"")+"</div>";
  }else{
    const w=trend>3?"warm":trend<-3?"cold":"hold";
    h+='<div class="loctemp t'+w+'">'+(w==="warm"?"WARMER â†‘":w==="cold"?"COLDER â†“":"hold")+"</div>";
    if(rssi>-45)h+='<div class="locclose">Very strong â€” itâ€™s right near you. Look around.</div>';
  }
  const rec=Object.keys(LOC.dirs).length;
  h+='<div class="locguide">';
  if(rec<4)h+='<div class="locstep">Stand still, step a few feet one way, then tap that '+
    "arrow â€” it snapshots the signal in that direction.</div>";
  h+='<div class="locdirs">'+LOC_DIRS.map(([d,lbl])=>{const v=LOC.dirs[d];
    return '<button class="locdir'+(v!=null?" done":"")+'" data-dir="'+d+'">'+lbl+
      (v!=null?'<span class="dv">'+v+"</span>":"")+"</button>";}).join("")+"</div>";
  if(rec>=2){let best=null,bv=-999;for(const d in LOC.dirs)if(LOC.dirs[d]>bv){bv=LOC.dirs[d];best=d;}
    const lbl={forward:"forward",back:"back",left:"left",right:"right"}[best];
    h+='<div class="locbest">Strongest so far: <b>'+lbl+"</b> â€” head that way, then re-check."+
      ' <button class="locre" data-loc="recal">reset</button></div>';}
  h+="</div>";
  h+='<div class="locfoot">Relative to your last move â€” this reads signal strength, not a '+
    "compass bearing.</div>"+
    '<div class="locact"><button class="prim" data-loc="close">Stop &amp; close</button></div>';
  sh.innerHTML=h;locBind();
}
function locBind(){
  const sh=$("locsheet");
  sh.querySelectorAll('[data-loc="close"]').forEach(b=>b.onclick=locateClose);
  const re=sh.querySelector('[data-loc="recal"]');if(re)re.onclick=()=>{LOC.dirs={};locateRender();};
  sh.querySelectorAll("[data-dir]").forEach(b=>b.onclick=()=>{
    if(LOC.ema==null){toast("No signal yet â€” wait for a reading.");return;}
    LOC.dirs[b.dataset.dir]=LOC.ema;locateRender();});
}
function locateClose(){
  const ov=$("locov");
  if(LOC&&LOC.timer)clearTimeout(LOC.timer);
  fetch("/api/cluster/locate/stop",{method:"POST"}).catch(()=>{});
  LOC=null;if(ov)ov.hidden=true;
}
function pmac(m){return '<span class="mono">'+esc(m||"?")+"</span>";}
function pkv(k,v){return "<span><b>"+esc(k)+"</b>"+esc(v??"â€”")+"</span>";}
function pflag(cls,txt){return '<span class="pill '+cls+'">'+esc(txt)+"</span>";}
function prow(cat,title,parts,flag,mac,rssi){
  const acked=mac&&ackHas(mac);
  return '<div class="prow'+(acked?" acked":"")+'" style="--cat:'+cat+'"><div class="pt"><span>'+
    title+"</span>"+(flag||"")+(acked?'<span class="pill done">reviewed</span>':"")+
    '</div><div class="pm">'+parts.join("")+"</div>"+
    (mac?'<div class="pact">'+privActions(mac,rssi)+"</div>":"")+"</div>";
}
const PRIV=[
 {k:"probe_req_log",label:"Probe requests",cat:"var(--wifi)",
  exp:"Devices broadcast the names of Wi-Fi networks they remember. Each "+
      "probed name can hint at places that device has connected before.",
  act:"On your own phone, â€˜forgetâ€™ Wi-Fi networks you no longer use so it stops "+
      "broadcasting their names. For other devices this is a privacy heads-up â€” "+
      "watch or locate it if it keeps reappearing.",
  row:r=>prow("var(--wifi)",
    r.ssid?esc(r.ssid):'<span class="hid">(broadcast â€” any network)</span>',
    [pmac(r.src_mac),pkv("category",r.category||"â€”"),pkv("hits",r.hit_count),
     pkv("scans",(r.first_seen_scan??"?")+"â€“"+(r.last_seen_scan??"?")),
     pkv("locally visible",r.local_visible?"yes":"no"),privLinks(r.src_mac)],"",r.src_mac),
  risk:r=>r.hit_count||0},
 {k:"seq_fingerprint_log",label:"Sequence fingerprint",cat:"var(--ble)",
  exp:"Even with a randomized MAC, a device's 802.11 sequence counter can "+
      "chain its frames together over time â€” defeating the randomization.",
  act:"Sequence-counter linking is a firmware trait you can't change from here. "+
      "If a â€˜linkableâ€™ device concerns you, watch it and use locate to identify it.",
  row:r=>prow("var(--ble)",pmac(r.src_mac),
    [pkv("seq range",(r.first_seq??"?")+"â€“"+(r.last_seq??"?")),pkv("hits",r.hit_count),
     privLinks(r.src_mac)],
    r.linked?pflag("p2","linkable"):"",r.src_mac),
  risk:r=>r.linked?1:0},
 {k:"ie_signature_log",label:"IE signatures",cat:"var(--track)",
  exp:"The set of capability tags a device advertises forms a fingerprint. "+
      "When the IE-implied vendor disagrees with the MAC's vendor, that can "+
      "flag a spoofed or cloned address.",
  act:"A vendor mismatch can mean a spoofed or cloned MAC. Flag it with watch and "+
      "open its result row to cross-check the hardware against what it claims to be.",
  row:r=>prow("var(--track)",pmac(r.src_mac),
    [pkv("IE vendor",r.ie_vendor||"â€”"),pkv("MAC vendor",r.mac_vendor||"â€”"),
     pkv("hash",r.ie_hash),pkv("hits",r.hit_count),privLinks(r.src_mac)],
    r.mismatch?pflag("p2","vendor mismatch"):"",r.src_mac),
  risk:r=>r.mismatch?1:0},
 {k:"anqp_log",label:"ANQP / GAS",cat:"var(--drone)",
  exp:"Hotspot 2.0 / ANQP queries can leak a device's identity and its "+
      "preferred (home) networks to anyone listening.",
  act:"A universal (non-randomized) MAC is stable and easy to track. On your own "+
      "device, turn off Hotspot 2.0 / Passpoint auto-join. Otherwise, watch it.",
  row:r=>prow("var(--drone)",pmac(r.src_mac),
    [pkv("universal MAC",r.universal?"yes":"no"),pkv("hits",r.hit_count),
     privLinks(r.src_mac)],
    r.universal?pflag("p1","universal MAC"):"",r.src_mac),
  risk:r=>r.universal?1:0},
 {k:"station_log",label:"Stations",cat:"var(--wifi)",
  exp:"Client devices (phones, laptops, cameras) talking on nearby networks. "+
      "Pulled from cleartext MAC headers â€” no decryption. Camera-vendor MACs "+
      "are flagged for the hotel-room / Airbnb hidden-camera check.",
  act:"Camera-vendor MACs are the hidden-camera signal â€” use locate and walk the "+
      "room while re-scanning; the signal climbs as you close in. Randomized MACs "+
      "can't be vendor-identified, so a camera may hide behind one.",
  panel:rec=>{
    let det=Array.isArray(rec.stations)?rec.stations.slice():[];
    let h='<div class="pexp" style="--cat:var(--wifi)">'+esc(PRIV_EXP.station_log)+"</div>"+
      pguide("Camera-vendor MACs are the hidden-camera signal â€” use locate and walk the "+
      "room while re-scanning; the signal climbs as you close in. Randomized MACs "+
      "can't be vendor-identified.");
    if(privNewOnly)det=det.filter(s=>!ackHas(s.mac));
    h+='<div class="pchips"><span class="pchip">stations<b>'+(rec.total||det.length)+
       "</b></span>"+(rec.cameras?'<span class="pchip">cameras<b>'+rec.cameras+
       "</b></span>":"")+"</div>";
    if(!det.length)return h+'<div class="note">'+(privNewOnly?
      "No un-reviewed stations.":"No client stations recorded.")+"</div>";
    det.sort((a,b)=>(b.camera?1:0)-(a.camera?1:0)||(b.frames||0)-(a.frames||0));
    return h+'<div class="plist">'+det.map(stationRow).join("")+"</div>";
  }},
 {k:"csi",label:"CSI",cat:"var(--ble)",
  exp:"Channel State Information probe (research go/no-go): does the C5 actually "+
      "deliver CSI callbacks, and how big are the records.",
  panel:rec=>{
    let h='<div class="pexp" style="--cat:var(--ble)">'+esc(PRIV_EXP.csi)+"</div>";
    if(!rec.supported)
      return h+'<div class="note">CSI is not compiled into this firmware '+
        "(rebuild with CONFIG_ESP_WIFI_CSI_ENABLED).</div>";
    if(!rec.ran)return h+'<div class="note">CSI is enabled but no window has run.</div>';
    const verdict=rec.cb_count?"GO":"NO-GO";
    return h+'<div class="pchips">'+
      '<span class="pchip">verdict<b>'+verdict+"</b></span>"+
      '<span class="pchip">channel<b>'+rec.channel+"</b></span>"+
      '<span class="pchip">window<b>'+rec.window_ms+"ms</b></span>"+
      '<span class="pchip">callbacks<b>'+rec.cb_count+"</b></span>"+
      '<span class="pchip">len<b>'+rec.len_min+"â€“"+rec.len_max+"</b></span>"+
      '<span class="pchip">rssi<b>'+rec.rssi_last+"</b></span></div>";
  }},
];

function stationRow(s){
  return prow("var(--wifi)",pmac(s.mac),
    [pkv("vendor",s.vendor||"â€”"),pkv("frames",s.frames),
     pkv("up/dn",(s.up||0)+"/"+(s.dn||0)),pkv("ch",s.channel),
     pkv("rssi",s.rssi_best),pkv("BSSID",s.bssid),privLinks(s.mac)],
    (s.camera?pflag("p1","camera"):"")+(s.randomized?pflag("p2","randomized"):""),
    s.mac,typeof s.rssi_best==="number"?s.rssi_best:undefined);
}

const PRIV_EXP={
  station_log:"Client devices (phones, laptops, cameras) seen talking on nearby "+
    "networks, from cleartext MAC headers. A camera-vendor OUI is the hidden-camera "+
    "signal; a randomized MAC can't be vendor-identified.",
  csi:"A short receive-only CSI capture window. GO means the radio delivered CSI "+
    "callbacks; NO-GO means none arrived in the window."};
// "What you can do" guidance strip shown at the top of an analyzer panel.
function pguide(txt){return txt?'<div class="pguide"><b>What you can do</b>'+esc(txt)+
  "</div>":"";}
function privPanel(p){
  const rec=M.logs[p.k];
  if(p.panel)return p.panel(rec);
  let h='<div class="pexp" style="--cat:'+p.cat+'">'+esc(p.exp)+"</div>"+pguide(p.act);
  const chips=o=>o?'<div class="pchips">'+Object.entries(o).map(([k,v])=>
    '<span class="pchip">'+esc(k)+"<b>"+esc(v)+"</b></span>").join("")+"</div>":"";
  h+=chips(rec.totals)+chips(rec.by_category);
  let det=Array.isArray(rec.detail)?rec.detail.slice():null;
  if(!det||!det.length)
    return h+'<div class="note">This capture holds totals only â€” no per-device '+
      "rows were recorded.</div>";
  if(privNewOnly)det=det.filter(r=>!ackHas(r.src_mac));
  if(!det.length)return h+'<div class="note">No un-reviewed devices in this analyzer.</div>';
  det.sort((a,b)=>p.risk(b)-p.risk(a));
  return h+'<div class="plist">'+det.map(p.row).join("")+"</div>";
}
let privActiveTab=0;
function renderPrivacy(){
  const avail=PRIV.filter(p=>M.logs[p.k]);
  if(!avail.length){$("privacy").innerHTML=empty("No analyzer log records.");return;}
  if(privActiveTab>=avail.length)privActiveTab=0;
  let h="";
  if(filterActive())
    h+='<div class="note">Aggregate analyzer logs are not device-scoped â€” '+
       "the filter above does not narrow this section.</div>";
  const reviewed=ackGet().length;
  h+='<div class="ptoolbar"><button type="button" class="fchip'+(privNewOnly?" on":"")+
     '" id="pnew" title="Hide devices youâ€™ve marked reviewed">'+
     (privNewOnly?"New only âœ“":"New only")+"</button>"+
     (reviewed?'<button type="button" class="fchip" id="pclr" title="Un-review everything">'+
       "Clear "+reviewed+" reviewed</button>":"")+
     '<span class="small">Watch flags a MAC Â· locate helps you home in Â· reviewed hides '+
     "it under â€œnew onlyâ€ â€” all stored in this browser.</span></div>";
  h+='<div class="ctabs" id="ptabs">'+avail.map((p,i)=>{
    const rec=M.logs[p.k];
    const det=rec.detail||rec.stations;
    const n=Array.isArray(det)?det.length:0;
    return '<button class="ctab'+(i===privActiveTab?" act":"")+'" data-i="'+i+'">'+
      esc(p.label)+(n?' <span class="tn">'+n+"</span>":"")+"</button>";
  }).join("")+"</div>";
  h+='<div id="ppanels">'+avail.map((p,i)=>
    '<div class="ppanel" data-i="'+i+'"'+(i===privActiveTab?"":' style="display:none"')+">"+
    privPanel(p)+"</div>").join("")+"</div>";
  $("privacy").innerHTML=h;
  const tabs=$("ptabs"),panels=$("ppanels");
  tabs.querySelectorAll(".ctab").forEach(b=>b.onclick=()=>{
    privActiveTab=+b.dataset.i;
    tabs.querySelectorAll(".ctab").forEach(x=>x.classList.toggle("act",x===b));
    panels.querySelectorAll(".ppanel").forEach(pn=>
      pn.style.display=pn.dataset.i===b.dataset.i?"":"none");
  });
  $("pnew").onclick=()=>{privNewOnly=!privNewOnly;renderPrivacy();};
  const clr=$("pclr");if(clr)clr.onclick=()=>{ackSet([]);renderPrivacy();renderBanner();};
  $("privacy").querySelectorAll("[data-pwatch]").forEach(b=>b.onclick=e=>{
    e.stopPropagation();const mac=b.dataset.pwatch;
    if(macWatched(mac)){watchSet(watchGet().filter(w=>
      !(w.t==="mac"&&normMac(w.v)===normMac(mac))));toast("Removed from watchlist");}
    else{watchAdd("mac",mac);toast("Added to watchlist â˜…");}
    renderPrivacy();renderBanner();renderWifi();renderBle();});
  $("privacy").querySelectorAll("[data-pack]").forEach(b=>b.onclick=e=>{
    e.stopPropagation();ackToggle(b.dataset.pack);
    toast(ackHas(b.dataset.pack)?"Marked reviewed âœ“":"Reopened");
    renderPrivacy();renderBanner();});
  $("privacy").querySelectorAll("[data-ploc]").forEach(b=>b.onclick=e=>{
    e.stopPropagation();locateOpen(b.dataset.ploc,1,0,b.dataset.ploc);});
}

let chBest=6;

let chList=[];
function renderChannel(){
  $("channel").innerHTML=
    '<div class="pexp">Live tools â€” they read the device you are connected to. '+
    'Pick a channel the last scan saw, then capture its stations or run a CSI '+
    'window. A capture uses the radio, so the SniffCheck AP drops while it runs '+
    'and returns on its own â€” reconnect and reopen this tab for results. '+
    'Inactive in a saved report.</div>'+
    '<div id="chans" class="pexp">channels found: â€¦</div>'+
    '<div id="stalist" class="pexp" style="max-height:200px;overflow:auto">'+
    'loading stationsâ€¦</div>'+
    '<button onclick="staCap(this)">Capture stations</button> '+
    '<button id="csibtn" onclick="csiRun(this)">Run CSI capture</button>'+
    '<div id="csiline" class="pexp">CSI: â€“</div>'+

    '<hr style="border:none;border-top:1px solid var(--line);margin:12px 0">'+
    '<div class="pexp"><b>Packet scan.</b> Sniff every channel in the graph for '+
    '10 s each into one <code>.pcap</code>. The AP drops while it runs and '+
    'returns on its own â€” reconnect to download. Receive-only: nothing is '+
    'transmitted.</div>'+
    '<button id="pcapbtn" onclick="pcapRun(this)" disabled>'+
    'Packet scan: 10s per channel</button>'+
    '<div id="pcapline" class="pexp">PCAP: â€“</div>';
}

function refreshChannel(){loadChans();loadStaList();loadCsiLine();loadPcapStatus();}
function loadChans(){
  fetch("/api/scan/channels").then(r=>r.json()).then(j=>{
    const c=j.channels||[];
    if(!c.length){
      chList=[];syncPcapBtn();
      $("chans").innerHTML=
        '<span class="dim">No channel activity from the last scan yet.</span>';
      return;
    }

    const rows=c.slice().sort((a,b)=>(a.band||0)-(b.band||0)||a.ch-b.ch);
    let best=0;rows.forEach(x=>{if((x.aps||0)>best)best=x.aps;});
    chBest=rows.reduce((p,x)=>((x.aps||0)>(p.aps||0)?x:p),rows[0]).ch;
    chList=rows.map(x=>x.ch);syncPcapBtn();
    const w=x=>best>0?Math.max(4,Math.round((x.aps||0)/best*100)):0;
    $("chans").innerHTML=
      '<div class="small dim" style="margin-bottom:4px">channels found ('+
        j.count+') â€” bars scale to the busiest channel</div>'+
      '<div class="cg">'+rows.map(x=>
        '<div class="cgr'+(x.band===5?' g5':'')+'">'+
          '<span class="lbl"><b>ch '+x.ch+'</b> '+
            (x.band===5?'5 GHz':'2.4 GHz')+'</span>'+
          '<span class="trk"><i style="width:'+w(x)+'%"></i></span>'+
          '<span class="n">'+(x.aps||0)+'</span>'+
        '</div>').join('')+'</div>';
  }).catch(()=>{});
}
function loadStaList(){
  fetch("/api/sta").then(r=>r.json()).then(j=>{
    let h="<b>"+(j.count||0)+"</b> stations"+
      (j.cameras?" Â· "+j.cameras+" camera":"")+"<br>";
    (j.stations||[]).slice(0,40).forEach(s=>{
      h+=esc(s.mac)+" "+esc(s.vendor||"?")+(s.randomized?" [rnd]":"")+
        " rssi"+s.rssi_best+" ch"+s.channel+" up/dn "+s.up+"/"+s.dn+
        (s.camera?" CAM":"")+"<br>";
    });
    $("stalist").innerHTML=j.count?h:"no stations from last scan";
  }).catch(()=>{});
}
function loadCsiLine(){
  fetch("/api/csi").then(r=>r.json()).then(j=>{
    let t;
    if(!j.supported){t="CSI: not enabled in firmware (rebuild with WiFi CSI)";
      const b=$("csibtn");if(b){b.disabled=true;b.textContent="CSI not in firmware";}}
    else if(!j.ran)t="CSI: not run yet";
    else t="CSI ch"+j.channel+": "+j.cb_count+" records, len "+j.len_min+"-"+
      j.len_max+" â€” "+(j.cb_count?"GO":"NO-GO");
    $("csiline").textContent=t;
  }).catch(()=>{});
}
function askCap(){
  const c=prompt("Channel (one the scan found above):",chBest);
  if(c===null)return null;
  const s=prompt("Seconds (1-30):","5");
  if(s===null)return null;
  return{channel:+c,seconds:+s};
}
// Extra seconds after the scan for the SniffCheck AP to redeploy before the
// user can reconnect.
const RC_AP_DEPLOY=10;
let rcTick=null;
// The browser can't rejoin Wi-Fi for the user, so a blind reload just hangs if
// they haven't reconnected to the (same-password) SniffCheck AP yet. Verify the
// device answers first; only then reload to the fresh results.
function rcReconnect(){
  const b=$("rcbtn");
  b.disabled=true;b.textContent="Checkingâ€¦";
  const ctrl=("AbortController"in window)?new AbortController():null;
  const t=setTimeout(()=>{if(ctrl)ctrl.abort();},4000);
  fetch("/api/status",{cache:"no-store",signal:ctrl?ctrl.signal:undefined})
    .then(r=>{clearTimeout(t);if(r.ok){location.reload();return;}throw 0;})
    .catch(()=>{clearTimeout(t);b.disabled=false;b.className="ready";
      b.textContent="Not back yet â€” rejoin the Wi-Fi, then tap";});
}
// Local countdown shown while the device is off-network running a scan. total =
// scan eta + AP redeploy. The reconnect button stays disabled until it hits 0,
// then turns green so the user can rejoin the (same-password) AP and refresh.
function startReconnectTimer(scanEta,label){
  const total=Math.max(1,(scanEta|0))+RC_AP_DEPLOY;
  $("rctitle").textContent=label||"Scan running";
  $("rcmsg").innerHTML="The SniffCheck AP drops while the radio scans, then "+
    "relaunches with the <b>same Wi-Fi password</b>. When the timer ends, "+
    "reconnect to the AP and tap below to load the new results.";
  const btn=$("rcbtn");
  btn.disabled=true;btn.className="";btn.textContent="Reconnect & refresh";
  $("rcov").classList.add("on");
  let left=total;
  const paint=()=>{
    $("rcnum").textContent=left>0?left+"s":"Ready";
    $("rcbarf").style.width=Math.round((total-left)/total*100)+"%";
  };
  paint();
  if(rcTick)clearInterval(rcTick);
  rcTick=setInterval(()=>{
    left--;
    if(left<=0){
      left=0;paint();clearInterval(rcTick);rcTick=null;
      btn.disabled=false;btn.className="ready";
      btn.textContent="Reconnect & refresh";
    }else paint();
  },1000);
}
function fireCap(u,b){
  const p=askCap();if(!p)return;
  b.textContent="Capturingâ€¦ the AP returns on its own â€” reconnect to see results";b.disabled=true;
  const label=u.indexOf("csi")>=0?"CSI capture running":"Station capture running";
  fetch(u,{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify(p)})
    .then(r=>r.json())
    .then(j=>startReconnectTimer(j&&j.eta_seconds!=null?j.eta_seconds:p.seconds,label))
    .catch(()=>startReconnectTimer(p.seconds,label));
}
function staCap(b){fireCap("/api/sta/capture",b);}
function csiRun(b){fireCap("/api/csi/run",b);}

function syncPcapBtn(){
  const b=$("pcapbtn");if(!b)return;
  if(b.dataset.busy==="1")return;
  b.disabled=chList.length===0;
}
function loadPcapStatus(){
  fetch("/api/pcap/status").then(r=>r.json())
    .then(pcapStatusLine)
    .catch(()=>{$("pcapline").textContent="PCAP: no packet scan yet";});
}
function pcapStatusLine(j){
  const el=$("pcapline");if(!el)return;
  if(!j||!j.ran){el.textContent="PCAP: no packet scan yet";return;}
  const st=j.status||"unknown";
  let h="<b>PCAP "+esc(st)+"</b>";
  if(j.scan_id!=null)h+=" #"+esc(""+j.scan_id);
  if(j.channels&&j.channels.length)h+=" Â· ch "+esc(j.channels.join(","));
  h+=" Â· "+(j.seconds_per_channel||10)+"s/ch";
  if(j.duration_s!=null)h+=" Â· "+j.duration_s+"s total";
  if(j.packets!=null)h+=" Â· "+j.packets+" pkts";
  if(j.dropped)h+=" Â· "+j.dropped+" dropped";
  if(j.truncated)h+=" Â· "+j.truncated+" truncated";
  if(j.bytes!=null)h+=" Â· "+(j.bytes>1024?(j.bytes/1024).toFixed(1)+" KB"
    :j.bytes+" B");
  if((st==="ready"||st==="partial")&&j.bytes>0)
    h+=' Â· <a href="'+esc(j.download||"/api/pcap/latest")+'" download>'+
       'Download PCAP</a>';
  el.innerHTML=h;

  if(st!=="running"){const b=$("pcapbtn");if(b)b.dataset.busy="";syncPcapBtn();}
}
function pcapRun(b){
  if(!chList.length)return;
  const n=chList.length,secs=n*10;
  if(!confirm("Packet scan "+n+" channel"+(n>1?"s":"")+" Ã— 10s â‰ˆ "+secs+"s.\n"+
    "The SniffCheck AP will disconnect while it runs, then relaunch itself.\n"+
    "Reconnect afterward to download the .pcap. Continue?"))return;
  b.dataset.busy="1";b.disabled=true;
  b.textContent="Scanning "+n+" channel"+(n>1?"s":"")+
    "â€¦ the AP relaunches when it finishes";
  fetch("/api/pcap/run",{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({channels:chList,seconds_per_channel:10})})
    .then(r=>r.json())
    .then(j=>startReconnectTimer(j&&j.eta_seconds!=null?j.eta_seconds:secs,
      "Packet scan running"))
    .catch(()=>startReconnectTimer(secs,"Packet scan running"));
}

function hlJson(obj){
  const j=JSON.stringify(obj,null,1);
  const re=/("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)/g;
  let out="",last=0,m;
  while((m=re.exec(j))){
    out+=esc(j.slice(last,m.index));
    if(m[1]!==undefined)
      out+=m[2]!==undefined
        ?'<span class="jk">'+esc(m[1])+"</span>"+esc(m[2])
        :'<span class="js">'+esc(m[1])+"</span>";
    else if(m[3]!==undefined)out+='<span class="jl">'+esc(m[3])+"</span>";
    else out+='<span class="jnum">'+esc(m[4])+"</span>";
    last=re.lastIndex;
  }
  return out+esc(j.slice(last));
}
const RAW_CAP=400;
function renderRaw(){
  const types=[...new Set(RAW_RECS.map(r=>r.type||"(untyped)"))].sort();
  $("raw").innerHTML='<details><summary>Browse all '+RAW_RECS.length+
    " records</summary>"+
    '<div class="note">type filter: <select id="rawsel">'+
    '<option value="">all types</option>'+
    types.map(t=>"<option>"+esc(t)+"</option>").join("")+
    "</select></div><div id='rawout'></div></details>";
  const out=$("rawout"),sel=$("rawsel");
  function show(){
    const f=sel.value;
    const rs=RAW_RECS.filter(r=>!f||(r.type||"(untyped)")===f);
    let h=rs.length>RAW_CAP?
      '<div class="note">showing first '+RAW_CAP+" of "+rs.length+
      " â€” narrow the type filter for the rest</div>":"";
    h+=rs.slice(0,RAW_CAP).map(r=>{
      const t=r.type||"(untyped)",k=KIND[t]||"";
      const sum=fName(r)||fMac(r)||"";
      return '<div class="rrec"><div class="rh"><span class="rt '+k+'">'+
        esc(t)+"</span>"+(sum?'<span class="rs">'+esc(sum)+"</span>":"")+
        "</div><pre>"+hlJson(r)+"</pre></div>";
    }).join("");
    out.innerHTML=h;
  }
  sel.onchange=show;show();
}

const ALL_SECS=["s-banner","s-wifi","s-ble","s-clusters","s-trackers",
  "s-alerts","s-privacy","s-channel","s-raw","s-drones"];
let curTab="s-banner";
function availPrivacy(){return PRIV.filter(p=>M.logs[p.k]).length;}

function showTab(){
  for(const id of ALL_SECS)$(id).style.display=(id===curTab)?"":"none";
  $("nav").querySelectorAll(".tab").forEach(b=>
    b.classList.toggle("act",b.dataset.s===curTab));
  if(curTab==="s-channel")refreshChannel();
  window.scrollTo(0,0);
}
function renderNav(){

  const secs=[
    ["s-banner","Summary",0,1],
    ["s-wifi","Wi-Fi",FW.length,1],
    ["s-ble","BLE",FB.length,1],
    ["s-clusters","Clusters",FC.length,1],
    ["s-trackers","Trackers",FT.length,1],
    ["s-alerts","Notices",FA.length,1],
    ["s-privacy","Privacy",availPrivacy(),1],
    ["s-channel","Channels",0,1],
    ["s-raw","Raw",M.total,1],
    ["s-drones","Drones",FD.length],
  ];
  const shown=secs.filter(s=>s[3]||s[2]>0);
  if(!shown.some(s=>s[0]===curTab))curTab=shown[0][0];
  let h="";
  for(const [id,label,n,always] of shown)
    h+='<button class="tab" data-s="'+id+'">'+esc(label)+
      (n>0&&!(id==="s-banner"||id==="s-session")?"<b>"+n+"</b>":"")+"</button>";
  const nav=$("nav");nav.innerHTML=h;nav.style.display="flex";
  $("navtog").style.display="block";
  nav.querySelectorAll(".tab").forEach(b=>
    b.onclick=()=>{curTab=b.dataset.s;showTab();});
  showTab();
}

// Delegated so a data-go link works wherever it is rendered,
// including inside a card detail that did not exist when the section was wired.
document.addEventListener("click",e=>{
  const a=e.target.closest&&e.target.closest("a[data-go]");
  if(!a||!a.dataset.tab)return;
  e.preventDefault();
  gotoDevice(a.dataset.tab,a.dataset.go);
});

function gotoDevice(tab,elId){
  curTab=tab;showTab();
  const t=$(elId);
  if(t){t.scrollIntoView({block:"center"});
    t.style.outline="2px solid var(--acc)";t.style.outlineOffset="2px";
    setTimeout(()=>{t.style.outline="";t.style.outlineOffset="";},1700);}
}

function gotoCluster(g,i){
  curTab="s-clusters";showTab();
  const root=$("clusters");
  const sub=g==="mr"?"radio":g==="pv"?"priv":g==="ag"?"agg":g==="rc"?"multi":"nic";
  const tb=root.querySelector('.ctab[data-t="'+sub+'"]');
  if(tb&&!tb.classList.contains("act"))tb.click();
  const tile=root.querySelector('.ctile[data-g="'+g+'"][data-i="'+i+'"]');
  if(tile)tile.scrollIntoView({block:"center"});
  // Open the detail popup for this cluster (repoints it if one is already up).
  openClusterModal(g,i);
}

function fillSel(id,anyLabel,pairs){
  const sel=$(id);
  sel.innerHTML='<option value="">'+esc(anyLabel)+"</option>"+
    pairs.map(([v,l])=>'<option value="'+esc(v)+'">'+esc(l)+"</option>").join("");
}

let REPS=[];
let CATS_AVAIL=[];

function renderCatChips(){
  const box=$("catchips");
  if(!box)return;
  if(!CATS_AVAIL.length){box.style.display="none";box.innerHTML="";return;}
  box.style.display="";
  box.innerHTML='<span class="chlbl">Groups:</span>'+
    CATS_AVAIL.map(([c,n])=>
      '<button class="fchip'+(F.cat.includes(c)?" on":"")+'" data-c="'+esc(c)+
      '">'+esc(c)+' <span class="chn">'+n+'</span></button>').join("");
  box.querySelectorAll(".fchip").forEach(b=>b.onclick=()=>{
    const c=b.dataset.c, i=F.cat.indexOf(c);
    if(i<0)F.cat.push(c); else F.cat.splice(i,1);
    renderCatChips();applyFilter();
  });
}

const QUICK=[
  ["Phones",        {cat:["Phones & mobile"]}],
  ["Cameras",       {cat:["Cameras & surveillance","Surveillance OUI (hint)"]}],
  ["Wearables",     {cat:["Wearables"]}],
  ["Drones",        {cat:["Drones"]}],
  ["Trackers",      {cat:["Trackers & beacons"]}],
  ["Cars",          {cat:["Cars"]}],
  ["Enterprise APs",{kind:"wifi",grade:"ent"}],
  ["Consumer APs",  {kind:"wifi",grade:"con"}],
  ["High threat",   {threat:"high"}],
];
function quickAvail(o){
  if(o.cat&&!o.cat.some(c=>CATS_AVAIL.some(([b])=>b===c)))return false;
  if(o.grade&&!REPS.some(r=>fGrade(r)===o.grade))return false;
  if(o.threat&&!REPS.some(r=>fThreat(r)===o.threat))return false;
  return true;
}
function renderQuickChips(){
  const box=$("quickchips");
  if(!box)return;
  const av=QUICK.filter(([,o])=>quickAvail(o));
  if(!av.length){box.style.display="none";box.innerHTML="";return;}
  box.style.display="";
  box.innerHTML='<span class="chlbl">Quick:</span>'+
    av.map(([lbl],i)=>'<button class="qchip" data-i="'+
      QUICK.indexOf(av[i])+'">'+esc(lbl)+'</button>').join("");
  box.querySelectorAll(".qchip").forEach(b=>b.onclick=()=>setQuick(QUICK[+b.dataset.i][1]));
}

function setQuick(o){
  F.q="";F.cat=[];F.kind="";F.vendor="";F.cls="";F.grade="";F.threat="";
  F.band="";F.channel="";
  Object.assign(F,o);
  if(!Array.isArray(F.cat))F.cat=[].concat(F.cat||[]);
  $("q").value=F.q;
  $("f-kind").value=F.kind;$("f-vendor").value=F.vendor;$("f-class").value=F.cls;
  $("f-grade").value=F.grade;$("f-threat").value=F.threat;$("f-band").value=F.band;
  $("f-channel").value=F.channel;
  renderCatChips();applyFilter();
}
function populateFilters(){
  const reps=[...M.wifi.values(),...M.ble.values(),...M.trackers.values(),
    ...M.drones.values()].map(x=>x.rec);
  const uniq=arr=>[...new Set(arr.filter(Boolean))].sort();
  const kinds=[];
  if(M.wifi.size)kinds.push(["wifi","Wi-Fi only"]);
  if(M.ble.size)kinds.push(["ble","BLE only"]);
  if(M.trackers.size)kinds.push(["track","Trackers only"]);
  if(M.drones.size)kinds.push(["drone","Drones only"]);
  fillSel("f-kind","Any category",kinds);

  REPS=reps;
  const catCount={};
  reps.forEach(r=>{const c=fCat(r);if(c)catCount[c]=(catCount[c]||0)+1;});
  CATS_AVAIL=CAT_BUCKETS.map(([c])=>c).filter(c=>catCount[c])
    .map(c=>[c,catCount[c]]);
  renderCatChips();
  renderQuickChips();
  fillSel("f-vendor","Any vendor",uniq(reps.map(fVendor)).map(v=>[v,v]));
  fillSel("f-class","Any device type",uniq(reps.map(fClass)).map(v=>[v,v]));

  const grades=[];
  if(reps.some(r=>fGrade(r)==="ent"))grades.push(["ent","Enterprise-grade"]);
  if(reps.some(r=>fGrade(r)==="con"))grades.push(["con","Consumer-grade"]);
  $("f-grade").style.display=grades.length?"":"none";
  fillSel("f-grade","Any grade",grades);

  const order=["none","low","medium","high"];
  const thr=uniq(reps.map(fThreat)).sort((a,b)=>
    (order.indexOf(a)+1||9)-(order.indexOf(b)+1||9));
  fillSel("f-threat","Any threat level",thr.map(v=>[v,v]));
  const hasWifi=M.wifi.size>0;
  $("f-band").style.display=hasWifi?"":"none";
  fillSel("f-band","Any band",hasWifi?[["2.4","2.4 GHz"],["5","5 GHz"]]:[]);

  const chans=[...new Set([...M.wifi.values()].map(x=>x.rec.channel)
    .filter(c=>c!=null))].sort((a,b)=>a-b);
  $("f-channel").style.display=chans.length?"":"none";
  fillSel("f-channel","Any channel",chans.map(c=>[String(c),"ch "+c]));
}
function readFilters(){
  F.kind=$("f-kind").value;F.vendor=$("f-vendor").value;
  F.cls=$("f-class").value;F.grade=$("f-grade").value;
  F.threat=$("f-threat").value;
  F.band=$("f-band").value;F.channel=$("f-channel").value;
  F.q=$("q").value.trim().toLowerCase();
}
function updateBar(){
  const n=FW.length+FB.length+FT.length+FD.length;
  const tot=M.wifi.size+M.ble.size+M.trackers.size+M.drones.size;
  $("exp").textContent=filterActive()?"Export "+n:"Export";
  $("count").innerHTML=filterActive()
    ? "Showing <b>"+n+"</b> of "+tot+" devices â€” Export saves only these"
    : "<b>"+tot+"</b> devices captured";
  const ac=activeCount();
  $("ftog").innerHTML="Filters"+(ac?'<span class="fbadge">'+ac+"</span>":"");
}
function onFilterChange(){readFilters();applyFilter();}

const FSEL=["f-kind","f-vendor","f-class","f-grade","f-threat","f-band","f-channel"];
$("q").oninput=onFilterChange;
FSEL.forEach(id=>$(id).onchange=onFilterChange);
$("ftog").onclick=()=>$("filters").classList.toggle("open");

const SC_TAB_LABELS={"s-banner":"Summary","s-wifi":"Wi-Fi","s-ble":"BLE",
  "s-clusters":"Clusters","s-trackers":"Trackers","s-alerts":"Notifications",
  "s-privacy":"Privacy","s-channel":"Channels","s-raw":"Raw","s-drones":"Drones"};
const SC_HOTLIST_DEFAULT=["s-wifi","s-ble","s-clusters","s-channel"];
function readHotlist(){
  let ids=null;
  try{const v=JSON.parse(localStorage.getItem("sc-hotlist"));
    if(Array.isArray(v))ids=v.filter(id=>SC_TAB_LABELS[id]);}catch(e){}
  return (ids&&ids.length)?ids:SC_HOTLIST_DEFAULT;
}
const hmenu=$("hotmenu");
function buildHotmenu(){
  hmenu.innerHTML=readHotlist().map(id=>
    '<button type="button" role="menuitem" data-h="'+id+'"'+
    (id===curTab?' class="act"':"")+">"+esc(SC_TAB_LABELS[id])+"</button>").join("");
}
$("hotbtn").onclick=()=>{
  if(hmenu.hidden)buildHotmenu();
  hmenu.hidden=!hmenu.hidden;
  $("hotbtn").setAttribute("aria-expanded",hmenu.hidden?"false":"true");
};
hmenu.onclick=e=>{
  const b=e.target.closest("[data-h]");if(!b)return;
  curTab=b.dataset.h;showTab();
  hmenu.hidden=true;$("hotbtn").setAttribute("aria-expanded","false");
};

$("navtog").onclick=()=>{
  const c=document.body.classList.toggle("nav-collapsed");
  $("navtog").textContent=c?"âŒ„ show tabs":"^ hide tabs";
  $("navtog").title=c?"Show tabs":"Hide tabs";
};

let lastScrollY=window.scrollY;
window.addEventListener("scroll",()=>{
  const y=window.scrollY;
  if(y>lastScrollY&&y>60&&!document.body.classList.contains("nav-collapsed")){
    document.body.classList.add("nav-collapsed");
    $("navtog").textContent="âŒ„ show tabs";$("navtog").title="Show tabs";
  }
  lastScrollY=y;
},{passive:true});
$("fclr").onclick=()=>{
  $("q").value="";
  FSEL.forEach(id=>$(id).value="");
  F.cat=[];renderCatChips();
  onFilterChange();
};

function buildExport(){
  const out=[];
  const first=t=>{for(const r of RAW_RECS)if(r.type===t){out.push(r);return;}};
  first("header");first("codebook");
  for(const r of RAW_RECS){
    const k=KIND[r.type];
    if(k&&match(r,k))out.push(r);
  }
  for(const r of RAW_RECS)
    if(r.type==="device_cluster"&&
       (r.members||[]).some(mb=>MATCHED.has(String(mb.mac||"").toLowerCase())))
      out.push(r);
  for(const r of RAW_RECS)
    if(r.type==="alert"){
      const ref=String(r.target_ref||"").toLowerCase();
      if(!filterActive()||MATCHED.has(ref)||
         (F.q&&(r.message||"").toLowerCase().includes(F.q)))out.push(r);
    }
  if(!filterActive())
    for(const r of RAW_RECS)
      if(["probe_req_log","seq_fingerprint_log","ie_signature_log","anqp_log"]
          .includes(r.type))out.push(r);

  if(M.slots.length>1){
    out.push({type:"multiscan_seq",generated_by:"capture_viewer",seq_schema:1,
      captures:SESSIONS.map(s=>s.label),
      slots:M.slots,
      devices:[...M.pres.values()].map(p=>({kind:p.kind,mac:p.mac,
        slots:p.slots,rssi:p.rssiBy,
        presence_conf:(presenceOf(p.kind,p.mac)||{}).conf??null})),
      chains:RC.map(c=>({evidence:c.evidence,rotation:c.rotation,
        overlap_slots:c.overlap,confidence:c.conf,
        members:c.members.map(mb=>({kind:mb.kind,mac:mb.mac,
          first:mb.p.first,last:mb.p.last,slots:mb.p.slots}))}))});
  }
  first("footer");
  return out;
}
function download(name,text,mime){
  const b=new Blob([text],{type:mime||"application/x-ndjson"});
  const u=URL.createObjectURL(b);
  const a=document.createElement("a");
  a.href=u;a.download=name;document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(u),1500);
}

// ---------- multi-format export ----------
// Everything here works on the records already loaded in this browser tab; the
// friendlier formats (CSV/WiGLE) are honest lossy summaries of the same rows the
// report shows, and never invent location the capture did not carry.
function expBase(){
  const sid=(M&&M.header&&M.header.session&&M.header.session.session_id)||"capture";
  return "sniffcheck-"+sid+(filterActive()?"-filtered":"");
}
// A walk (Sniff Walk / Walk Pup) is single-scan-ineligible for WDGWars upload.
function expIsWalk(){
  if(RAW_RECS.some(r=>r&&r.type==="pup_walk"))return true;
  return RAW_RECS.some(r=>r&&(r.type==="wifi_ap"||r.type==="ble_device")&&r.source==="walk");
}
// Served from the device SoftAP (http, no uplink) vs. a saved report opened
// standalone (file://, the browser has its own internet). WDGWars upload needs
// the latter, since the AP page can't reach wdgwars.pl.
function expServedByDevice(){return location.protocol!=="file:"&&deviceOnline();}

function csvEsc(v){
  const s=v==null?"":String(v);
  return /[",\r\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;
}
// Flatten the current filtered Wi-Fi + BLE (+ tracker/drone) view into simple rows.
function expRows(){
  const rows=[];
  for(const r of FW)rows.push({type:"Wi-Fi",name:r.ssid||"",mac:r.bssid||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:r.channel,
    band:r.band_5g?"5GHz":"2.4GHz",auth:r.auth||"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  for(const r of FB)rows.push({type:"BLE",name:r.name||r.fastpair_name||"",mac:r.addr||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:"",band:"BLE",auth:"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  for(const r of FT)rows.push({type:"Tracker",name:fName(r)||"",mac:r.addr||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:"",band:"BLE",auth:"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  for(const r of FD)rows.push({type:"Drone",name:fName(r)||r.id||"",mac:r.addr||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:"",band:"",auth:"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  return rows;
}
function toSummaryCSV(){
  const cols=["type","name","mac","vendor","class","rssi","channel","band",
    "auth","threat","grade"];
  const lines=[cols.join(",")];
  for(const r of expRows())
    lines.push([r.type,r.name,r.mac,r.vendor,r.cls,r.rssi,r.channel,r.band,
      r.auth,r.threat,r.grade].map(csvEsc).join(","));
  return lines.join("\r\n")+"\r\n";
}

// WiGLE / WigleWifi-1.6 CSV â€” same column contract dp_wigle.c writes on the X4,
// so device-scan exports land in WiGLE/WDGWars the same way walk exports do.
const WIGLE_PRE="WigleWifi-1.6,appRelease=1.31.0,model=SniffCheck-C5,"+
  "release=1.31.0,device=esp32c5,display=st7735,board=t-dongle-c5,brand=SniffCheck";
const WIGLE_COLS="MAC,SSID,AuthMode,FirstSeen,Channel,Frequency,RSSI,"+
  "CurrentLatitude,CurrentLongitude,AltitudeMeters,AccuracyMeters,RCOIs,MfgrId,Type";
function chanFreq(ch,band5){
  if(!ch)return "";
  if(band5)return 5000+ch*5;
  return ch===14?2484:2407+ch*5;
}
function wigleAuth(auth,type){
  const a=String(auth||"").toLowerCase();
  if(type!=="Wi-Fi")return "";
  if(a.indexOf("wpa3")>=0)return "[WPA3-SAE][ESS]";
  if(a.indexOf("wpa2")>=0&&a.indexOf("eap")>=0)return "[WPA2-EAP-CCMP][ESS]";
  if(a.indexOf("wpa2")>=0)return "[WPA2-PSK-CCMP][ESS]";
  if(a.indexOf("wpa")>=0)return "[WPA-PSK-TKIP][ESS]";
  if(a.indexOf("wep")>=0)return "[WEP][ESS]";
  return "[ESS]";
}
function wigleTime(){
  const base=(M&&M.header&&M.header.session&&M.header.session.start_us)||null;
  const d=base?new Date(base/1000):new Date();
  const p=n=>String(n).padStart(2,"0");
  return d.getUTCFullYear()+"-"+p(d.getUTCMonth()+1)+"-"+p(d.getUTCDate())+" "+
    p(d.getUTCHours())+":"+p(d.getUTCMinutes())+":"+p(d.getUTCSeconds());
}
function toWigleCSV(loc){
  const lat=loc&&loc.lat!=null?loc.lat:"";
  const lon=loc&&loc.lon!=null?loc.lon:"";
  const ts=wigleTime();
  const lines=[WIGLE_PRE,WIGLE_COLS];
  for(const r of expRows()){
    if(!r.mac)continue;
    const type=r.type==="Wi-Fi"?"WIFI":"BLE";
    lines.push([csvEsc(r.mac),csvEsc(r.name),csvEsc(wigleAuth(r.auth,r.type)),ts,
      r.channel||"",chanFreq(Number(r.channel),r.band==="5GHz"),
      typeof r.rssi==="number"?r.rssi:"",lat,lon,"","",""/*RCOIs*/,
      csvEsc(r.vendor),type].join(","));
  }
  return lines.join("\r\n")+"\r\n";
}

// Save the rendered report as one self-contained offline HTML file: clone this
// document, drop transient overlays, and seed the data island so it reloads the
// exact records on open. No external assets â€” everything is already inline.
function saveReportHTML(){
  const jsonl=RAW_RECS.map(r=>JSON.stringify(r)).join("\n");
  const doc=document.documentElement.cloneNode(true);
  const isl=doc.querySelector("#sc-data");
  if(isl)isl.textContent=jsonl;
  ["#expov","#rcov"].forEach(sel=>{const n=doc.querySelector(sel);if(n)n.remove();});
  const body=doc.querySelector("body");
  if(body){body.classList.remove("bar-hidden");
    body.querySelectorAll("style[data-runtime]").forEach(n=>n.remove());}
  const html="<!doctype html>\n"+doc.outerHTML;
  download(expBase()+".html",html,"text/html");
}

// WDGWars API key lives only in this browser (localStorage), never in exports.
const WDG_KEY="sc-wdgwars-key";
function wdgKeyGet(){try{return localStorage.getItem(WDG_KEY)||"";}catch(e){return "";}}
function wdgKeySet(k){try{k?localStorage.setItem(WDG_KEY,k):localStorage.removeItem(WDG_KEY);}catch(e){}}
function wdgKeyMask(k){return k&&k.length>4?"key ending â€¦"+k.slice(-4):"linked";}

// ---- export menu UI ----
// #expov / #expsheet live after this script in the DOM, so they don't exist at
// load; bind them on first Export click (all render fns run only after that).
let expov=null,expsheet=null;
let expLoc=null; // {lat,lon} user-confirmed device location for this upload
function expClose(){if(expov)expov.hidden=true;expLoc=null;}
let expWired=false;
function expWire(){
  expov=$("expov");expsheet=$("expsheet");
  if(expWired)return;expWired=true;
  expov.addEventListener("click",e=>{if(e.target===expov)expClose();});
  addEventListener("keydown",e=>{if(e.key==="Escape"&&expov&&!expov.hidden)expClose();});
}

function expIcon(id){return '<svg class="exi" aria-hidden="true"><use href="#'+id+'"/></svg>';}
function expOptHTML(id,icon,label,desc,tag,net,dis){
  return '<button class="exopt'+(net?" net":"")+'" data-act="'+id+'"'+
    (dis?" disabled":"")+'>'+expIcon(icon)+
    '<span class="ext"><span class="exl">'+esc(label)+'</span>'+
    '<span class="exd">'+desc+'</span></span>'+
    (tag?'<span class="extag">'+esc(tag)+"</span>":"")+"</button>";
}
function renderExportMenu(){
  const n=expRows().length,walk=expIsWalk(),served=expServedByDevice();
  const filt=filterActive();
  let h="<h3>Export</h3><div class=exsub>"+n+" device"+(n===1?"":"s")+
    (filt?" (current filter)":"")+" Â· everything stays local unless you upload.</div>";
  h+=expOptHTML("report","ic-privacy","Generate report","Tailored, navigable report with presets â€” HTML, PDF, or JSON.","report");
  h+=expOptHTML("json","ic-download","JSON","Full SniffCheck capture â€” recommended for re-import / BYOS.","jsonl");
  h+=expOptHTML("csv","ic-download","CSV","Spreadsheet-friendly device summary. Lossy.","csv");
  h+=expOptHTML("wigle","ic-download","WiGLE","WigleWifi-1.6 CSV for wardrive tools. Location only if you add it.","csv");
  h+=expOptHTML("html","ic-download","HTML","Save this report to view offline, raw details included.","html");
  // WDGWars: single-scan only, and needs internet the device AP can't provide.
  const wdgDis=walk||served;
  const wdgDesc=walk?"Single-scan only â€” walk geotag/upload waits on GPS hardware.":
    served?"Open a saved report off the device (with internet) to upload.":
    "Upload this single scan to WDGWars. Sends data off-device.";
  h+=expOptHTML("wdgwars","ic-cloud","WDGWars",wdgDesc,"upload",true,wdgDis);
  h+='<button class="excancel" data-act="cancel">Cancel</button>';
  expsheet.innerHTML=h;
  expsheet.querySelectorAll(".exopt,.excancel").forEach(b=>
    b.onclick=()=>expRoute(b.dataset.act));
}
function expRoute(act){
  if(act==="cancel"){expClose();return;}
  if(act==="json"){
    const recs=buildExport();
    if(!recs.length){expClose();alert("Nothing to export for this filter.");return;}
    download(expBase()+".jsonl",recs.map(r=>JSON.stringify(r)).join("\n")+"\n");
    expClose();return;}
  if(act==="csv"){download(expBase()+".csv",toSummaryCSV(),"text/csv");expClose();return;}
  if(act==="wigle"){renderWigleForm();return;}
  if(act==="html"){saveReportHTML();expClose();return;}
  if(act==="wdgwars"){renderWdgForm();return;}
  if(act==="report"){renderReportForm();return;}
}

// ===================== Generate Report (tailored HTML / PDF / JSON) =====================
// A clean, navigable document built from the parsed capture â€” distinct from the "HTML"
// option (which clones the whole interactive app). Presets pick sensible section sets;
// the user can then tweak sections, descriptions, and format. Everything is built
// client-side and stays local; PDF is the browser's print-to-PDF on a self-contained doc.
const REP_SECTIONS=[
  {id:"overview",label:"Overview & verdict",has:()=>true},
  {id:"wifi",    label:"Wi-Fi networks",     has:()=>FW.length>0},
  {id:"ble",     label:"BLE devices",        has:()=>FB.length>0},
  {id:"trackers",label:"Trackers",           has:()=>FT.length>0},
  {id:"drones",  label:"Drones (Remote ID)", has:()=>FD.length>0},
  {id:"clusters",label:"Device clusters",    has:()=>{const P=clusterParts();
    return (P.net.length+P.bt.length+P.mr.length+P.veh.length+RC.length)>0;}},
  {id:"privacy", label:"Privacy exposure",   has:()=>PV.length>0||PRIV.some(p=>M.logs[p.k])},
  {id:"alerts",  label:"Notifications",      has:()=>FA.length>0},
  {id:"timeline",label:"Scan timeline & device transference",has:()=>M.slots.length>1},
];
const REP_PRESETS={
  full:    {label:"Full report",           secs:null},
  privacy: {label:"Privacy report",        secs:["overview","privacy","timeline"]},
  wifible: {label:"Wi-Fi / BLE report",    secs:["overview","wifi","ble","timeline"]},
  rfenv:   {label:"RF environment report", secs:["overview","wifi","ble","trackers","drones","clusters","timeline"]},
  sentinel:{label:"Sentinel report",       secs:["overview","alerts","trackers","privacy"]},
};
let repOpts={preset:"full",secs:null,desc:true,fmt:"html"};
function repAvail(){return REP_SECTIONS.filter(s=>s.has());}
function repPresetSecs(preset){
  const avail=repAvail().map(s=>s.id),p=REP_PRESETS[preset];
  return (p&&p.secs?p.secs:avail).filter(id=>avail.indexOf(id)>=0);
}
function repSelected(){
  const avail=new Set(repAvail().map(s=>s.id)),order=REP_SECTIONS.map(s=>s.id);
  return (repOpts.secs||[]).filter(id=>avail.has(id))
    .sort((a,b)=>order.indexOf(a)-order.indexOf(b));
}
// ---- small static-HTML table helpers (all cells pre-escaped by the caller) ----
function repTable(cols,rows){
  if(!rows.length)return '<p class="desc">None.</p>';
  return '<div class="tw"><table><thead><tr>'+cols.map(c=>"<th>"+esc(c[0])+"</th>").join("")+
    "</tr></thead><tbody>"+rows.map(r=>"<tr>"+cols.map(c=>"<td>"+
      (r[c[1]]==null?"":r[c[1]])+"</td>").join("")+"</tr>").join("")+"</tbody></table></div>";
}
function repKV(rows){return '<div class="tw"><table class="kv"><tbody>'+
  rows.map(r=>"<tr><th>"+esc(r[0])+"</th><td>"+esc(String(r[1]))+"</td></tr>").join("")+
  "</tbody></table></div>";}
// ---- per-section builders: each returns {id,title,html} ----
function repOverview(desc){
  let worst=0;for(const r of [...FW,...FB,...FT,...FD])worst=Math.max(worst,r.threat_level||0);
  const rows=[["Wi-Fi networks",FW.length],["BLE devices",FB.length],["Trackers",FT.length],
    ["Drones",FD.length],["Privacy findings",PV.length],
    ["Notifications",FA.reduce((s,a)=>s+(a.n||1),0)],
    ["Worst threat",cb("threat_level",worst).toUpperCase()],
    ["Scans in report",M.slots.length]];
  return {id:"rep-overview",title:"Overview & verdict",
    html:(desc?'<p class="desc">Everything SniffCheck observed passively during this '+
      "capture. Counts reflect "+(filterActive()?"the active filter":"the full capture")+
      ".</p>":"")+repKV(rows)};
}
function repWifi(desc){
  return {id:"rep-wifi",title:"Wi-Fi networks ("+FW.length+")",
    html:(desc?'<p class="desc">Access points and Wi-Fi networks observed.</p>':"")+
    repTable([["SSID","ssid"],["BSSID","bssid"],["Band","band"],["Ch","ch"],["RSSI","rssi"],
      ["Threat","threat"],["Vendor","vendor"]],
      FW.slice(0,600).map(r=>({ssid:esc(r.ssid||"(hidden)"),bssid:esc(r.bssid||""),
        band:r.band_5g?"5 GHz":"2.4 GHz",ch:r.channel==null?"":r.channel,
        rssi:r.rssi==null?"":r.rssi,threat:esc(cb("threat_level",r.threat_level||0)),
        vendor:esc(r.vendor||r.company_name||"")})))};
}
function repBle(desc){
  return {id:"rep-ble",title:"BLE devices ("+FB.length+")",
    html:(desc?'<p class="desc">Bluetooth Low Energy devices observed.</p>':"")+
    repTable([["Name","name"],["Address","addr"],["Category","cat"],["RSSI","rssi"],
      ["Threat","threat"],["Vendor","vendor"]],
      FB.slice(0,600).map(r=>({name:esc(r.name||r.fastpair_name||"â€”"),addr:esc(r.addr||""),
        cat:esc(fCat(r)||""),rssi:r.rssi==null?"":r.rssi,
        threat:esc(cb("threat_level",r.threat_level||0)),
        vendor:esc(r.vendor||r.company_name||"")})))};
}
function repTrackers(desc){
  return {id:"rep-trackers",title:"Trackers ("+FT.length+")",
    html:(desc?'<p class="desc">Find My / DULT-class and other trackers. â€œSeparatedâ€ '+
      "tags are away from their owner.</p>":"")+
    repTable([["Name","name"],["Address","addr"],["Kind","kind"],["RSSI","rssi"]],
      FT.slice(0,300).map(r=>({name:esc(r.name||"â€”"),addr:esc(r.addr||fMac(r)||""),
        kind:esc(r.tracker_kind||""),rssi:r.rssi==null?"":r.rssi})))};
}
function repDrones(desc){
  return {id:"rep-drones",title:"Drones ("+FD.length+")",
    html:(desc?'<p class="desc">Remote ID broadcasts from nearby drones.</p>':"")+
    repTable([["ID","id"],["Address","addr"],["RSSI","rssi"]],
      FD.slice(0,200).map(r=>({id:esc(r.uas_id||r.id||r.description||"â€”"),
        addr:esc(fMac(r)||r.mac||""),rssi:r.rssi==null?"":r.rssi})))};
}
function repClusters(desc){
  const P=clusterParts();
  let h=(desc?'<p class="desc">Separate addresses that evidence ties to one device or '+
    "product. Rotation chains show a single device changing its MAC across scans.</p>":"")+
    repKV([["Wi-Fi (NIC) clusters",P.net.length],["BLE (NIC) clusters",P.bt.length],
      ["Multi-radio access points",P.mr.length],["Vehicles",P.veh.length],
      ["Address-rotation chains",RC.length]].filter(r=>r[1]));
  if(RC.length)h+="<h3>Address-rotation chains (device transference)</h3>"+
    repTable([["Addresses","n"],["Evidence","e"],["Confidence","c"]],
      RC.map(c=>({n:c.members.length,e:esc(c.evidence),c:c.conf+"%"})));
  return {id:"rep-clusters",title:"Device clusters",html:h};
}
function repPrivacy(desc){
  let h=(desc?'<p class="desc">Passive identifiers that can re-link a device across '+
    "randomized MACs, or reveal remembered networks.</p>":"");
  const anlz=PRIV.filter(p=>M.logs[p.k]).map(p=>{const d=M.logs[p.k],det=d&&(d.detail||d.stations);
    return [p.label,Array.isArray(det)?det.length:0];});
  h+=repKV([["Devices leaking identity",PV.length],...anlz]);
  if(PV.length)h+="<h3>Devices with leaks</h3>"+
    repTable([["Identity","id"],["MAC","mac"],["Leaks","n"]],
      PV.slice(0,300).map(e=>({id:esc(e.ident?e.ident.s:"â€”"),mac:esc(e.mac),n:e.items.length})));
  if(desc){const g=PRIV.filter(p=>M.logs[p.k]&&p.act);
    if(g.length)h+='<h3>What you can do</h3><ul class="guide">'+
      g.map(p=>"<li><b>"+esc(p.label)+".</b> "+esc(p.act)+"</li>").join("")+"</ul>";}
  return {id:"rep-privacy",title:"Privacy exposure",html:h};
}
function repAlerts(desc){
  return {id:"rep-alerts",title:"Notifications ("+FA.reduce((s,a)=>s+(a.n||1),0)+")",
    html:(desc?'<p class="desc">Rule-based notifications raised during the capture.</p>':"")+
    repTable([["Severity","sev"],["Message","msg"],["Rule","rule"],["Count","n"]],
      FA.map(a=>({sev:esc(a.rec.severity||""),msg:esc(a.rec.message||a.rec.rule_id||""),
        rule:esc(a.rec.rule_id||""),n:a.n||1})))};
}
function repTimeline(desc){
  const tot=M.slots.length;
  const per=new Array(tot).fill(0),first=new Array(tot).fill(0),last=new Array(tot).fill(0);
  let stable=0,transient=0;
  for(const p of M.pres.values()){
    for(const s of p.slots)per[s]++;
    first[p.slots[0]]++;last[p.slots[p.slots.length-1]]++;
    const n=p.slots.length;
    if(n>=Math.max(2,Math.ceil(tot*0.8)))stable++;if(n===1)transient++;}
  let h=(desc?'<p class="desc">How the device population changed across '+tot+" scans. "+
    "â€œNewâ€ and â€œLeft afterâ€ are the discrepancies between consecutive passes; "+
    "rotation chains are the same device changing address (transference).</p>":"");
  h+=repTable([["Scan","s"],["Devices","d"],["New","n"],["Left after","l"]],
    M.slots.map((k,i)=>({s:"#"+(i+1),d:per[i],n:i>0?"+"+first[i]:"â€”",
      l:i<tot-1?"âˆ’"+last[i]:"â€”"})));
  h+=repKV([["Stable devices (â‰¥80% of scans)",stable],["Transient (seen once)",transient],
    ["Address-rotation chains",RC.length]]);
  if(SESSIONS.length>1)h+='<p class="desc">Captures aggregated: '+
    esc(SESSIONS.map(s=>String(s.label).split(" Â· ")[0]).join(", "))+".</p>";
  return {id:"rep-timeline",title:"Scan timeline & device transference",html:h};
}
const REP_BUILD={overview:repOverview,wifi:repWifi,ble:repBle,trackers:repTrackers,
  drones:repDrones,clusters:repClusters,privacy:repPrivacy,alerts:repAlerts,timeline:repTimeline};
function repHead(label){
  const h=M.header||{},d=h.device||{},s=h.session||{};
  return '<header id="top"><h1>'+esc(label)+"</h1>"+
    '<p class="meta">SniffCheck Â· '+esc((d.model||"?")+" / "+(d.chip||"?"))+
    " Â· fw "+esc(d.fw_version||"?")+"</p>"+
    '<p class="meta">Session '+esc(s.session_id||"?")+" Â· "+esc(fmtTs(s.start_us))+
    " Â· "+M.slots.length+" scan"+(M.slots.length===1?"":"s")+
    (SESSIONS.length>1?" Â· "+SESSIONS.length+" captures":"")+"</p>"+
    '<p class="meta gen">Generated '+esc(new Date().toLocaleString())+
    (filterActive()?" Â· filtered view":"")+"</p></header>";
}
function reportCss(){return "*{box-sizing:border-box}body{margin:0 auto;max-width:900px;"+
  "padding:24px;font:15px/1.55 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;"+
  "color:#1a1a1a;background:#fff}header{border-bottom:3px solid #b45309;padding-bottom:12px}"+
  "h1{margin:0 0 4px;font-size:24px}.meta{margin:2px 0;color:#666;font-size:13px}"+
  ".meta.gen{font-size:12px}.toc{background:#faf7f2;border:1px solid #d8d2c8;border-radius:8px;"+
  "padding:12px 18px;margin:16px 0}.toc h2{margin:0 0 6px;font-size:13px;text-transform:uppercase;"+
  "letter-spacing:.5px;color:#666}.toc ol{margin:0;padding-left:20px}.toc a{color:#b45309;"+
  "text-decoration:none}.toc a:hover{text-decoration:underline}section{margin:22px 0}"+
  "section h2{font-size:19px;border-bottom:2px solid #d8d2c8;padding-bottom:4px}"+
  "section h3{font-size:15px;margin:16px 0 6px}.desc{color:#555;font-size:13.5px}"+
  ".tw{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px;margin:8px 0}"+
  "th,td{border:1px solid #d8d2c8;padding:5px 8px;text-align:left;vertical-align:top;"+
  "word-break:break-word}thead th{background:#f3efe9}table.kv th{width:44%;background:#faf7f2}"+
  ".guide{font-size:13.5px}.backtop{font-size:12px;margin:6px 0 0}.backtop a{color:#888;"+
  "text-decoration:none}footer{margin-top:28px;border-top:1px solid #d8d2c8;padding-top:10px;"+
  "color:#666;font-size:12px}@media print{body{padding:0;max-width:none}.backtop{display:none}"+
  ".toc{break-inside:avoid}tr{break-inside:avoid}@page{margin:14mm}}";}
function reportDoc(){
  const secs=repSelected(),desc=repOpts.desc,preset=REP_PRESETS[repOpts.preset]||{label:"Report"};
  const parts=secs.map(id=>REP_BUILD[id](desc)).filter(Boolean);
  const toc='<nav class="toc"><h2>Contents</h2><ol>'+parts.map(p=>
    '<li><a href="#'+p.id+'">'+esc(p.title)+"</a></li>").join("")+"</ol></nav>";
  const body=repHead(preset.label)+toc+parts.map(p=>'<section id="'+p.id+'"><h2>'+
    esc(p.title)+"</h2>"+p.html+'<p class="backtop"><a href="#top">â†‘ back to top</a></p></section>').join("")+
    "<footer>Generated by SniffCheck â€” observation-only passive RF report. "+
    "All data stayed on your device.</footer>";
  return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"+
    '<meta name="viewport" content="width=device-width,initial-scale=1">'+
    "<title>"+esc(preset.label)+" â€” SniffCheck</title><style>"+reportCss()+
    "</style></head><body>"+body+"</body></html>";
}
function reportJSON(){
  const secs=repSelected(),h=M.header||{},d=h.device||{},s=h.session||{};
  const pick=(r,f)=>{const o={};for(const k of f)o[k]=r[k];return o;};
  const o={tool:"SniffCheck",generated:new Date().toISOString(),preset:repOpts.preset,
    filtered:filterActive(),device:{model:d.model,chip:d.chip,fw:d.fw_version},
    session:{id:s.session_id,start_us:s.start_us,scans:M.slots.length,captures:SESSIONS.length},
    sections:{}};
  const S=o.sections;
  if(secs.includes("overview")){let w=0;for(const r of [...FW,...FB,...FT,...FD])w=Math.max(w,r.threat_level||0);
    S.overview={wifi:FW.length,ble:FB.length,trackers:FT.length,drones:FD.length,
      privacy:PV.length,notifications:FA.reduce((a,x)=>a+(x.n||1),0),worst_threat:cb("threat_level",w)};}
  if(secs.includes("wifi"))S.wifi=FW.map(r=>pick(r,["ssid","bssid","channel","band_5g","rssi","threat_level","vendor"]));
  if(secs.includes("ble"))S.ble=FB.map(r=>pick(r,["name","addr","rssi","threat_level","vendor"]));
  if(secs.includes("trackers"))S.trackers=FT.map(r=>pick(r,["name","addr","rssi","tracker_kind"]));
  if(secs.includes("drones"))S.drones=FD.map(r=>pick(r,["uas_id","id","mac","rssi"]));
  if(secs.includes("clusters")){const P=clusterParts();
    S.clusters={nic_wifi:P.net.length,nic_ble:P.bt.length,radio:P.mr.length,vehicles:P.veh.length,
      rotation_chains:RC.map(c=>({addresses:c.members.length,evidence:c.evidence,confidence:c.conf}))};}
  if(secs.includes("privacy"))S.privacy={
    devices:PV.map(e=>({mac:e.mac,identity:e.ident?e.ident.s:null,leaks:e.items.length})),
    analyzers:PRIV.filter(p=>M.logs[p.k]).map(p=>{const dd=M.logs[p.k],det=dd&&(dd.detail||dd.stations);
      return {label:p.label,records:Array.isArray(det)?det.length:0};})};
  if(secs.includes("alerts"))S.notifications=FA.map(a=>({severity:a.rec.severity,
    message:a.rec.message||a.rec.rule_id,rule:a.rec.rule_id,count:a.n||1}));
  if(secs.includes("timeline")){const tot=M.slots.length,per=new Array(tot).fill(0),
    first=new Array(tot).fill(0),last=new Array(tot).fill(0);
    for(const p of M.pres.values()){for(const sl of p.slots)per[sl]++;
      first[p.slots[0]]++;last[p.slots[p.slots.length-1]]++;}
    S.timeline={scans:tot,per_scan_devices:per,new_by_scan:first,left_by_scan:last,rotation_chains:RC.length};}
  return o;
}
function reportPrint(doc){
  const w=window.open("","_blank");
  if(!w){toast("Allow pop-ups to print/PDF â€” or use HTML export instead.");return;}
  w.document.open();w.document.write(doc);w.document.close();w.focus();
  const go=()=>{try{w.print();}catch(e){}};
  if(w.document.readyState==="complete")setTimeout(go,350);
  else w.addEventListener("load",()=>setTimeout(go,350));
}
function buildReport(){
  if(repOpts.fmt==="json"){
    download(expBase()+"-report.json",JSON.stringify(reportJSON(),null,2),"application/json");
    expClose();return;}
  const doc=reportDoc();
  if(repOpts.fmt==="pdf"){reportPrint(doc);return;}   // keep sheet open in case of popup block
  download(expBase()+"-report.html",doc,"text/html");expClose();
}
function renderReportForm(){
  const avail=repAvail();
  if(!repOpts.secs)repOpts.secs=repPresetSecs(repOpts.preset);
  let h='<button class="exback" data-act=back>â€¹ Export</button><h3>Generate report</h3>'+
    '<div class=exsub>A clean, navigable report â€” pick a preset, choose sections, export.</div>';
  h+='<label>Preset</label><div class="repsegs">'+Object.keys(REP_PRESETS).filter(k=>
    k!=="sentinel"||clusterOn())    // "Sentinel report" is cluster-branded â€” hide off-cluster
    .map(k=>
    '<button type="button" class="repseg'+(repOpts.preset===k?" on":"")+'" data-preset="'+k+
    '">'+esc(REP_PRESETS[k].label.replace(" report",""))+"</button>").join("")+"</div>";
  h+='<label>Sections</label><div class="repsecs">'+avail.map(s=>
    '<label class="repchk"><input type="checkbox" data-sec="'+s.id+'"'+
    (repOpts.secs.indexOf(s.id)>=0?" checked":"")+"> "+esc(s.label)+"</label>").join("")+"</div>";
  h+='<label class="repchk repdescrow"><input type="checkbox" id="repdesc"'+
    (repOpts.desc?" checked":"")+"> Include descriptions &amp; guidance</label>";
  h+='<label>Format</label><div class="repsegs">'+
    [["html","HTML"],["pdf","PDF (print)"],["json","JSON"]].map(f=>
      '<button type="button" class="repseg'+(repOpts.fmt===f[0]?" on":"")+'" data-fmt="'+
      f[0]+'">'+f[1]+"</button>").join("")+"</div>";
  h+='<button class="exgo" data-act=gen>Generate report</button>';
  h+='<div class=exnote>HTML is one self-contained file. PDF opens a print view â€” choose '+
    "â€œSave as PDFâ€. JSON is structured data. Everything stays on your device.</div>";
  expsheet.innerHTML=h;
  expsheet.querySelector("[data-act=back]").onclick=renderExportMenu;
  expsheet.querySelectorAll("[data-preset]").forEach(b=>b.onclick=()=>{
    repOpts.preset=b.dataset.preset;repOpts.secs=repPresetSecs(repOpts.preset);renderReportForm();});
  expsheet.querySelectorAll("[data-sec]").forEach(c=>c.onchange=()=>{
    const id=c.dataset.sec;
    if(c.checked){if(repOpts.secs.indexOf(id)<0)repOpts.secs.push(id);}
    else repOpts.secs=repOpts.secs.filter(x=>x!==id);});
  expsheet.querySelector("#repdesc").onchange=e=>{repOpts.desc=e.target.checked;};
  expsheet.querySelectorAll("[data-fmt]").forEach(b=>b.onclick=()=>{
    repOpts.fmt=b.dataset.fmt;renderReportForm();});
  expsheet.querySelector("[data-act=gen]").onclick=()=>{
    if(!repSelected().length){toast("Pick at least one section.");return;}
    buildReport();};
}

// Shared device-location capture (browser geolocation or manual entry), used by
// the WiGLE and WDGWars flows. Never auto-collected â€” only when the user asks.
function locFieldsHTML(){
  return '<label>Device location (optional)</label>'+
    '<div class=exrow><input id=exlat type=text inputmode=decimal placeholder=latitude '+
    (expLoc?'value="'+esc(expLoc.lat)+'"':"")+'>'+
    '<input id=exlon type=text inputmode=decimal placeholder=longitude '+
    (expLoc?'value="'+esc(expLoc.lon)+'"':"")+'></div>'+
    '<button class="excancel" style="margin-top:8px" data-loc=geo>Use my phone location</button>';
}
function locWire(statEl){
  const geo=expsheet.querySelector('[data-loc=geo]');
  if(geo)geo.onclick=()=>{
    if(!navigator.geolocation){statEl.textContent="Geolocation unavailable.";statEl.className="exstat err";return;}
    statEl.textContent="Locatingâ€¦";statEl.className="exstat";
    navigator.geolocation.getCurrentPosition(p=>{
      expsheet.querySelector("#exlat").value=p.coords.latitude.toFixed(6);
      expsheet.querySelector("#exlon").value=p.coords.longitude.toFixed(6);
      statEl.textContent="Location added.";statEl.className="exstat ok";
    },e=>{statEl.textContent="Location denied.";statEl.className="exstat err";},
    {enableHighAccuracy:true,timeout:10000});
  };
}
function readLoc(){
  const la=expsheet.querySelector("#exlat"),lo=expsheet.querySelector("#exlon");
  const lat=la&&la.value.trim(),lon=lo&&lo.value.trim();
  if(!lat&&!lon)return null;
  const nlat=Number(lat),nlon=Number(lon);
  if(!isFinite(nlat)||!isFinite(nlon))return {bad:true};
  return {lat:nlat,lon:nlon};
}
function renderWigleForm(){
  let h='<button class="exback" data-act=back>â€¹ Export</button>'+
    "<h3>WiGLE CSV</h3><div class=exsub>WigleWifi-1.6. Add a device location, or "+
    "leave blank for a no-location file.</div>";
  h+=locFieldsHTML();
  h+='<button class="exgo" data-act=go>Download WiGLE CSV</button>';
  h+='<div class="exstat" id=exstat></div>';
  h+='<div class=exnote>Location is honest: blank unless you add it. Walks are not '+
     "geotagged from a single point.</div>";
  expsheet.innerHTML=h;
  const stat=$("exstat");
  expsheet.querySelector('[data-act=back]').onclick=renderExportMenu;
  locWire(stat);
  expsheet.querySelector('[data-act=go]').onclick=()=>{
    const loc=readLoc();
    if(loc&&loc.bad){stat.textContent="Latitude/longitude must be numbers.";stat.className="exstat err";return;}
    download(expBase()+".wigle.csv",toWigleCSV(loc),"text/csv");
    expClose();
  };
}
function renderWdgForm(){
  const key=wdgKeyGet();
  let h='<button class="exback" data-act=back>â€¹ Export</button>'+
    "<h3>Upload to WDGWars</h3><div class=exsub>Sends this single scan to "+
    "wdgwars.pl as a WigleWifi CSV. Single-scan only.</div>";
  h+='<div class=exform>';
  if(key){
    h+='<div style="font-weight:700;font-size:12.5px">WDGWars: linked ('+esc(wdgKeyMask(key))+')</div>'+
      '<button class="excancel" style="margin-top:8px" data-act=clearkey>Clear saved key</button>';
  }else{
    h+='<label>WDGWars API key</label><input id=exkey type=password '+
      'autocomplete=off placeholder="X-API-Key">';
  }
  h+=locFieldsHTML();
  h+='<button class="exgo" data-act=go'+(key?"":" disabled")+'>Review &amp; upload</button>';
  h+='<div class="exstat" id=exstat></div>';
  h+='<div class=exnote>Your key is stored only in this browser and never written '+
     "into any exported file. Uploading sends the selected scan data to WDGWars.</div>";
  h+="</div>";
  expsheet.innerHTML=h;
  const stat=$("exstat");
  expsheet.querySelector('[data-act=back]').onclick=renderExportMenu;
  locWire(stat);
  const clr=expsheet.querySelector('[data-act=clearkey]');
  if(clr)clr.onclick=()=>{wdgKeySet("");renderWdgForm();};
  const keyIn=expsheet.querySelector("#exkey"),go=expsheet.querySelector('[data-act=go]');
  if(keyIn)keyIn.oninput=()=>{go.disabled=!keyIn.value.trim();};
  go.onclick=()=>{
    let k=key;
    if(keyIn){k=keyIn.value.trim();if(!k)return;wdgKeySet(k);}
    const loc=readLoc();
    if(loc&&loc.bad){stat.textContent="Latitude/longitude must be numbers.";stat.className="exstat err";return;}
    doWdgUpload(k,loc,stat,go);
  };
}
function doWdgUpload(key,loc,stat,go){
  const csv=toWigleCSV(loc);
  stat.textContent="Uploadingâ€¦";stat.className="exstat";go.disabled=true;
  const fd=new FormData();
  fd.append("file",new Blob([csv],{type:"text/csv"}),"wardrive.csv");
  fetch("https://wdgwars.pl/api/v2/upload-csv",{method:"POST",
    headers:{"X-API-Key":key},body:fd})
    .then(r=>{
      if(r.ok){stat.textContent="Upload complete.";stat.className="exstat ok";
        go.disabled=false;return;}
      stat.textContent="Upload failed (HTTP "+r.status+"). Your WiGLE CSV download "+
        "still works for manual upload.";stat.className="exstat err";go.disabled=false;
    })
    .catch(()=>{stat.textContent="Could not reach WDGWars. If this phone is on the "+
      "SniffCheck AP it has no internet â€” download the WiGLE CSV and upload it "+
      "yourself.";stat.className="exstat err";go.disabled=false;});
}
$("exp").onclick=()=>{
  if(!M||!RAW_RECS.length){alert("Load a capture first.");return;}
  expWire();
  renderExportMenu();
  expov.hidden=false;
};

let RAW_RECS=[];

let SESSIONS=[];
let DEVICE_SESSION=-1;   // index of the session mirroring the device's live ring
function combinedRecs(){
  const recs=[];let bad=0;
  SESSIONS.forEach((s,si)=>{
    bad+=s.bad;
    for(const r of s.recs){r._sess=si;recs.push(r);}
  });
  return {recs,bad};
}
function srcLabel(){
  if(SESSIONS.length===1)return SESSIONS[0].label;
  return SESSIONS.length+" captures aggregated Â· "+
    SESSIONS.map(s=>String(s.label).split(" Â· ")[0]).join(" + ");
}
function renderAll(){
  const {recs,bad}=combinedRecs();
  RAW_RECS=recs;
  M=buildModel(recs,bad);
  $("srcinfo").textContent=srcLabel();
  $("drop").style.display="none";
  $("app").style.display="block";
  $("bar").style.display="block";
  $("addcap").style.display="";
  // Refresh only makes sense when served live from a device (not a file:// report).
  $("refbtn").style.display=deviceOnline()?"":"none";
  populateFilters();
  readFilters();
  applyFilter();
  clusterProbe();   // reveal cluster-only blocks only when a live cluster backend answers
}

function loadText(text,label){
  const {recs,bad}=parseCapture(text);
  if(!recs.length){
    alert("No capture records found in that file"+(bad?" ("+bad+
      " unparseable lines)":"")+".");
    return;
  }
  SESSIONS.push({label,recs,bad});
  renderAll();
}

// SniffCheck-native record types. A native capture always carries at least one
// of these; a foreign wardrive dump never does. Used to route Import.
const NATIVE_TYPES={header:1,footer:1,codebook:1,wifi_ap:1,ble_device:1,tracker:1,
  drone_rid:1,device_cluster:1,alert:1,station_log:1,probe_req_log:1,
  seq_fingerprint_log:1,ie_signature_log:1,anqp_log:1,channel_activity:1,
  pcap_capture:1,pup_walk:1,csi:1,crowd_density:1,multiscan_seq:1,
  environment_indicators:1,law_enforcement_presence:1,medical_responder_presence:1,
  ble_addr_stats:1};
function looksNative(recs){
  for(let i=0;i<recs.length&&i<300;i++)if(recs[i]&&NATIVE_TYPES[recs[i].type])return true;
  return false;
}
function deviceOnline(){return location.protocol==="http:"||location.protocol==="https:";}

// ---- foreign wardrive carve (ported from the on-device BYOS "Carve") ----
// Produces the same tab-separated W/B/M lines /api/byos/sniffcheck consumes.
function bynorm(m){var h=String(m==null?"":m).replace(/[^0-9A-Fa-f]/g,"").toUpperCase();
  return h.length==12?h.match(/../g).join(":"):"";}
function bysan(v,n){return String(v==null?"":v).replace(/[\t\r\n]+/g," ").trim().slice(0,n);}
function bysrcname(fn){var b=String(fn||"").replace(/\.[^.]*$/,"");return bysan(b,16)||"src";}
function byhasmac(o){var ks=Object.keys(o);for(var i=0;i<ks.length;i++){var lp=ks[i].toLowerCase().split(".").pop();
  if((lp=="mac"||lp=="bssid"||lp=="macaddr"||lp=="addr"||lp=="address")&&bynorm(o[ks[i]]))return true;}return false;}
function byfield(o,names,d){if(!o||typeof o!="object"||d>4)return undefined;var ks=Object.keys(o);
  for(var n=0;n<names.length;n++){for(var i=0;i<ks.length;i++){var kl=ks[i].toLowerCase();
    if(kl==names[n]||kl.split(".").pop()==names[n]){var v=o[ks[i]];if(v!=null&&v!==""&&typeof v!="object")return v;}}}
  for(var i=0;i<ks.length;i++){var v=o[ks[i]];if(v&&typeof v=="object"&&!Array.isArray(v)){var r=byfield(v,names,(d||0)+1);if(r!==undefined)return r;}}return undefined;}
function byrec(o,dsrc){var mac=bynorm(byfield(o,["mac","bssid","macaddr","addr","address"],0));if(!mac)return null;
  var typ=String(byfield(o,["type","phyname","phy","technology"],0)||"").toLowerCase();
  var ssid=byfield(o,["ssid","essid"],0),name=byfield(o,["name","local_name","devname","commonname"],0);
  var ch=parseInt(byfield(o,["channel","chan"],0),10),rssi=parseInt(byfield(o,["rssi","signal","signal_dbm","last_signal","bestlevel"],0),10);
  var auth=byfield(o,["authtype","authmode","auth","capabilities","encryption","security","crypt"],0);
  var w=/wifi|wlan|802\.11|ieee/.test(typ),b=/ble|bt|bluetooth/.test(typ);
  var isw=w||(!b&&(ssid!=null||auth!=null)),isb=b||(!w&&!isw&&name!=null);
  var src=bysan(byfield(o,["source_id","source","node","node_id","sensor","observer"],0),16)||dsrc||"local";
  var lat=bysan(byfield(o,["lat","latitude","trilat","currentlatitude"],0),16);
  var lon=bysan(byfield(o,["lon","lng","longitude","trilong","currentlongitude"],0),16);
  var ts=bysan(byfield(o,["time","timestamp","lasttime","firsttime","firstseen","lastseen"],0),16);
  if(isw)return ["W",mac,bysan(ssid!=null?ssid:name,32),isNaN(ch)?"":ch,isNaN(rssi)?"":rssi,bysan(auth,23),src,lat,lon,ts].join("\t");
  if(isb)return ["B",mac,bysan(name,32),isNaN(rssi)?"":rssi,src,lat,lon,ts].join("\t");
  return ["M",mac,src,lat,lon,ts].join("\t");}
function bywalk(node,out){if(Array.isArray(node)){for(var i=0;i<node.length;i++)bywalk(node[i],out);return;}
  if(node&&typeof node=="object"){if(byhasmac(node)){out.push(node);return;}var ks=Object.keys(node);for(var i=0;i<ks.length;i++)bywalk(node[ks[i]],out);}}
function bysplit(l){var o=[],c="",q=false;for(var i=0;i<l.length;i++){var ch=l[i];
  if(q){if(ch=='"'){if(l[i+1]=='"'){c+='"';i++;}else q=false;}else c+=ch;}
  else if(ch=='"')q=true;else if(ch==","){o.push(c);c="";}else c+=ch;}o.push(c);return o;}
function bycsv(s,dsrc){var ls=s.split(/\r?\n/),h=-1,cols=[];
  for(var i=0;i<ls.length;i++){var fs=bysplit(ls[i]).map(function(x){return x.trim().toLowerCase();});
    if(fs.indexOf("mac")>=0||fs.indexOf("bssid")>=0){h=i;cols=fs;break;}}
  if(h<0)return [];var recs=[];
  for(var i=h+1;i<ls.length;i++){if(!ls[i].trim())continue;var fs=bysplit(ls[i]),o={};
    for(var j=0;j<cols.length;j++)if(j<fs.length)o[cols[j]]=fs[j];var r=byrec(o,dsrc);if(r)recs.push(r);}return recs;}
function bysrcof(p){return p[0]=="W"?p[6]:p[0]=="B"?p[4]:p[2];}
function byone(s,dsrc,seen,out,cnt){var objs=[],recs=[];
  try{objs.push(JSON.parse(s));}catch(e){var ls=s.split(/\r?\n/);for(var i=0;i<ls.length;i++){var t=ls[i].trim();
    if(t&&(t[0]=="{"||t[0]=="[")){try{objs.push(JSON.parse(t));}catch(e2){}}}}
  if(objs.length){var found=[];for(var i=0;i<objs.length;i++)bywalk(objs[i],found);
    for(var i=0;i<found.length;i++){var r=byrec(found[i],dsrc);if(r)recs.push(r);}}
  if(!recs.length)recs=bycsv(s,dsrc);
  for(var i=0;i<recs.length;i++){var p=recs[i].split("\t"),mac=p[1];if(!mac)continue;
    var k=mac+"|"+(bysrcof(p)||dsrc);if(seen[k])continue;seen[k]=1;out.push(recs[i]);
    if(p[0]=="W")cnt[0]++;else if(p[0]=="B")cnt[1]++;else cnt[2]++;}
  var re=/(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}|\b[0-9A-Fa-f]{12}\b/g,m;
  while((m=re.exec(s))){var x=bynorm(m[0]);if(!x)continue;var k=x+"|"+dsrc;if(!seen[k]){seen[k]=1;out.push(["M",x,dsrc,"","",""].join("\t"));cnt[2]++;}}}

// Native SniffCheck captures aggregate locally; foreign scans are carved and
// re-decoded by a connected SniffCheck, then folded into the cross-scan view.
function importFiles(files){
  const arr=[...files];
  let pending=arr.length;
  if(!pending)return;
  let added=false;
  const seen={},carved=[],cnt=[0,0,0],foreignNames=[];
  const finish=()=>{
    if(added)renderAll();
    if(!carved.length){
      if(!added)alert("No capture records found in the selected file(s).");
      return;
    }
    if(!deviceOnline()){
      alert(carved.length+" external sighting(s) carved from "+foreignNames.join(", ")+
        ".\n\nImporting a Biscuit/Wigle/Kismet/wardriver scan needs a live SniffCheck to "+
        "re-decode it â€” open this report from the SniffCheck AP (http://â€¦/report.html) and "+
        "import again. Native SniffCheck exports (.jsonl/.ndjson) can be added offline.");
      return;
    }
    importCarved(carved,foreignNames,cnt);
  };
  arr.forEach(f=>{
    const rd=new FileReader();
    rd.onload=()=>{
      const text=String(rd.result||"");
      const pr=parseCapture(text);
      if(pr.recs.length&&looksNative(pr.recs)){
        SESSIONS.push({label:f.name+" Â· "+(f.size/1024).toFixed(1)+" KB",recs:pr.recs,bad:pr.bad});
        added=true;
      }else{
        byone(text,bysrcname(f.name),seen,carved,cnt);
        foreignNames.push(f.name);
      }
      if(--pending===0)finish();
    };
    rd.onerror=()=>{if(--pending===0)finish();};
    rd.readAsText(f);
  });
}

// POST carved lines to the device, which re-decodes against eui.db (and replaces
// its volatile ring). Pull the decoded records back as one cross-scan session.
function importCarved(lines,names,cnt){
  const label=names.join(", ");
  fetch("/api/byos/sniffcheck",{method:"POST",
      headers:{"Content-Type":"text/plain"},body:lines.join("\n")})
    .then(r=>r.json().then(j=>{if(!r.ok)throw new Error(j.error||"import failed");return j;}))
    .then(j=>fetch("/api/captures/live.jsonl").then(r=>r.text()).then(txt=>{
      const pr=parseCapture(txt);
      if(!pr.recs.length)throw new Error("import produced no records");
      // Additive: the device ring now holds the prior capture + this import as a
      // new scan pass, so mirror the whole ring into the one device session
      // (replace, don't duplicate the pre-existing records).
      const sess={label:"SniffCheck device Â· +"+label+" ("+
        (j.wifi||0)+" Wi-Fi, "+(j.ble||0)+" BLE, "+(j.mac_only||0)+" MAC-only imported)",
        recs:pr.recs,bad:pr.bad};
      if(DEVICE_SESSION>=0&&DEVICE_SESSION<SESSIONS.length)SESSIONS[DEVICE_SESSION]=sess;
      else{SESSIONS.push(sess);DEVICE_SESSION=SESSIONS.length-1;}
      renderAll();
    }))
    .catch(e=>alert("External import failed: "+(e.message||e)));
}

const drop=$("drop"),fpick=$("fpick");
drop.onclick=()=>fpick.click();
fpick.onchange=()=>{
  if(fpick.files.length)importFiles(fpick.files);
  fpick.value="";
};
$("addcap").onclick=()=>fpick.click();

// Refresh: re-pull the device's current results (served from the head's uncapped SD
// store) and fold them back into the device session, so a scan or walk shows up
// without reloading the page. Mirrors importCarved's session-replace so we never
// duplicate the pre-existing device records.
function refreshDevice(){
  const b=$("refbtn");if(!b||b.disabled)return;
  // When the cluster accumulator owns the device session, a full-ring replace would
  // clobber the results it has offloaded from PSRAM. Force an incremental pull instead.
  if(ACC_ON){
    const label=b.textContent;b.disabled=true;b.textContent="Refreshingâ€¦";
    // Turn the cluster blocks OFF for the duration of the pull, then back ON. Those blocks each
    // hold one of the ESP32's few HTTP sockets, starving accPull's request; suspending them
    // (and disabling their controls) lets the refresh get through, then we resume.
    const wasPolling=DP.started;
    dpBusy(true);
    accPull().finally(()=>{
      b.disabled=false;b.textContent=label;
      dpBusy(false);if(wasPolling)dpSchedule(300);
    });
    return;
  }
  const label=b.textContent;b.disabled=true;b.textContent="Refreshingâ€¦";
  dpBusy(true);
  fetch("/api/captures/live.jsonl",{cache:"no-store"})
    .then(r=>{if(!r.ok)throw new Error("device did not answer");return r.text();})
    .then(txt=>{
      const pr=parseCapture(txt);
      if(!pr.recs.length)throw new Error("no records returned");
      const sess={label:"SniffCheck device",recs:pr.recs,bad:pr.bad};
      if(DEVICE_SESSION>=0&&DEVICE_SESSION<SESSIONS.length)SESSIONS[DEVICE_SESSION]=sess;
      else{SESSIONS.push(sess);DEVICE_SESSION=SESSIONS.length-1;}
      renderAll();
    })
    .catch(e=>alert("Refresh failed: "+(e.message||e)))
    .finally(()=>{b.disabled=false;b.textContent=label;
      dpBusy(false);if(DP.started)dpSchedule(300);});
}
$("refbtn").onclick=refreshDevice;

// ==== Cluster result accumulator (IndexedDB offload) ==========================
// Problem: the brain serves report.html from a PSRAM ring that drop_oldest()s under
// load, so a long walk with thousands of sightings silently loses the earliest ones.
// Fix: the browser becomes the durable accumulator for THIS scan session. We pull
// only NEW records from the ring (GET /api/captures/live.jsonl?since=<cursor>, which
// the firmware skips server-side) and persist them to IndexedDB, deduped by device
// identity. The ring can evict freely; the browser keeps everything it has seen, so
// the results view keeps climbing past what PSRAM holds. Cluster-only: kicked off
// from dpPoll once /api/cluster/status confirms a cluster, so the standalone
// one-shot report is untouched. Per-scan-session: the store is keyed by the firmware
// session id (X-SC-Session) and cleared when that changes.
const RS_DB="sc-results",RS_RECS="recs",RS_META="meta";
let ACC_ON=false,ACC_CURSOR=0,ACC_SESSION=null,ACC_GAP=false,rsDB=null,accBusy=false;

function rsOpen(){
  return new Promise((res,rej)=>{
    if(rsDB)return res(rsDB);
    if(!("indexedDB"in window))return rej(new Error("no IndexedDB"));
    const q=indexedDB.open(RS_DB,1);
    q.onupgradeneeded=()=>{const db=q.result;
      if(!db.objectStoreNames.contains(RS_RECS))db.createObjectStore(RS_RECS);
      if(!db.objectStoreNames.contains(RS_META))db.createObjectStore(RS_META);};
    q.onsuccess=()=>{rsDB=q.result;res(rsDB);};
    q.onerror=()=>rej(q.error);
  });
}
function rsTx(store,mode,fn){
  return rsOpen().then(db=>new Promise((res,rej)=>{
    const tx=db.transaction(store,mode),st=tx.objectStore(store);
    let out;try{out=fn(st);}catch(e){rej(e);return;}
    tx.oncomplete=()=>res(out);tx.onerror=()=>rej(tx.error);tx.onabort=()=>rej(tx.error);
  }));
}
function rsGetMeta(){return rsTx(RS_META,"readonly",st=>st.get("state"))
  .then(r=>new Promise(res=>{r.onsuccess=()=>res(r.result||{});r.onerror=()=>res({});}));}
function rsSetMeta(m){return rsTx(RS_META,"readwrite",st=>{st.put(m,"state");});}
function rsClear(){return rsTx(RS_RECS,"readwrite",st=>{st.clear();});}
function rsPutAll(pairs){return rsTx(RS_RECS,"readwrite",st=>{for(const[k,v]of pairs)st.put(v,k);});}
function rsAll(){return rsTx(RS_RECS,"readonly",st=>st.getAll())
  .then(r=>new Promise(res=>{r.onsuccess=()=>res(r.result||[]);r.onerror=()=>res([]);}));}

// Stable dedupe identity. Slice 1: the brain now dedupes into a session device table and
// serves ONE durable row per device (carrying first_scan/last_scan/seen), so we key device
// records by type|MAC and UPSERT â€” the browser mirrors the brain instead of stacking a row
// per scan window. Non-device seed singletons key by type|content-hash.
function accMac(r){const pk=PRES_KINDS[r&&r.type];return pk?pk[1](r):null;}
function accHash(s){let h=5381;for(let i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return(h>>>0).toString(36);}
function accKey(r){
  const mac=accMac(r);
  if(mac)return r.type+"|"+String(mac).toUpperCase();
  return (r&&r.type||"?")+"|"+accHash(JSON.stringify(r));
}
function accIngest(recs){const pairs=[];for(const r of recs)if(r&&typeof r==="object")pairs.push([accKey(r),r]);return pairs;}

// Rebuild the device session from everything in the store and re-render.
function accApply(){
  return rsAll().then(recs=>{
    const sess={label:"SniffCheck cluster Â· "+recs.length.toLocaleString()+" accumulated"+
      (ACC_GAP?" Â· âš  some sightings missed":""),recs,bad:0};
    if(DEVICE_SESSION>=0&&DEVICE_SESSION<SESSIONS.length)SESSIONS[DEVICE_SESSION]=sess;
    else{SESSIONS.push(sess);DEVICE_SESSION=SESSIONS.length-1;}
    renderAll();
  });
}

function accStart(){
  if(ACC_ON||!deviceOnline()||!("indexedDB"in window))return;
  ACC_ON=true;
  // Seed the store with whatever the initial data island already showed, so nothing is
  // lost even if the ring evicts those records before our first pull lands.
  const seed=(DEVICE_SESSION>=0&&SESSIONS[DEVICE_SESSION])?SESSIONS[DEVICE_SESSION].recs:[];
  rsGetMeta()
    .then(m=>{ACC_CURSOR=m.cursor||0;ACC_SESSION=m.session||null;
      return seed.length?rsPutAll(accIngest(seed)):null;})
    .then(accApply)
    .catch(e=>{console.warn("accumulator disabled:",e);ACC_ON=false;})
    .finally(()=>{if(ACC_ON)accSchedule();});
}
let accT=null;
function accSchedule(){clearTimeout(accT);accT=setTimeout(accPull,4000);}

// One incremental pull: fetch the brain's device rows changed since our window cursor
// (GET /api/cluster/devices?since=<window>), upsert them by device identity, advance the
// cursor to X-SC-Merge, reset on a brain restart (X-SC-Session), and re-render only when
// something actually changed. The brain table is bounded, so this stays small even on a
// long walk; IndexedDB remains the browser's durable layer if the brain evicts its oldest.
function accPull(){
  if(!ACC_ON)return Promise.resolve();
  if(accBusy){accSchedule();return Promise.resolve();}
  accBusy=true;
  return fetch("/api/cluster/devices?since="+ACC_CURSOR,{cache:"no-store"})
    .then(r=>{if(!r.ok)throw new Error("device did not answer");
      const merge=parseInt(r.headers.get("X-SC-Merge"),10),
            sess=r.headers.get("X-SC-Session")||"";
      return r.text().then(t=>({merge,sess,t}));})
    .then(({merge,sess,t})=>{
      let pre=Promise.resolve();
      if(sess&&ACC_SESSION&&sess!==ACC_SESSION){          // brain restarted -> reset mirror
        pre=rsClear().then(()=>{ACC_CURSOR=0;ACC_GAP=false;});
      }
      return pre.then(()=>{
        if(sess)ACC_SESSION=sess;
        const pr=parseCapture(t),pairs=accIngest(pr.recs);
        const p=pairs.length?rsPutAll(pairs):Promise.resolve();
        return p.then(()=>{
          if(Number.isFinite(merge)&&merge>=ACC_CURSOR)ACC_CURSOR=merge;
          return rsSetMeta({cursor:ACC_CURSOR,session:ACC_SESSION});
        }).then(()=>pairs.length>0);
      });
    })
    .then(changed=>{ if(changed) return accApply(); })
    .catch(e=>{console.warn("accumulator pull failed:",e&&e.message||e);})
    .finally(()=>{accBusy=false;if(ACC_ON)accSchedule();});
}
// ==============================================================================

drop.ondragover=e=>{e.preventDefault();drop.classList.add("hover");};
drop.ondragleave=()=>drop.classList.remove("hover");
drop.ondrop=e=>{
  e.preventDefault();drop.classList.remove("hover");
  if(e.dataTransfer.files.length)importFiles(e.dataTransfer.files);
};

// Live connection indicator: green "online" when a SniffCheck device answers,
// red "offline" otherwise (e.g. a downloaded report opened from disk).
function setConn(on){
  const c=$("constat");if(!c)return;
  c.classList.toggle("on",!!on);
  const t=c.querySelector(".ctext");if(t)t.textContent=on?"online":"offline";
  c.title=on?"Connected to a SniffCheck device":"Not connected to a SniffCheck device";
}
function pollConn(){
  if(location.protocol==="file:"){setConn(false);return;}
  fetch("/api/status",{cache:"no-store"}).then(r=>setConn(r.ok)).catch(()=>setConn(false));
}
pollConn();setInterval(pollConn,15000);
addEventListener("visibilitychange",()=>{if(!document.hidden)pollConn();});

// Auto-hide the top bar (search / filters / export / dashboard + tabs) on
// scroll-down for more screen; reveal it on scroll-up or near the top.
(function(){
  let lastY=0,ticking=false;
  function upd(){
    const y=window.scrollY||document.documentElement.scrollTop||0;
    if(y<60)document.body.classList.remove("bar-hidden");
    else if(y>lastY+6){document.body.classList.add("bar-hidden");
      // collapse the open filter panel too, so it doesn't spring back expanded
      $("filters").classList.remove("open");}
    else if(y<lastY-6)document.body.classList.remove("bar-hidden");
    lastY=y;ticking=false;
  }
  addEventListener("scroll",()=>{if(!ticking){ticking=true;requestAnimationFrame(upd);}},{passive:true});
})();

(function(){
  const isl=document.getElementById("sc-data");
  if(!isl)return;
  let t=(isl.textContent||"").replace(/<!--.*?-->/g,"").trim();
  if(t){loadText(t,"locally stored report");DEVICE_SESSION=SESSIONS.length-1;}
})();

// Dashboard "Save report (.html)" links here with ?dl=1 â€” fulfill it once the
// report has loaded by triggering the same self-contained HTML export.
(function(){
  try{
    if(new URLSearchParams(location.search).get("dl")==="1"&&RAW_RECS.length)
      setTimeout(saveReportHTML,300);
  }catch(e){}
})();
</script>
<div id="expov" hidden><div id="expsheet" role="dialog" aria-modal="true" aria-label="Export"></div></div>
<div id="smov" hidden><div id="smsheet" role="dialog" aria-modal="true" aria-label="Customize summary"></div></div>
<div id="wlov" hidden><div id="wlsheet" role="dialog" aria-modal="true" aria-label="Watchlist"></div></div>
<div id="locov" hidden><div id="locsheet" role="dialog" aria-modal="true" aria-label="Locate device"></div></div>
<div id="clov" hidden><div id="clsheet" role="dialog" aria-modal="true" aria-label="Cluster detail"></div></div>
<div id="epov" hidden><div id="epsheet" role="dialog" aria-modal="true" aria-label="Detail"></div></div>
<div id="rcov"><div id="rcbox">
  <h3 id="rctitle">Scan running</h3>
  <div class="rcmsg" id="rcmsg"></div>
  <div id="rcnum">â€“</div>
  <div id="rcbar"><i id="rcbarf"></i></div>
  <button id="rcbtn" disabled onclick="rcReconnect()">Reconnect &amp; refresh</button>
</div></div>
</body>
</html>
