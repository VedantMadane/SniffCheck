  {id:"environ",   label:"Environments (place memory)",def:false,render:blkEnviron},
  {id:"health",    label:"Cluster health (nodes / traffic)",def:false,render:blkHealth},
  {id:"sentstat",  label:"Guard Dog stats (lifetime)",def:false,isList:true,render:blkSentStat},
  {id:"activity",  label:"Activity log (cluster history)",def:false,isList:true,render:blkActivity},
  {id:"verdict",   label:"Worst-threat verdict",   def:true,  render:blkVerdict},
  {id:"tiles",     label:"Count tiles",            def:true,  render:blkTiles},
  {id:"channels",  label:"Channel chips",          def:true,  render:blkChannels},
  {id:"env",       label:"Environment indicators", def:true,  render:blkEnv},
  {id:"crowd",     label:"RF environment estimate",def:true,  render:blkCrowd},
  {id:"crossscan", label:"Scan timeline (multi-scan)",def:true,render:blkCrossScan},
  {id:"pcap",      label:"Packet-capture status",  def:true,  render:blkPcap},
  {id:"c_comp",    label:"Chart: result composition",def:false,isChart:true,render:chartComposition},
  {id:"c_threat",  label:"Chart: threat distribution",def:false,isChart:true,render:chartThreat},
  {id:"c_signal",  label:"Chart: signal strength", def:false, isChart:true,render:chartSignal},
  {id:"c_chan",    label:"Chart: Wi-Fi channel activity",def:false,isChart:true,render:chartChannels},
  {id:"c_cat",     label:"Chart: device categories",def:false,isChart:true,render:chartCategories},
  {id:"top_signal",label:"List: strongest signals",def:false, isList:true,render:blkTopSignal},
  {id:"top_threat",label:"List: top threats",      def:false, isList:true,render:blkTopThreat},
  {id:"privsum",   label:"Privacy exposure",       def:false, render:blkPrivacy},
  {id:"clustersum",label:"Clusters (identity grouping)",def:false,render:blkClusters},
  {id:"watch",     label:"Watchlist (your flags)", def:false, isList:true,render:blkWatch},
];
const BLK={};SUMMARY_BLOCKS.forEach(b=>BLK[b.id]=b);





const CLUSTER_BLOCKS=new Set(["dogpark","epup","sentinel","environ","health","sentstat","activity"]);
function clusterOn(){return DP.cluster===true;}


let clusterProbed=false;
function clusterProbe(){
  if(clusterProbed||!deviceOnline())return;clusterProbed=true;
  fetch("/api/cluster/status",{cache:"no-store"}).then(r=>{if(!r.ok)throw 0;return r.json();})
    .then(j=>{DP.cluster=true;DP.status=j;dpStart();renderBanner();})
    .catch(()=>{DP.cluster=false;});   
}
const SM_KEY="sc-summary-layout";


function defaultTabs(){return [
  {name:"Overview",         blocks:["verdict","tiles","crowd","env"]},
  {name:"Signals",          blocks:["channels","crossscan","pcap"]},
  {name:"Privacy & groups", blocks:["privsum","clustersum"]},
  {name:"Guard Dog",        blocks:["sentinel","watch"]},
];}



function summaryCfg(){
  let saved=null;
  try{saved=JSON.parse(localStorage.getItem(SM_KEY));}catch(e){}
  let tabs,hide=null;
  if(saved&&saved.v===2&&Array.isArray(saved.tabs)){
    tabs=saved.tabs.map(t=>({name:String(t&&t.name||"Tab").slice(0,24),
      blocks:Array.isArray(t&&t.blocks)?t.blocks.slice():[]}));
  }else if(Array.isArray(saved)){                       
    tabs=[{name:"Summary",blocks:saved.filter(s=>s&&BLK[s.id]&&s.on).map(s=>s.id)}];
    hide=new Set(saved.filter(s=>s&&BLK[s.id]&&!s.on).map(s=>s.id)); 
  }else{
    tabs=defaultTabs();
  }
  const seen=new Set();                                  
  for(const t of tabs)t.blocks=t.blocks.filter(id=>BLK[id]&&!seen.has(id)&&seen.add(id));
  if(!tabs.length)tabs=[{name:"Summary",blocks:[]}];
  for(const b of SUMMARY_BLOCKS)                          
    if(b.def&&!seen.has(b.id)&&!(hide&&hide.has(b.id))){tabs[0].blocks.push(b.id);seen.add(b.id);}
  let active=saved&&typeof saved.active==="number"?saved.active:0;
  if(active<0||active>=tabs.length)active=0;
  return {v:2,active,tabs};
}
function saveSummaryCfg(cfg){
  try{if(cfg)localStorage.setItem(SM_KEY,JSON.stringify(
      {v:2,active:cfg.active|0,tabs:cfg.tabs.map(t=>({name:t.name,blocks:t.blocks.slice()}))}));
    else localStorage.removeItem(SM_KEY);}catch(e){}
}

function offBlocks(cfg){
  const used=new Set();cfg.tabs.forEach(t=>t.blocks.forEach(id=>used.add(id)));
  return SUMMARY_BLOCKS.filter(b=>!used.has(b.id)&&
    (clusterOn()||!CLUSTER_BLOCKS.has(b.id))).map(b=>b.id);
}

function renderTabBlocks(tab){
  let h="",run=[];
  const flush=()=>{if(run.length){const inner=run.join("");
    if(inner)h+='<div class="charts">'+inner+"</div>";run=[];}};
  for(const id of (tab?tab.blocks:[])){
    const def=BLK[id];if(!def)continue;
    if(CLUSTER_BLOCKS.has(id)&&!clusterOn())continue;   
    const html=def.render()||"";if(!html)continue;
    if(def.isChart)run.push(html);else{flush();h+=html;}
  }
  flush();
  if(!h)h='<div class="chempty">This tab is empty. Tap <b>Customize</b> to add blocks.</div>';
  return h;
}
function renderBanner(){
  const cfg=summaryCfg();
  let bar='<div class="smbar"><button class="smgear" id="smgear" type="button" '+
    'aria-haspopup="dialog" title="Customize the RF Env Summary">'+
    '<svg><use href="#ic-gear"/></svg>Customize</button></div>';
  let side='<div class="smtabs" role="tablist" aria-label="Summary tabs">';
  cfg.tabs.forEach((t,i)=>{side+='<button class="smtab'+(i===cfg.active?" act":"")+
    '" type="button" role="tab" aria-selected="'+(i===cfg.active?"true":"false")+
    '" data-tab="'+i+'">'+esc(t.name)+"</button>";});
  side+="</div>";
  let content=renderTabBlocks(cfg.tabs[cfg.active]);
  if(!filterActive()&&M.bad)
    content+='<div class="stats"><div><b>skipped lines</b>'+M.bad+"</div></div>";
  $("smhost").innerHTML=bar+'<div class="smwrap">'+side+
    '<div id="banner" class="smcontent">'+content+"</div></div>";
  $("smgear").onclick=openSummaryCfg;
  $("smhost").querySelectorAll(".smtab").forEach(b=>b.onclick=()=>{
    const c=summaryCfg();c.active=+b.dataset.tab;saveSummaryCfg(c);renderBanner();});
  wireSummaryActs();
}

function goResults(){
  const t=FW.length?"s-wifi":FB.length?"s-ble":FT.length?"s-trackers":
    FD.length?"s-drones":"s-wifi";
  curTab=t;showTab();
}
function summaryAct(act){
  const go=t=>{curTab=t;showTab();};
  const simple={wifi:"s-wifi",ble:"s-ble",track:"s-trackers",drone:"s-drones",
    clusters:"s-clusters",alerts:"s-alerts",scans:"s-raw",privacy:"s-privacy"};
  if(simple[act]){go(simple[act]);return;}
  if(act==="ap24"){setQuick({kind:"wifi",band:"2.4"});go("s-wifi");return;}
  if(act==="ap5"){setQuick({kind:"wifi",band:"5"});go("s-wifi");return;}
  const i=act.indexOf(":");if(i<0)return;
  const k=act.slice(0,i),v=act.slice(i+1);
  if(k==="ch"){setQuick({kind:"wifi",channel:v});go("s-wifi");return;}
  if(k==="t"){setQuick({threat:v});goResults();return;}
  if(k==="cat"){setQuick({cat:[v]});goResults();return;}
  if(k==="kind"){setQuick({kind:v});goResults();return;}
  if(k==="dev"){const j=v.indexOf(":");if(j>0)gotoDevice(v.slice(0,j),v.slice(j+1));return;}
}
function wireSummaryActs(){
  $("banner").querySelectorAll("[data-act]").forEach(el=>{
    el.onclick=e=>{e.stopPropagation();summaryAct(el.dataset.act);};
    if(el.getAttribute("role")==="button")
      el.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();
        summaryAct(el.dataset.act);}};
  });
  $("banner").querySelectorAll("[data-wl=manage]").forEach(el=>
    el.onclick=openWatchlist);
  
  
  
  if($("dpwrap")||$("epwrap")||$("hcard")||$("ss-card")||$("act-card")){dpStart();}
  if($("dpwrap")){dpVis();dpPaintCtrl();dpPaintLog();}
  if($("epwrap")){epPaint();}
  if($("hcard")){healthPaint();}
  if($("ss-card")){sentStatPaint();}
  if($("act-card")){actFetch();activityPaint();}
}


let wlWired=false,wlov=null,wlsheet=null,wlType="mac";
function openWatchlist(){
  wlov=$("wlov");wlsheet=$("wlsheet");
  if(!wlWired){wlWired=true;
    wlov.addEventListener("click",e=>{if(e.target===wlov)wlov.hidden=true;});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&wlov&&!wlov.hidden)wlov.hidden=true;});}
  renderWatchlist();wlov.hidden=false;
}

function watchRefresh(){renderWatchlist();renderBanner();renderWifi();renderBle();}
function renderWatchlist(){
  const wl=watchGet();
  let h='<h3>Watchlist</h3><div class="smsub">Flag a device or network when it '+
    "shows up in a scan. Stored only in this browser. Matching never hides anything "+
    "вЂ” it just marks the row.</div>";
  h+='<div class="wlman"><span class="wlseg">'+
    '<button data-wt="mac" class="'+(wlType==="mac"?"on":"")+'">MAC</button>'+
    '<button data-wt="name" class="'+(wlType==="name"?"on":"")+'">Name</button></span>'+
    '<input id="wlin" placeholder="'+(wlType==="mac"?"AA:BB:CC:DD:EE:FF":
      "SSID or device name (partial ok)")+'" autocomplete="off">'+
    '<button class="wladd" data-wl="add">Add</button></div>';
  h+='<div class="wlstat" style="font-size:12px;color:var(--avoid);min-height:1.1em;'+
    'margin-top:6px"></div>';
  if(wl.length)h+=wl.map((w,i)=>'<div class="wlrow"><span class="wt">'+
    (w.t==="mac"?"MAC":"name")+'</span><span class="wv" title="'+esc(w.v)+'">'+
    esc(w.v)+'</span><button class="wx" data-del="'+i+'" aria-label="Remove">вњ•</button>'+
    "</div>").join("");
  else h+='<div class="chempty" style="margin-top:8px">No watchlist entries yet.</div>';
  h+='<div class="smact"><button class="prim" data-wl="done">Done</button></div>';
  wlsheet.innerHTML=h;
  wlsheet.querySelectorAll("[data-wt]").forEach(b=>b.onclick=()=>{
    wlType=b.dataset.wt;renderWatchlist();});
  const stat=wlsheet.querySelector(".wlstat");
  const doAdd=()=>{
    const inp=wlsheet.querySelector("#wlin"),v=inp.value;
    if(watchAdd(wlType,v)){inp.value="";watchRefresh();
      wlsheet.querySelector("#wlin").focus();}
    else{const s=wlsheet.querySelector(".wlstat");
      if(s)s.textContent=wlType==="mac"?
        "Enter a full MAC (12 hex digits).":"Enter a name.";}
  };
  wlsheet.querySelector("[data-wl=add]").onclick=doAdd;
  wlsheet.querySelector("#wlin").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();doAdd();}};
  wlsheet.querySelectorAll("[data-del]").forEach(b=>b.onclick=()=>{
    watchDel(+b.dataset.del);watchRefresh();});
  wlsheet.querySelector("[data-wl=done]").onclick=()=>{wlov.hidden=true;};
}


let smWired=false,smov=null,smsheet=null;
function openSummaryCfg(){
  smov=$("smov");smsheet=$("smsheet");
  if(!smWired){smWired=true;
    smov.addEventListener("click",e=>{if(e.target===smov)smov.hidden=true;});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&smov&&!smov.hidden)smov.hidden=true;});}
  renderSummaryCfg();smov.hidden=false;
}
function renderSummaryCfg(){
  const cfg=summaryCfg();
  const apply=c=>{saveSummaryCfg(c);renderSummaryCfg();renderBanner();};
  let h='<h3>Customize summary</h3><div class="smsub">Group blocks into tabs to cut '+
    'scrolling. Rename a tab, use в†‘в†“ (or drag the grip) to reorder within a tab, and '+
    '"Move to" to send a block to another tab or hide it. Saved on this device.</div>';
  
  h+='<div class="smtabmgr">';
  cfg.tabs.forEach((t,i)=>{
    h+='<div class="smtabrow" draggable="true" data-ti="'+i+'">'+
      '<span class="smgrip" title="Drag to reorder tabs">в ї</span>'+
      '<input data-tname="'+i+'" value="'+esc(t.name)+'" maxlength="24" aria-label="Tab name">'+
      '<button data-tmv="up:'+i+'"'+(i===0?" disabled":"")+' aria-label="Move tab up">в†‘</button>'+
      '<button data-tmv="down:'+i+'"'+(i===cfg.tabs.length-1?" disabled":"")+' aria-label="Move tab down">в†“</button>'+
      '<button data-tdel="'+i+'"'+(cfg.tabs.length<=1?" disabled":"")+' aria-label="Delete tab">вњ•</button>'+
      "</div>";
  });
  h+='</div><button class="smaddtab" data-addtab="1">+ Add tab</button>';
  
  const tag=def=>def.isChart?'<span class="smtag">chart</span>':
    def.isList?'<span class="smtag">list</span>':"";
  const tabOpts=cur=>cfg.tabs.map((t,i)=>'<option value="'+i+'"'+(i===cur?" selected":"")+
    ">"+esc(t.name)+"</option>").join("");
  cfg.tabs.forEach((t,i)=>{
    h+='<div class="smgrp">'+esc(t.name)+"</div>";
    if(!t.blocks.length)h+='<div class="chempty" style="margin:0 0 8px">(empty)</div>';
    t.blocks.forEach((id,bi)=>{const def=BLK[id];if(!def)return;
      if(CLUSTER_BLOCKS.has(id)&&!clusterOn())return;   
      h+='<div class="smblk on" draggable="true" data-bid="'+id+'" data-ti="'+i+'" data-bi="'+bi+'">'+
        '<span class="smgrip" title="Drag to reorder">в ї</span>'+
        '<span class="smname">'+esc(def.label)+'</span>'+tag(def)+
        '<span class="smmv"><button data-bmv="up"'+(bi===0?" disabled":"")+' aria-label="Move up">в†‘</button>'+
        '<button data-bmv="down"'+(bi===t.blocks.length-1?" disabled":"")+' aria-label="Move down">в†“</button></span>'+
        '<select class="smmove" data-move="'+id+'" aria-label="Move to tab">'+tabOpts(i)+
        '<option value="off">Hide</option></select></div>';
    });
  });
  const off=offBlocks(cfg);
  if(off.length){
    h+='<div class="smgrp off">Hidden вЂ” pick a tab to show</div>';
    off.forEach(id=>{const def=BLK[id];if(!def)return;
      h+='<div class="smblk off" data-bid="'+id+'">'+
        '<span class="smname">'+esc(def.label)+'</span>'+tag(def)+
        '<select class="smmove" data-move="'+id+'" aria-label="Add to tab">'+
        '<option value="off" selected>Hidden</option>'+tabOpts(-1)+"</select></div>";
    });
  }
  h+='<div class="smact"><button data-sm="reset">Reset to default</button>'+
    '<button class="prim" data-sm="done">Done</button></div>';
  smsheet.innerHTML=h;
  
  smsheet.querySelectorAll("[data-tname]").forEach(inp=>inp.onchange=()=>{
    const c=summaryCfg(),i=+inp.dataset.tname;
    if(c.tabs[i]){c.tabs[i].name=(inp.value.trim()||"Tab").slice(0,24);apply(c);}});
  smsheet.querySelectorAll("[data-tmv]").forEach(b=>b.onclick=()=>{
    const[dir,is]=b.dataset.tmv.split(":"),i=+is,c=summaryCfg();
    const j=dir==="up"?i-1:i+1;if(j<0||j>=c.tabs.length)return;
    const t=c.tabs[i];c.tabs[i]=c.tabs[j];c.tabs[j]=t;
    if(c.active===i)c.active=j;else if(c.active===j)c.active=i;apply(c);});
  smsheet.querySelectorAll("[data-tdel]").forEach(b=>b.onclick=()=>{
    const c=summaryCfg(),i=+b.dataset.tdel;if(c.tabs.length<=1)return;
    const moved=c.tabs[i].blocks;c.tabs.splice(i,1);
    (c.tabs[i>0?i-1:0].blocks).push(...moved);          
    if(c.active>=c.tabs.length)c.active=c.tabs.length-1;apply(c);});
  smsheet.querySelector("[data-addtab]").onclick=()=>{
    const c=summaryCfg();c.tabs.push({name:"Tab "+(c.tabs.length+1),blocks:[]});apply(c);};
  smsheet.querySelectorAll("[data-bmv]").forEach(b=>b.onclick=()=>{
    const row=b.closest(".smblk"),ti=+row.dataset.ti,bi=+row.dataset.bi,c=summaryCfg();
    const t=c.tabs[ti];if(!t)return;const j=b.dataset.bmv==="up"?bi-1:bi+1;
    if(j<0||j>=t.blocks.length)return;
    const tmp=t.blocks[bi];t.blocks[bi]=t.blocks[j];t.blocks[j]=tmp;apply(c);});
  smsheet.querySelectorAll("[data-move]").forEach(sel=>sel.onchange=()=>{
    const id=sel.dataset.move,to=sel.value,c=summaryCfg();
    c.tabs.forEach(t=>{const k=t.blocks.indexOf(id);if(k>=0)t.blocks.splice(k,1);});
    if(to!=="off"&&c.tabs[+to])c.tabs[+to].blocks.push(id);apply(c);});
  smsheet.querySelectorAll("[data-sm]").forEach(b=>b.onclick=()=>{
    if(b.dataset.sm==="reset")apply(null);else smov.hidden=true;});
  
  let dragBid=null,dragBti=null;
  smsheet.querySelectorAll(".smblk[data-ti]").forEach(el=>{
    el.ondragstart=e=>{dragBid=el.dataset.bid;dragBti=el.dataset.ti;
      el.classList.add("dragging");e.dataTransfer.effectAllowed="move";};
    el.ondragend=()=>{el.classList.remove("dragging");
      smsheet.querySelectorAll(".smblk").forEach(x=>x.classList.remove("dragover"));};
    el.ondragover=e=>{if(el.dataset.ti===dragBti){e.preventDefault();el.classList.add("dragover");}};
    el.ondragleave=()=>el.classList.remove("dragover");
    el.ondrop=e=>{e.preventDefault();
      if(dragBid==null||el.dataset.ti!==dragBti)return;
      const c=summaryCfg(),t=c.tabs[+dragBti];if(!t)return;
      const from=t.blocks.indexOf(dragBid),to=+el.dataset.bi;
      if(from<0||from===to)return;
      const m=t.blocks.splice(from,1)[0];t.blocks.splice(to,0,m);apply(c);};
  });
  let dragTi=null;
  smsheet.querySelectorAll(".smtabrow").forEach(el=>{
    el.ondragstart=e=>{dragTi=+el.dataset.ti;el.classList.add("dragging");
      e.dataTransfer.effectAllowed="move";};
    el.ondragend=()=>{el.classList.remove("dragging");
      smsheet.querySelectorAll(".smtabrow").forEach(x=>x.classList.remove("dragover"));};
    el.ondragover=e=>{e.preventDefault();el.classList.add("dragover");};
    el.ondragleave=()=>el.classList.remove("dragover");
    el.ondrop=e=>{e.preventDefault();const to=+el.dataset.ti;
      if(dragTi==null||dragTi===to)return;
      const c=summaryCfg(),m=c.tabs.splice(dragTi,1)[0];c.tabs.splice(to,0,m);
      c.active=to;apply(c);};
  });
}

function renderSession(){
  const h=M.header||{},d=h.device||{},s=h.session||{},
        f=M.footer,fc=f&&f.counters||{};
  const rows=[
    ...(SESSIONS.length>1?[["captures aggregated",
      SESSIONS.length+" вЂ” "+esc(SESSIONS.map(s=>String(s.label).split(" В· ")[0])
        .join(", "))+" (header/footer shown for the first)"]]:[]),
    ["device",esc((d.model||"?")+" / "+(d.chip||"?")+" (hw "+(d.hw_rev||"?")+")")],
    ["firmware",esc((d.fw_version||"?")+" @ "+(d.fw_commit||"?"))],
    ["schema",esc(h.schema_version||"?")],
    ["session_id",esc(s.session_id||"?")],
    ["boot_count",esc(s.boot_count!==undefined?s.boot_count:"?")],
    ["advisor mode",esc(s.advisor_mode||"?")],
    ["records parsed",M.total+(M.bad?" ("+M.bad+" bad line"+(M.bad>1?"s":"")+" skipped)":"")],
    ["capture start",fmtTs(s.start_us)],
    ["capture end",f?fmtTs(f.session&&f.session.end_us)+
      " вЂ” "+esc(f.session&&f.session.end_reason||"?"):"(no footer вЂ” capture still live or clipped)"],
  ];
  if(f)rows.push(["session counters",
    "records "+(fc.records_written??"?")+", dropped "+(fc.events_dropped??"?")+
    ", scans "+(fc.scans_completed??"?")]);
  $("session").innerHTML='<div class="kv">'+rows.map(([k,v])=>
    "<div><b>"+esc(k)+":</b><span>"+v+"</span></div>").join("")+"</div>";
}

const EV_LABEL={
  nearby_mac_suffix:"nearby hardware address (same maker block)",
  conserved_nic_bytes:"shared NIC bytes (one radio's networks)",
  same_product_model:"same product make and model",
  l2l3_id:"same wired identity (LLDP/CDP)",
  name_match:"BLE name matches the Wi-Fi network name",
  fast_pair_model:"same Fast Pair model (same product, not same device)",
  shared_service_uuid:"shared service UUID (same product family)",
  ble_local_name:"same BLE local name (related, not same device)",
  remote_id_serial:"same Remote ID serial (same aircraft)",
  vehicle_make:"same vehicle make by name (Wi-Fi + BLE; not necessarily one car)",

  mac_adjacent:"nearby hardware address (same maker block)",
  same_physical_router:"shared NIC bytes (one radio's networks)",
  wps_vendor_model:"same product make and model"};
function evName(ev){
  const s=typeof ev==="number"?cb("cluster_evidence",ev):String(ev??"?");
  return EV_LABEL[s]||s;
}

const EV_CLASS={
  physical_strong:   {t:"same device",         c:"var(--safe)"},
  physical_candidate:{t:"candidate",           c:"var(--ok)"},
  relationship:      {t:"related",             c:"var(--wifi)"},
  product_family:    {t:"same product/family", c:"var(--ble)"},
  context:           {t:"context",             c:"var(--dim)"}};
function evClassOf(e){
  let s=e.evidence_class;
  if(s==null&&typeof e.evidence_class_i==="number")
    s=cb("cluster_evidence_class",e.evidence_class_i);
  return String(s??"");
}

const MATCH_CLASS={
  physical:      {t:"likely same device",  c:"var(--safe)"},
  candidate:     {t:"may be related",      c:"var(--ok)"},
  product_family:{t:"same product/family", c:"var(--ble)"},
  conflict:      {t:"probably separate",   c:"var(--avoid)"}};
function evClassBadge(e){

  if(e.corroborated){
    const c=MATCH_CLASS.physical.c;
    return ' <span class="ecl" style="color:'+c+';border-color:'+c+
      '">same device В· corroborated</span>';
  }
  const mc=e.match_class&&MATCH_CLASS[e.match_class];
  if(mc)return ' <span class="ecl" style="color:'+mc.c+';border-color:'+mc.c+
    '">'+esc(mc.t)+"</span>";
  const info=EV_CLASS[evClassOf(e)];
  if(!info)return "";
  return ' <span class="ecl" style="color:'+info.c+';border-color:'+info.c+
    '">'+esc(info.t)+"</span>";
}
function renderClusters(){

  const P=clusterParts(),list=FC,mrAps=P.mr,supBle=P.sb;
  if(!list.length&&!mrAps.length&&!supBle.length&&!PV.length&&!RC.length){
    $("clusters").innerHTML=empty(filterActive()?
      "No clusters or merged radios match the filter.":
      "No device_cluster / merged-radio records (single-radio environment, or pre-1.6.0 capture).");
    return;
  }
  const bandChip=b=>'<span class="chip" style="padding:1px 6px">'+(b?"5G":"2.4G")+"</span>";
  function nameOf(layer,mac){
    if(layer==="wifi"){const w=M.wifi.get(mac);return w?(w.rec.ssid||null):null;}
    const b=M.ble.get(mac);return b?(b.rec.name||b.rec.vendor||null):null;
  }
  function vendorOf(layer,mac){
    const m=layer==="wifi"?M.wifi.get(mac):M.ble.get(mac);
    return m?(m.rec.vendor||m.rec.company_name||null):null;
  }
  
  
  
  
  
  
  const NIC_EV={conserved_nic_bytes:1,same_physical_router:1,
    nearby_mac_suffix:1,mac_adjacent:1};
  const STRONG_EV={same_product_model:1,wps_vendor_model:1,name_match:1,
    l2l3_id:1};
  function siblingCaveat(c){
    const kind=c.cluster_kind||"physical";
    if(kind!=="physical"&&kind!=="candidate")return "";
    const wifiN=(c.members||[]).filter(mb=>mb.layer==="wifi").length;
    if(wifiN<2)return "";
    let nic=false,strong=false,ssid=false;
    for(const e of c.edges||[]){
      if(e.merged===false)continue;
      const ev=String(e.evidence??"");
      if(NIC_EV[ev])nic=true;
      if(STRONG_EV[ev])strong=true;
      if(Array.isArray(e.candidate_evidence)&&
         e.candidate_evidence.indexOf("ssid_related")>=0)ssid=true;
    }
    if(!nic||strong||ssid)return "";
    return '<div class="sibcav"><b>Possible sibling units.</b> These networks '+
      'were grouped by matching hardware-address bytes and radio co-location '+
      'alone, with no shared network name or product identifier. That is what '+
      'one router with several SSIDs looks like вЂ” but two identical units of '+
      'the same model, bought together and sitting side by side, look the same '+
      'on RF. Treat as one device with low confidence.</div>';
  }
  function panelHtml(c){
    const members=c.members||[],total=c.member_total??members.length;

    let best=null;
    for(const e of c.edges||[]){
      if(e.merged===false)continue;
      if(!best||(e.confidence||0)>(best.confidence||0))best=e;
    }
    const kind=c.cluster_kind||"physical";
    const lead=kind==="physical"?"likely one physical device":
      kind==="vehicle"?"same vehicle make (Wi-Fi + BLE) В· not necessarily one car":
      kind==="candidate"?"candidate link В· not confirmed one device":
      "same product family В· not one device";
    let h='<div class="card">'+
      (best?'<div class="why">grouped by: '+esc(evName(best.evidence))+"</div>":"")+
      '<div class="small dim">'+lead+" В· "+total+
      " member"+(total>1?"s":"")+" В· confidence "+esc(c.confidence??"?")+
      " В· scan "+esc(c.scan_index??"?")+"</div>"+siblingCaveat(c)+'<div class="mgrid">';
    for(const mb of members){
      const w=mb.layer==="wifi";
      h+=memberCard({mac:mb.mac,kind:w?"wifi":"ble",
        name:nameOf(mb.layer,mb.mac)||mb.mac});
    }
    h+="</div>";
    if((c.edges||[]).length){
      const byRef={};
      for(const mb of members)byRef[(mb.layer||"?")+":"+mb.index]=mb;
      const endName=p=>{
        const mb=p&&byRef[(p.layer||"?")+":"+p.index];
        if(!mb)return esc((p&&p.layer)||"?")+"["+esc((p&&p.index)??"?")+"]";
        return esc(nameOf(mb.layer,mb.mac)||mb.mac||"?");
      };
      h+='<div class="ev" style="margin-top:8px"><b>evidence:</b><br>';
      for(const e of c.edges){

        const note=e.merged===false?
          ' <span class="dim">В· shown, did not merge</span>':"";

        const facts=(e.candidate_evidence&&e.candidate_evidence.length)?
          ' <span class="dim">В· via: '+esc(e.candidate_evidence.join(", "))+"</span>":"";
        const conf=(e.conflicts&&e.conflicts.length)?
          ' <span class="dim">В· conflict: '+esc(e.conflicts.join(", "))+"</span>":"";
        h+=endName(e.a)+' <span class="dim">+</span> '+endName(e.b)+
          ' <span class="dim">вЂ”</span> '+esc(evName(e.evidence))+
          evClassBadge(e)+
          ' <span class="dim">(conf '+esc(e.confidence??"?")+")</span>"+facts+note+conf+"<br>";
      }
      h+="</div>";
    }
    return h+"</div>";
  }

  function repRec(c){
    for(const mb of c.members||[]){
      const m=mb.layer==="wifi"?M.wifi.get(mb.mac):M.ble.get(mb.mac);
      if(m)return{r:m.rec,kind:mb.layer==="wifi"?"wifi":"ble"};
    }
    return null;
  }
  function clusterIcon(c){const p=repRec(c);return p?catIcon(p.r,p.kind):"";}

  function mrPanel(r){
    const sibs=r.radio_siblings||[],total=r.radio_count??(sibs.length+1);
    const nm=realName(r.ssid)||"(hidden)";
    let h='<div class="card"><div class="small dim">'+esc(nm)+
      " В· "+esc(total)+" radios merged into one logical network В· scan "+
      esc(r.scan_index??"?")+'</div><div class="mgrid">';
    h+=memberCard({mac:r.bssid,kind:"wifi",name:nm,radio:true,
      rssi:r.rssi,band:r.band_5g?"5G":"2.4G"});
    for(const s of sibs)
      h+=memberCard({mac:s.bssid,kind:"wifi",name:nm,radio:true,
        rssi:s.rssi,band:s.band_5g?"5G":"2.4G"});
    return h+"</div></div>";
  }

  function sbPanel(r){
    let h='<div class="card"><div class="small dim">anonymous / ambient advertiser'+
      " В· hidden from the on-device Lite list В· scan "+esc(r.scan_index??"?")+
      '</div><div class="mgrid">'+
      memberCard({mac:r.addr,kind:"ble",name:r.name||r.vendor||r.addr,
        rssi:typeof r.rssi==="number"?r.rssi:null,band:null})+
      "</div><div>";
    if(r.addr_subtype!=null)h+='<span class="chip">'+esc(cb("addr_subtype",r.addr_subtype))+"</span>";
    if(r.vendor)h+='<span class="chip">'+esc(r.vendor)+"</span>";
    h+='<span class="chip dim">class '+esc(fClass(r)||"вЂ”")+"</span>";
    return h+"</div></div>";
  }

  const{net,bt,veh}=P;

  function repMac(c){
    for(const mb of c.members||[])if(mb.layer==="wifi"&&mb.mac)return mb.mac;
    for(const mb of c.members||[])if(mb.mac)return mb.mac;
    return "?";
  }

  function repName(c){
    const cnt=new Map();
    for(const mb of c.members||[]){
      if(mb.layer!=="wifi")continue;
      const s=realName(nameOf("wifi",mb.mac));
      if(s)cnt.set(s,(cnt.get(s)||0)+1);
    }
    let top=null,n=0;cnt.forEach((v,k)=>{if(v>n){n=v;top=k;}});
    if(top)return top;
    for(const mb of c.members||[])
      if(mb.layer!=="wifi"){const nm=realName(nameOf("ble",mb.mac));if(nm)return nm;}
    
    return repMac(c);
  }

  
  
  
  
  
  function tgrid(arr,label,gid,meta,panel){
    if(!arr.length)return "";
    let h="";
    arr.forEach((c,i)=>{
      const m=meta(c);
      h+='<button class="ctile'+(m.kcls?" "+m.kcls:"")+'" data-g="'+gid+
        '" data-i="'+i+'" aria-haspopup="dialog" aria-expanded="false" title="'+
        esc(m.mac||m.name||"")+'"><span class="cthd">'+
        '<span class="dicon">'+(m.icon||"")+"</span>"+
        '<span class="ctname">'+esc(m.name||"?")+"</span>"+
        (m.kind?'<span class="ctkind">'+esc(m.kind)+"</span>":"")+"</span>"+
        '<span class="ctmac mono">'+esc(m.mac||"")+"</span>"+
        '<span class="ctico">'+(m.ico||"")+"</span></button>"+
        '<div class="cdet" data-g="'+gid+'" data-i="'+i+'">'+panel(c)+"</div>";
    });
    return '<h3 class="cgh">'+label+" ("+arr.length+')</h3><div class="cgrid">'+h+"</div>";
  }

  function pvIcon(e){
    const w=M.wifi.get(e.mac);if(w)return catIcon(w.rec,"wifi");
    const b=M.ble.get(e.mac);if(b)return catIcon(b.rec,"ble");
    return iconSpan(["ic-privacy","privacy findings"]);
  }
  function pvPanel(e){
    let h='<div class="card"><div class="small dim">privacy-analyzer findings '+
      "for this address В· "+e.items.length+" item(s)</div>";
    const dl=devLink(e.mac);
    if(dl)h+='<div style="margin:5px 0">'+dl+"</div>";
    let last="";
    for(const[label,row]of e.items){
      if(label!==last){h+='<h3 class="cgh" style="margin:9px 0 4px">'+esc(label)+"</h3>";last=label;}
      h+=row;
    }
    return h+"</div>";
  }

  
  
  
  
  const bestIdent=mac=>{
    if(!mac)return{t:0,s:"?"};
    const w=M.wifi.get(mac);
    if(w){const r=w.rec;
      if(r.ssid)return{t:3,s:r.ssid};
      if(r.vendor)return{t:1,s:r.vendor};}
    const b=M.ble.get(mac);
    if(b){const r=b.rec;
      const nm=r.name||r.fastpair_name;
      if(nm)return{t:3,s:nm};
      const id=r.uuid16_name||r.uuid128_name||r.uuid32_name||r.ms_subtype_name||
               r.name_rule_name||r.apple_category||r.mfg_rule_name;
      if(id)return{t:2,s:id};
      const v=r.vendor||r.company_name;
      if(v)return{t:1,s:v};}
    return{t:0,s:mac};
  };
  const pvName=e=>{
    const b=bestIdent(e.mac);
    if(b.t>0)return{s:b.s,mono:false,title:e.mac};        
    if(e.ident&&e.ident.s)return{s:e.ident.s,mono:false,title:e.mac}; 
    return{s:e.mac,mono:true,title:e.mac};                
  };

  function buildAggregates(){
    const up=s=>String(s||"").toUpperCase();
    const oui=a=>{const m=up(a).replace(/[^0-9A-F]/g,"");return m.length>=6?m.slice(0,6):"";};
    const nodes=[];
    const addNode=(family,g,i,ref,addrs,ssids)=>{
      const A=new Set(),S=new Set(),O=new Set();
      for(const a of addrs)if(a){A.add(up(a));const o=oui(a);if(o)O.add(o);}
      for(const s of ssids)if(s)S.add(s);
      nodes.push({family,g,i,ref,addrs:A,ssids:S,ouis:O});
    };
    [["v",veh],["n",net],["b",bt]].forEach(([g,arr])=>arr.forEach((c,i)=>{
      const addrs=[],ssids=[];
      for(const mb of c.members||[]){
        if(mb.mac)addrs.push(mb.mac);
        if(mb.layer==="wifi"){const w=M.wifi.get(mb.mac);if(w&&w.rec.ssid)ssids.push(w.rec.ssid);}
      }
      addNode("nic",g,i,c,addrs,ssids);
    }));
    mrAps.forEach((r,i)=>addNode("radio","mr",i,r,
      [r.bssid,...(r.radio_siblings||[]).map(s=>s.bssid)],[r.ssid]));
    PV.forEach((e,i)=>{const w=M.wifi.get(e.mac);
      addNode("priv","pv",i,e,[e.mac],[w&&w.rec.ssid]);});

    const parent=nodes.map((_,i)=>i);
    const find=x=>{while(parent[x]!==x){parent[x]=parent[parent[x]];x=parent[x];}return x;};
    const linked=(a,b)=>{
      for(const x of a.addrs)if(b.addrs.has(x))return "addr";
      let ssidHit=false;for(const s of a.ssids)if(b.ssids.has(s)){ssidHit=true;break;}
      if(ssidHit)for(const o of a.ouis)if(b.ouis.has(o))return "ssid";
      return "";
    };
    for(let a=0;a<nodes.length;a++)for(let b=a+1;b<nodes.length;b++){
      if(linked(nodes[a],nodes[b])){const ra=find(a),rb=find(b);if(ra!==rb)parent[ra]=rb;}
    }
    const comps=new Map();
    nodes.forEach((_,idx)=>{const r=find(idx);
      let c=comps.get(r);if(!c){c=[];comps.set(r,c);}c.push(idx);});
    const order={nic:0,radio:1,priv:2};
    const agg=[];
    comps.forEach(idxs=>{
      if(idxs.length<2)return;
      const ns=idxs.map(i=>nodes[i]),addrs=new Set(),ssids=new Set();
      ns.forEach(n=>{n.addrs.forEach(x=>addrs.add(x));n.ssids.forEach(s=>ssids.add(s));});
      let byAddr=false,bySsid=false;
      for(let a=0;a<ns.length;a++)for(let b=a+1;b<ns.length;b++){
        const l=linked(ns[a],ns[b]);
        if(l==="addr")byAddr=true;else if(l==="ssid")bySsid=true;
      }
      ns.sort((x,y)=>order[x.family]-order[y.family]||x.g.localeCompare(y.g)||x.i-y.i);
      agg.push({nodes:ns,addrs,ssids,byAddr,bySsid});
    });
    return agg;
  }
  const AGG=buildAggregates();

  const wOf=ad=>M.wifi.get(ad)||M.wifi.get(String(ad).toLowerCase());
  const bOf=ad=>M.ble.get(ad)||M.ble.get(String(ad).toLowerCase());

  const sibMeta=new Map();
  mrAps.forEach(r=>{
    const put=(bssid,b5,ch,rssi)=>{if(bssid)
      sibMeta.set(String(bssid).toUpperCase(),{band_5g:b5,channel:ch,rssi:rssi,ssid:r.ssid});};
    put(r.bssid,r.band_5g,r.channel,r.rssi);
    (r.radio_siblings||[]).forEach(s=>put(s.bssid,s.band_5g,s.channel,s.rssi));
  });

  const addrInfo=ad=>{
    const b=bOf(ad);
    if(b)return{type:"BLE",ly:"b",name:b.rec.name||b.rec.vendor||"",
      band:"2.4G",rssi:b.rec.rssi};
    const w=wOf(ad);
    if(w)return{type:"WiFi",ly:"w",name:w.rec.ssid||"",
      band:w.rec.band_5g?"5G":"2.4G",rssi:w.rec.rssi};
    const s=sibMeta.get(String(ad).toUpperCase());
    if(s)return{type:"Radio",ly:"w",name:s.ssid||"",
      band:s.band_5g?"5G":"2.4G",rssi:s.rssi};
    return{type:"",ly:"",name:"",band:"",rssi:undefined};
  };

  const aggRep=a=>{
    for(const ad of a.addrs){const w=wOf(ad);if(w)return{r:w.rec,kind:"wifi"};}
    for(const ad of a.addrs){const b=bOf(ad);if(b)return{r:b.rec,kind:"ble"};}
    return null;
  };
  const aggIcon=a=>{const p=aggRep(a);
    return p?catIcon(p.r,p.kind):iconSpan(["ic-nic","cluster"]);};
  const aggName=a=>{
    for(const s of a.ssids)if(realName(s))return s;
    for(const ad of a.addrs){const i=addrInfo(ad);if(realName(i.name))return i.name;}
    return [...a.addrs][0]||"?";
  };
  const famLabel=f=>f==="nic"?"NIC cluster":f==="radio"?"Radio cluster":"Privacy cluster";
  function aggPanel(a){
    const reasons=[];
    if(a.byAddr)reasons.push("shared hardware address");
    if(a.bySsid)reasons.push("shared SSID + vendor OUI");
    let h='<div class="card"><div class="small dim">'+a.nodes.length+
      " source clusters combined"+
      (reasons.length?" В· linked by: "+esc(reasons.join(" + ")):"")+"</div><div>";
    for(const n of a.nodes)
      h+='<span class="chip"><b>'+famLabel(n.family)+"</b> "+
        '<button class="plink" type="button" onclick="event.stopPropagation();'+
        "gotoCluster('"+n.g+"',"+n.i+')">view</button></span>';
    h+='</div><div class="mgrid">';

    for(const ad of a.addrs){
      const d=addrInfo(ad);
      h+=memberCard({mac:ad,kind:d.ly==="b"?"ble":"wifi",name:d.name||ad,
        rssi:typeof d.rssi==="number"?d.rssi:null,
        band:d.band||null,radio:d.type==="Radio"});
    }
    return h+"</div></div>";
  }
  
  const kindOf=k=>k==="wifi"?{kind:"WIFI",kcls:"k-wifi"}:{kind:"BLE",kcls:"k-ble"};
  const nicMeta=c=>{const p=repRec(c),k=p?kindOf(p.kind):{kind:"",kcls:""};
    return{icon:clusterIcon(c),name:repName(c),mac:repMac(c),
      ico:iconSpan(["ic-nic","NIC cluster"]),...k};};
  const nicHtml=
    tgrid(veh,"Vehicle groups","v",nicMeta,panelHtml)+
    tgrid(net,"Network clusters","n",nicMeta,panelHtml)+
    tgrid(bt,"Bluetooth clusters","b",nicMeta,panelHtml)+
    tgrid(supBle,"Suppressed BLE","sb",
      r=>({icon:catIcon(r,"ble"),name:r.name||r.vendor||r.addr,mac:r.addr,
        kind:"BLE",kcls:"k-ble",ico:iconSpan(["ic-privacy","suppressed advertiser"])}),
      sbPanel)||
    empty("No NIC clusters in this capture.");
  const radioHtml=
    tgrid(mrAps,"Merged radios","mr",
      r=>({icon:catIcon(r,"wifi"),name:realName(r.ssid)||r.bssid,mac:r.bssid,
        kind:"RADIO",kcls:"k-wifi",ico:iconSpan(["ic-radio","radio cluster"])}),
      mrPanel)||
    empty("No merged-radio records in this capture.");
  const privHtml=
    tgrid(PV,"Privacy clusters","pv",
      e=>{const nm=pvName(e),p=M.wifi.get(e.mac)?"wifi":(M.ble.get(e.mac)?"ble":null),
        k=p?kindOf(p):{kind:"",kcls:""};
        return{icon:pvIcon(e),name:nm.s,mac:e.mac,
          ico:iconSpan(["ic-privacy","privacy cluster"]),...k};},
      pvPanel)||
    empty("No per-device privacy-analyzer rows in this capture.");
  const aggHtml=
    tgrid(AGG,"Aggregate clusters","ag",
      a=>{const p=aggRep(a),k=p?kindOf(p.kind):{kind:"MIXED",kcls:""};
        return{icon:aggIcon(a),name:aggName(a),mac:[...a.addrs][0]||"?",
          ico:iconSpan(["ic-nic","aggregate cluster"]),...k};},
      aggPanel)||
    empty("No clusters combine across families in this capture.");

  const rcName=c=>{
    const mb=c.members[0],r=mb.rec;
    return (mb.kind==="wifi"?realName(r.ssid):(r.name||r.vendor))||mb.mac;
  };
  
  
  
  
  
  const rcIcon=c=>{const mb=c.members[0];return catIcon(mb.rec,mb.kind==="wifi"?"wifi":"ble");};
  const xcType=c=>c.rotation?["ic-rotate","address rotation"]:["ic-chain","product group"];
  function xcPanel(c){
    const rot=c.rotation,ico=iconSpan(xcType(c));
    const lbl=rot?"MAC randomization вЂ” one device changing address across scans":
      c.members.length+" concurrent units of one product (kept apart)";
    let h='<div class="card"><div class="xhead '+(rot?"rot":"grp")+'">'+ico+
      "<span>"+esc(lbl)+"</span></div>"+
      '<div class="why">linked by: '+esc(c.evidence)+"</div>"+
      '<div class="small dim">'+c.members.length+" addresses В· confidence "+
      c.conf+" "+identBar(c.conf)+"</div>";
    if(rot){
      h+='<div class="tl">';
      c.members.forEach((mb,i)=>{
        const w=mb.kind==="wifi",nm=w?mb.rec.ssid:(mb.rec.name||mb.rec.vendor||"");
        const band=w?(mb.rec.band_5g?"5 GHz":"2.4 GHz"):"BLE";
        h+='<div class="hop"><span class="dot"></span><div class="body">'+
          memberCard({mac:mb.mac,kind:w?"wifi":"ble",name:nm||mb.mac,
            rssi:mb.rec&&typeof mb.rec.rssi==="number"?mb.rec.rssi:null,
            band:w?(mb.rec.band_5g?"5G":"2.4G"):null})+
          '<span class="rng">scans '+esc(slotLabel(mb.p.first))+"вЂ“"+
          esc(slotLabel(mb.p.last))+" В· "+esc(band)+" В· seen "+mb.p.seen+"/"+
          mb.p.total+"</span> "+presStrip(mb.p)+" "+
          (i<c.members.length-1?'<div class="small dim" style="margin-top:3px">'+
            "в†“ address changed</div>":"")+
          "</div></div>";
      });
      h+="</div>";
    }else{
      h+="<div>";
      for(const mb of c.members){
        const w=mb.kind==="wifi",nm=w?mb.rec.ssid:(mb.rec.name||mb.rec.vendor||"");
        h+='<div style="margin:4px 0">'+
          memberCard({mac:mb.mac,kind:w?"wifi":"ble",name:nm||mb.mac,
            rssi:mb.rec&&typeof mb.rec.rssi==="number"?mb.rec.rssi:null,
            band:w?(mb.rec.band_5g?"5G":"2.4G"):null})+" "+presStrip(mb.p)+
          ' <span class="dim">scans '+esc(slotLabel(mb.p.first))+"вЂ“"+
          esc(slotLabel(mb.p.last))+" ("+mb.p.seen+"/"+mb.p.total+")</span></div>";
      }
      h+="</div>"+'<div class="small dim" style="margin-top:6px">'+
        c.overlap+" scan pass"+(c.overlap>1?"es":"")+" heard 2+ of these addresses "+
        "at once, so they are kept apart as probable separate devices вЂ” nothing "+
        "is merged or hidden on identifier match alone.</div>";
    }
    return h+"</div>";
  }
  const rcHtml=M.slots.length<2?
    empty("Single scan loaded вЂ” use Import (or run more scan passes) to trace devices across scans."):
    (tgrid(RC,"Cross scan clusters","rc",
       c=>{const mb=c.members[0];return{icon:rcIcon(c),name:rcName(c),mac:mb.mac,
         ...kindOf(mb.kind),ico:iconSpan(xcType(c))};},
       xcPanel)||
     empty("No cross-scan matches вЂ” no device was seen in two scans under a "+
       "different address with >70 confidence of being the same unit."));
  const nicN=veh.length+net.length+bt.length+supBle.length;
  $("clusters").innerHTML=
    '<div class="ctabs">'+
    '<button class="ctab act" data-t="agg">Aggregate Cluster(s) <span class="tn">'+AGG.length+"</span></button>"+
    '<button class="ctab" data-t="multi">Cross Scan Cluster(s) <span class="tn">'+RC.length+"</span></button>"+
    '<button class="ctab" data-t="priv">Privacy Cluster(s) <span class="tn">'+PV.length+"</span></button>"+
    '<button class="ctab" data-t="nic">NIC Cluster(s) <span class="tn">'+nicN+"</span></button>"+
    '<button class="ctab" data-t="radio">Radio Cluster(s) <span class="tn">'+mrAps.length+"</span></button></div>"+
    '<div class="cltab" data-t="agg">'+aggHtml+"</div>"+
    '<div class="cltab" data-t="multi" style="display:none">'+rcHtml+"</div>"+
    '<div class="cltab" data-t="priv" style="display:none">'+privHtml+"</div>"+
    '<div class="cltab" data-t="nic" style="display:none">'+nicHtml+"</div>"+
    '<div class="cltab" data-t="radio" style="display:none">'+radioHtml+"</div>";
  const root=$("clusters");
  root.querySelectorAll(".ctab").forEach(b=>{
    b.onclick=()=>{
      root.querySelectorAll(".ctab").forEach(x=>x.classList.toggle("act",x===b));
      root.querySelectorAll(".cltab")
        .forEach(p=>p.style.display=p.dataset.t===b.dataset.t?"":"none");
    };
  });
  root.querySelectorAll(".ctile").forEach(b=>{
    b.onclick=()=>openClusterModal(b.dataset.g,b.dataset.i);
  });
}





let clWired=false;
function clModalClose(){const ov=$("clov");if(ov)ov.hidden=true;}
function openClusterModal(g,i){
  const root=$("clusters");if(!root)return;
  const det=root.querySelector('.cdet[data-g="'+g+'"][data-i="'+i+'"]');
  if(!det)return;
  const tile=root.querySelector('.ctile[data-g="'+g+'"][data-i="'+i+'"]');
  root.querySelectorAll(".ctile.open").forEach(x=>{
    x.classList.remove("open");x.setAttribute("aria-expanded","false");});
  if(tile){tile.classList.add("open");tile.setAttribute("aria-expanded","true");}
  const title=(tile&&tile.querySelector(".ctname"))?
    tile.querySelector(".ctname").textContent:"Cluster detail";
  const ov=$("clov"),sheet=$("clsheet");
  sheet.innerHTML='<div class="clhd"><h3>'+esc(title)+"</h3>"+
    '<button class="clx" type="button" aria-label="Close">вњ•</button></div>'+
    '<div class="clbody">'+det.innerHTML+"</div>";
  sheet.querySelector(".clx").onclick=clModalClose;
  if(!clWired){
    clWired=true;
    ov.addEventListener("click",e=>{if(e.target===ov)clModalClose();});
    
    
    
    
    
    sheet.addEventListener("click",e=>{
      const a=e.target.closest(".plink,.clink,.mcard");
      if(a&&/gotoDevice/.test(a.getAttribute("onclick")||""))clModalClose();
    },true);
    addEventListener("keydown",e=>{
      if(e.key==="Escape"&&!ov.hidden)clModalClose();});
  }
  ov.hidden=false;sheet.scrollTop=0;
}

function renderTrackers(){
  const el=$("trackers");
  if(!FT.length){el.innerHTML=empty(filterActive()?
    "No trackers match the filter.":"No tracker records.");return;}
  const rows=FT.slice();sortRows(rows,"threat");
  el.innerHTML='<div class="dlist">'+rows.map(r=>{
    const sep=r.find_my_separated?
      '<span class="pill p2">separated from owner</span>':"";
    const meta=vendCell(r)+kindBadge("track","Tracker")+
      span("",'<b>'+esc(r.tracker_kind||"?")+"</b>")+
      rssiHtml(r.rssi)+span("",fmtDist(r.distance_dm))+
      span("mono",esc(r.addr||"?"));

    const why=r.find_my_separated?
      '<div class="why">'+esc(whyText(r)||"Broadcasting in separated-from-owner"+
        " mode вЂ” it may be travelling with you rather than its owner.")+"</div>":
      whyHtml(r);
    return devCard("track",null,nameDisp(r.name),
      sep||threatPill(r.threat_level),meta,why+presLine("track",r.addr),
      catIcon(r,"track"));
  }).join("")+"</div>";
  wireCards(el,rows,kvGrid);
}

function copyText(t,btn){
  const done=()=>{btn.textContent="copied";setTimeout(()=>btn.textContent="copy lat,lon",900);};
  if(navigator.clipboard&&navigator.clipboard.writeText)
    navigator.clipboard.writeText(t).then(done,fallback);
  else fallback();
  function fallback(){
    const ta=document.createElement("textarea");
    ta.value=t;document.body.appendChild(ta);ta.select();
    try{document.execCommand("copy");done();}catch(e){}
    ta.remove();
  }
}
function coordHtml(latE7,lonE7){
  if(typeof latE7!=="number"||typeof lonE7!=="number")
    return '<span class="dim">вЂ”</span>';
  const t=(latE7/1e7).toFixed(6)+","+(lonE7/1e7).toFixed(6);
  return '<span class="mono">'+t+'</span> <button data-copy="'+t+
    '">copy lat,lon</button>';
}

function droneDetail(r){
  const d=r.drone||{}, o=r.operator||{};
  return '<div class="kv">'+
    "<div><b>drone position:</b><span>"+coordHtml(d.lat_e7,d.lon_e7)+
      (r.drone?' <span class="dim">alt '+esc(d.alt_m)+" m</span>":"")+"</span></div>"+
    "<div><b>operator position:</b><span>"+coordHtml(o.lat_e7,o.lon_e7)+"</span></div>"+
    "<div><b>speed / track:</b><span>"+
      (r.drone?esc(d.speed_mps)+" m/s В· "+esc(d.track_deg)+"В°":"вЂ”")+"</span></div>"+
    "<div><b>operator separation:</b><span>"+
      (typeof r.op_separation_m==="number"&&r.op_separation_m>=0?
        esc(r.op_separation_m)+" m":"вЂ”")+"</span></div>"+
    (r.operator_id?"<div><b>operator_id:</b><span>"+esc(r.operator_id)+"</span></div>":"")+
    (r.self_id?"<div><b>self_id:</b><span>"+esc(r.self_id)+"</span></div>":"")+
    "</div>"+kvGrid(r);
}
function renderDrones(){
  const el=$("drones");
  if(!FD.length){el.innerHTML=empty(filterActive()?
    "No drones match the filter.":"No drone_rid records.");return;}
  const rows=FD.slice();sortRows(rows,"threat");
  el.innerHTML='<div class="dlist">'+rows.map(r=>{
    const sep=(typeof r.op_separation_m==="number"&&r.op_separation_m>=0)?
      "operator "+r.op_separation_m+" m":null;
    const meta=vendCell(r)+kindBadge("drone","Drone")+
      span("",esc(r.ua_type_label||("ua_type "+(r.ua_type??"?"))))+
      (sep?span("",esc(sep)):"")+
      (r.drone&&r.drone.alt_m!=null?span("","alt "+esc(r.drone.alt_m)+" m"):"")+
      rssiHtml(r.rssi)+span("",fmtDist(r.distance_dm))+
      span("mono",esc(r.addr||"?"));
    return devCard("drone",null,esc(r.id||"(no UAS id)"),
      threatPill(r.threat_level||0),meta,
      whyHtml(r)+presLine("drone",r.addr),iconSpan(ICON_BY_KIND.drone));
  }).join("")+"</div>";
  wireCards(el,rows,droneDetail);

  el.onclick=e=>{
    const b=e.target.closest("button[data-copy]");
    if(b){e.stopPropagation();copyText(b.dataset.copy,b);}
  };
}

function subjLink(r){
  return macLink(r.target_ref||"",r.target_kind==="wifi_ap"?"wifi":"ble");
}
function macLink(ref,kind){
  if(/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/i.test(ref))
    return '<a class="mono" style="cursor:pointer" data-go="'+anchorId(kind,ref)+
      '" data-tab="s-'+kind+'">'+esc(ref)+"</a>";
  return ref?esc(ref):'<span class="dim">вЂ”</span>';
}





const TWIN_TRIGGER_TEXT={
  open_security_downgrade:"an open network sharing a protected network's SSID",
  tier1_peer_score:"an unrelated-identity peer with a large signal gap",
  beacon_fingerprint_conflict:"a peer whose security/beacon profile disagrees",
  relationship_only_no_twin:"a related pair with no impersonation evidence"
};
const TWIN_REL_TEXT={
  likely_sibling_virtual_bssid:"coordinated virtual BSSIDs on one radio",
  likely_managed_ess_peer:"peers in one managed network",
  known_service_family_peer:"same service family",
  unrelated_same_ssid_peer:"unrelated identities",
  unknown_same_ssid_peer:"relationship unknown"
};


const TWIN_EV_TEXT={
  exact_ssid_match:["identical SSID","for"],
  security_mismatch:["security profiles differ","for"],
  rssi_gap:["large signal gap","for"],
  rsn_mismatch:["encryption differs","for"],
  pmf_mismatch:["management-frame protection differs","for"],
  wps_mismatch:["WPS differs","for"],
  beacon_interval_conflict:["beacon timing differs","for"],
  suffix_delta:["distant MAC suffix","for"],
  conserved_mac_structure:["conserved MAC structure","against"],
  same_public_oui:["same vendor OUI","against"],
  both_laa:["both locally administered","against"],
  same_channel:["same channel","against"],
  same_beacon_interval:["matching beacon timing","against"],
  chain_ssid:["recognised public/chain SSID","against"]
};
function twinEvidenceHtml(f){
  if(!f)return "";
  const ev=f.evidence||{};
  const fors=[],againsts=[];
  for(const k in TWIN_EV_TEXT){
    if(!(k in ev))continue;               
    if(!ev[k])continue;                   
    (TWIN_EV_TEXT[k][1]==="for"?fors:againsts).push(TWIN_EV_TEXT[k][0]);
  }
  let h="";
  const trig=TWIN_TRIGGER_TEXT[f.trigger]||f.trigger||"";
  const rel=TWIN_REL_TEXT[f.relationship_class]||f.relationship_class||"";
  if(trig)h+='<div class="ev"><b>triggered by:</b> '+esc(trig)+"</div>";
  if(rel) h+='<div class="ev"><b>relationship:</b> '+esc(rel)+"</div>";
  if(fors.length)
    h+='<div class="ev"><b>points to impersonation:</b> '+esc(fors.join(", "))+"</div>";
  if(againsts.length)
    h+='<div class="ev"><b>points away from it:</b> '+esc(againsts.join(", "))+"</div>";
  if(f.symmetric)
    h+='<div class="ev dim">Neither network can be named as the impostor from this '+
       "evidence вЂ” treat both as unconfirmed.</div>";
  return h;
}

function twinFindingFor(r){
  if(!r||!r.peer_ref||!r.target_ref)return null;
  const a=r.target_ref,b=r.peer_ref,want=(a<b?a+"|"+b:b+"|"+a);
  for(const {rec} of M.twins.values()){
    const x=rec.target_ref||"",y=rec.peer_ref||"";
    if((x<y?x+"|"+y:y+"|"+x)===want)return rec;
  }
  return null;
}



const ALERT_KEY="sc-alert-prefs";
let alertShowAll=false;
function alertPrefs(){
  try{const p=JSON.parse(localStorage.getItem(ALERT_KEY));
    if(p&&typeof p==="object")return {minSev:p.minSev||"all",
      muted:Array.isArray(p.muted)?p.muted:[]};}catch(e){}
  return {minSev:"all",muted:[]};
}
function alertPrefsSet(p){try{localStorage.setItem(ALERT_KEY,JSON.stringify(p));}catch(e){}}
function renderAlerts(){
  const el=$("alerts");
  if(!FA.length){el.innerHTML=empty(filterActive()?
    "No notifications match the filter.":"No notifications.");return;}
  const sevRank={high:3,medium:2,low:1};
  const rows=FA.slice().sort((a,b)=>
    (sevRank[b.rec.severity]||0)-(sevRank[a.rec.severity]||0));
  const prefs=alertPrefs();
  const minR=sevRank[prefs.minSev]||0;
  const muted=new Set(prefs.muted);
  const passes=a=>!(muted.has(a.rec.rule_id)||(sevRank[a.rec.severity]||0)<minR);
  const shown=alertShowAll?rows:rows.filter(passes);
  const hidden=rows.length-rows.filter(passes).length;
  
  const rules=[];const seen=new Set();
  for(const a of rows){const id=a.rec.rule_id||"?";
    if(!seen.has(id)){seen.add(id);rules.push(id);}}
  let h='<div class="alfbar"><label for="alsev">Show severity</label>'+
    '<select id="alsev"><option value="all">all</option>'+
    '<option value="low">low +</option><option value="medium">medium +</option>'+
    '<option value="high">high only</option></select>'+
    '<div class="alfmutes">'+rules.map(id=>'<button class="almute'+
      (muted.has(id)?" muted":"")+'" data-rule="'+esc(id)+'" title="'+
      (muted.has(id)?"Muted вЂ” click to show":"Click to mute this rule")+'">'+
      esc(id)+"</button>").join("")+"</div></div>";
  if(hidden>0&&!alertShowAll)
    h+='<div class="alfnote">'+hidden+" notification"+(hidden>1?"s":"")+
      " hidden by your filter (still in the data/export). "+
      '<button data-al="showall">Show all</button></div>';
  else if(alertShowAll&&hidden>0)
    h+='<div class="alfnote">Showing all вЂ” '+hidden+" would be filtered. "+
      '<button data-al="applyfilter">Apply filter</button></div>';
  h+=shown.length?'<div class="dlist">'+shown.map(a=>{
    const r=a.rec;
    
    
    
    const meta=span("mono",esc(r.rule_id||"?"))+
      (r.target_ref?subjLink(r):"")+
      (r.peer_ref?span("dim","в†”")+macLink(r.peer_ref,"wifi"):"")+
      (a.n>1?span("",a.n+"Г—"):"");
    let why=twinEvidenceHtml(twinFindingFor(r));
    if(!why&&Array.isArray(r.limitations)&&
       r.limitations.indexOf("legacy_unattributed_alert")>=0)
      why='<div class="ev dim">This capture predates pair evidence, so the peer '+
          "that triggered it was not recorded. It cannot be audited here.</div>";
    return devCard("alert",null,esc(r.message||r.rule_id||"notification"),
      sevPill(r.severity),meta,why||null,iconSpan(ICON_BY_KIND.alert));
  }).join("")+"</div>":
    '<div class="note">All '+rows.length+" notification"+(rows.length>1?"s":"")+
    " hidden by your filter.</div>";
  el.innerHTML=h;
  const sev=$("alsev");if(sev){sev.value=prefs.minSev;
    sev.onchange=()=>{const p=alertPrefs();p.minSev=sev.value;alertPrefsSet(p);
      alertShowAll=false;renderAlerts();};}
  el.querySelectorAll("[data-rule]").forEach(b=>b.onclick=()=>{
    const p=alertPrefs(),id=b.dataset.rule,i=p.muted.indexOf(id);
    if(i>=0)p.muted.splice(i,1);else p.muted.push(id);
    alertPrefsSet(p);renderAlerts();});
  el.querySelectorAll("[data-al]").forEach(b=>b.onclick=()=>{
    alertShowAll=b.dataset.al==="showall";renderAlerts();});
  
  
}




const PACK_KEY="sc-priv-ack";
function ackGet(){try{const a=JSON.parse(localStorage.getItem(PACK_KEY));
  return Array.isArray(a)?a:[];}catch(e){return [];}}
function ackSet(a){try{localStorage.setItem(PACK_KEY,JSON.stringify(a));}catch(e){}}
function ackHas(mac){const m=normMac(mac);return !!m&&ackGet().indexOf(m)>=0;}
function ackToggle(mac){const m=normMac(mac);if(!m)return;
  const a=ackGet(),i=a.indexOf(m);if(i>=0)a.splice(i,1);else a.push(m);ackSet(a);}
let privNewOnly=false;
function toast(msg){
  let t=$("toast");
  if(!t){t=document.createElement("div");t.id="toast";document.body.appendChild(t);}
  t.textContent=msg;t.classList.add("show");
  clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove("show"),3600);
}
function macWatched(mac){const m=normMac(mac);
  return watchGet().some(w=>w.t==="mac"&&normMac(w.v)===m);}

function privActions(mac,rssi){
  if(!mac)return "";
  const watched=macWatched(mac),acked=ackHas(mac);
  const loc='<button type="button" class="pa" data-ploc="'+esc(mac)+'"'+
    ' title="Guided RSSI hunt вЂ” the arms help you home in on this device">locate</button>';
  return '<button type="button" class="pa'+(watched?" on":"")+'" data-pwatch="'+esc(mac)+
      '" title="Flag this MAC on your watchlist">'+(watched?"в… watching":"в† watch")+
      "</button>"+loc+
    '<button type="button" class="pa'+(acked?" done":"")+'" data-pack="'+esc(mac)+
      '" title="Mark reviewed вЂ” hidden under вЂnew onlyвЂ™">'+
      (acked?"вњ“ reviewed":"mark reviewed")+"</button>";
}



let LOC=null;
function locBarPct(r){return r==null?0:Math.max(0,Math.min(100,Math.round((r+90)/60*100)));}
function locTrend(){const h=LOC.hist;if(h.length<3)return 0;
  return h[h.length-1]-h[Math.max(0,h.length-4)];}
function locateOpen(mac,kind,channel,name){
  const ov=$("locov");if(!ov)return;
  LOC={mac:mac,kind:kind==null?1:kind,channel:channel||0,name:name||mac,
    ema:null,hist:[],dirs:{},phase:"start",fails:0,found:false,age:255,samples:0,timer:null};
  if(!ov._w){ov._w=1;
    ov.addEventListener("click",e=>{if(e.target===ov)locateClose();});
    addEventListener("keydown",e=>{if(e.key==="Escape"&&!ov.hidden)locateClose();});}
  ov.hidden=false;locateRender();
  fetch("/api/cluster/locate/start",{method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({mac:LOC.mac,kind:LOC.kind,channel:LOC.channel})})
   .then(r=>{if(!r.ok)throw 0;if(LOC){LOC.phase="hunt";locatePoll();}})
   .catch(()=>{if(LOC){LOC.phase="offline";locateRender();}});
}
function locatePoll(){
  if(!LOC||LOC.phase==="offline")return;
  fetch("/api/cluster/locate",{cache:"no-store"}).then(r=>r.json()).then(s=>{
    if(!LOC)return;
    LOC.found=!!s.found;LOC.age=s.age_ds;LOC.samples=s.samples;
    if(s.found&&s.age_ds<20){
      LOC.ema=LOC.ema==null?s.rssi:Math.round(LOC.ema*0.6+s.rssi*0.4);
      LOC.hist.push(LOC.ema);if(LOC.hist.length>30)LOC.hist.shift();LOC.fails=0;
    }else LOC.fails++;
    locateRender();
  }).catch(()=>{if(LOC)LOC.fails++;})
    .finally(()=>{if(LOC&&LOC.phase!=="offline")LOC.timer=setTimeout(locatePoll,700);});
}
const LOC_DIRS=[["forward","в–І Fwd"],["back","в–ј Back"],["left","в—Ђ Left"],["right","в–¶ Right"]];
function locateRender(){
  const sh=$("locsheet");if(!sh||!LOC)return;
  let h='<div class="lochd"><span><b>Locate</b> '+esc(String(LOC.name).slice(0,22))+
    '</span><button class="locx" data-loc="close" aria-label="Stop">вњ•</button></div>';
  if(LOC.phase==="offline"){
    h+='<div class="locwarn">Live locate needs a running SniffCheck cluster. Join the '+
      "clusterвЂ™s Wi-Fi and open this report there to hunt.</div>"+
      '<div class="locact"><button class="prim" data-loc="close">Close</button></div>';
    sh.innerHTML=h;locBind();return;
  }
  const rssi=LOC.ema,pct=locBarPct(rssi);
  const weak=LOC.fails>3||LOC.age>30||!LOC.found||rssi==null;
  const trend=locTrend();
  h+='<div class="locsig'+(weak?" weak":"")+'"><div class="locbar"><i style="width:'+
    pct+'%"></i></div><div class="locdbm">'+(rssi==null?"вЂ”":rssi+" dBm")+"</div></div>";
  if(weak){
    h+='<div class="locwarn">Weak / intermittent signal вЂ” this device isnвЂ™t transmitting '+
      "often enough to lock reliably (probe-only or rotating-MAC devices are the hardest). "+
      "Move toward where you last saw it and keep watching."+
      (LOC.samples?" В· samples: "+LOC.samples:"")+"</div>";
  }else{
    const w=trend>3?"warm":trend<-3?"cold":"hold";
    h+='<div class="loctemp t'+w+'">'+(w==="warm"?"WARMER в†‘":w==="cold"?"COLDER в†“":"hold")+"</div>";
    if(rssi>-45)h+='<div class="locclose">Very strong вЂ” itвЂ™s right near you. Look around.</div>';
  }
  const rec=Object.keys(LOC.dirs).length;
  h+='<div class="locguide">';
  if(rec<4)h+='<div class="locstep">Stand still, step a few feet one way, then tap that '+
    "arrow вЂ” it snapshots the signal in that direction.</div>";
  h+='<div class="locdirs">'+LOC_DIRS.map(([d,lbl])=>{const v=LOC.dirs[d];
    return '<button class="locdir'+(v!=null?" done":"")+'" data-dir="'+d+'">'+lbl+
      (v!=null?'<span class="dv">'+v+"</span>":"")+"</button>";}).join("")+"</div>";
  if(rec>=2){let best=null,bv=-999;for(const d in LOC.dirs)if(LOC.dirs[d]>bv){bv=LOC.dirs[d];best=d;}
    const lbl={forward:"forward",back:"back",left:"left",right:"right"}[best];
    h+='<div class="locbest">Strongest so far: <b>'+lbl+"</b> вЂ” head that way, then re-check."+
      ' <button class="locre" data-loc="recal">reset</button></div>';}
  h+="</div>";
  h+='<div class="locfoot">Relative to your last move вЂ” this reads signal strength, not a '+
    "compass bearing.</div>"+
    '<div class="locact"><button class="prim" data-loc="close">Stop &amp; close</button></div>';
  sh.innerHTML=h;locBind();
}
function locBind(){
  const sh=$("locsheet");
  sh.querySelectorAll('[data-loc="close"]').forEach(b=>b.onclick=locateClose);
  const re=sh.querySelector('[data-loc="recal"]');if(re)re.onclick=()=>{LOC.dirs={};locateRender();};
  sh.querySelectorAll("[data-dir]").forEach(b=>b.onclick=()=>{
    if(LOC.ema==null){toast("No signal yet вЂ” wait for a reading.");return;}
    LOC.dirs[b.dataset.dir]=LOC.ema;locateRender();});
}
function locateClose(){
  const ov=$("locov");
  if(LOC&&LOC.timer)clearTimeout(LOC.timer);
  fetch("/api/cluster/locate/stop",{method:"POST"}).catch(()=>{});
  LOC=null;if(ov)ov.hidden=true;
}
function pmac(m){return '<span class="mono">'+esc(m||"?")+"</span>";}
function pkv(k,v){return "<span><b>"+esc(k)+"</b>"+esc(v??"вЂ”")+"</span>";}
function pflag(cls,txt){return '<span class="pill '+cls+'">'+esc(txt)+"</span>";}
function prow(cat,title,parts,flag,mac,rssi){
  const acked=mac&&ackHas(mac);
  return '<div class="prow'+(acked?" acked":"")+'" style="--cat:'+cat+'"><div class="pt"><span>'+
    title+"</span>"+(flag||"")+(acked?'<span class="pill done">reviewed</span>':"")+
    '</div><div class="pm">'+parts.join("")+"</div>"+
    (mac?'<div class="pact">'+privActions(mac,rssi)+"</div>":"")+"</div>";
}
const PRIV=[
 {k:"probe_req_log",label:"Probe requests",cat:"var(--wifi)",
  exp:"Devices broadcast the names of Wi-Fi networks they remember. Each "+
      "probed name can hint at places that device has connected before.",
  act:"On your own phone, вЂforgetвЂ™ Wi-Fi networks you no longer use so it stops "+
      "broadcasting their names. For other devices this is a privacy heads-up вЂ” "+
      "watch or locate it if it keeps reappearing.",
  row:r=>prow("var(--wifi)",
    r.ssid?esc(r.ssid):'<span class="hid">(broadcast вЂ” any network)</span>',
    [pmac(r.src_mac),pkv("category",r.category||"вЂ”"),pkv("hits",r.hit_count),
     pkv("scans",(r.first_seen_scan??"?")+"вЂ“"+(r.last_seen_scan??"?")),
     pkv("locally visible",r.local_visible?"yes":"no"),privLinks(r.src_mac)],"",r.src_mac),
  risk:r=>r.hit_count||0},
 {k:"seq_fingerprint_log",label:"Sequence fingerprint",cat:"var(--ble)",
  exp:"Even with a randomized MAC, a device's 802.11 sequence counter can "+
      "chain its frames together over time вЂ” defeating the randomization.",
  act:"Sequence-counter linking is a firmware trait you can't change from here. "+
      "If a вЂlinkableвЂ™ device concerns you, watch it and use locate to identify it.",
  row:r=>prow("var(--ble)",pmac(r.src_mac),
    [pkv("seq range",(r.first_seq??"?")+"вЂ“"+(r.last_seq??"?")),pkv("hits",r.hit_count),
     privLinks(r.src_mac)],
    r.linked?pflag("p2","linkable"):"",r.src_mac),
  risk:r=>r.linked?1:0},
 {k:"ie_signature_log",label:"IE signatures",cat:"var(--track)",
  exp:"The set of capability tags a device advertises forms a fingerprint. "+
      "When the IE-implied vendor disagrees with the MAC's vendor, that can "+
      "flag a spoofed or cloned address.",
  act:"A vendor mismatch can mean a spoofed or cloned MAC. Flag it with watch and "+
      "open its result row to cross-check the hardware against what it claims to be.",
  row:r=>prow("var(--track)",pmac(r.src_mac),
    [pkv("IE vendor",r.ie_vendor||"вЂ”"),pkv("MAC vendor",r.mac_vendor||"вЂ”"),
     pkv("hash",r.ie_hash),pkv("hits",r.hit_count),privLinks(r.src_mac)],
    r.mismatch?pflag("p2","vendor mismatch"):"",r.src_mac),
  risk:r=>r.mismatch?1:0},
 {k:"anqp_log",label:"ANQP / GAS",cat:"var(--drone)",
  exp:"Hotspot 2.0 / ANQP queries can leak a device's identity and its "+
      "preferred (home) networks to anyone listening.",
  act:"A universal (non-randomized) MAC is stable and easy to track. On your own "+
      "device, turn off Hotspot 2.0 / Passpoint auto-join. Otherwise, watch it.",
  row:r=>prow("var(--drone)",pmac(r.src_mac),
    [pkv("universal MAC",r.universal?"yes":"no"),pkv("hits",r.hit_count),
     privLinks(r.src_mac)],
    r.universal?pflag("p1","universal MAC"):"",r.src_mac),
  risk:r=>r.universal?1:0},
 {k:"station_log",label:"Stations",cat:"var(--wifi)",
  exp:"Client devices (phones, laptops, cameras) talking on nearby networks. "+
      "Pulled from cleartext MAC headers вЂ” no decryption. Camera-vendor MACs "+
      "are flagged for the hotel-room / Airbnb hidden-camera check.",
  act:"Camera-vendor MACs are the hidden-camera signal вЂ” use locate and walk the "+
      "room while re-scanning; the signal climbs as you close in. Randomized MACs "+
      "can't be vendor-identified, so a camera may hide behind one.",
  panel:rec=>{
    let det=Array.isArray(rec.stations)?rec.stations.slice():[];
    let h='<div class="pexp" style="--cat:var(--wifi)">'+esc(PRIV_EXP.station_log)+"</div>"+
      pguide("Camera-vendor MACs are the hidden-camera signal вЂ” use locate and walk the "+
      "room while re-scanning; the signal climbs as you close in. Randomized MACs "+
      "can't be vendor-identified.");
    if(privNewOnly)det=det.filter(s=>!ackHas(s.mac));
    h+='<div class="pchips"><span class="pchip">stations<b>'+(rec.total||det.length)+
       "</b></span>"+(rec.cameras?'<span class="pchip">cameras<b>'+rec.cameras+
       "</b></span>":"")+"</div>";
    if(!det.length)return h+'<div class="note">'+(privNewOnly?
      "No un-reviewed stations.":"No client stations recorded.")+"</div>";
    det.sort((a,b)=>(b.camera?1:0)-(a.camera?1:0)||(b.frames||0)-(a.frames||0));
    return h+'<div class="plist">'+det.map(stationRow).join("")+"</div>";
  }},
 {k:"csi",label:"CSI",cat:"var(--ble)",
  exp:"Channel State Information probe (research go/no-go): does the C5 actually "+
      "deliver CSI callbacks, and how big are the records.",
  panel:rec=>{
    let h='<div class="pexp" style="--cat:var(--ble)">'+esc(PRIV_EXP.csi)+"</div>";
    if(!rec.supported)
      return h+'<div class="note">CSI is not compiled into this firmware '+
        "(rebuild with CONFIG_ESP_WIFI_CSI_ENABLED).</div>";
    if(!rec.ran)return h+'<div class="note">CSI is enabled but no window has run.</div>';
    const verdict=rec.cb_count?"GO":"NO-GO";
    return h+'<div class="pchips">'+
      '<span class="pchip">verdict<b>'+verdict+"</b></span>"+
      '<span class="pchip">channel<b>'+rec.channel+"</b></span>"+
      '<span class="pchip">window<b>'+rec.window_ms+"ms</b></span>"+
      '<span class="pchip">callbacks<b>'+rec.cb_count+"</b></span>"+
      '<span class="pchip">len<b>'+rec.len_min+"вЂ“"+rec.len_max+"</b></span>"+
      '<span class="pchip">rssi<b>'+rec.rssi_last+"</b></span></div>";
  }},
];

function stationRow(s){
  return prow("var(--wifi)",pmac(s.mac),
    [pkv("vendor",s.vendor||"вЂ”"),pkv("frames",s.frames),
     pkv("up/dn",(s.up||0)+"/"+(s.dn||0)),pkv("ch",s.channel),
     "<span>"+rssiHtml(s.rssi_best)+"</span>",pkv("BSSID",s.bssid),privLinks(s.mac)],
    (s.camera?pflag("p1","camera"):"")+(s.randomized?pflag("p2","randomized"):""),
    s.mac,typeof s.rssi_best==="number"?s.rssi_best:undefined);
}

const PRIV_EXP={
  station_log:"Client devices (phones, laptops, cameras) seen talking on nearby "+
    "networks, from cleartext MAC headers. A camera-vendor OUI is the hidden-camera "+
    "signal; a randomized MAC can't be vendor-identified.",
  csi:"A short receive-only CSI capture window. GO means the radio delivered CSI "+
    "callbacks; NO-GO means none arrived in the window."};

function pguide(txt){return txt?'<div class="pguide"><b>What you can do</b>'+esc(txt)+
  "</div>":"";}
function privPanel(p){
  const rec=M.logs[p.k];
  if(p.panel)return p.panel(rec);
  let h='<div class="pexp" style="--cat:'+p.cat+'">'+esc(p.exp)+"</div>"+pguide(p.act);
  const chips=o=>o?'<div class="pchips">'+Object.entries(o).map(([k,v])=>
    '<span class="pchip">'+esc(k)+"<b>"+esc(v)+"</b></span>").join("")+"</div>":"";
  h+=chips(rec.totals)+chips(rec.by_category);
  let det=Array.isArray(rec.detail)?rec.detail.slice():null;
  if(!det||!det.length)
    return h+'<div class="note">This capture holds totals only вЂ” no per-device '+
      "rows were recorded.</div>";
  if(privNewOnly)det=det.filter(r=>!ackHas(r.src_mac));
  if(!det.length)return h+'<div class="note">No un-reviewed devices in this analyzer.</div>';
  det.sort((a,b)=>p.risk(b)-p.risk(a));
  return h+'<div class="plist">'+det.map(p.row).join("")+"</div>";
}
let privActiveTab=0;
function renderPrivacy(){
  const avail=PRIV.filter(p=>M.logs[p.k]);
  if(!avail.length){$("privacy").innerHTML=empty("No analyzer log records.");return;}
  if(privActiveTab>=avail.length)privActiveTab=0;
  let h="";
  if(filterActive())
    h+='<div class="note">Aggregate analyzer logs are not device-scoped вЂ” '+
       "the filter above does not narrow this section.</div>";
  const reviewed=ackGet().length;
  h+='<div class="ptoolbar"><button type="button" class="fchip'+(privNewOnly?" on":"")+
     '" id="pnew" title="Hide devices youвЂ™ve marked reviewed">'+
     (privNewOnly?"New only вњ“":"New only")+"</button>"+
     (reviewed?'<button type="button" class="fchip" id="pclr" title="Un-review everything">'+
       "Clear "+reviewed+" reviewed</button>":"")+
     '<span class="small">Watch flags a MAC В· locate helps you home in В· reviewed hides '+
     "it under вЂњnew onlyвЂќ вЂ” all stored in this browser.</span></div>";
  h+='<div class="ctabs" id="ptabs">'+avail.map((p,i)=>{
    const rec=M.logs[p.k];
    const det=rec.detail||rec.stations;
    const n=Array.isArray(det)?det.length:0;
    return '<button class="ctab'+(i===privActiveTab?" act":"")+'" data-i="'+i+'">'+
      esc(p.label)+(n?' <span class="tn">'+n+"</span>":"")+"</button>";
  }).join("")+"</div>";
  h+='<div id="ppanels">'+avail.map((p,i)=>
    '<div class="ppanel" data-i="'+i+'"'+(i===privActiveTab?"":' style="display:none"')+">"+
    privPanel(p)+"</div>").join("")+"</div>";
  $("privacy").innerHTML=h;
  const tabs=$("ptabs"),panels=$("ppanels");
  tabs.querySelectorAll(".ctab").forEach(b=>b.onclick=()=>{
    privActiveTab=+b.dataset.i;
    tabs.querySelectorAll(".ctab").forEach(x=>x.classList.toggle("act",x===b));
    panels.querySelectorAll(".ppanel").forEach(pn=>
      pn.style.display=pn.dataset.i===b.dataset.i?"":"none");
  });
  $("pnew").onclick=()=>{privNewOnly=!privNewOnly;renderPrivacy();};
  const clr=$("pclr");if(clr)clr.onclick=()=>{ackSet([]);renderPrivacy();renderBanner();};
  $("privacy").querySelectorAll("[data-pwatch]").forEach(b=>b.onclick=e=>{
    e.stopPropagation();const mac=b.dataset.pwatch;
    if(macWatched(mac)){watchSet(watchGet().filter(w=>
      !(w.t==="mac"&&normMac(w.v)===normMac(mac))));toast("Removed from watchlist");}
    else{watchAdd("mac",mac);toast("Added to watchlist в…");}
    renderPrivacy();renderBanner();renderWifi();renderBle();});
  $("privacy").querySelectorAll("[data-pack]").forEach(b=>b.onclick=e=>{
    e.stopPropagation();ackToggle(b.dataset.pack);
    toast(ackHas(b.dataset.pack)?"Marked reviewed вњ“":"Reopened");
    renderPrivacy();renderBanner();});
  $("privacy").querySelectorAll("[data-ploc]").forEach(b=>b.onclick=e=>{
    e.stopPropagation();locateOpen(b.dataset.ploc,1,0,b.dataset.ploc);});
}

let chBest=6;

let chList=[];
function renderChannel(){
  $("channel").innerHTML=
    '<div class="pexp">Live tools вЂ” they read the device you are connected to. '+
    'Pick a channel the last scan saw, then capture its stations or run a CSI '+
    'window. A capture uses the radio, so the SniffCheck AP drops while it runs '+
    'and returns on its own вЂ” reconnect and reopen this tab for results. '+
    'Inactive in a saved report.</div>'+
    '<div id="chans" class="pexp">channels found: вЂ¦</div>'+
    '<div id="stalist" class="pexp" style="max-height:200px;overflow:auto">'+
    'loading stationsвЂ¦</div>'+
    '<button onclick="staCap(this)">Capture stations</button> '+
    '<button id="csibtn" onclick="csiRun(this)">Run CSI capture</button>'+
    '<div id="csiline" class="pexp">CSI: вЂ“</div>'+

    '<hr style="border:none;border-top:1px solid var(--line);margin:12px 0">'+
    '<div class="pexp"><b>Packet scan.</b> Sniff every channel in the graph for '+
    '10 s each into one <code>.pcap</code>. The AP drops while it runs and '+
    'returns on its own вЂ” reconnect to download. Receive-only: nothing is '+
    'transmitted.</div>'+
    '<button id="pcapbtn" onclick="pcapRun(this)" disabled>'+
    'Packet scan: 10s per channel</button>'+
    '<div id="pcapline" class="pexp">PCAP: вЂ“</div>';
}

function refreshChannel(){loadChans();loadStaList();loadCsiLine();loadPcapStatus();}
function loadChans(){
  fetch("/api/scan/channels").then(r=>r.json()).then(j=>{
    const c=j.channels||[];
    if(!c.length){
      chList=[];syncPcapBtn();
      $("chans").innerHTML=
        '<span class="dim">No channel activity from the last scan yet.</span>';
      return;
    }

    const rows=c.slice().sort((a,b)=>(a.band||0)-(b.band||0)||a.ch-b.ch);
    let best=0;rows.forEach(x=>{if((x.aps||0)>best)best=x.aps;});
    chBest=rows.reduce((p,x)=>((x.aps||0)>(p.aps||0)?x:p),rows[0]).ch;
    chList=rows.map(x=>x.ch);syncPcapBtn();
    const w=x=>best>0?Math.max(4,Math.round((x.aps||0)/best*100)):0;
    $("chans").innerHTML=
      '<div class="small dim" style="margin-bottom:4px">channels found ('+
        j.count+') вЂ” bars scale to the busiest channel</div>'+
      '<div class="cg">'+rows.map(x=>
        '<div class="cgr'+(x.band===5?' g5':'')+'">'+
          '<span class="lbl"><b>ch '+x.ch+'</b> '+
            (x.band===5?'5 GHz':'2.4 GHz')+'</span>'+
          '<span class="trk"><i style="width:'+w(x)+'%"></i></span>'+
          '<span class="n">'+(x.aps||0)+'</span>'+
        '</div>').join('')+'</div>';
  }).catch(()=>{});
}
function loadStaList(){
  fetch("/api/sta").then(r=>r.json()).then(j=>{
    let h="<b>"+(j.count||0)+"</b> stations"+
      (j.cameras?" В· "+j.cameras+" camera":"")+"<br>";
    (j.stations||[]).slice(0,40).forEach(s=>{
      h+=esc(s.mac)+" "+esc(s.vendor||"?")+(s.randomized?" [rnd]":"")+
        " rssi"+s.rssi_best+" ch"+s.channel+" up/dn "+s.up+"/"+s.dn+
        (s.camera?" CAM":"")+"<br>";
    });
    $("stalist").innerHTML=j.count?h:"no stations from last scan";
  }).catch(()=>{});
}
function loadCsiLine(){
  fetch("/api/csi").then(r=>r.json()).then(j=>{
    let t;
    if(!j.supported){t="CSI: not enabled in firmware (rebuild with WiFi CSI)";
      const b=$("csibtn");if(b){b.disabled=true;b.textContent="CSI not in firmware";}}
    else if(!j.ran)t="CSI: not run yet";
    else t="CSI ch"+j.channel+": "+j.cb_count+" records, len "+j.len_min+"-"+
      j.len_max+" вЂ” "+(j.cb_count?"GO":"NO-GO");
    $("csiline").textContent=t;
  }).catch(()=>{});
}
function askCap(){
  const c=prompt("Channel (one the scan found above):",chBest);
  if(c===null)return null;
  const s=prompt("Seconds (1-30):","5");
  if(s===null)return null;
  return{channel:+c,seconds:+s};
}


const RC_AP_DEPLOY=10;
let rcTick=null;



function rcReconnect(){
  const b=$("rcbtn");
  b.disabled=true;b.textContent="CheckingвЂ¦";
  const ctrl=("AbortController"in window)?new AbortController():null;
  const t=setTimeout(()=>{if(ctrl)ctrl.abort();},4000);
  fetch("/api/status",{cache:"no-store",signal:ctrl?ctrl.signal:undefined})
    .then(r=>{clearTimeout(t);if(r.ok){location.reload();return;}throw 0;})
    .catch(()=>{clearTimeout(t);b.disabled=false;b.className="ready";
      b.textContent="Not back yet вЂ” rejoin the Wi-Fi, then tap";});
}



function startReconnectTimer(scanEta,label){
  const total=Math.max(1,(scanEta|0))+RC_AP_DEPLOY;
  $("rctitle").textContent=label||"Scan running";
  $("rcmsg").innerHTML="The SniffCheck AP drops while the radio scans, then "+
    "relaunches with the <b>same Wi-Fi password</b>. When the timer ends, "+
    "reconnect to the AP and tap below to load the new results.";
  const btn=$("rcbtn");
  btn.disabled=true;btn.className="";btn.textContent="Reconnect & refresh";
  $("rcov").classList.add("on");
  let left=total;
  const paint=()=>{
    $("rcnum").textContent=left>0?left+"s":"Ready";
    $("rcbarf").style.width=Math.round((total-left)/total*100)+"%";
  };
  paint();
  if(rcTick)clearInterval(rcTick);
  rcTick=setInterval(()=>{
    left--;
    if(left<=0){
      left=0;paint();clearInterval(rcTick);rcTick=null;
      btn.disabled=false;btn.className="ready";
      btn.textContent="Reconnect & refresh";
    }else paint();
  },1000);
}
function fireCap(u,b){
  const p=askCap();if(!p)return;
  b.textContent="CapturingвЂ¦ the AP returns on its own вЂ” reconnect to see results";b.disabled=true;
  const label=u.indexOf("csi")>=0?"CSI capture running":"Station capture running";
  fetch(u,{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify(p)})
    .then(r=>r.json())
    .then(j=>startReconnectTimer(j&&j.eta_seconds!=null?j.eta_seconds:p.seconds,label))
    .catch(()=>startReconnectTimer(p.seconds,label));
}
function staCap(b){fireCap("/api/sta/capture",b);}
function csiRun(b){fireCap("/api/csi/run",b);}

function syncPcapBtn(){
  const b=$("pcapbtn");if(!b)return;
  if(b.dataset.busy==="1")return;
  b.disabled=chList.length===0;
}
function loadPcapStatus(){
  fetch("/api/pcap/status").then(r=>r.json())
    .then(pcapStatusLine)
    .catch(()=>{$("pcapline").textContent="PCAP: no packet scan yet";});
}
function pcapStatusLine(j){
  const el=$("pcapline");if(!el)return;
  if(!j||!j.ran){el.textContent="PCAP: no packet scan yet";return;}
  const st=j.status||"unknown";
  let h="<b>PCAP "+esc(st)+"</b>";
  if(j.scan_id!=null)h+=" #"+esc(""+j.scan_id);
  if(j.channels&&j.channels.length)h+=" В· ch "+esc(j.channels.join(","));
  h+=" В· "+(j.seconds_per_channel||10)+"s/ch";
  if(j.duration_s!=null)h+=" В· "+j.duration_s+"s total";
  if(j.packets!=null)h+=" В· "+j.packets+" pkts";
  if(j.dropped)h+=" В· "+j.dropped+" dropped";
  if(j.truncated)h+=" В· "+j.truncated+" truncated";
  if(j.bytes!=null)h+=" В· "+(j.bytes>1024?(j.bytes/1024).toFixed(1)+" KB"
    :j.bytes+" B");
  if((st==="ready"||st==="partial")&&j.bytes>0)
    h+=' В· <a href="'+esc(j.download||"/api/pcap/latest")+'" download>'+
       'Download PCAP</a>';
  el.innerHTML=h;

  if(st!=="running"){const b=$("pcapbtn");if(b)b.dataset.busy="";syncPcapBtn();}
}
function pcapRun(b){
  if(!chList.length)return;
  const n=chList.length,secs=n*10;
  if(!confirm("Packet scan "+n+" channel"+(n>1?"s":"")+" Г— 10s в‰€ "+secs+"s.\n"+
    "The SniffCheck AP will disconnect while it runs, then relaunch itself.\n"+
    "Reconnect afterward to download the .pcap. Continue?"))return;
  b.dataset.busy="1";b.disabled=true;
  b.textContent="Scanning "+n+" channel"+(n>1?"s":"")+
    "вЂ¦ the AP relaunches when it finishes";
  fetch("/api/pcap/run",{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({channels:chList,seconds_per_channel:10})})
    .then(r=>r.json())
    .then(j=>startReconnectTimer(j&&j.eta_seconds!=null?j.eta_seconds:secs,
      "Packet scan running"))
    .catch(()=>startReconnectTimer(secs,"Packet scan running"));
}

function hlJson(obj){
  const j=JSON.stringify(obj,null,1);
  const re=/("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)/g;
  let out="",last=0,m;
  while((m=re.exec(j))){
    out+=esc(j.slice(last,m.index));
    if(m[1]!==undefined)
      out+=m[2]!==undefined
        ?'<span class="jk">'+esc(m[1])+"</span>"+esc(m[2])
        :'<span class="js">'+esc(m[1])+"</span>";
    else if(m[3]!==undefined)out+='<span class="jl">'+esc(m[3])+"</span>";
    else out+='<span class="jnum">'+esc(m[4])+"</span>";
    last=re.lastIndex;
  }
  return out+esc(j.slice(last));
}
const RAW_CAP=400;
function renderRaw(){
  const types=[...new Set(RAW_RECS.map(r=>r.type||"(untyped)"))].sort();
  $("raw").innerHTML='<details><summary>Browse all '+RAW_RECS.length+
    " records</summary>"+
    '<div class="note">type filter: <select id="rawsel">'+
    '<option value="">all types</option>'+
    types.map(t=>"<option>"+esc(t)+"</option>").join("")+
    "</select></div><div id='rawout'></div></details>";
  const out=$("rawout"),sel=$("rawsel");
  function show(){
    const f=sel.value;
    const rs=RAW_RECS.filter(r=>!f||(r.type||"(untyped)")===f);
    let h=rs.length>RAW_CAP?
      '<div class="note">showing first '+RAW_CAP+" of "+rs.length+
      " вЂ” narrow the type filter for the rest</div>":"";
    h+=rs.slice(0,RAW_CAP).map(r=>{
      const t=r.type||"(untyped)",k=KIND[t]||"";
      const sum=fName(r)||fMac(r)||"";
      return '<div class="rrec"><div class="rh"><span class="rt '+k+'">'+
        esc(t)+"</span>"+(sum?'<span class="rs">'+esc(sum)+"</span>":"")+
        "</div><pre>"+hlJson(r)+"</pre></div>";
    }).join("");
    out.innerHTML=h;
  }
  sel.onchange=show;show();
}

const ALL_SECS=["s-banner","s-wifi","s-ble","s-clusters","s-trackers",
  "s-alerts","s-privacy","s-channel","s-compare","s-raw","s-drones"];
let curTab="s-banner";
// Declared here, not beside the rest of the 124e compare code below: renderNav
// reads it, and renderNav runs during the data-island load вЂ” which is earlier in
// this script than the compare block, so a `let` down there is still in its
// temporal dead zone and throws.
let CMP=null;               // {A,B,appeared,gone,changed,rotating,changes}
let CMPBUCKET="appeared";
function availPrivacy(){return PRIV.filter(p=>M.logs[p.k]).length;}

function showTab(){
  for(const id of ALL_SECS)$(id).style.display=(id===curTab)?"":"none";
  $("nav").querySelectorAll(".tab").forEach(b=>
    b.classList.toggle("act",b.dataset.s===curTab));
  if(curTab==="s-channel")refreshChannel();
  if(curTab==="s-compare")renderCompare();
  window.scrollTo(0,0);
}
function renderNav(){

  const secs=[
    ["s-banner","Summary",0,1],
    ["s-wifi","Wi-Fi",FW.length,1],
    ["s-ble","BLE",FB.length,1],
    ["s-clusters","Clusters",FC.length,1],
    ["s-trackers","Trackers",FT.length,1],
    ["s-alerts","Notices",FA.length,1],
    ["s-privacy","Privacy",availPrivacy(),1],
    ["s-channel","Channels",0,1],
    // Only offered once two captures are actually loaded to compare (124e).
    ["s-compare","Compare",CMP?CMP.changes:0,CMP?1:0],
    ["s-raw","Raw",M.total,1],
    ["s-drones","Drones",FD.length],
  ];
  const shown=secs.filter(s=>s[3]||s[2]>0);
  if(!shown.some(s=>s[0]===curTab))curTab=shown[0][0];
  let h="";
  for(const [id,label,n,always] of shown)
    h+='<button class="tab" data-s="'+id+'">'+esc(label)+
      (n>0&&!(id==="s-banner"||id==="s-session")?"<b>"+n+"</b>":"")+"</button>";
  const nav=$("nav");nav.innerHTML=h;nav.style.display="flex";
  $("navtog").style.display="block";
  nav.querySelectorAll(".tab").forEach(b=>
    b.onclick=()=>{curTab=b.dataset.s;showTab();});
  showTab();
}

// Phase 113f вЂ” delegated so a data-go link works wherever it is rendered,
// including inside a card detail that did not exist when the section was wired.
document.addEventListener("click",e=>{
  const a=e.target.closest&&e.target.closest("a[data-go]");
  if(!a||!a.dataset.tab)return;
  e.preventDefault();
  gotoDevice(a.dataset.tab,a.dataset.go);
});

function gotoDevice(tab,elId){
  curTab=tab;showTab();
  const t=$(elId);
  if(t){t.scrollIntoView({block:"center"});
    t.style.outline="2px solid var(--acc)";t.style.outlineOffset="2px";
    setTimeout(()=>{t.style.outline="";t.style.outlineOffset="";},1700);}
}

function gotoCluster(g,i){
  curTab="s-clusters";showTab();
  const root=$("clusters");
  const sub=g==="mr"?"radio":g==="pv"?"priv":g==="ag"?"agg":g==="rc"?"multi":"nic";
  const tb=root.querySelector('.ctab[data-t="'+sub+'"]');
  if(tb&&!tb.classList.contains("act"))tb.click();
  const tile=root.querySelector('.ctile[data-g="'+g+'"][data-i="'+i+'"]');
  if(tile)tile.scrollIntoView({block:"center"});
  // Open the detail popup for this cluster (repoints it if one is already up).
  openClusterModal(g,i);
}

function fillSel(id,anyLabel,pairs){
  const sel=$(id);
  sel.innerHTML='<option value="">'+esc(anyLabel)+"</option>"+
    pairs.map(([v,l])=>'<option value="'+esc(v)+'">'+esc(l)+"</option>").join("");
}

let REPS=[];
let CATS_AVAIL=[];

function renderCatChips(){
  const box=$("catchips");
  if(!box)return;
  if(!CATS_AVAIL.length){box.style.display="none";box.innerHTML="";return;}
  box.style.display="";
  box.innerHTML='<span class="chlbl">Groups:</span>'+
    CATS_AVAIL.map(([c,n])=>
      '<button class="fchip'+(F.cat.includes(c)?" on":"")+'" data-c="'+esc(c)+
      '">'+esc(c)+' <span class="chn">'+n+'</span></button>').join("");
  box.querySelectorAll(".fchip").forEach(b=>b.onclick=()=>{
    const c=b.dataset.c, i=F.cat.indexOf(c);
    if(i<0)F.cat.push(c); else F.cat.splice(i,1);
    renderCatChips();applyFilter();
  });
}

const QUICK=[
  ["Phones",        {cat:["Phones & mobile"]}],
  ["Cameras",       {cat:["Cameras & surveillance","Surveillance OUI (hint)"]}],
  ["Wearables",     {cat:["Wearables"]}],
  ["Drones",        {cat:["Drones"]}],
  ["Trackers",      {cat:["Trackers & beacons"]}],
  ["Cars",          {cat:["Cars"]}],
  ["Enterprise APs",{kind:"wifi",grade:"ent"}],
  ["Consumer APs",  {kind:"wifi",grade:"con"}],
  ["High threat",   {threat:"high"}],
];
function quickAvail(o){
  if(o.cat&&!o.cat.some(c=>CATS_AVAIL.some(([b])=>b===c)))return false;
  if(o.grade&&!REPS.some(r=>fGrade(r)===o.grade))return false;
  if(o.threat&&!REPS.some(r=>fThreat(r)===o.threat))return false;
  return true;
}
function renderQuickChips(){
  const box=$("quickchips");
  if(!box)return;
  const av=QUICK.filter(([,o])=>quickAvail(o));
  if(!av.length){box.style.display="none";box.innerHTML="";return;}
  box.style.display="";
  box.innerHTML='<span class="chlbl">Quick:</span>'+
    av.map(([lbl],i)=>'<button class="qchip" data-i="'+
      QUICK.indexOf(av[i])+'">'+esc(lbl)+'</button>').join("");
  box.querySelectorAll(".qchip").forEach(b=>b.onclick=()=>setQuick(QUICK[+b.dataset.i][1]));
}

function setQuick(o){
  F.q="";F.cat=[];F.kind="";F.vendor="";F.cls="";F.grade="";F.threat="";
  F.band="";F.channel="";
  Object.assign(F,o);
  if(!Array.isArray(F.cat))F.cat=[].concat(F.cat||[]);
  $("q").value=F.q;
  $("f-kind").value=F.kind;$("f-vendor").value=F.vendor;$("f-class").value=F.cls;
  $("f-grade").value=F.grade;$("f-threat").value=F.threat;$("f-band").value=F.band;
  $("f-channel").value=F.channel;
  renderCatChips();applyFilter();
}
function populateFilters(){
  const reps=[...M.wifi.values(),...M.ble.values(),...M.trackers.values(),
    ...M.drones.values()].map(x=>x.rec);
  const uniq=arr=>[...new Set(arr.filter(Boolean))].sort();
  const kinds=[];
  if(M.wifi.size)kinds.push(["wifi","Wi-Fi only"]);
  if(M.ble.size)kinds.push(["ble","BLE only"]);
  if(M.trackers.size)kinds.push(["track","Trackers only"]);
  if(M.drones.size)kinds.push(["drone","Drones only"]);
  fillSel("f-kind","Any category",kinds);

  REPS=reps;
  const catCount={};
  reps.forEach(r=>{const c=fCat(r);if(c)catCount[c]=(catCount[c]||0)+1;});
  CATS_AVAIL=CAT_BUCKETS.map(([c])=>c).filter(c=>catCount[c])
    .map(c=>[c,catCount[c]]);
  renderCatChips();
  renderQuickChips();
  fillSel("f-vendor","Any vendor",uniq(reps.map(fVendor)).map(v=>[v,v]));
  fillSel("f-class","Any device type",uniq(reps.map(fClass)).map(v=>[v,v]));

  const grades=[];
  if(reps.some(r=>fGrade(r)==="ent"))grades.push(["ent","Enterprise-grade"]);
  if(reps.some(r=>fGrade(r)==="con"))grades.push(["con","Consumer-grade"]);
  $("f-grade").style.display=grades.length?"":"none";
  fillSel("f-grade","Any grade",grades);

  const order=["none","low","medium","high"];
  const thr=uniq(reps.map(fThreat)).sort((a,b)=>
    (order.indexOf(a)+1||9)-(order.indexOf(b)+1||9));
  fillSel("f-threat","Any threat level",thr.map(v=>[v,v]));
  const hasWifi=M.wifi.size>0;
  $("f-band").style.display=hasWifi?"":"none";
  fillSel("f-band","Any band",hasWifi?[["2.4","2.4 GHz"],["5","5 GHz"]]:[]);

  const chans=[...new Set([...M.wifi.values()].map(x=>x.rec.channel)
    .filter(c=>c!=null))].sort((a,b)=>a-b);
  $("f-channel").style.display=chans.length?"":"none";
  fillSel("f-channel","Any channel",chans.map(c=>[String(c),"ch "+c]));
}
function readFilters(){
  F.kind=$("f-kind").value;F.vendor=$("f-vendor").value;
  F.cls=$("f-class").value;F.grade=$("f-grade").value;
  F.threat=$("f-threat").value;
  F.band=$("f-band").value;F.channel=$("f-channel").value;
  F.q=$("q").value.trim().toLowerCase();
}
function updateBar(){
  const n=FW.length+FB.length+FT.length+FD.length;
  const tot=M.wifi.size+M.ble.size+M.trackers.size+M.drones.size;
  $("exp").textContent=filterActive()?"Export "+n:"Export";
  $("count").innerHTML=filterActive()
    ? "Showing <b>"+n+"</b> of "+tot+" devices вЂ” Export saves only these"
    : "<b>"+tot+"</b> devices captured";
  const ac=activeCount();
  $("ftog").innerHTML="Filters"+(ac?'<span class="fbadge">'+ac+"</span>":"");
}
function onFilterChange(){readFilters();applyFilter();}

const FSEL=["f-kind","f-vendor","f-class","f-grade","f-threat","f-band","f-channel"];
$("q").oninput=onFilterChange;
FSEL.forEach(id=>$(id).onchange=onFilterChange);
$("ftog").onclick=()=>$("filters").classList.toggle("open");

const SC_TAB_LABELS={"s-banner":"Summary","s-wifi":"Wi-Fi","s-ble":"BLE",
  "s-clusters":"Clusters","s-trackers":"Trackers","s-alerts":"Notifications",
  "s-privacy":"Privacy","s-channel":"Channels","s-raw":"Raw","s-drones":"Drones"};
const SC_HOTLIST_DEFAULT=["s-wifi","s-ble","s-clusters","s-channel"];
function readHotlist(){
  let ids=null;
  try{const v=JSON.parse(localStorage.getItem("sc-hotlist"));
    if(Array.isArray(v))ids=v.filter(id=>SC_TAB_LABELS[id]);}catch(e){}
  return (ids&&ids.length)?ids:SC_HOTLIST_DEFAULT;
}
const hmenu=$("hotmenu");
function buildHotmenu(){
  hmenu.innerHTML=readHotlist().map(id=>
    '<button type="button" role="menuitem" data-h="'+id+'"'+
    (id===curTab?' class="act"':"")+">"+esc(SC_TAB_LABELS[id])+"</button>").join("");
}
$("hotbtn").onclick=()=>{
  if(hmenu.hidden)buildHotmenu();
  hmenu.hidden=!hmenu.hidden;
  $("hotbtn").setAttribute("aria-expanded",hmenu.hidden?"false":"true");
};
hmenu.onclick=e=>{
  const b=e.target.closest("[data-h]");if(!b)return;
  curTab=b.dataset.h;showTab();
  hmenu.hidden=true;$("hotbtn").setAttribute("aria-expanded","false");
};

$("navtog").onclick=()=>{
  const c=document.body.classList.toggle("nav-collapsed");
  $("navtog").textContent=c?"вЊ„ show tabs":"^ hide tabs";
  $("navtog").title=c?"Show tabs":"Hide tabs";
};

let lastScrollY=window.scrollY;
window.addEventListener("scroll",()=>{
  const y=window.scrollY;
  if(y>lastScrollY&&y>60&&!document.body.classList.contains("nav-collapsed")){
    document.body.classList.add("nav-collapsed");
    $("navtog").textContent="вЊ„ show tabs";$("navtog").title="Show tabs";
  }
  lastScrollY=y;
},{passive:true});
$("fclr").onclick=()=>{
  $("q").value="";
  FSEL.forEach(id=>$(id).value="");
  F.cat=[];renderCatChips();
  onFilterChange();
};

function buildExport(){
  const out=[];
  const first=t=>{for(const r of RAW_RECS)if(r.type===t){out.push(r);return;}};
  first("header");first("codebook");
  for(const r of RAW_RECS){
    const k=KIND[r.type];
    if(k&&match(r,k))out.push(r);
  }
  for(const r of RAW_RECS)
    if(r.type==="device_cluster"&&
       (r.members||[]).some(mb=>MATCHED.has(String(mb.mac||"").toLowerCase())))
      out.push(r);
  for(const r of RAW_RECS)
    if(r.type==="alert"){
      const ref=String(r.target_ref||"").toLowerCase();
      if(!filterActive()||MATCHED.has(ref)||
         (F.q&&(r.message||"").toLowerCase().includes(F.q)))out.push(r);
    }
  if(!filterActive())
    for(const r of RAW_RECS)
      if(["probe_req_log","seq_fingerprint_log","ie_signature_log","anqp_log"]
          .includes(r.type))out.push(r);

  if(M.slots.length>1){
    out.push({type:"multiscan_seq",generated_by:"capture_viewer",seq_schema:1,
      captures:SESSIONS.map(s=>s.label),
      slots:M.slots,
      devices:[...M.pres.values()].map(p=>({kind:p.kind,mac:p.mac,
        slots:p.slots,rssi:p.rssiBy,
        presence_conf:(presenceOf(p.kind,p.mac)||{}).conf??null})),
      chains:RC.map(c=>({evidence:c.evidence,rotation:c.rotation,
        overlap_slots:c.overlap,confidence:c.conf,
        members:c.members.map(mb=>({kind:mb.kind,mac:mb.mac,
          first:mb.p.first,last:mb.p.last,slots:mb.p.slots}))}))});
  }
  first("footer");
  return out;
}
function download(name,text,mime){
  const b=new Blob([text],{type:mime||"application/x-ndjson"});
  const u=URL.createObjectURL(b);
  const a=document.createElement("a");
  a.href=u;a.download=name;document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(u),1500);
}

// ---------- Phase 86: multi-format export ----------
// Everything here works on the records already loaded in this browser tab; the
// friendlier formats (CSV/WiGLE) are honest lossy summaries of the same rows the
// report shows, and never invent location the capture did not carry.
function expBase(){
  const sid=(M&&M.header&&M.header.session&&M.header.session.session_id)||"capture";
  return "sniffcheck-"+sid+(filterActive()?"-filtered":"");
}
// A walk (Sniff Walk / Walk Pup) is single-scan-ineligible for WDGWars upload.
function expIsWalk(){
  if(RAW_RECS.some(r=>r&&r.type==="pup_walk"))return true;
  return RAW_RECS.some(r=>r&&(r.type==="wifi_ap"||r.type==="ble_device")&&r.source==="walk");
}
// Served from the device SoftAP (http, no uplink) vs. a saved report opened
// standalone (file://, the browser has its own internet). WDGWars upload needs
// the latter, since the AP page can't reach wdgwars.pl.
function expServedByDevice(){return location.protocol!=="file:"&&deviceOnline();}

function csvEsc(v){
  const s=v==null?"":String(v);
  return /[",\r\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;
}
// Flatten the current filtered Wi-Fi + BLE (+ tracker/drone) view into simple rows.
function expRows(){
  const rows=[];
  for(const r of FW)rows.push({type:"Wi-Fi",name:r.ssid||"",mac:r.bssid||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:r.channel,
    band:r.band_5g?"5GHz":"2.4GHz",auth:r.auth||"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  for(const r of FB)rows.push({type:"BLE",name:r.name||r.fastpair_name||"",mac:r.addr||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:"",band:"BLE",auth:"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  for(const r of FT)rows.push({type:"Tracker",name:fName(r)||"",mac:r.addr||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:"",band:"BLE",auth:"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  for(const r of FD)rows.push({type:"Drone",name:fName(r)||r.id||"",mac:r.addr||"",
    vendor:fVendor(r)||"",cls:fClass(r)||"",rssi:r.rssi,channel:"",band:"",auth:"",
    threat:fThreat(r)||"",grade:fGrade(r)||""});
  return rows;
}
function toSummaryCSV(){
  const cols=["type","name","mac","vendor","class","rssi","channel","band",
    "auth","threat","grade"];
  const lines=[cols.join(",")];
  for(const r of expRows())
    lines.push([r.type,r.name,r.mac,r.vendor,r.cls,r.rssi,r.channel,r.band,
      r.auth,r.threat,r.grade].map(csvEsc).join(","));
  return lines.join("\r\n")+"\r\n";
}

// WiGLE / WigleWifi-1.6 CSV вЂ” same column contract dp_wigle.c writes on the X4,
// so device-scan exports land in WiGLE/WDGWars the same way walk exports do.
const WIGLE_PRE="WigleWifi-1.6,appRelease=1.31.0,model=SniffCheck-C5,"+
  "release=1.31.0,device=esp32c5,display=st7735,board=t-dongle-c5,brand=SniffCheck";
const WIGLE_COLS="MAC,SSID,AuthMode,FirstSeen,Channel,Frequency,RSSI,"+
  "CurrentLatitude,CurrentLongitude,AltitudeMeters,AccuracyMeters,RCOIs,MfgrId,Type";
function chanFreq(ch,band5){
  if(!ch)return "";
  if(band5)return 5000+ch*5;
  return ch===14?2484:2407+ch*5;
}
function wigleAuth(auth,type){
  const a=String(auth||"").toLowerCase();
  if(type!=="Wi-Fi")return "";
  if(a.indexOf("wpa3")>=0)return "[WPA3-SAE][ESS]";
  if(a.indexOf("wpa2")>=0&&a.indexOf("eap")>=0)return "[WPA2-EAP-CCMP][ESS]";
  if(a.indexOf("wpa2")>=0)return "[WPA2-PSK-CCMP][ESS]";
  if(a.indexOf("wpa")>=0)return "[WPA-PSK-TKIP][ESS]";
  if(a.indexOf("wep")>=0)return "[WEP][ESS]";
  return "[ESS]";
}
function wigleTime(){
  const base=(M&&M.header&&M.header.session&&M.header.session.start_us)||null;
  const d=base?new Date(base/1000):new Date();
  const p=n=>String(n).padStart(2,"0");
  return d.getUTCFullYear()+"-"+p(d.getUTCMonth()+1)+"-"+p(d.getUTCDate())+" "+
    p(d.getUTCHours())+":"+p(d.getUTCMinutes())+":"+p(d.getUTCSeconds());
}
function toWigleCSV(loc){
  const lat=loc&&loc.lat!=null?loc.lat:"";
  const lon=loc&&loc.lon!=null?loc.lon:"";
  const ts=wigleTime();
  const lines=[WIGLE_PRE,WIGLE_COLS];
  for(const r of expRows()){
    if(!r.mac)continue;
    const type=r.type==="Wi-Fi"?"WIFI":"BLE";
    lines.push([csvEsc(r.mac),csvEsc(r.name),csvEsc(wigleAuth(r.auth,r.type)),ts,
      r.channel||"",chanFreq(Number(r.channel),r.band==="5GHz"),
      typeof r.rssi==="number"?r.rssi:"",lat,lon,"","",""/*RCOIs*/,
      csvEsc(r.vendor),type].join(","));
  }
  return lines.join("\r\n")+"\r\n";
}

// Save the rendered report as one self-contained offline HTML file: clone this
// document, drop transient overlays, and seed the data island so it reloads the
// exact records on open. No external assets вЂ” everything is already inline.
function saveReportHTML(){
  const jsonl=RAW_RECS.map(r=>JSON.stringify(r)).join("\n");
  const doc=document.documentElement.cloneNode(true);
  const isl=doc.querySelector("#sc-data");
  if(isl)isl.textContent=jsonl;
  ["#expov","#rcov"].forEach(sel=>{const n=doc.querySelector(sel);if(n)n.remove();});
  const body=doc.querySelector("body");
  if(body){body.classList.remove("bar-hidden");
    body.querySelectorAll("style[data-runtime]").forEach(n=>n.remove());}
  const html="<!doctype html>\n"+doc.outerHTML;
  download(expBase()+".html",html,"text/html");
}

// WDGWars API key lives only in this browser (localStorage), never in exports.
const WDG_KEY="sc-wdgwars-key";
function wdgKeyGet(){try{return localStorage.getItem(WDG_KEY)||"";}catch(e){return "";}}
function wdgKeySet(k){try{k?localStorage.setItem(WDG_KEY,k):localStorage.removeItem(WDG_KEY);}catch(e){}}
function wdgKeyMask(k){return k&&k.length>4?"key ending вЂ¦"+k.slice(-4):"linked";}

// ---- export menu UI ----
// #expov / #expsheet live after this script in the DOM, so they don't exist at

let expov=null,expsheet=null;
let expLoc=null; 
function expClose(){if(expov)expov.hidden=true;expLoc=null;}
let expWired=false;
function expWire(){
  expov=$("expov");expsheet=$("expsheet");
  if(expWired)return;expWired=true;
  expov.addEventListener("click",e=>{if(e.target===expov)expClose();});
  addEventListener("keydown",e=>{if(e.key==="Escape"&&expov&&!expov.hidden)expClose();});
}

function expIcon(id){return '<svg class="exi" aria-hidden="true"><use href="#'+id+'"/></svg>';}
function expOptHTML(id,icon,label,desc,tag,net,dis){
  return '<button class="exopt'+(net?" net":"")+'" data-act="'+id+'"'+
    (dis?" disabled":"")+'>'+expIcon(icon)+
    '<span class="ext"><span class="exl">'+esc(label)+'</span>'+
    '<span class="exd">'+desc+'</span></span>'+
    (tag?'<span class="extag">'+esc(tag)+"</span>":"")+"</button>";
}
function renderExportMenu(){
  const n=expRows().length,walk=expIsWalk(),served=expServedByDevice();
  const filt=filterActive();
  let h="<h3>Export</h3><div class=exsub>"+n+" device"+(n===1?"":"s")+
    (filt?" (current filter)":"")+" В· everything stays local unless you upload.</div>";
  h+=expOptHTML("report","ic-privacy","Generate report","Tailored, navigable report with presets вЂ” HTML, PDF, or JSON.","report");
  h+=expOptHTML("json","ic-download","JSON","Full SniffCheck capture вЂ” recommended for re-import / BYOS.","jsonl");
  h+=expOptHTML("csv","ic-download","CSV","Spreadsheet-friendly device summary. Lossy.","csv");
  h+=expOptHTML("wigle","ic-download","WiGLE","WigleWifi-1.6 CSV for wardrive tools. Location only if you add it.","csv");
  h+=expOptHTML("html","ic-download","HTML","Save this report to view offline, raw details included.","html");
  
  const wdgDis=walk||served;
  const wdgDesc=walk?"Single-scan only вЂ” walk geotag/upload waits on GPS hardware.":
    served?"Open a saved report off the device (with internet) to upload.":
    "Upload this single scan to WDGWars. Sends data off-device.";
  h+=expOptHTML("wdgwars","ic-cloud","WDGWars",wdgDesc,"upload",true,wdgDis);
  h+='<button class="excancel" data-act="cancel">Cancel</button>';
  expsheet.innerHTML=h;
  expsheet.querySelectorAll(".exopt,.excancel").forEach(b=>
    b.onclick=()=>expRoute(b.dataset.act));
}
function expRoute(act){
  if(act==="cancel"){expClose();return;}
  if(act==="json"){
    const recs=buildExport();
    if(!recs.length){expClose();alert("Nothing to export for this filter.");return;}
    download(expBase()+".jsonl",recs.map(r=>JSON.stringify(r)).join("\n")+"\n");
    expClose();return;}
  if(act==="csv"){download(expBase()+".csv",toSummaryCSV(),"text/csv");expClose();return;}
  if(act==="wigle"){renderWigleForm();return;}
  if(act==="html"){saveReportHTML();expClose();return;}
  if(act==="wdgwars"){renderWdgForm();return;}
  if(act==="report"){renderReportForm();return;}
}






const REP_SECTIONS=[
  {id:"overview",label:"Overview & verdict",has:()=>true},
  {id:"wifi",    label:"Wi-Fi networks",     has:()=>FW.length>0},
  {id:"ble",     label:"BLE devices",        has:()=>FB.length>0},
  {id:"trackers",label:"Trackers",           has:()=>FT.length>0},
  {id:"drones",  label:"Drones (Remote ID)", has:()=>FD.length>0},
  {id:"clusters",label:"Device clusters",    has:()=>{const P=clusterParts();
    return (P.net.length+P.bt.length+P.mr.length+P.veh.length+RC.length)>0;}},
  {id:"privacy", label:"Privacy exposure",   has:()=>PV.length>0||PRIV.some(p=>M.logs[p.k])},
  {id:"alerts",  label:"Notifications",      has:()=>FA.length>0},
  {id:"timeline",label:"Scan timeline & device transference",has:()=>M.slots.length>1},
];
const REP_PRESETS={
  full:    {label:"Full report",           secs:null},
  privacy: {label:"Privacy report",        secs:["overview","privacy","timeline"]},
  wifible: {label:"Wi-Fi / BLE report",    secs:["overview","wifi","ble","timeline"]},
  rfenv:   {label:"RF environment report", secs:["overview","wifi","ble","trackers","drones","clusters","timeline"]},
  sentinel:{label:"Sentinel report",       secs:["overview","alerts","trackers","privacy"]},
};
let repOpts={preset:"full",secs:null,desc:true,fmt:"html"};
function repAvail(){return REP_SECTIONS.filter(s=>s.has());}
function repPresetSecs(preset){
  const avail=repAvail().map(s=>s.id),p=REP_PRESETS[preset];
  return (p&&p.secs?p.secs:avail).filter(id=>avail.indexOf(id)>=0);
}
function repSelected(){
  const avail=new Set(repAvail().map(s=>s.id)),order=REP_SECTIONS.map(s=>s.id);
  return (repOpts.secs||[]).filter(id=>avail.has(id))
    .sort((a,b)=>order.indexOf(a)-order.indexOf(b));
}

function repTable(cols,rows){
  if(!rows.length)return '<p class="desc">None.</p>';
  return '<div class="tw"><table><thead><tr>'+cols.map(c=>"<th>"+esc(c[0])+"</th>").join("")+
    "</tr></thead><tbody>"+rows.map(r=>"<tr>"+cols.map(c=>"<td>"+
      (r[c[1]]==null?"":r[c[1]])+"</td>").join("")+"</tr>").join("")+"</tbody></table></div>";
}
function repKV(rows){return '<div class="tw"><table class="kv"><tbody>'+
  rows.map(r=>"<tr><th>"+esc(r[0])+"</th><td>"+esc(String(r[1]))+"</td></tr>").join("")+
  "</tbody></table></div>";}

function repOverview(desc){
  let worst=0;for(const r of [...FW,...FB,...FT,...FD])worst=Math.max(worst,r.threat_level||0);
  const rows=[["Wi-Fi networks",FW.length],["BLE devices",FB.length],["Trackers",FT.length],
    ["Drones",FD.length],["Privacy findings",PV.length],
    ["Notifications",FA.reduce((s,a)=>s+(a.n||1),0)],
    ["Worst threat",cb("threat_level",worst).toUpperCase()],
    ["Scans in report",M.slots.length]];
  return {id:"rep-overview",title:"Overview & verdict",
    html:(desc?'<p class="desc">Everything SniffCheck observed passively during this '+
      "capture. Counts reflect "+(filterActive()?"the active filter":"the full capture")+
      ".</p>":"")+repKV(rows)};
}
function repWifi(desc){
  return {id:"rep-wifi",title:"Wi-Fi networks ("+FW.length+")",
    html:(desc?'<p class="desc">Access points and Wi-Fi networks observed.</p>':"")+
    repTable([["SSID","ssid"],["BSSID","bssid"],["Band","band"],["Ch","ch"],["RSSI","rssi"],
      ["Threat","threat"],["Vendor","vendor"]],
      FW.slice(0,600).map(r=>({ssid:esc(r.ssid||"(hidden)"),bssid:esc(r.bssid||""),
        band:r.band_5g?"5 GHz":"2.4 GHz",ch:r.channel==null?"":r.channel,
        rssi:r.rssi==null?"":r.rssi,threat:esc(cb("threat_level",r.threat_level||0)),
        vendor:esc(r.vendor||r.company_name||"")})))};
}
function repBle(desc){
  return {id:"rep-ble",title:"BLE devices ("+FB.length+")",
    html:(desc?'<p class="desc">Bluetooth Low Energy devices observed.</p>':"")+
    repTable([["Name","name"],["Address","addr"],["Category","cat"],["RSSI","rssi"],
      ["Threat","threat"],["Vendor","vendor"]],
      FB.slice(0,600).map(r=>({name:esc(r.name||r.fastpair_name||"вЂ”"),addr:esc(r.addr||""),
        cat:esc(fCat(r)||""),rssi:r.rssi==null?"":r.rssi,
        threat:esc(cb("threat_level",r.threat_level||0)),
        vendor:esc(r.vendor||r.company_name||"")})))};
}
function repTrackers(desc){
  return {id:"rep-trackers",title:"Trackers ("+FT.length+")",
    html:(desc?'<p class="desc">Find My / DULT-class and other trackers. вЂњSeparatedвЂќ '+
      "tags are away from their owner.</p>":"")+
    repTable([["Name","name"],["Address","addr"],["Kind","kind"],["RSSI","rssi"]],
      FT.slice(0,300).map(r=>({name:esc(r.name||"вЂ”"),addr:esc(r.addr||fMac(r)||""),
        kind:esc(r.tracker_kind||""),rssi:r.rssi==null?"":r.rssi})))};
}
function repDrones(desc){
  return {id:"rep-drones",title:"Drones ("+FD.length+")",
    html:(desc?'<p class="desc">Remote ID broadcasts from nearby drones.</p>':"")+
    repTable([["ID","id"],["Address","addr"],["RSSI","rssi"]],
      FD.slice(0,200).map(r=>({id:esc(r.uas_id||r.id||r.description||"вЂ”"),
        addr:esc(fMac(r)||r.mac||""),rssi:r.rssi==null?"":r.rssi})))};
}
function repClusters(desc){
  const P=clusterParts();
  let h=(desc?'<p class="desc">Separate addresses that evidence ties to one device or '+
    "product. Rotation chains show a single device changing its MAC across scans.</p>":"")+
    repKV([["Wi-Fi (NIC) clusters",P.net.length],["BLE (NIC) clusters",P.bt.length],
      ["Multi-radio access points",P.mr.length],["Vehicles",P.veh.length],
      ["Address-rotation chains",RC.length]].filter(r=>r[1]));
  if(RC.length)h+="<h3>Address-rotation chains (device transference)</h3>"+
    repTable([["Addresses","n"],["Evidence","e"],["Confidence","c"]],
      RC.map(c=>({n:c.members.length,e:esc(c.evidence),c:c.conf+"%"})));
  return {id:"rep-clusters",title:"Device clusters",html:h};
}
function repPrivacy(desc){
  let h=(desc?'<p class="desc">Passive identifiers that can re-link a device across '+
    "randomized MACs, or reveal remembered networks.</p>":"");
  const anlz=PRIV.filter(p=>M.logs[p.k]).map(p=>{const d=M.logs[p.k],det=d&&(d.detail||d.stations);
    return [p.label,Array.isArray(det)?det.length:0];});
  h+=repKV([["Devices leaking identity",PV.length],...anlz]);
  if(PV.length)h+="<h3>Devices with leaks</h3>"+
    repTable([["Identity","id"],["MAC","mac"],["Leaks","n"]],
      PV.slice(0,300).map(e=>({id:esc(e.ident?e.ident.s:"вЂ”"),mac:esc(e.mac),n:e.items.length})));
  if(desc){const g=PRIV.filter(p=>M.logs[p.k]&&p.act);
    if(g.length)h+='<h3>What you can do</h3><ul class="guide">'+
      g.map(p=>"<li><b>"+esc(p.label)+".</b> "+esc(p.act)+"</li>").join("")+"</ul>";}
  return {id:"rep-privacy",title:"Privacy exposure",html:h};
}
function repAlerts(desc){
  return {id:"rep-alerts",title:"Notifications ("+FA.reduce((s,a)=>s+(a.n||1),0)+")",
    html:(desc?'<p class="desc">Rule-based notifications raised during the capture.</p>':"")+
    repTable([["Severity","sev"],["Message","msg"],["Rule","rule"],["Count","n"]],
      FA.map(a=>({sev:esc(a.rec.severity||""),msg:esc(a.rec.message||a.rec.rule_id||""),
        rule:esc(a.rec.rule_id||""),n:a.n||1})))};
}
function repTimeline(desc){
  const tot=M.slots.length;
  const per=new Array(tot).fill(0),first=new Array(tot).fill(0),last=new Array(tot).fill(0);
  let stable=0,transient=0;
  for(const p of M.pres.values()){
    for(const s of p.slots)per[s]++;
    first[p.slots[0]]++;last[p.slots[p.slots.length-1]]++;
    const n=p.slots.length;
    if(n>=Math.max(2,Math.ceil(tot*0.8)))stable++;if(n===1)transient++;}
  let h=(desc?'<p class="desc">How the device population changed across '+tot+" scans. "+
    "вЂњNewвЂќ and вЂњLeft afterвЂќ are the discrepancies between consecutive passes; "+
    "rotation chains are the same device changing address (transference).</p>":"");
  h+=repTable([["Scan","s"],["Devices","d"],["New","n"],["Left after","l"]],
    M.slots.map((k,i)=>({s:"#"+(i+1),d:per[i],n:i>0?"+"+first[i]:"вЂ”",
      l:i<tot-1?"в€’"+last[i]:"вЂ”"})));
  h+=repKV([["Stable devices (в‰Ґ80% of scans)",stable],["Transient (seen once)",transient],
    ["Address-rotation chains",RC.length]]);
  if(SESSIONS.length>1)h+='<p class="desc">Captures aggregated: '+
    esc(SESSIONS.map(s=>String(s.label).split(" В· ")[0]).join(", "))+".</p>";
  return {id:"rep-timeline",title:"Scan timeline & device transference",html:h};
}
const REP_BUILD={overview:repOverview,wifi:repWifi,ble:repBle,trackers:repTrackers,
  drones:repDrones,clusters:repClusters,privacy:repPrivacy,alerts:repAlerts,timeline:repTimeline};
function repHead(label){
  const h=M.header||{},d=h.device||{},s=h.session||{};
  return '<header id="top"><h1>'+esc(label)+"</h1>"+
    '<p class="meta">SniffCheck В· '+esc((d.model||"?")+" / "+(d.chip||"?"))+
    " В· fw "+esc(d.fw_version||"?")+"</p>"+
    '<p class="meta">Session '+esc(s.session_id||"?")+" В· "+esc(fmtTs(s.start_us))+
    " В· "+M.slots.length+" scan"+(M.slots.length===1?"":"s")+
    (SESSIONS.length>1?" В· "+SESSIONS.length+" captures":"")+"</p>"+
    '<p class="meta gen">Generated '+esc(new Date().toLocaleString())+
    (filterActive()?" В· filtered view":"")+"</p></header>";
}
function reportCss(){return "*{box-sizing:border-box}body{margin:0 auto;max-width:900px;"+
  "padding:24px;font:15px/1.55 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;"+
  "color:#1a1a1a;background:#fff}header{border-bottom:3px solid #b45309;padding-bottom:12px}"+
  "h1{margin:0 0 4px;font-size:24px}.meta{margin:2px 0;color:#666;font-size:13px}"+
  ".meta.gen{font-size:12px}.toc{background:#faf7f2;border:1px solid #d8d2c8;border-radius:8px;"+
  "padding:12px 18px;margin:16px 0}.toc h2{margin:0 0 6px;font-size:13px;text-transform:uppercase;"+
  "letter-spacing:.5px;color:#666}.toc ol{margin:0;padding-left:20px}.toc a{color:#b45309;"+
  "text-decoration:none}.toc a:hover{text-decoration:underline}section{margin:22px 0}"+
  "section h2{font-size:19px;border-bottom:2px solid #d8d2c8;padding-bottom:4px}"+
  "section h3{font-size:15px;margin:16px 0 6px}.desc{color:#555;font-size:13.5px}"+
  ".tw{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px;margin:8px 0}"+
  "th,td{border:1px solid #d8d2c8;padding:5px 8px;text-align:left;vertical-align:top;"+
  "word-break:break-word}thead th{background:#f3efe9}table.kv th{width:44%;background:#faf7f2}"+
  ".guide{font-size:13.5px}.backtop{font-size:12px;margin:6px 0 0}.backtop a{color:#888;"+
  "text-decoration:none}footer{margin-top:28px;border-top:1px solid #d8d2c8;padding-top:10px;"+
  "color:#666;font-size:12px}@media print{body{padding:0;max-width:none}.backtop{display:none}"+
  ".toc{break-inside:avoid}tr{break-inside:avoid}@page{margin:14mm}}";}
function reportDoc(){
  const secs=repSelected(),desc=repOpts.desc,preset=REP_PRESETS[repOpts.preset]||{label:"Report"};
  const parts=secs.map(id=>REP_BUILD[id](desc)).filter(Boolean);
  const toc='<nav class="toc"><h2>Contents</h2><ol>'+parts.map(p=>
    '<li><a href="#'+p.id+'">'+esc(p.title)+"</a></li>").join("")+"</ol></nav>";
  const body=repHead(preset.label)+toc+parts.map(p=>'<section id="'+p.id+'"><h2>'+
    esc(p.title)+"</h2>"+p.html+'<p class="backtop"><a href="#top">в†‘ back to top</a></p></section>').join("")+
    "<footer>Generated by SniffCheck вЂ” observation-only passive RF report. "+
    "All data stayed on your device.</footer>";
  return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"+
    '<meta name="viewport" content="width=device-width,initial-scale=1">'+
    "<title>"+esc(preset.label)+" вЂ” SniffCheck</title><style>"+reportCss()+
    "</style></head><body>"+body+"</body></html>";
}
function reportJSON(){
  const secs=repSelected(),h=M.header||{},d=h.device||{},s=h.session||{};
  const pick=(r,f)=>{const o={};for(const k of f)o[k]=r[k];return o;};
  const o={tool:"SniffCheck",generated:new Date().toISOString(),preset:repOpts.preset,
    filtered:filterActive(),device:{model:d.model,chip:d.chip,fw:d.fw_version},
    session:{id:s.session_id,start_us:s.start_us,scans:M.slots.length,captures:SESSIONS.length},
    sections:{}};
  const S=o.sections;
  if(secs.includes("overview")){let w=0;for(const r of [...FW,...FB,...FT,...FD])w=Math.max(w,r.threat_level||0);
    S.overview={wifi:FW.length,ble:FB.length,trackers:FT.length,drones:FD.length,
      privacy:PV.length,notifications:FA.reduce((a,x)=>a+(x.n||1),0),worst_threat:cb("threat_level",w)};}
  if(secs.includes("wifi"))S.wifi=FW.map(r=>pick(r,["ssid","bssid","channel","band_5g","rssi","threat_level","vendor"]));
  if(secs.includes("ble"))S.ble=FB.map(r=>pick(r,["name","addr","rssi","threat_level","vendor"]));
  if(secs.includes("trackers"))S.trackers=FT.map(r=>pick(r,["name","addr","rssi","tracker_kind"]));
  if(secs.includes("drones"))S.drones=FD.map(r=>pick(r,["uas_id","id","mac","rssi"]));
  if(secs.includes("clusters")){const P=clusterParts();
    S.clusters={nic_wifi:P.net.length,nic_ble:P.bt.length,radio:P.mr.length,vehicles:P.veh.length,
      rotation_chains:RC.map(c=>({addresses:c.members.length,evidence:c.evidence,confidence:c.conf}))};}
  if(secs.includes("privacy"))S.privacy={
    devices:PV.map(e=>({mac:e.mac,identity:e.ident?e.ident.s:null,leaks:e.items.length})),
    analyzers:PRIV.filter(p=>M.logs[p.k]).map(p=>{const dd=M.logs[p.k],det=dd&&(dd.detail||dd.stations);
      return {label:p.label,records:Array.isArray(det)?det.length:0};})};
  if(secs.includes("alerts"))S.notifications=FA.map(a=>({severity:a.rec.severity,
    message:a.rec.message||a.rec.rule_id,rule:a.rec.rule_id,count:a.n||1}));
  if(secs.includes("timeline")){const tot=M.slots.length,per=new Array(tot).fill(0),
    first=new Array(tot).fill(0),last=new Array(tot).fill(0);
    for(const p of M.pres.values()){for(const sl of p.slots)per[sl]++;
      first[p.slots[0]]++;last[p.slots[p.slots.length-1]]++;}
    S.timeline={scans:tot,per_scan_devices:per,new_by_scan:first,left_by_scan:last,rotation_chains:RC.length};}
  return o;
}
function reportPrint(doc){
  const w=window.open("","_blank");
  if(!w){toast("Allow pop-ups to print/PDF вЂ” or use HTML export instead.");return;}
  w.document.open();w.document.write(doc);w.document.close();w.focus();
  const go=()=>{try{w.print();}catch(e){}};
  if(w.document.readyState==="complete")setTimeout(go,350);
  else w.addEventListener("load",()=>setTimeout(go,350));
}
function buildReport(){
  if(repOpts.fmt==="json"){
    download(expBase()+"-report.json",JSON.stringify(reportJSON(),null,2),"application/json");
    expClose();return;}
  const doc=reportDoc();
  if(repOpts.fmt==="pdf"){reportPrint(doc);return;}   
  download(expBase()+"-report.html",doc,"text/html");expClose();
}
function renderReportForm(){
  const avail=repAvail();
  if(!repOpts.secs)repOpts.secs=repPresetSecs(repOpts.preset);
  let h='<button class="exback" data-act=back>вЂ№ Export</button><h3>Generate report</h3>'+
    '<div class=exsub>A clean, navigable report вЂ” pick a preset, choose sections, export.</div>';
  h+='<label>Preset</label><div class="repsegs">'+Object.keys(REP_PRESETS).filter(k=>
    k!=="sentinel"||clusterOn())    
    .map(k=>
    '<button type="button" class="repseg'+(repOpts.preset===k?" on":"")+'" data-preset="'+k+
    '">'+esc(REP_PRESETS[k].label.replace(" report",""))+"</button>").join("")+"</div>";
  h+='<label>Sections</label><div class="repsecs">'+avail.map(s=>
    '<label class="repchk"><input type="checkbox" data-sec="'+s.id+'"'+
    (repOpts.secs.indexOf(s.id)>=0?" checked":"")+"> "+esc(s.label)+"</label>").join("")+"</div>";
  h+='<label class="repchk repdescrow"><input type="checkbox" id="repdesc"'+
    (repOpts.desc?" checked":"")+"> Include descriptions &amp; guidance</label>";
  h+='<label>Format</label><div class="repsegs">'+
    [["html","HTML"],["pdf","PDF (print)"],["json","JSON"]].map(f=>
      '<button type="button" class="repseg'+(repOpts.fmt===f[0]?" on":"")+'" data-fmt="'+
      f[0]+'">'+f[1]+"</button>").join("")+"</div>";
  h+='<button class="exgo" data-act=gen>Generate report</button>';
  h+='<div class=exnote>HTML is one self-contained file. PDF opens a print view вЂ” choose '+
    "вЂњSave as PDFвЂќ. JSON is structured data. Everything stays on your device.</div>";
  expsheet.innerHTML=h;
  expsheet.querySelector("[data-act=back]").onclick=renderExportMenu;
  expsheet.querySelectorAll("[data-preset]").forEach(b=>b.onclick=()=>{
    repOpts.preset=b.dataset.preset;repOpts.secs=repPresetSecs(repOpts.preset);renderReportForm();});
  expsheet.querySelectorAll("[data-sec]").forEach(c=>c.onchange=()=>{
    const id=c.dataset.sec;
    if(c.checked){if(repOpts.secs.indexOf(id)<0)repOpts.secs.push(id);}
    else repOpts.secs=repOpts.secs.filter(x=>x!==id);});
  expsheet.querySelector("#repdesc").onchange=e=>{repOpts.desc=e.target.checked;};
  expsheet.querySelectorAll("[data-fmt]").forEach(b=>b.onclick=()=>{
    repOpts.fmt=b.dataset.fmt;renderReportForm();});
  expsheet.querySelector("[data-act=gen]").onclick=()=>{
    if(!repSelected().length){toast("Pick at least one section.");return;}
    buildReport();};
}



function locFieldsHTML(){
  return '<label>Device location (optional)</label>'+
    '<div class=exrow><input id=exlat type=text inputmode=decimal placeholder=latitude '+
    (expLoc?'value="'+esc(expLoc.lat)+'"':"")+'>'+
    '<input id=exlon type=text inputmode=decimal placeholder=longitude '+
    (expLoc?'value="'+esc(expLoc.lon)+'"':"")+'></div>'+
    '<button class="excancel" style="margin-top:8px" data-loc=geo>Use my phone location</button>';
}
function locWire(statEl){
  const geo=expsheet.querySelector('[data-loc=geo]');
  if(geo)geo.onclick=()=>{
    if(!navigator.geolocation){statEl.textContent="Geolocation unavailable.";statEl.className="exstat err";return;}
    statEl.textContent="LocatingвЂ¦";statEl.className="exstat";
    navigator.geolocation.getCurrentPosition(p=>{
      expsheet.querySelector("#exlat").value=p.coords.latitude.toFixed(6);
      expsheet.querySelector("#exlon").value=p.coords.longitude.toFixed(6);
      statEl.textContent="Location added.";statEl.className="exstat ok";
    },e=>{statEl.textContent="Location denied.";statEl.className="exstat err";},
    {enableHighAccuracy:true,timeout:10000});
  };
}
function readLoc(){
  const la=expsheet.querySelector("#exlat"),lo=expsheet.querySelector("#exlon");
  const lat=la&&la.value.trim(),lon=lo&&lo.value.trim();
  if(!lat&&!lon)return null;
  const nlat=Number(lat),nlon=Number(lon);
  if(!isFinite(nlat)||!isFinite(nlon))return {bad:true};
  return {lat:nlat,lon:nlon};
}
function renderWigleForm(){
  let h='<button class="exback" data-act=back>вЂ№ Export</button>'+
    "<h3>WiGLE CSV</h3><div class=exsub>WigleWifi-1.6. Add a device location, or "+
    "leave blank for a no-location file.</div>";
  h+=locFieldsHTML();
  h+='<button class="exgo" data-act=go>Download WiGLE CSV</button>';
  h+='<div class="exstat" id=exstat></div>';
  h+='<div class=exnote>Location is honest: blank unless you add it. Walks are not '+
     "geotagged from a single point.</div>";
  expsheet.innerHTML=h;
  const stat=$("exstat");
  expsheet.querySelector('[data-act=back]').onclick=renderExportMenu;
  locWire(stat);
  expsheet.querySelector('[data-act=go]').onclick=()=>{
    const loc=readLoc();
    if(loc&&loc.bad){stat.textContent="Latitude/longitude must be numbers.";stat.className="exstat err";return;}
    download(expBase()+".wigle.csv",toWigleCSV(loc),"text/csv");
    expClose();
  };
}
function renderWdgForm(){
  const key=wdgKeyGet();
  let h='<button class="exback" data-act=back>вЂ№ Export</button>'+
    "<h3>Upload to WDGWars</h3><div class=exsub>Sends this single scan to "+
    "wdgwars.pl as a WigleWifi CSV. Single-scan only.</div>";
  h+='<div class=exform>';
  if(key){
    h+='<div style="font-weight:700;font-size:12.5px">WDGWars: linked ('+esc(wdgKeyMask(key))+')</div>'+
      '<button class="excancel" style="margin-top:8px" data-act=clearkey>Clear saved key</button>';
  }else{
    h+='<label>WDGWars API key</label><input id=exkey type=password '+
      'autocomplete=off placeholder="X-API-Key">';
  }
  h+=locFieldsHTML();
  h+='<button class="exgo" data-act=go'+(key?"":" disabled")+'>Review &amp; upload</button>';
  h+='<div class="exstat" id=exstat></div>';
  h+='<div class=exnote>Your key is stored only in this browser and never written '+
     "into any exported file. Uploading sends the selected scan data to WDGWars.</div>";
  h+="</div>";
  expsheet.innerHTML=h;
  const stat=$("exstat");
  expsheet.querySelector('[data-act=back]').onclick=renderExportMenu;
  locWire(stat);
  const clr=expsheet.querySelector('[data-act=clearkey]');
  if(clr)clr.onclick=()=>{wdgKeySet("");renderWdgForm();};
  const keyIn=expsheet.querySelector("#exkey"),go=expsheet.querySelector('[data-act=go]');
  if(keyIn)keyIn.oninput=()=>{go.disabled=!keyIn.value.trim();};
  go.onclick=()=>{
    let k=key;
    if(keyIn){k=keyIn.value.trim();if(!k)return;wdgKeySet(k);}
    const loc=readLoc();
    if(loc&&loc.bad){stat.textContent="Latitude/longitude must be numbers.";stat.className="exstat err";return;}
    doWdgUpload(k,loc,stat,go);
  };
}
function doWdgUpload(key,loc,stat,go){
  const csv=toWigleCSV(loc);
  stat.textContent="UploadingвЂ¦";stat.className="exstat";go.disabled=true;
  const fd=new FormData();
  fd.append("file",new Blob([csv],{type:"text/csv"}),"wardrive.csv");
  fetch("https://wdgwars.pl/api/v2/upload-csv",{method:"POST",
    headers:{"X-API-Key":key},body:fd})
    .then(r=>{
      if(r.ok){stat.textContent="Upload complete.";stat.className="exstat ok";
        go.disabled=false;return;}
      stat.textContent="Upload failed (HTTP "+r.status+"). Your WiGLE CSV download "+
        "still works for manual upload.";stat.className="exstat err";go.disabled=false;
    })
    .catch(()=>{stat.textContent="Could not reach WDGWars. If this phone is on the "+
      "SniffCheck AP it has no internet вЂ” download the WiGLE CSV and upload it "+
      "yourself.";stat.className="exstat err";go.disabled=false;});
}
$("exp").onclick=()=>{
  if(!M||!RAW_RECS.length){alert("Load a capture first.");return;}
  expWire();
  renderExportMenu();
  expov.hidden=false;
};

let RAW_RECS=[];

let SESSIONS=[];
let DEVICE_SESSION=-1;   
function combinedRecs(){
  const recs=[];let bad=0;
  SESSIONS.forEach((s,si)=>{
    bad+=s.bad;
    for(const r of s.recs){r._sess=si;recs.push(r);}
  });
  return {recs,bad};
}
function srcLabel(){
  if(SESSIONS.length===1)return SESSIONS[0].label;
  return SESSIONS.length+" captures aggregated В· "+
    SESSIONS.map(s=>String(s.label).split(" В· ")[0]).join(" + ");
}
function renderAll(){
  const {recs,bad}=combinedRecs();
  RAW_RECS=recs;
  M=buildModel(recs,bad);
  $("srcinfo").textContent=srcLabel();
  $("drop").style.display="none";
  $("app").style.display="block";
  $("bar").style.display="block";
  $("addcap").style.display="";
  
  $("refbtn").style.display=deviceOnline()?"":"none";
  populateFilters();
  readFilters();
  applyFilter();
  clusterProbe();   
}

function loadText(text,label){
  const {recs,bad}=parseCapture(text);
  if(!recs.length){
    alert("No capture records found in that file"+(bad?" ("+bad+
      " unparseable lines)":"")+".");
    return;
  }
  SESSIONS.push({label,recs,bad});
  renderAll();
}



const NATIVE_TYPES={header:1,footer:1,codebook:1,wifi_ap:1,ble_device:1,tracker:1,
  drone_rid:1,device_cluster:1,alert:1,station_log:1,probe_req_log:1,
  seq_fingerprint_log:1,ie_signature_log:1,anqp_log:1,channel_activity:1,
  pcap_capture:1,pup_walk:1,csi:1,crowd_density:1,multiscan_seq:1,
  environment_indicators:1,law_enforcement_presence:1,medical_responder_presence:1,
  ble_addr_stats:1};
function looksNative(recs){
  for(let i=0;i<recs.length&&i<300;i++)if(recs[i]&&NATIVE_TYPES[recs[i].type])return true;
  return false;
}
function deviceOnline(){return location.protocol==="http:"||location.protocol==="https:";}



function bynorm(m){var h=String(m==null?"":m).replace(/[^0-9A-Fa-f]/g,"").toUpperCase();
  return h.length==12?h.match(/../g).join(":"):"";}
function bysan(v,n){return String(v==null?"":v).replace(/[\t\r\n]+/g," ").trim().slice(0,n);}
function bysrcname(fn){var b=String(fn||"").replace(/\.[^.]*$/,"");return bysan(b,16)||"src";}
function byhasmac(o){var ks=Object.keys(o);for(var i=0;i<ks.length;i++){var lp=ks[i].toLowerCase().split(".").pop();
  if((lp=="mac"||lp=="bssid"||lp=="macaddr"||lp=="addr"||lp=="address")&&bynorm(o[ks[i]]))return true;}return false;}
function byfield(o,names,d){if(!o||typeof o!="object"||d>4)return undefined;var ks=Object.keys(o);
  for(var n=0;n<names.length;n++){for(var i=0;i<ks.length;i++){var kl=ks[i].toLowerCase();
    if(kl==names[n]||kl.split(".").pop()==names[n]){var v=o[ks[i]];if(v!=null&&v!==""&&typeof v!="object")return v;}}}
  for(var i=0;i<ks.length;i++){var v=o[ks[i]];if(v&&typeof v=="object"&&!Array.isArray(v)){var r=byfield(v,names,(d||0)+1);if(r!==undefined)return r;}}return undefined;}
function byrec(o,dsrc){var mac=bynorm(byfield(o,["mac","bssid","macaddr","addr","address"],0));if(!mac)return null;
  var typ=String(byfield(o,["type","phyname","phy","technology"],0)||"").toLowerCase();
  var ssid=byfield(o,["ssid","essid"],0),name=byfield(o,["name","local_name","devname","commonname"],0);
  var ch=parseInt(byfield(o,["channel","chan"],0),10),rssi=parseInt(byfield(o,["rssi","signal","signal_dbm","last_signal","bestlevel"],0),10);
  var auth=byfield(o,["authtype","authmode","auth","capabilities","encryption","security","crypt"],0);
  var w=/wifi|wlan|802\.11|ieee/.test(typ),b=/ble|bt|bluetooth/.test(typ);
  var isw=w||(!b&&(ssid!=null||auth!=null)),isb=b||(!w&&!isw&&name!=null);
  var src=bysan(byfield(o,["source_id","source","node","node_id","sensor","observer"],0),16)||dsrc||"local";
  var lat=bysan(byfield(o,["lat","latitude","trilat","currentlatitude"],0),16);
  var lon=bysan(byfield(o,["lon","lng","longitude","trilong","currentlongitude"],0),16);
  var ts=bysan(byfield(o,["time","timestamp","lasttime","firsttime","firstseen","lastseen"],0),16);
  if(isw)return ["W",mac,bysan(ssid!=null?ssid:name,32),isNaN(ch)?"":ch,isNaN(rssi)?"":rssi,bysan(auth,23),src,lat,lon,ts].join("\t");
  if(isb)return ["B",mac,bysan(name,32),isNaN(rssi)?"":rssi,src,lat,lon,ts].join("\t");
  return ["M",mac,src,lat,lon,ts].join("\t");}
function bywalk(node,out){if(Array.isArray(node)){for(var i=0;i<node.length;i++)bywalk(node[i],out);return;}
  if(node&&typeof node=="object"){if(byhasmac(node)){out.push(node);return;}var ks=Object.keys(node);for(var i=0;i<ks.length;i++)bywalk(node[ks[i]],out);}}
function bysplit(l){var o=[],c="",q=false;for(var i=0;i<l.length;i++){var ch=l[i];
  if(q){if(ch=='"'){if(l[i+1]=='"'){c+='"';i++;}else q=false;}else c+=ch;}
  else if(ch=='"')q=true;else if(ch==","){o.push(c);c="";}else c+=ch;}o.push(c);return o;}
function bycsv(s,dsrc){var ls=s.split(/\r?\n/),h=-1,cols=[];
  for(var i=0;i<ls.length;i++){var fs=bysplit(ls[i]).map(function(x){return x.trim().toLowerCase();});
    if(fs.indexOf("mac")>=0||fs.indexOf("bssid")>=0){h=i;cols=fs;break;}}
  if(h<0)return [];var recs=[];
  for(var i=h+1;i<ls.length;i++){if(!ls[i].trim())continue;var fs=bysplit(ls[i]),o={};
    for(var j=0;j<cols.length;j++)if(j<fs.length)o[cols[j]]=fs[j];var r=byrec(o,dsrc);if(r)recs.push(r);}return recs;}
function bysrcof(p){return p[0]=="W"?p[6]:p[0]=="B"?p[4]:p[2];}
function byone(s,dsrc,seen,out,cnt){var objs=[],recs=[];
  try{objs.push(JSON.parse(s));}catch(e){var ls=s.split(/\r?\n/);for(var i=0;i<ls.length;i++){var t=ls[i].trim();
    if(t&&(t[0]=="{"||t[0]=="[")){try{objs.push(JSON.parse(t));}catch(e2){}}}}
  if(objs.length){var found=[];for(var i=0;i<objs.length;i++)bywalk(objs[i],found);
    for(var i=0;i<found.length;i++){var r=byrec(found[i],dsrc);if(r)recs.push(r);}}
  if(!recs.length)recs=bycsv(s,dsrc);
  for(var i=0;i<recs.length;i++){var p=recs[i].split("\t"),mac=p[1];if(!mac)continue;
    var k=mac+"|"+(bysrcof(p)||dsrc);if(seen[k])continue;seen[k]=1;out.push(recs[i]);
    if(p[0]=="W")cnt[0]++;else if(p[0]=="B")cnt[1]++;else cnt[2]++;}
  var re=/(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}|\b[0-9A-Fa-f]{12}\b/g,m;
  while((m=re.exec(s))){var x=bynorm(m[0]);if(!x)continue;var k=x+"|"+dsrc;if(!seen[k]){seen[k]=1;out.push(["M",x,dsrc,"","",""].join("\t"));cnt[2]++;}}}



function importFiles(files){
  const arr=[...files];
  let pending=arr.length;
  if(!pending)return;
  let added=false;
  const seen={},carved=[],cnt=[0,0,0],foreignNames=[];
  const finish=()=>{
    if(added)renderAll();
    if(!carved.length){
      if(!added)alert("No capture records found in the selected file(s).");
      return;
    }
    if(!deviceOnline()){
      alert(carved.length+" external sighting(s) carved from "+foreignNames.join(", ")+
        ".\n\nImporting a Biscuit/Wigle/Kismet/wardriver scan needs a live SniffCheck to "+
        "re-decode it вЂ” open this report from the SniffCheck AP (http://вЂ¦/report.html) and "+
        "import again. Native SniffCheck exports (.jsonl/.ndjson) can be added offline.");
      return;
    }
    importCarved(carved,foreignNames,cnt);
  };
  arr.forEach(f=>{
    const rd=new FileReader();
    rd.onload=()=>{
      const text=String(rd.result||"");
      const pr=parseCapture(text);
      if(pr.recs.length&&looksNative(pr.recs)){
        SESSIONS.push({label:f.name+" В· "+(f.size/1024).toFixed(1)+" KB",recs:pr.recs,bad:pr.bad});
        added=true;
      }else{
        byone(text,bysrcname(f.name),seen,carved,cnt);
        foreignNames.push(f.name);
      }
      if(--pending===0)finish();
    };
    rd.onerror=()=>{if(--pending===0)finish();};
    rd.readAsText(f);
  });
}



function importCarved(lines,names,cnt){
  const label=names.join(", ");
  fetch("/api/byos/sniffcheck",{method:"POST",
      headers:{"Content-Type":"text/plain"},body:lines.join("\n")})
    .then(r=>r.json().then(j=>{if(!r.ok)throw new Error(j.error||"import failed");return j;}))
    .then(j=>fetch("/api/captures/live.jsonl").then(r=>r.text()).then(txt=>{
      const pr=parseCapture(txt);
      if(!pr.recs.length)throw new Error("import produced no records");
      
      
      
      const sess={label:"SniffCheck device В· +"+label+" ("+
        (j.wifi||0)+" Wi-Fi, "+(j.ble||0)+" BLE, "+(j.mac_only||0)+" MAC-only imported)",
        recs:pr.recs,bad:pr.bad};
      if(DEVICE_SESSION>=0&&DEVICE_SESSION<SESSIONS.length)SESSIONS[DEVICE_SESSION]=sess;
      else{SESSIONS.push(sess);DEVICE_SESSION=SESSIONS.length-1;}
      renderAll();
    }))
    .catch(e=>alert("External import failed: "+(e.message||e)));
}

const drop=$("drop"),fpick=$("fpick");
drop.onclick=()=>fpick.click();
fpick.onchange=()=>{
  if(fpick.files.length)importFiles(fpick.files);
  fpick.value="";
};
$("addcap").onclick=()=>fpick.click();





function refreshDevice(){
  const b=$("refbtn");if(!b||b.disabled)return;
  
  
  if(ACC_ON){
    const label=b.textContent;b.disabled=true;b.textContent="RefreshingвЂ¦";
    
    
    
    const wasPolling=DP.started;
    dpBusy(true);
    accPull().finally(()=>{
      b.disabled=false;b.textContent=label;
      dpBusy(false);if(wasPolling)dpSchedule(300);
    });
    return;
  }
  const label=b.textContent;b.disabled=true;b.textContent="RefreshingвЂ¦";
  dpBusy(true);
  fetch("/api/captures/live.jsonl",{cache:"no-store"})
    .then(r=>{if(!r.ok)throw new Error("device did not answer");return r.text();})
    .then(txt=>{
      const pr=parseCapture(txt);
      if(!pr.recs.length)throw new Error("no records returned");
      const sess={label:"SniffCheck device",recs:pr.recs,bad:pr.bad};
      if(DEVICE_SESSION>=0&&DEVICE_SESSION<SESSIONS.length)SESSIONS[DEVICE_SESSION]=sess;
      else{SESSIONS.push(sess);DEVICE_SESSION=SESSIONS.length-1;}
      renderAll();
    })
    .catch(e=>alert("Refresh failed: "+(e.message||e)))
    .finally(()=>{b.disabled=false;b.textContent=label;
      dpBusy(false);if(DP.started)dpSchedule(300);});
}
$("refbtn").onclick=refreshDevice;












const RS_DB="sc-results",RS_RECS="recs",RS_META="meta";
let ACC_ON=false,ACC_CURSOR=0,ACC_SESSION=null,ACC_GAP=false,rsDB=null,accBusy=false;

function rsOpen(){
  return new Promise((res,rej)=>{
    if(rsDB)return res(rsDB);
    if(!("indexedDB"in window))return rej(new Error("no IndexedDB"));
    const q=indexedDB.open(RS_DB,1);
    q.onupgradeneeded=()=>{const db=q.result;
      if(!db.objectStoreNames.contains(RS_RECS))db.createObjectStore(RS_RECS);
      if(!db.objectStoreNames.contains(RS_META))db.createObjectStore(RS_META);};
    q.onsuccess=()=>{rsDB=q.result;res(rsDB);};
    q.onerror=()=>rej(q.error);
  });
}
function rsTx(store,mode,fn){
  return rsOpen().then(db=>new Promise((res,rej)=>{
    const tx=db.transaction(store,mode),st=tx.objectStore(store);
    let out;try{out=fn(st);}catch(e){rej(e);return;}
    tx.oncomplete=()=>res(out);tx.onerror=()=>rej(tx.error);tx.onabort=()=>rej(tx.error);
  }));
}
function rsGetMeta(){return rsTx(RS_META,"readonly",st=>st.get("state"))
  .then(r=>new Promise(res=>{r.onsuccess=()=>res(r.result||{});r.onerror=()=>res({});}));}
function rsSetMeta(m){return rsTx(RS_META,"readwrite",st=>{st.put(m,"state");});}
function rsClear(){return rsTx(RS_RECS,"readwrite",st=>{st.clear();});}
function rsPutAll(pairs){return rsTx(RS_RECS,"readwrite",st=>{for(const[k,v]of pairs)st.put(v,k);});}
function rsAll(){return rsTx(RS_RECS,"readonly",st=>st.getAll())
  .then(r=>new Promise(res=>{r.onsuccess=()=>res(r.result||[]);r.onerror=()=>res([]);}));}





function accMac(r){const pk=PRES_KINDS[r&&r.type];return pk?pk[1](r):null;}
function accHash(s){let h=5381;for(let i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return(h>>>0).toString(36);}
function accKey(r){
  const mac=accMac(r);
  if(mac)return r.type+"|"+String(mac).toUpperCase();
  return (r&&r.type||"?")+"|"+accHash(JSON.stringify(r));
}
function accIngest(recs){const pairs=[];for(const r of recs)if(r&&typeof r==="object")pairs.push([accKey(r),r]);return pairs;}


function accApply(){
  return rsAll().then(recs=>{
    const sess={label:"SniffCheck cluster В· "+recs.length.toLocaleString()+" accumulated"+
      (ACC_GAP?" В· вљ  some sightings missed":""),recs,bad:0};
    if(DEVICE_SESSION>=0&&DEVICE_SESSION<SESSIONS.length)SESSIONS[DEVICE_SESSION]=sess;
    else{SESSIONS.push(sess);DEVICE_SESSION=SESSIONS.length-1;}
    renderAll();
  });
}

function accStart(){
  if(ACC_ON||!deviceOnline()||!("indexedDB"in window))return;
  ACC_ON=true;
  
  
  const seed=(DEVICE_SESSION>=0&&SESSIONS[DEVICE_SESSION])?SESSIONS[DEVICE_SESSION].recs:[];
  rsGetMeta()
    .then(m=>{ACC_CURSOR=m.cursor||0;ACC_SESSION=m.session||null;
      return seed.length?rsPutAll(accIngest(seed)):null;})
    .then(accApply)
    .catch(e=>{console.warn("accumulator disabled:",e);ACC_ON=false;})
    .finally(()=>{if(ACC_ON)accSchedule();});
}
let accT=null;
function accSchedule(){clearTimeout(accT);accT=setTimeout(accPull,4000);}






function accPull(){
  if(!ACC_ON)return Promise.resolve();
  if(accBusy){accSchedule();return Promise.resolve();}
  accBusy=true;
  return fetch("/api/cluster/devices?since="+ACC_CURSOR,{cache:"no-store"})
    .then(r=>{if(!r.ok)throw new Error("device did not answer");
      const merge=parseInt(r.headers.get("X-SC-Merge"),10),
            sess=r.headers.get("X-SC-Session")||"";
      return r.text().then(t=>({merge,sess,t}));})
    .then(({merge,sess,t})=>{
      let pre=Promise.resolve();
      if(sess&&ACC_SESSION&&sess!==ACC_SESSION){          
        pre=rsClear().then(()=>{ACC_CURSOR=0;ACC_GAP=false;});
      }
      return pre.then(()=>{
        if(sess)ACC_SESSION=sess;
        const pr=parseCapture(t),pairs=accIngest(pr.recs);
        const p=pairs.length?rsPutAll(pairs):Promise.resolve();
        return p.then(()=>{
          if(Number.isFinite(merge)&&merge>=ACC_CURSOR)ACC_CURSOR=merge;
          return rsSetMeta({cursor:ACC_CURSOR,session:ACC_SESSION});
        }).then(()=>pairs.length>0);
      });
    })
    .then(changed=>{ if(changed) return accApply(); })
    .catch(e=>{console.warn("accumulator pull failed:",e&&e.message||e);})
    .finally(()=>{accBusy=false;if(ACC_ON)accSchedule();});
}


drop.ondragover=e=>{e.preventDefault();drop.classList.add("hover");};
drop.ondragleave=()=>drop.classList.remove("hover");
drop.ondrop=e=>{
  e.preventDefault();drop.classList.remove("hover");
  if(e.dataTransfer.files.length)importFiles(e.dataTransfer.files);
};



function setConn(on){
  const c=$("constat");if(!c)return;
  c.classList.toggle("on",!!on);
  const t=c.querySelector(".ctext");if(t)t.textContent=on?"online":"offline";
  c.title=on?"Connected to a SniffCheck device":"Not connected to a SniffCheck device";
}
function pollConn(){
  if(location.protocol==="file:"){setConn(false);return;}
  fetch("/api/status",{cache:"no-store"}).then(r=>setConn(r.ok)).catch(()=>setConn(false));
}
pollConn();setInterval(pollConn,15000);
addEventListener("visibilitychange",()=>{if(!document.hidden)pollConn();});



(function(){
  let lastY=0,ticking=false;
  function upd(){
    const y=window.scrollY||document.documentElement.scrollTop||0;
    if(y<60)document.body.classList.remove("bar-hidden");
    else if(y>lastY+6){document.body.classList.add("bar-hidden");
      
      $("filters").classList.remove("open");}
    else if(y<lastY-6)document.body.classList.remove("bar-hidden");
    lastY=y;ticking=false;
  }
  addEventListener("scroll",()=>{if(!ticking){ticking=true;requestAnimationFrame(upd);}},{passive:true});
})();

(function(){
  const isl=document.getElementById("sc-data");
  if(!isl)return;
  let t=(isl.textContent||"").replace(
  if(t){loadText(t,"locally stored report");DEVICE_SESSION=SESSIONS.length-1;}
})();









function cmpIndex(recs){
  const ix=new Map();
  for(const r of recs){
    let kind,mac,extra="";
    if(r.type==="wifi_ap"){kind="wifi";mac=r.bssid;}
    else if(r.type==="ble_device"){kind="ble";mac=r.addr;}
    else if(r.type==="tracker"){kind="tracker";mac=r.addr;extra="|"+(r.tracker_kind||"");}
    else continue;
    if(!mac)continue;
    const key=kind+"|"+String(mac).toUpperCase()+extra;
    const cur=ix.get(key);
    
    if(!cur||(r.ts_us||0)>=(cur.rec.ts_us||0))ix.set(key,{kind,mac,rec:r});
  }
  return ix;
}





function cmpRotating(e){
  return e.kind==="ble" &&
    (e.rec.addr_subtype==="rpa"||e.rec.addr_subtype==="nrpa");
}

function cmpName(e){
  const r=e.rec;
  if(e.kind==="wifi")return r.ssid||"(hidden network)";
  return r.name||r.vendor||"(unnamed)";
}




const CMP_FIELDS={
  wifi:[["ssid","network name"],["channel","channel"],["auth","security"],
        ["threat_level","threat level"],["twin_class","evil-twin verdict"]],
  ble:[["name","name"],["vendor","vendor"],["threat_level","threat level"]],
  tracker:[["name","name"],["threat_level","threat level"]],
};

const THREAT_WORDS=["none","low","medium","high"];



function cmpLinkKind(e){return e.kind==="wifi"?"wifi":"ble";}

function cmpDiffFields(a,b){
  const out=[];
  for(const [f,label] of (CMP_FIELDS[a.kind]||[])){
    let x=a.rec[f],y=b.rec[f];
    if(x==null&&y==null)continue;
    if(f==="threat_level"){x=THREAT_WORDS[x|0]||x;y=THREAT_WORDS[y|0]||y;}
    if(String(x??"")===String(y??""))continue;
    out.push({label,from:x==null||x===""?"вЂ”":String(x),to:y==null||y===""?"вЂ”":String(y)});
  }
  return out;
}

function buildCompare(sa,sb){
  const A=cmpIndex(sa.recs),B=cmpIndex(sb.recs);
  const appeared=[],gone=[],changed=[];
  const rotating={appeared:0,gone:0};

  for(const [k,e] of B)if(!A.has(k)){
    if(cmpRotating(e))rotating.appeared++;else appeared.push(e);
  }
  for(const [k,e] of A)if(!B.has(k)){
    if(cmpRotating(e))rotating.gone++;else gone.push(e);
  }
  for(const [k,e] of A){
    const f=B.get(k);if(!f)continue;
    const d=cmpDiffFields(e,f);
    if(d.length)changed.push({e:f,was:e,diffs:d});
  }

  const byName=(x,y)=>String(cmpName(x)).localeCompare(String(cmpName(y)));
  appeared.sort(byName);gone.sort(byName);
  changed.sort((x,y)=>byName(x.e,y.e));

  CMP={A:sa,B:sb,appeared,gone,changed,rotating,
       changes:appeared.length+gone.length+changed.length};
  return CMP;
}

function cmpRowHTML(e,detail){
  return '<div class="cmprow"><span class="k '+e.kind+'">'+e.kind+"</span>"+
    '<span class="who">'+esc(cmpName(e))+" "+macLink(e.mac,cmpLinkKind(e))+
    (detail?'<span class="what">'+detail+"</span>":"")+"</span></div>";
}

function renderCompare(){
  const out=$("compare");
  if(!CMP){out.innerHTML='<div class="cmpempty">Pick two saved scans on the '+
    "SniffCheck dashboard's SD Card tab to compare them.</div>";return;}

  const c=CMP;
  let h='<div class="cmphd"><div class="cmpwhich">'+
    '<div><b>earlier</b>'+esc(c.A.label)+"</div>"+
    '<div><b>later</b>'+esc(c.B.label)+"</div></div></div>";

  h+='<div class="cmpbuckets">'+
    ['<button data-b="appeared" class="'+(CMPBUCKET==="appeared"?"act":"")+'"><i>'+
       c.appeared.length+"</i>appeared</button>",
     '<button data-b="gone" class="'+(CMPBUCKET==="gone"?"act":"")+'"><i>'+
       c.gone.length+"</i>no longer seen</button>",
     '<button data-b="changed" class="'+(CMPBUCKET==="changed"?"act":"")+'"><i>'+
       c.changed.length+"</i>changed</button>"].join("")+"</div>";

  
  
  
  if(CMPBUCKET==="gone")
    h+='<div class="cmpnote"><b>Absence is weak evidence.</b> A device here was '+
       "seen in the earlier capture and not the later one. That can mean it left "+
       "вЂ” but it can equally mean it moved out of range, went to sleep, or "+
       "changed its address. Treat this as a question to ask, not a conclusion.</div>";
  if(CMPBUCKET==="appeared"&&(c.rotating.appeared||c.rotating.gone))
    h+='<div class="cmpnote">'+(c.rotating.appeared+c.rotating.gone)+
       " BLE device"+((c.rotating.appeared+c.rotating.gone)===1?" is":"s are")+
       " left out of these lists because they use rotating private addresses. "+
       "The same phone or watch gets a new address roughly every 15 minutes, so "+
       "comparing them by address would report churn that never happened.</div>";

  const list=CMPBUCKET==="appeared"?c.appeared:CMPBUCKET==="gone"?c.gone:c.changed;
  if(!list.length){
    h+='<div class="cmpempty">Nothing '+
      (CMPBUCKET==="changed"?"changed":CMPBUCKET==="gone"?"went missing":"is new")+
      " between these two captures.</div>";
  }else if(CMPBUCKET==="changed"){
    h+=list.map(x=>cmpRowHTML(x.e,x.diffs.map(d=>
      esc(d.label)+": <del>"+esc(d.from)+"</del> в†’ <ins>"+esc(d.to)+"</ins>"
    ).join(" В· "))).join("");
  }else{
    h+=list.map(e=>cmpRowHTML(e,"")).join("");
  }

  out.innerHTML=h;
  out.querySelectorAll(".cmpbuckets button").forEach(b=>
    b.onclick=()=>{CMPBUCKET=b.dataset.b;renderCompare();});
}


function fetchArchive(id){
  return fetch("/api/captures/session/"+encodeURIComponent(id)+".jsonl",
               {cache:"no-store"})
    .then(r=>{if(!r.ok)throw new Error("session "+id+" ("+r.status+")");return r.text();})
    .then(txt=>{
      const {recs,bad}=parseCapture(txt);
      if(!recs.length)throw new Error("session "+id+" holds no records");
      return {id,recs,bad,label:id+" В· "+recs.length+" records"};
    });
}

(function(){
  if(!deviceOnline())return;
  let q;try{q=new URLSearchParams(location.search);}catch(e){return;}
  const cmp=q.get("compare"),load=q.get("load");
  if(!cmp&&!load)return;

  const ids=String(cmp||load).split(",").map(s=>s.trim()).filter(Boolean);
  if(!ids.length)return;
  if(cmp&&ids.length!==2){alert("Compare needs exactly two saved scans.");return;}

  $("srcinfo").textContent="Loading "+ids.length+
    (ids.length===1?" saved scanвЂ¦":" saved scansвЂ¦");

  Promise.all(ids.map(fetchArchive)).then(sess=>{
    
    
    
    SESSIONS=sess.map(s=>({label:s.label,recs:s.recs,bad:s.bad}));
    DEVICE_SESSION=-1;
    
    
    
    if(cmp){
      const t=s=>(s.recs[0]&&s.recs[0].ts_us)||0;
      const [a,b]=sess.slice().sort((x,y)=>t(x)-t(y));
      buildCompare(a,b);
    }
    renderAll();
    if(cmp){curTab="s-compare";showTab();}
  }).catch(err=>{
    alert("Could not open that saved scan: "+(err&&err.message||err)+
          "\n\nThe card may have been removed, or the session deleted.");
    $("srcinfo").textContent="";
  });
})();



(function(){
  try{
    if(new URLSearchParams(location.search).get("dl")==="1"&&RAW_RECS.length)
      setTimeout(saveReportHTML,300);
  }catch(e){}
})();
</script>
<div id="expov" hidden><div id="expsheet" role="dialog" aria-modal="true" aria-label="Export"></div></div>
<div id="smov" hidden><div id="smsheet" role="dialog" aria-modal="true" aria-label="Customize summary"></div></div>
<div id="wlov" hidden><div id="wlsheet" role="dialog" aria-modal="true" aria-label="Watchlist"></div></div>
<div id="locov" hidden><div id="locsheet" role="dialog" aria-modal="true" aria-label="Locate device"></div></div>
<div id="clov" hidden><div id="clsheet" role="dialog" aria-modal="true" aria-label="Cluster detail"></div></div>
<div id="epov" hidden><div id="epsheet" role="dialog" aria-modal="true" aria-label="Detail"></div></div>
<div id="rcov"><div id="rcbox">
  <h3 id="rctitle">Scan running</h3>
  <div class="rcmsg" id="rcmsg"></div>
  <div id="rcnum">вЂ“</div>
  <div id="rcbar"><i id="rcbarf"></i></div>
  <button id="rcbtn" disabled onclick="rcReconnect()">Reconnect &amp; refresh</button>
</div></div>
</body>
</html>
