  txt:"#c0caf5",dim:"#9aa5ce",acc:"#7aa2f7",acc2:"#bb9af7",onacc:"#1a1b26",
  purple:"#bb9af7",sh:"#0f101a",trk:"#0f101a",code:"#16161e",wifi:"#7dcfff",
  ble:"#bb9af7",track:"#ff9e64",drone:"#f7768e",safe:"#9ece6a",ok:"#e0af68",
  caution:"#ff9e64",avoid:"#f7768e"}},
 "monokai":{label:"Monokai",dark:true,vars:{bg:"#272822",panel:"#34352d",
  panelw:"#3e3d32",band:"#49483e",line:"#e6db74",line2:"#75715e",txt:"#f8f8f2",
  dim:"#a59f85",acc:"#fd971f",acc2:"#e6db74",onacc:"#272822",purple:"#ae81ff",
  sh:"#1b1c17",trk:"#1b1c17",code:"#1e1f1c",wifi:"#66d9ef",ble:"#ae81ff",
  track:"#fd971f",drone:"#f92672",safe:"#a6e22e",ok:"#e6db74",caution:"#fd971f",
  avoid:"#f92672"}},
 "catppuccin-mocha":{label:"Catppuccin Mocha",dark:true,vars:{bg:"#1e1e2e",
  panel:"#313244",panelw:"#45475a",band:"#45475a",line:"#cba6f7",line2:"#585b70",
  txt:"#cdd6f4",dim:"#a6adc8",acc:"#89b4fa",acc2:"#cba6f7",onacc:"#1e1e2e",
  purple:"#cba6f7",sh:"#11111b",trk:"#11111b",code:"#181825",wifi:"#89dceb",
  ble:"#cba6f7",track:"#fab387",drone:"#f5c2e7",safe:"#a6e3a1",ok:"#f9e2af",
  caution:"#fab387",avoid:"#f38ba8"}},
 "catppuccin-latte":{label:"Catppuccin Latte",dark:false,vars:{bg:"#eff1f5",
  panel:"#e6e9ef",panelw:"#ccd0da",band:"#ccd0da",line:"#8839ef",line2:"#bcc0cc",
  txt:"#4c4f69",dim:"#6c6f85",acc:"#1e66f5",acc2:"#8839ef",onacc:"#eff1f5",
  purple:"#8839ef",sh:"#bcc0cc",trk:"#ffffff",code:"#dce0e8",wifi:"#04a5e5",
  ble:"#8839ef",track:"#fe640b",drone:"#ea76cb",safe:"#40a02b",ok:"#df8e1d",
  caution:"#fe640b",avoid:"#d20f39"}},
 "one-dark":{label:"One Dark",dark:true,vars:{bg:"#282c34",panel:"#2c313a",
  panelw:"#353b45",band:"#3a3f4b",line:"#61afef",line2:"#4b5263",txt:"#abb2bf",
  dim:"#7f848e",acc:"#61afef",acc2:"#c678dd",onacc:"#282c34",purple:"#c678dd",
  sh:"#1b1e24",trk:"#1b1e24",code:"#21252b",wifi:"#56b6c2",ble:"#c678dd",
  track:"#e5c07b",drone:"#e06c75",safe:"#98c379",ok:"#e5c07b",caution:"#d19a66",
  avoid:"#e06c75"}},
 "github-light":{label:"GitHub Light",dark:false,vars:{bg:"#ffffff",
  panel:"#f6f8fa",panelw:"#eaeef2",band:"#eaeef2",line:"#0969da",line2:"#d0d7de",
  txt:"#1f2328",dim:"#656d76",acc:"#0969da",acc2:"#8250df",onacc:"#ffffff",
  purple:"#8250df",sh:"#d0d7de",trk:"#ffffff",code:"#f6f8fa",wifi:"#0969da",
  ble:"#8250df",track:"#bc4c00",drone:"#bf3989",safe:"#1a7f37",ok:"#9a6700",
  caution:"#bc4c00",avoid:"#cf222e"}},
 "ayu-mirage":{label:"Ayu Mirage",dark:true,vars:{bg:"#1f2430",panel:"#232834",
  panelw:"#2d3441",band:"#343f4c",line:"#ffcc66",line2:"#3d4752",txt:"#cbccc6",
  dim:"#8a9199",acc:"#ffcc66",acc2:"#73d0ff",onacc:"#1f2430",purple:"#d4bfff",
  sh:"#171b24",trk:"#171b24",code:"#1a1f29",wifi:"#73d0ff",ble:"#d4bfff",
  track:"#ffd580",drone:"#f29e74",safe:"#a6cc70",ok:"#ffcc66",caution:"#ffa759",
  avoid:"#f28779"}},
 "everforest-dark":{label:"Everforest Dark",dark:true,vars:{bg:"#2d353b",
  panel:"#343f44",panelw:"#3d484d",band:"#475258",line:"#a7c080",line2:"#4f585e",
  txt:"#d3c6aa",dim:"#9da9a0",acc:"#a7c080",acc2:"#7fbbb3",onacc:"#2d353b",
  purple:"#d699b6",sh:"#232a2e",trk:"#232a2e",code:"#272e33",wifi:"#7fbbb3",
  ble:"#d699b6",track:"#e69875",drone:"#d699b6",safe:"#a7c080",ok:"#dbbc7f",
  caution:"#e69875",avoid:"#e67e80"}},
 "synthwave-84":{label:"Synthwave '84",dark:true,vars:{bg:"#262335",
  panel:"#2a2139",panelw:"#34294f",band:"#423384",line:"#ff7edb",line2:"#495495",
  txt:"#f0eff1",dim:"#b6b1c8",acc:"#ff7edb",acc2:"#36f9f6",onacc:"#262335",
  purple:"#d580ff",sh:"#171520",trk:"#171520",code:"#241b2f",wifi:"#36f9f6",
  ble:"#d580ff",track:"#ff8b39",drone:"#ff7edb",safe:"#72f1b8",ok:"#fede5d",
  caution:"#ff8b39",avoid:"#fe4450"}},
 "hacker-green":{label:"Hacker â€” Neon Green",dark:true,vars:{bg:"#000000",
  panel:"#0a140a",panelw:"#0f1f0f",band:"#123312",line:"#39ff14",line2:"#1f5f1f",
  txt:"#39ff14",dim:"#2fae2f",acc:"#39ff14",acc2:"#7dff5a",onacc:"#001100",
