  caution:"#b6ff5a",avoid:"#ff4d4d"}},
 "hacker-red":{label:"Hacker â€” Blood Red",dark:true,vars:{bg:"#0a0000",
  panel:"#180404",panelw:"#220808",band:"#3a0e0e",line:"#5a1414",line2:"#3a0e0e",
  txt:"#ff5a5a",dim:"#b02a2a",acc:"#ff1a1a",acc2:"#ff8080",onacc:"#200000",
