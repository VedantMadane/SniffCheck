  <symbol id="ic-car" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M4 18v-5c0-1.6.8-2.9 2.1-3.4L7.6 6.4C8 5.6 8.8 5 9.7 5h4.6c.9 0 1.7.6 2.1 1.4l1.5 3.2c1.3.5 2.1 1.8 2.1 3.4v5ZM8.6 8.8h6.8l-1-2.1c-.1-.2-.3-.3-.5-.3h-3.8c-.2 0-.4.1-.5.3ZM6 12h3v1.6H6Zm9 0h3v1.6h-3Z"/><g fill="currentColor"><rect x="5" y="16.5" width="4" height="3.2" rx="1.4"/><rect x="15" y="16.5" width="4" height="3.2" rx="1.4"/></g></symbol>
