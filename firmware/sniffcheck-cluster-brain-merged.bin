let curTheme="sniffcheck";
function applyTheme(id){
  if(id==="custom"){applyCustomReport();curTheme="custom";return;}
  if(!SC_THEMES[id])id="sniffcheck";
  const t=SC_THEMES[id],s=document.body.style;
  SC_VARS.forEach(v=>s.removeProperty("--"+v));
  Object.keys(t.vars).forEach(v=>s.setProperty("--"+v,t.vars[v]));
  s.removeProperty("--bold");s.removeProperty("--ital");s.removeProperty("--bgimg");
  document.body.classList.remove("hasbg");
  document.body.classList.toggle("dark",!!t.dark);
  curTheme=id;
}
// Custom theme authored on the dashboard (sc-custom). Maps the dashboard's var
// names (ink/accent/pname) onto the viewer's (txt/acc/acc2); unset vars fall back
// to the :root / .dark defaults so derived colors stay coherent.
function applyCustomReport(){
  let c;try{c=JSON.parse(localStorage.getItem("sc-custom"));}catch(e){}
  if(!c||!c.v)c={d:0,v:{},img:""};
  const s=document.body.style;
  SC_VARS.forEach(v=>s.removeProperty("--"+v));
  document.body.classList.toggle("dark",!!c.d);
  const map={bg:"bg",panel:"panel",ink:"txt",line:"line",accent:"acc",pname:"acc2",muted:"dim",
    onacc:"onacc",sh:"sh",safe:"safe",caution:"caution",avoid:"avoid",
    wifi:"wifi",ble:"ble",track:"track",drone:"drone"};
  Object.keys(map).forEach(k=>{if(c.v[k])s.setProperty("--"+map[k],c.v[k]);});
  ["bold","ital"].forEach(k=>{if(c.v[k])s.setProperty("--"+k,c.v[k]);else s.removeProperty("--"+k);});
  if(c.img){s.setProperty("--bgimg","url("+c.img+")");document.body.classList.add("hasbg");}
  else{s.removeProperty("--bgimg");document.body.classList.remove("hasbg");}
}
const RFONTS={system:"system-ui,-apple-system,'Segoe UI',Roboto,sans-serif",
  rounded:"ui-rounded,'SF Pro Rounded','Segoe UI Rounded',Nunito,system-ui,sans-serif",
  serif:"Georgia,'Times New Roman',serif",
  mono:"ui-monospace,Menlo,Consolas,'Courier New',monospace",
  condensed:"'Roboto Condensed','Arial Narrow',system-ui,sans-serif",
  comic:"'Comic Sans MS','Comic Neue',cursive"};
function applyFontReport(id){document.body.style.setProperty("--font",RFONTS[id]||RFONTS.system);}
// This viewer has no picker of its own â€” it inherits the theme/font chosen on the
// SniffCheck dashboard (Settings) via the shared sc-theme / sc-custom / sc-font keys.
try{let t=localStorage.getItem("sc-theme");
  if(t==="dark")t="sniffcheck-dark";else if(t==="light")t="sniffcheck";
  applyTheme(t||"sniffcheck");
}catch(e){}
try{applyFontReport(localStorage.getItem("sc-font")||"system");}catch(e){}
// Live-update if the dashboard changes theme/font in another tab.
addEventListener("storage",e=>{if(e&&/^sc-(theme|custom|font)$/.test(e.key||"")){
  try{let t=localStorage.getItem("sc-theme");
    if(t==="dark")t="sniffcheck-dark";else if(t==="light")t="sniffcheck";
    applyTheme(t||"sniffcheck");applyFontReport(localStorage.getItem("sc-font")||"system");
    if(typeof renderBanner==="function")renderBanner();}catch(_){}}});</script>
