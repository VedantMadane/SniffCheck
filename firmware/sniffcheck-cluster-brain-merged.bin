<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SniffCheck capture viewer</title>

<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%2064%2064%27%3E%3Crect%20x%3D%273%27%20y%3D%273%27%20width%3D%2758%27%20height%3D%2758%27%20rx%3D%2714%27%20fill%3D%27%23ffd93b%27%20stroke%3D%27%233f2a14%27%20stroke-width%3D%275%27/%3E%3Cg%20fill%3D%27%233f2a14%27%3E%3Ccircle%20cx%3D%2722%27%20cy%3D%2723%27%20r%3D%275.6%27/%3E%3Ccircle%20cx%3D%2742%27%20cy%3D%2723%27%20r%3D%275.6%27/%3E%3Ccircle%20cx%3D%2714%27%20cy%3D%2736%27%20r%3D%275%27/%3E%3Ccircle%20cx%3D%2750%27%20cy%3D%2736%27%20r%3D%275%27/%3E%3Cpath%20d%3D%27M32%2033c7%200%2012%205%2012%2011%200%205-5%207.5-12%207.5S20%2049%2020%2044c0-6%205-11%2012-11z%27/%3E%3C/g%3E%3C/svg%3E">
<link rel="alternate icon" href="/favicon.ico">
<style>
:root{

  --bg:#ffd93b; --panel:#fff7d6; --panelw:#ffc24a; --band:#ff9e3d;
  --line:#3f2a14; --line2:#8a5a2e;
  --txt:#3f2a14; --dim:#7a5a34; --acc:#ff8a1e; --acc2:#e0701a;
  --purple:#b79cf0;

  --sh:#3f2a14; --trk:#ffffff;

  --onacc:#3f2a14; --code:#fffdf3;

  --wifi:#2f7fd6; --ble:#7a52d6; --track:#e5701a; --drone:#d6489a;

  --safe:#2fa85a; --ok:#e0a500; --caution:#e5701a; --avoid:#d63838;
}

body.dark{
  --bg:#241a0e; --panel:#3a2a18; --panelw:#4a3620; --band:#6b4a1e;
  --line:#c8a25a; --line2:#8a6a3a;
  --txt:#f3e4bf; --dim:#c9ac7e; --acc:#ffcf4a; --acc2:#f0a83a;
  --sh:#100a04; --trk:#0f0a04;
  --onacc:#3f2a14; --code:#1a1206;
  --wifi:#6db3f2; --ble:#b79cf0; --track:#ffab5e; --drone:#f07ac0;
  --safe:#5ec98a; --ok:#ffc94a; --caution:#ff9f5e; --avoid:#ff6b6b;
}

.hotbtn{position:fixed;right:14px;bottom:14px;z-index:9;width:44px;height:44px;
  display:flex;align-items:center;justify-content:center;padding:0;cursor:pointer;
  color:var(--txt);background:var(--panel);border:3px solid var(--line);
  border-radius:12px;box-shadow:3px 3px 0 var(--sh)}
.hotbtn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.hotbtn svg{width:22px;height:22px}

#hotmenu{position:fixed;right:14px;bottom:66px;z-index:9;display:flex;
  flex-direction:column;gap:4px;background:var(--panel);border:3px solid var(--line);
  border-radius:12px;padding:8px;box-shadow:4px 4px 0 var(--sh);
  max-height:70vh;overflow:auto}
#hotmenu[hidden]{display:none}
#hotmenu button{display:flex;align-items:center;gap:9px;text-align:left;
  border:2px solid transparent;background:none;box-shadow:none;padding:7px 10px;
  font-weight:800}
#hotmenu button:active{transform:none}
#hotmenu button.act{border-color:var(--line);background:var(--panelw)}
#hotmenu .tn{margin-left:auto;font-weight:900;opacity:.7}
#expov{position:fixed;inset:0;z-index:40;background:rgba(0,0,0,.45);
  display:flex;align-items:flex-end;justify-content:center}
#expov[hidden]{display:none}
@media(min-width:560px){#expov{align-items:center}}
#expsheet{width:100%;max-width:460px;max-height:88vh;overflow:auto;
  background:var(--panel);border:3px solid var(--line);border-radius:14px 14px 0 0;
  box-shadow:0 -4px 0 var(--sh);padding:16px}
@media(min-width:560px){#expsheet{border-radius:14px;box-shadow:5px 5px 0 var(--sh)}}
#expsheet h3{margin:0 0 3px;font-size:18px}
#expsheet .exsub{color:var(--dim);font-size:12.5px;margin-bottom:12px}
.exopt{display:flex;align-items:center;gap:11px;width:100%;text-align:left;
  border:2.5px solid var(--line);background:var(--panelw);color:var(--txt);
  border-radius:11px;padding:11px 13px;margin-bottom:9px;box-shadow:2px 2px 0 var(--sh);
  font:inherit;cursor:pointer}
.exopt:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.exopt:disabled{opacity:.5;cursor:not-allowed;box-shadow:none;background:var(--panel)}
.exopt .exi{flex:none;width:26px;height:26px;color:var(--acc)}
.exopt.net .exi{color:var(--band)}
.exopt .ext{flex:1;min-width:0}
.exopt .exl{font-weight:800;display:block}
.exopt .exd{display:block;font-size:11.5px;color:var(--dim);line-height:1.35;margin-top:1px}
.exopt .extag{flex:none;font-size:10px;font-weight:800;text-transform:uppercase;
  letter-spacing:.4px;border:1.5px solid currentColor;border-radius:6px;padding:1px 5px;opacity:.8}
.exopt.net .extag{color:var(--band)}
#expsheet .excancel{width:100%;border:2.5px solid var(--line2);background:none;
  color:var(--txt);border-radius:11px;padding:10px;font:inherit;font-weight:800;
  box-shadow:none;margin-top:3px;cursor:pointer}
#expsheet .exform{border-top:2px solid var(--line2);margin-top:6px;padding-top:12px}
#expsheet label{display:block;font-weight:700;font-size:12.5px;margin:8px 0 3px}
#expsheet input[type=text],#expsheet input[type=password],#expsheet input[type=number]{
  width:100%;padding:9px 10px;border:2px solid var(--line2);border-radius:9px;
  background:var(--panel);color:var(--txt);font:inherit}
#expsheet .exrow{display:flex;gap:8px}
#expsheet .exrow>*{flex:1;min-width:0}
.exgo{width:100%;border:2.5px solid var(--line);background:var(--acc);color:var(--onacc,#3f2a14);
  border-radius:11px;padding:11px;font:inherit;font-weight:800;box-shadow:2px 2px 0 var(--sh);
  margin-top:12px;cursor:pointer}
.exgo:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.exgo:disabled{opacity:.55;cursor:not-allowed}
#expsheet .exnote{font-size:11.5px;color:var(--dim);margin-top:9px;line-height:1.4}
#expsheet .exstat{font-size:12.5px;font-weight:700;margin-top:10px;min-height:1.2em}
#expsheet .exstat.err{color:var(--avoid)}
#expsheet .exstat.ok{color:var(--safe)}
#expsheet .exback{background:none;border:none;color:var(--acc2);font:inherit;
  font-weight:800;padding:0;margin-bottom:8px;cursor:pointer;box-shadow:none}
/* Generate-report builder: preset/format segmented buttons + section checkboxes */
#expsheet .repsegs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px}
#expsheet .repseg{flex:1 1 auto;border:2px solid var(--line2);background:var(--panel);
  color:var(--txt);border-radius:9px;padding:8px 10px;font:inherit;font-size:12.5px;
  font-weight:700;cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
#expsheet .repseg.on{background:var(--acc);color:var(--onacc,#3f2a14);border-color:var(--line)}
#expsheet .repseg:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
#expsheet .repsecs{display:flex;flex-direction:column;gap:4px;margin-bottom:4px}
#expsheet .repchk{display:flex;align-items:center;gap:8px;font-weight:600;font-size:13px;
  margin:0;cursor:pointer}
#expsheet .repchk input{width:16px;height:16px;flex:none;accent-color:var(--acc)}
#expsheet .repdescrow{margin:10px 0 2px}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;color:var(--txt);
  font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-family:var(--font,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif);
  padding-bottom:env(safe-area-inset-bottom);
  background:var(--bg)}
/* dashboard-authored custom theme: bold/italic accent colors + bg image */
strong,b{color:var(--bold,inherit)}
em,i{color:var(--ital,inherit)}
body.hasbg::before{content:"";position:fixed;inset:0;z-index:-1;background-image:var(--bgimg);
  background-size:cover;background-position:center;background-attachment:fixed}

h2{font-size:13px;margin:0 0 12px;color:var(--txt);letter-spacing:.7px;
  text-transform:uppercase;font-weight:900;display:flex;align-items:center;gap:8px}

header{display:flex;align-items:center;gap:10px;padding:4px 12px;
  background:var(--panelw);border-bottom:3px solid var(--line);flex-wrap:wrap}
header img{height:40px;width:auto;display:block;border:3px solid var(--line);
  border-radius:11px;background:var(--panel);padding:3px 6px;
  box-shadow:3px 3px 0 var(--sh)}
header .sub{color:var(--dim);font-size:12px;font-weight:700}
.constat{display:inline-flex;align-items:center;gap:5px;font-size:11px;
  font-weight:800;letter-spacing:.02em;color:var(--avoid)}
.constat .cdot{width:9px;height:9px;border-radius:50%;background:var(--avoid);flex:none}
.constat.on{color:var(--safe)}
.constat.on .cdot{background:var(--safe)}

#top{position:sticky;top:0;z-index:8;
  background:var(--bg);border-bottom:3px solid var(--line);
  transition:transform .22s ease}
body.bar-hidden #top{transform:translateY(-100%)}
#bar{display:none;padding:8px 12px;
  padding-top:calc(8px + env(safe-area-inset-top))}
.trow{display:flex;gap:8px;align-items:center}
#q{flex:1;min-width:0;background:var(--panel);border:2px solid var(--line);
  border-radius:10px;color:var(--txt);padding:11px 12px;font-size:16px}
#q::placeholder{color:var(--dim)}
.tbtn{flex:none;background:var(--panel);border:2px solid var(--line);
  color:var(--txt);border-radius:10px;padding:11px 13px;font-size:14px;
  font-weight:800;cursor:pointer;white-space:nowrap;box-shadow:2px 2px 0 var(--sh)}
.tbtn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
a.tbtn{text-decoration:none;display:inline-block}
#exp{background:var(--acc);color:var(--onacc);border:2px solid var(--line);
  font-weight:900}
.fbadge{background:var(--avoid);color:#fff;border:1.5px solid var(--line);
  border-radius:8px;padding:0 6px;font-size:11px;font-weight:800;margin-left:5px}
#filters{display:none;flex-wrap:wrap;gap:8px;margin-top:8px}
#filters.open{display:flex}
#filters select{flex:1 1 44%;min-width:130px}
.fclr{flex:1 1 100%;text-align:center;background:var(--panel);color:var(--avoid);
  border:2px solid var(--line);border-radius:10px;padding:9px;font-weight:800;
  cursor:pointer}
#count{color:var(--dim);font-size:12.5px;margin-top:7px;font-weight:700}
#count b{color:var(--acc2)}

#nav{display:none;gap:8px;flex-wrap:wrap;padding:10px 12px}

#navtog{display:none;width:100%;border:0;border-top:2px solid var(--line);
  border-radius:0;background:var(--bg);color:var(--txt);font-weight:900;
  font-size:12px;letter-spacing:1px;padding:3px;cursor:pointer;box-shadow:none}
#navtog:active{transform:none}
body.nav-collapsed #nav{display:none!important}
.tab{white-space:nowrap;background:var(--panel);border:2px solid var(--line);
  border-radius:12px;padding:9px 6px;font-size:13px;font-weight:800;
  color:var(--txt);cursor:pointer;flex:1 1 calc(25% - 8px);
  min-width:0;text-align:center;box-shadow:2px 2px 0 var(--sh)}
.tab b{color:var(--acc2);font-weight:900;margin-left:6px}
.tab.act{background:var(--acc);color:var(--onacc);
  border-color:var(--line)}
.tab.act b{color:var(--onacc)}
.tab:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}

main{max-width:1180px;margin:0 auto;padding:8px 12px 70px}
section{background:var(--panel);border:3px solid var(--line);
  border-radius:16px;padding:15px 16px;margin:16px 0;scroll-margin-top:72px;
  box-shadow:5px 5px 0 var(--sh)}

#drop{border:3px dashed var(--line);border-radius:14px;padding:46px 20px;
  text-align:center;color:var(--dim);margin:18px 0;cursor:pointer;
  background:var(--panel);box-shadow:5px 5px 0 var(--sh);
  transition:border-color .15s,background .15s}
#drop.hover{border-color:var(--acc2);background:var(--panelw)}
#drop b{color:var(--txt)}
#drop input{display:none}

select{background:var(--panel);color:var(--txt);border:2px solid var(--line);
  border-radius:10px;padding:10px;font-size:15px;font-weight:700;
  -webkit-appearance:none;appearance:none}
button{background:var(--panel);color:var(--txt);border:2px solid var(--line);
  border-radius:9px;padding:6px 12px;font-size:13px;font-weight:700;cursor:pointer;
  box-shadow:2px 2px 0 var(--sh)}
button:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
a{color:var(--acc2);text-decoration:none;font-weight:700}

.sortbar{font-size:12.5px;color:var(--dim);margin:0 0 10px}
.sortbar select{padding:6px 8px;font-size:13px;margin-left:4px}

.seg{display:inline-flex;margin-left:auto;border:2px solid var(--line);
  border-radius:7px;overflow:hidden}
.seg .segb{font:inherit;font-size:10.5px;font-weight:800;letter-spacing:.3px;
  text-transform:uppercase;padding:3px 8px;border:0;cursor:pointer;
  background:var(--panel);color:var(--dim)}
.seg .segb+.segb{border-left:2px solid var(--line)}
.seg .segb.on{background:var(--band);color:var(--line);cursor:default}

.rawtag{display:inline-block;margin-left:6px;padding:1px 6px;font-size:10px;
  font-weight:800;text-transform:uppercase;letter-spacing:.3px;
  border:2px solid var(--line2);border-radius:6px;color:var(--dim)}
.dlist{display:grid;grid-template-columns:1fr;gap:10px}
@media(min-width:760px){
  .dlist{grid-template-columns:repeat(auto-fill,minmax(360px,1fr))}
}
.dcard{min-width:0;background:var(--panel);border:3px solid var(--line);
  border-left:8px solid var(--cat,var(--line));border-radius:13px;
  padding:12px 13px;box-shadow:4px 4px 0 var(--sh)}
.dcard:hover{border-color:var(--line)}
.k-wifi{--cat:var(--wifi)} .k-ble{--cat:var(--ble)}
.k-track{--cat:var(--track)} .k-drone{--cat:var(--drone)}
.k-alert{--cat:var(--avoid)}
.dch{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;
  cursor:pointer}

.dleft{display:flex;gap:7px;align-items:baseline;min-width:0;flex:1}

.dright{display:flex;align-items:center;gap:7px;flex:none}
.draw{flex:none;width:26px;height:26px;padding:0;font-size:13px;font-weight:900;
  line-height:1;color:var(--txt);background:var(--panel);border:2px solid var(--line);
  border-radius:8px;box-shadow:2px 2px 0 var(--sh);cursor:pointer;
  transition:transform .12s}
.draw.open{transform:rotate(180deg)}
@media(prefers-reduced-motion:reduce){.draw{transition:none}}
.dicon{flex:none;font-size:15px;line-height:1.3;font-style:normal}
.ic{width:1em;height:1em;display:inline-block;vertical-align:-.16em;color:currentColor}
.dname{font-size:15.5px;font-weight:700;color:var(--txt);word-break:break-word;
  line-height:1.3}
.dname .hid,.daddr .hid{color:var(--dim);font-weight:500;font-style:italic}
.dmeta{margin-top:7px;font-size:12.5px;color:var(--dim);display:flex;
  flex-wrap:wrap;gap:4px 12px;align-items:center}
.dmeta .vend{color:var(--cat,var(--acc));font-weight:700}
.kb{font-size:10px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;
  color:var(--cat);border:1px solid var(--cat);border-radius:5px;padding:0 5px;
  opacity:.9}
.ddet{margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}

.daddr{font-size:14.5px;font-weight:700;color:var(--txt);min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dvend{margin-top:5px;font-size:13px;font-weight:700;color:var(--cat,var(--acc));
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dvend .pill{margin-left:7px}
.drow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px 10px;
  margin-top:8px;font-size:12.5px}
.dc{min-width:0;display:flex;flex-direction:column;gap:1px}
.dcl{font-size:9.5px;text-transform:uppercase;letter-spacing:.4px;
  color:var(--dim);font-weight:800}
.dcv{color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dcv .bar{width:34px}

.clink{flex:none;width:26px;height:26px;padding:0;color:var(--txt);
  background:var(--panel);border:2px solid var(--line);border-radius:8px;
  box-shadow:2px 2px 0 var(--sh);cursor:pointer;line-height:1}
.clink .ic{width:15px;height:15px;vertical-align:middle}

.plink{font-size:11px;font-weight:800;color:var(--acc2);background:var(--panel);
  border:1.5px solid var(--acc2);border-radius:7px;padding:2px 8px;
  cursor:pointer;margin:2px 4px 2px 0}
.empty{color:var(--dim);font-size:13px}

.why{margin-top:7px;font-size:13px;color:var(--txt);background:var(--panelw);
  border:1.5px solid var(--line);border-radius:9px;padding:8px 11px;
  border-left:4px solid var(--cat,var(--acc))}
.surf{font-weight:800}
.surf .sfx{width:13px;height:13px;vertical-align:-2px;margin-left:4px;opacity:.7}
.idsurf{display:flex;gap:7px;align-items:flex-start;margin:6px 0 2px;
  font-size:12.5px;line-height:1.35;background:var(--panelw);
  border:1.5px solid var(--line);border-left:4px solid var(--acc2);
  border-radius:9px;padding:7px 10px}
.idsurf .ic{width:16px;height:16px;flex:none;margin-top:1px;color:var(--acc2)}
.idsurf.hi{border-left-color:var(--avoid)}
.idsurf.hi .ic{color:var(--avoid)}

.grphdr{grid-column:1/-1;font-size:11px;letter-spacing:.6px;text-transform:uppercase;
  color:var(--dim);font-weight:800;margin:6px 0 0;padding-left:2px}
.grphdr.avoid{color:var(--avoid)} .grphdr.caution{color:var(--caution)}

.pill{display:inline-block;padding:2px 10px;border-radius:11px;font-size:11px;
  font-weight:800;color:#181206;white-space:nowrap}
.p0{background:var(--safe)} .p1{background:var(--ok)}
.p2{background:var(--caution)} .p3{background:var(--avoid);color:#fff}
.pu{background:var(--dim)}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size:12px;color:var(--dim);word-break:break-all}
.dim{color:var(--dim)} .small{font-size:12px}
.sig{font-weight:700}
.sigbar{display:inline-flex;flex-direction:column;align-items:center;gap:2px;vertical-align:middle}
.sigbar .bars{display:flex;align-items:flex-end;gap:2px;height:12px}
.sigbar .bars i{width:3px;border-radius:1px;background:var(--dim);opacity:.3}
.sigbar .bars i:nth-child(1){height:4px}.sigbar .bars i:nth-child(2){height:6.5px}
.sigbar .bars i:nth-child(3){height:9px}.sigbar .bars i:nth-child(4){height:12px}
.sigbar .bars i.on{opacity:1;background:var(--txt)}
.sigbar .rssi{font-size:9px;color:var(--dim);opacity:.7;line-height:1;font-variant-numeric:tabular-nums}
/* Dog Park cluster-control summary card */
.dpwrap{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:0 0 10px}
/* Paused during a manual Refresh: dim the block and block its controls so it reads as "off". */
.dp-busy{opacity:.5;pointer-events:none;filter:grayscale(.4);transition:opacity .15s}
.dphead{font-weight:800;color:var(--acc);display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.dphead .dpico{width:1.15em;height:1.15em;flex:none}
.dparms{font-weight:600;font-size:12px;color:var(--dim);display:flex;flex-wrap:wrap;gap:10px}
.dparmpill{white-space:nowrap}
.dpctrl{display:flex;gap:8px;margin:4px 0 8px;flex-wrap:wrap}
.dpbtn{padding:6px 12px;border:2px solid var(--line);border-radius:8px;background:var(--panelw);color:var(--txt);font-weight:700;cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.dpbtn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.dplog{max-height:38vh;overflow-y:auto;border:1px solid var(--line);border-radius:8px;background:var(--bg);padding:2px 8px;font-family:ui-monospace,Menlo,Consolas,monospace}
.dprow{display:flex;align-items:center;gap:8px;padding:3px 0;border-top:1px solid var(--line2)}
.dprow:first-child{border-top:0}
.dprow .dicon .ic{width:1.2em;height:1.2em;vertical-align:-.22em}
.dpnm{flex:1 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px}
.dparm{color:var(--acc2)}
.dpt{flex:none;color:var(--dim);font-size:11px;font-variant-numeric:tabular-nums}
.bar{display:inline-block;width:54px;height:8px;background:var(--trk);border-radius:5px;
  overflow:hidden;vertical-align:middle;margin-right:4px;border:1.5px solid var(--line)}
.bar i{display:block;height:100%}

/* ePup learning-brain summary card (B9) */
.epwrap{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:0 0 10px}
.ephead{font-weight:800;color:var(--acc);display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.ephead .epico{width:1.15em;height:1.15em;flex:none}
.epsub{font-weight:600;font-size:12px;color:var(--dim)}
.epstats{display:flex;flex-wrap:wrap;gap:6px 14px;margin:2px 0 8px}
.epstat{display:flex;flex-direction:column;font-size:11px;color:var(--dim);line-height:1.15}
.epstat b{font-size:15px;color:var(--txt);font-weight:800;font-variant-numeric:tabular-nums}
.epplace{display:flex;align-items:center;gap:8px;font-size:12.5px;padding:7px 9px;border-radius:8px;
  border:1px solid var(--line);background:var(--bg)}
.epplace .ic{width:1.2em;height:1.2em;flex:none;opacity:.85}
.epplace.tone-known{border-color:var(--safe);color:var(--safe)}
.epplace.tone-new{border-color:var(--acc2);color:var(--acc2)}
.epplace.tone-fam{border-color:var(--acc);color:var(--acc)}
.epplace.tone-dim{color:var(--dim)}
.epclass{display:flex;gap:6px;margin-top:8px}
.epclass input{flex:1;min-width:0;padding:6px 9px;border:1.5px solid var(--line);border-radius:8px;
  background:var(--panelw);color:var(--txt);font-size:13px}
.epclass button{padding:6px 12px;border:2px solid var(--line);border-radius:8px;background:var(--panelw);
  color:var(--txt);font-weight:700;cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.epclass button:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
/* ePup mascot animation (105l). One embedded 640x800 sprite sheet (/epup_sprites.png),
   cell 160 native, shown at 120 (background-size 480x600). Each state is a row; walk/
   sniff/dig cycle via steps(), stand/sit are static poses. The browser does all the
   animation â€” the S3 just serves the sheet once. */
.epsprite{width:120px;height:120px;margin:2px auto 4px;
  background:url(/epup_sprites.png) no-repeat 0 0;background-size:480px 600px}
.epsprite.sniff{background-position:0 0;animation:eps-sniff .9s steps(4) infinite}
@keyframes eps-sniff{from{background-position:0 0}to{background-position:-480px 0}}
.epsprite.walk{background-position:0 -120px;animation:eps-walk .5s steps(2) infinite}
@keyframes eps-walk{from{background-position:0 -120px}to{background-position:-240px -120px}}
.epsprite.dig{background-position:0 -240px;animation:eps-dig .7s steps(3) infinite}
@keyframes eps-dig{from{background-position:0 -240px}to{background-position:-360px -240px}}
.epsprite.stand{background-position:0 -360px}
.epsprite.sit{background-position:0 -480px}
@media(prefers-reduced-motion:reduce){.epsprite{animation:none!important}}
/* ePup stats panel (toggled open under the card body). */
.epmore{display:block;margin:2px auto 6px;padding:4px 12px;border:2px solid var(--line);
  border-radius:8px;background:var(--panelw);color:var(--txt);font-weight:700;font-size:12px;
  cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.epmore:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.epdetail{margin:2px 0 6px;border-top:1px solid var(--line);padding-top:6px}
.epdrow{display:flex;align-items:baseline;gap:8px;padding:3px 0;font-size:12px}
.epdrow b{min-width:104px;color:var(--acc);font-weight:800}
.epdrow span{color:var(--txt);font-weight:700}
.epdrow i{color:var(--dim);font-style:normal;font-weight:600;margin-left:auto;text-align:right}
/* Hostile-gadget sentinel controls, hosted inside the ePup card. */
.epsent{margin-top:10px;border-top:1px solid var(--line);padding-top:8px}
.epshd{display:flex;align-items:center;gap:7px;font-weight:800;color:var(--acc);font-size:13px;margin-bottom:6px}
.epshd .ic{width:1.1em;height:1.1em;flex:none}
.epsent-arm{display:flex;align-items:center;gap:7px;font-size:12.5px;padding-bottom:6px;margin-bottom:6px;
  border-bottom:1px solid var(--line)}
.epsent-arm b{color:var(--txt);font-weight:800}
.epsbody.off{opacity:.45}
.epscount{font-size:12px;color:var(--dim);margin:2px 0 6px}
.epscount b{color:var(--txt);font-weight:800;font-variant-numeric:tabular-nums}
.epslbl{font-size:11px;color:var(--dim);margin:7px 0 2px}
.epsrow{display:flex;align-items:center;gap:6px;font-size:12px;padding:3px 0;color:var(--txt)}
.epsrow .dicon .ic{width:1.05em;height:1.05em}
.epsrow .hits{color:var(--dim);font-size:11px;margin-left:auto;text-align:right;white-space:nowrap}
.epsrow input[type=checkbox]{flex:none;margin:0}
.epsadd{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px}
.epsadd input,.epsadd select{padding:5px 7px;border:1.5px solid var(--line);border-radius:7px;
  background:var(--panelw);color:var(--txt);font-size:12px}
.epsadd .mac{flex:1 1 130px;min-width:0}
.epsadd .nm{width:84px}
.epsadd button{padding:5px 11px;border:2px solid var(--line);border-radius:7px;background:var(--panelw);
  color:var(--txt);font-weight:700;cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.epsadd button:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.epsdel{margin-left:auto;border:none;background:none;color:var(--avoid);cursor:pointer;
  font-size:14px;line-height:1;padding:0 2px}
/* Sentinel action buttons (open the signatures / add-device / flagged-results popups). */
.epsbtns{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 4px}
.epsbtns button{display:flex;align-items:center;gap:6px;padding:6px 11px;border:2px solid var(--line);
  border-radius:8px;background:var(--panelw);color:var(--txt);font-weight:700;font-size:12px;cursor:pointer;
  box-shadow:2px 2px 0 var(--sh)}
.epsbtns button:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.epsbtns button .ic{width:1.05em;height:1.05em;flex:none}
/* Popup form (add device / rename environment). */
.epsform{display:flex;flex-direction:column;gap:9px;margin-top:4px}
.epsform label{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--dim)}
.epsform input,.epsform select{padding:7px 9px;border:1.5px solid var(--line);border-radius:8px;
  background:var(--panelw);color:var(--txt);font-size:13px}
.epsform button,.envclass button{align-self:flex-start;padding:7px 14px;border:2px solid var(--line);
  border-radius:8px;background:var(--acc);color:#fff;font-weight:800;cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.epsform button:active,.envclass button:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
/* Flagged-detection history cards (the flagged-results popup). */
.hitcard{border:2px solid var(--line);border-left:6px solid var(--avoid);border-radius:10px;
  padding:8px 10px;margin:7px 0;background:var(--panelw);box-shadow:2px 2px 0 var(--sh)}
.hithd{display:flex;align-items:center;gap:7px;min-width:0}
.hithd .ic{width:1.1em;height:1.1em;flex:none}
.hitnm{flex:1;min-width:0;font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hitkind{flex:none;font-size:10px;font-weight:800;text-transform:uppercase;color:var(--dim)}
.hitmeta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:4px;
  font-size:11.5px;color:var(--dim);flex-wrap:wrap}
.hitts{font-variant-numeric:tabular-nums}
.hitgps{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:11px;color:var(--dim);opacity:.45}
.hitgps .ic{width:1em;height:1em;flex:none}
/* Environments (place memory) grid â€” a clusters-style tile view. */
.envwrap{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:0 0 10px}
.envgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:6px}
.envtile{display:flex;flex-direction:column;gap:5px;text-align:left;font:inherit;cursor:pointer;
  background:var(--panelw);color:var(--txt);border:2px solid var(--line);border-left:6px solid var(--cat,var(--line));
  border-radius:10px;padding:9px 10px;box-shadow:2px 2px 0 var(--sh)}
.envtile:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.envtile.tone-cur{--cat:var(--acc)} .envtile.tone-known{--cat:var(--safe)} .envtile.tone-new{--cat:var(--acc2)}
.envtn{font-weight:800;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.envtb{display:flex;flex-wrap:wrap;gap:2px 10px;font-size:10.5px;color:var(--dim)}
.envdet .kv2{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;margin:10px 0}
.envdet .kv2>div{display:flex;flex-direction:column;font-size:11px;color:var(--dim)}
.envdet .kv2 b{color:var(--txt);font-size:14px;font-weight:800;font-variant-numeric:tabular-nums}
.envclass{display:flex;gap:6px;margin-top:6px}
.envclass input{flex:1;min-width:0;padding:7px 9px;border:1.5px solid var(--line);border-radius:8px;
  background:var(--panelw);color:var(--txt);font-size:13px}
.envlm{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--line)}
.envlm:last-child{border-bottom:0}
.envlmbtn,.envlearn,.envdanger{font:inherit;font-size:11.5px;border:2px solid var(--line);background:none;
  color:var(--txt);border-radius:8px;padding:3px 8px;cursor:pointer;margin-left:6px}
.envdanger{color:var(--avoid);border-color:var(--avoid);width:100%;margin:10px 0 0}
.envlearn{margin-left:auto;font-weight:700}
.envchk{display:flex;gap:7px;align-items:center;margin-top:6px;font-size:12.5px}
.envdet input[type=number]{width:80px;padding:6px 8px;border:1.5px solid var(--line);border-radius:8px;
  background:var(--panelw);color:var(--txt);font-size:13px}
/* Generic popup overlay for the sentinel/environment sheets (mirrors #clov). */
#epov{position:fixed;inset:0;z-index:43;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center}
#epov[hidden]{display:none}
@media(min-width:560px){#epov{align-items:center}}
#epsheet{width:100%;max-width:520px;max-height:88vh;overflow:auto;background:var(--panel);
  border:3px solid var(--line);border-radius:14px 14px 0 0;box-shadow:0 -4px 0 var(--sh);padding:0 15px 15px}
@media(min-width:560px){#epsheet{border-radius:14px;box-shadow:5px 5px 0 var(--sh)}}

.pres{display:flex;align-items:center;gap:8px;margin-top:5px;flex-wrap:wrap;
  font-size:11px}
.pstrip{display:inline-flex;gap:1.5px;align-items:center}
.pstrip i{width:5px;height:9px;border-radius:1.5px;background:var(--trk);
  border:1px solid var(--line)}
.pstrip i.on{background:var(--acc);border-color:var(--acc)}

.cg{display:flex;flex-direction:column;gap:5px;margin:6px 0}
.cgr{display:flex;align-items:center;gap:8px;font-size:12.5px}
.cgr .lbl{flex:none;width:104px;color:var(--dim)}
.cgr .lbl b{color:var(--txt)}
.cgr .trk{flex:1;min-width:0;height:14px;background:var(--trk);border:1.5px solid var(--line);
  border-radius:5px;overflow:hidden}
.cgr .trk i{display:block;height:100%;background:linear-gradient(90deg,var(--acc2),var(--acc))}
.cgr.g5 .trk i{background:linear-gradient(90deg,#2b7fb0,var(--wifi))}
.cgr .n{flex:none;width:34px;text-align:right;font-weight:700}

.kv{display:grid;grid-template-columns:1fr;gap:4px 18px;font-size:12.5px}
@media(min-width:560px){
  .kv{grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
}
.kv>div{display:flex;gap:6px;min-width:0}
.kv b{color:var(--acc);font-weight:600;white-space:nowrap;opacity:.85}
.kv span{word-break:break-all}
.ev{font-size:12.5px;margin:2px 0 8px}
.ev b{color:var(--dim);font-weight:700}

#banner{display:flex;flex-direction:column;gap:14px}
.hero{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
.hero-ring{flex:none;position:relative;width:148px;height:148px;margin:0 auto}
.hero-ring .ctr{position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center}
.hero-ring .ctr .n{font-size:30px;font-weight:800;line-height:1;color:var(--txt)}
.hero-ring .ctr .l{font-size:10px;letter-spacing:.6px;text-transform:uppercase;
  color:var(--dim);margin-top:3px}
.hero-side{flex:1;min-width:200px;display:flex;flex-direction:column;gap:12px}
.verdict{font-size:15px;font-weight:900;padding:11px 16px;border-radius:11px;
  color:#181206;text-align:center;border:3px solid var(--line);
  box-shadow:4px 4px 0 var(--sh)}

.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:9px}
.tile{background:var(--panel);border:2.5px solid var(--line);
  border-left:7px solid var(--c,var(--line));border-radius:11px;padding:9px 11px;
  box-shadow:3px 3px 0 var(--sh);cursor:pointer;text-align:left;
  color:var(--txt);font:inherit}
.tile:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.tile .n{font-size:21px;font-weight:800;color:var(--txt);
  display:flex;align-items:center;gap:7px}
.tile .n .ic{width:17px;height:17px;flex:none;color:var(--c,var(--txt))}
.tile .l{font-size:10.5px;color:var(--dim);text-transform:uppercase;
  letter-spacing:.4px}

.chansum{display:flex;flex-wrap:wrap;gap:6px;align-items:center}

.topvl{font-size:11.5px;color:var(--dim);margin:0 0 8px}
.topvl b{color:var(--txt);font-weight:700}
.iclg{font-size:11.5px;color:var(--dim);margin:0 0 8px}
.iclg summary{cursor:pointer;font-weight:800;letter-spacing:.4px;
  text-transform:uppercase;font-size:10.5px}
.iclg .wrap{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:6px}
.iclg .it{display:inline-flex;align-items:center;gap:5px}
.stats{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:13px}
.stats b{color:var(--dim);font-weight:600;margin-right:5px}

.envb{display:flex;flex-wrap:wrap;gap:8px;margin-top:2px}
.envb .b{display:flex;align-items:center;gap:6px;background:var(--panel);
  border:1px dashed var(--line2);border-radius:8px;padding:5px 9px;
  font-size:12px;color:var(--dim);cursor:help}
.envb .b .ic{font-size:14px;opacity:.85}
.envb .b .ct{color:var(--txt);font-weight:700}
.envb .b .cf{font-size:9.5px;opacity:.7;text-transform:uppercase;letter-spacing:.3px}
.envb .b.tap{cursor:pointer}
.envb .b.tap:hover{background:var(--panelw)}

.crowd{margin-top:8px;background:var(--panel);border:1px dashed var(--line2);
  border-radius:10px;padding:9px 11px}
.crowd .ttl{font-size:12px;font-weight:800;color:var(--dim);
  text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
.crowd .est{display:flex;flex-wrap:wrap;gap:6px 14px;margin-bottom:7px}
.crowd .est .r{display:flex;align-items:baseline;gap:6px;font-size:12.5px}
.crowd .est .r b{color:var(--dim);font-weight:600}
.crowd .est .r .v{color:var(--txt);font-weight:800}
.crowd .evid{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:7px}
.crowd .evid .e{display:flex;align-items:center;gap:4px;font-size:12px;
  color:var(--dim)}
.crowd .evid .e .ic{width:1.05em;height:1.05em;vertical-align:-.18em;opacity:.85}
.crowd .evid .e span{color:var(--txt);font-weight:700}
/* clickable evidence chip (Privacy / Clusters summary cards drill into a device) */
.crowd .evid button.e{border:2px solid var(--line2);background:var(--panelw);
  border-radius:9px;padding:3px 8px;font:inherit;font-size:12px;cursor:pointer;
  box-shadow:2px 2px 0 var(--sh)}
.crowd .evid button.e:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.crowd .smmore{margin-top:8px}
.crowd .disc{font-size:11px;color:var(--dim);line-height:1.4}
.crowd.tone-safe{border-color:var(--safe)}
.crowd.tone-ok{border-color:var(--ok)}
.crowd.tone-caution{border-color:var(--caution)}
.crowd.tone-avoid{border-color:var(--avoid)}
.crowd.tone-info{border-color:var(--wifi)}
.crowd .ttl .tt{font-weight:800;padding:0 5px;border-radius:6px;margin-left:6px;
  font-size:11px;color:#fff}
.tone-safe .ttl .tt{background:var(--safe)}
.tone-ok .ttl .tt{background:var(--ok)}
.tone-caution .ttl .tt{background:var(--caution)}
.tone-avoid .ttl .tt{background:var(--avoid)}
.tone-info .ttl .tt{background:var(--wifi)}
.crowd .est .r .v.c-safe{color:var(--safe)}
.crowd .est .r .v.c-ok{color:var(--ok)}
.crowd .est .r .v.c-caution{color:var(--caution)}
.crowd .est .r .v.c-avoid{color:var(--avoid)}
.crowd .est .r .v.c-info{color:var(--wifi)}
.crowd .est .r .v.c-rot{color:var(--drone)}
/* 74g â€” lightweight local charts (SVG/CSS only, no libraries) */
.charts{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
  gap:10px;margin-top:10px}
.chart{background:var(--panel);border:2.5px solid var(--line);border-radius:11px;
  padding:10px 12px;box-shadow:2px 2px 0 var(--sh)}
.chart h4{margin:0 0 8px;font-size:11px;font-weight:800;color:var(--dim);
  text-transform:uppercase;letter-spacing:.4px}
.chstack{display:flex;height:20px;border-radius:6px;overflow:hidden;
  border:1.5px solid var(--line2);background:var(--panelw)}
.chstack .seg{height:100%}
.chleg{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:8px;font-size:11.5px}
.chleg .k{display:inline-flex;align-items:center;gap:5px;color:var(--dim)}
.chleg .k i{width:10px;height:10px;border-radius:2px;flex:none}
.chleg .k b{color:var(--txt);font-weight:700}
.chrow{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;
  font-size:11.5px;margin-top:5px}
.chrow .rl{color:var(--dim);white-space:nowrap;max-width:96px;overflow:hidden;
  text-overflow:ellipsis}
.chrow .rb{height:11px;border-radius:3px;background:var(--panelw);
  border:1px solid var(--line2);overflow:hidden}
.chrow .rb i{display:block;height:100%}
.chrow .rn{color:var(--txt);font-weight:700;font-variant-numeric:tabular-nums;
  text-align:right;min-width:2ch}
.chhist{display:flex;align-items:flex-end;gap:4px;height:72px;margin-top:4px}
.chhist .col{flex:1;display:flex;flex-direction:column;align-items:center;
  justify-content:flex-end;gap:3px;height:100%}
.chhist .col .bar{width:100%;border-radius:3px 3px 0 0;min-height:2px}
.chhist .col .cn{font-size:10px;font-weight:700;color:var(--txt);
  font-variant-numeric:tabular-nums}
.chhist .col .cl{font-size:9px;color:var(--dim);text-align:center;line-height:1.1}
.chempty{font-size:11.5px;color:var(--dim)}
/* clickable chart marks (drill into a filtered result list) */
.chstack .seg.clk,.chhist .col.clk{cursor:pointer}
.chrow.clk{cursor:pointer;border:0;background:none;width:100%;text-align:left;
  padding:0;font:inherit;color:inherit}
.chstack .seg.clk:hover{filter:brightness(1.12)}
.chrow.clk:hover .rl{color:var(--txt)}
.chleg .k.clk{cursor:pointer}
.chleg .k.clk:hover b{text-decoration:underline}
/* Summary customization: gear header + settings sheet + block list */
.smbar{display:flex;align-items:center;justify-content:flex-end;gap:8px;
  margin:-2px 0 6px}
.smgear{display:inline-flex;align-items:center;gap:6px;background:var(--panel);
  border:2px solid var(--line);border-radius:9px;padding:5px 10px;font:inherit;
  font-weight:700;font-size:12px;color:var(--dim);box-shadow:2px 2px 0 var(--sh);
  cursor:pointer}
.smgear:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.smgear svg{width:15px;height:15px}
/* Tabbed RF Env Summary: a left rail of user-named tabs + the active tab's blocks.
   Collapses to a horizontal scroll strip on narrow screens so it never adds vertical
   scroll of its own. */
.smwrap{display:grid;grid-template-columns:minmax(140px,180px) 1fr;gap:14px;align-items:start}
.smtabs{display:flex;flex-direction:column;gap:6px;position:sticky;top:72px}
.smtab{text-align:left;background:var(--panel);border:2px solid var(--line);
  border-radius:11px;padding:9px 11px;font:inherit;font-weight:800;font-size:13px;
  color:var(--txt);box-shadow:2px 2px 0 var(--sh);cursor:pointer;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis}
.smtab.act{background:var(--acc);color:var(--onacc,#3f2a14);border-color:var(--line)}
.smtab:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.smcontent{min-width:0}
.smcontent>.charts:not(:first-child),.smcontent>.stats:not(:first-child){margin-top:14px}
@media(max-width:620px){
  .smwrap{grid-template-columns:1fr;gap:10px}
  .smtabs{flex-direction:row;overflow-x:auto;position:static;padding-bottom:2px;
    scrollbar-width:thin}
  .smtab{flex:none}
}
/* customize sheet: tab manager + per-tab block groups */
.smtabmgr{display:flex;flex-direction:column;gap:6px;margin-bottom:12px}
.smtabrow{display:flex;align-items:center;gap:7px;border:2px solid var(--line2);
  border-radius:10px;padding:6px 8px;background:var(--panelw)}
.smtabrow input{flex:1;min-width:0;background:var(--panel);border:2px solid var(--line2);
  border-radius:8px;color:var(--txt);padding:6px 8px;font:inherit;font-weight:700;font-size:13px}
.smtabrow .smgrip{flex:none;color:var(--dim);cursor:grab;font-size:15px}
.smtabrow button{flex:none;border:2px solid var(--line2);background:var(--panel);
  color:var(--txt);border-radius:8px;width:30px;height:30px;font:inherit;font-weight:800;
  cursor:pointer;padding:0}
.smtabrow button:disabled{opacity:.35;cursor:not-allowed}
.smaddtab{width:100%;border:2px dashed var(--line);background:none;color:var(--acc2);
  border-radius:10px;padding:8px;font:inherit;font-weight:800;cursor:pointer;margin-bottom:12px}
.smgrp{margin:0 0 5px;font-size:11px;font-weight:900;text-transform:uppercase;
  letter-spacing:.5px;color:var(--dim)}
.smgrp.off{color:var(--avoid)}
.smblk .smmove{flex:none;border:2px solid var(--line2);background:var(--panel);
  color:var(--txt);border-radius:8px;padding:4px 6px;font:inherit;font-size:11px;font-weight:700;
  max-width:96px}
#smov,#wlov{position:fixed;inset:0;z-index:41;background:rgba(0,0,0,.45);
  display:flex;align-items:flex-end;justify-content:center}
#smov[hidden],#wlov[hidden]{display:none}
@media(min-width:560px){#smov,#wlov{align-items:center}}
#smsheet,#wlsheet{width:100%;max-width:480px;max-height:88vh;overflow:auto;
  background:var(--panel);border:3px solid var(--line);border-radius:14px 14px 0 0;
  box-shadow:0 -4px 0 var(--sh);padding:16px}
@media(min-width:560px){#smsheet,#wlsheet{border-radius:14px;box-shadow:5px 5px 0 var(--sh)}}
#smsheet h3,#wlsheet h3{margin:0 0 3px;font-size:18px}
#smsheet .smsub,#wlsheet .smsub{color:var(--dim);font-size:12.5px;margin-bottom:12px}
.smblk{display:flex;align-items:center;gap:9px;border:2px solid var(--line2);
  border-radius:10px;padding:8px 10px;margin-bottom:7px;background:var(--panelw)}
.smblk.off{opacity:.62}
.smblk .smgrip{flex:none;color:var(--dim);cursor:grab;font-size:15px;line-height:1;
  touch-action:none;user-select:none}
.smblk .smname{flex:1;min-width:0;font-weight:700;font-size:13px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.smblk .smtag{flex:none;font-size:9.5px;text-transform:uppercase;letter-spacing:.4px;
  color:var(--dim);border:1px solid var(--line2);border-radius:5px;padding:1px 5px}
.smblk .smmv{flex:none;display:flex;gap:3px}
.smblk .smmv button,.smblk .smtog{flex:none;border:2px solid var(--line2);
  background:var(--panel);color:var(--txt);border-radius:7px;width:34px;height:34px;
  font:inherit;font-weight:800;cursor:pointer;box-shadow:none;padding:0}
.smblk .smmv button:disabled{opacity:.35;cursor:not-allowed}
.smblk .smtog{width:auto;padding:0 10px;font-size:11px}
.smblk.on .smtog{border-color:var(--acc);color:var(--acc)}
.smblk.dragging{opacity:.5;border-style:dashed}
.smblk.dragover{border-color:var(--acc)}
#smsheet .smact{display:flex;gap:8px;margin-top:6px}
#smsheet .smact button{flex:1;border:2.5px solid var(--line);background:var(--panel);
  color:var(--txt);border-radius:10px;padding:10px;font:inherit;font-weight:800;
  cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
#smsheet .smact button.prim{background:var(--acc);color:var(--onacc,#3f2a14)}
#smsheet .smact button:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
/* summary mini result lists (top signal / top threats) */
.smlist{background:var(--panel);border:2.5px solid var(--line);border-radius:11px;
  padding:8px 10px;box-shadow:2px 2px 0 var(--sh);margin-top:10px}
.smlist h4{margin:0 0 6px;font-size:11px;font-weight:800;color:var(--dim);
  text-transform:uppercase;letter-spacing:.4px}
.smlrow{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;
  width:100%;text-align:left;border:0;background:none;font:inherit;color:inherit;
  padding:5px 4px;border-radius:7px;cursor:pointer}
.smlrow:hover{background:var(--panelw)}
.smlrow .li{width:15px;height:15px;flex:none;color:var(--c,var(--dim))}
.smlrow .ln{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  font-weight:600;font-size:12.5px}
.smlrow .lv{font-size:11px;color:var(--dim);font-variant-numeric:tabular-nums;
  white-space:nowrap}
/* watchlist: match badge + manager sheet */
.pill.watch{background:var(--acc);color:var(--onacc,#3f2a14);border:0}
.dcard.watched{outline:2px solid var(--acc);outline-offset:-2px}
.smlist.watch h4{color:var(--acc)}
.wlman{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.wlman input{flex:1 1 150px;min-width:0;padding:8px 10px;border:2px solid var(--line2);
  border-radius:9px;background:var(--panel);color:var(--txt);font:inherit}
.wlseg{display:inline-flex;border:2px solid var(--line2);border-radius:9px;overflow:hidden}
.wlseg button{border:0;background:var(--panel);color:var(--dim);font:inherit;
  font-weight:700;padding:8px 11px;cursor:pointer;box-shadow:none}
.wlseg button.on{background:var(--panelw);color:var(--txt)}
.wladd{border:2.5px solid var(--line);background:var(--acc);color:var(--onacc,#3f2a14);
  border-radius:9px;padding:8px 14px;font:inherit;font-weight:800;cursor:pointer;
  box-shadow:2px 2px 0 var(--sh)}
.wladd:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.wlrow{display:flex;align-items:center;gap:9px;border:2px solid var(--line2);
  border-radius:9px;padding:7px 10px;margin-top:7px;background:var(--panelw)}
.wlrow .wt{font-size:9.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--dim);
  border:1px solid var(--line2);border-radius:5px;padding:1px 5px;flex:none}
.wlrow .wv{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  font-weight:600;font-size:13px}
.wlrow .wx{flex:none;border:2px solid var(--line2);background:var(--panel);color:var(--avoid);
  border-radius:7px;width:32px;height:32px;font:inherit;font-weight:800;cursor:pointer;
  box-shadow:none;padding:0}
/* notification display filter controls */
.alfbar{display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center;margin-bottom:10px;
  padding:9px 11px;border:2px dashed var(--line2);border-radius:10px}
.alfbar label{font-size:12px;color:var(--dim);font-weight:700}
.alfbar select{padding:6px 8px;border:2px solid var(--line2);border-radius:8px;
  background:var(--panel);color:var(--txt);font:inherit}
.alfmutes{display:flex;flex-wrap:wrap;gap:5px;margin-top:2px}
.almute{font-size:11px;border:1.5px solid var(--line2);border-radius:7px;padding:2px 8px;
  background:var(--panel);color:var(--dim);cursor:pointer;font:inherit}
.almute.muted{background:var(--band);color:var(--txt);border-color:var(--band);
  text-decoration:line-through}
.alfnote{font-size:12px;color:var(--dim);margin-bottom:8px}
.alfnote button{border:0;background:none;color:var(--acc2);font:inherit;font-weight:800;
  cursor:pointer;padding:0;box-shadow:none}
/* narrow-phone tightening for the summary customization sheet */
@media(max-width:400px){
  .smblk{gap:6px;padding:7px 8px}
  .smblk .smtag{display:none}
  .smblk .smgrip{display:none}
  .smgear span,.smgear{font-size:11px}
}
.tl{margin-top:7px}
.tl .hop{display:flex;gap:9px;align-items:flex-start;padding:5px 0;position:relative}
.tl .hop .dot{width:10px;height:10px;border-radius:50%;background:var(--drone);
  flex:none;margin-top:4px;box-shadow:0 0 0 2px var(--panel)}
.tl .hop:not(:last-child)::before{content:"";position:absolute;left:4px;top:15px;
  bottom:-5px;width:2px;background:var(--line2)}
.tl .hop .body{flex:1;min-width:0}
.tl .hop .rng{font-size:11px;color:var(--dim);font-weight:700;margin-left:6px}
.card .xhead{display:flex;align-items:center;gap:6px;margin-bottom:6px;
  font-size:12.5px;font-weight:800}
.card .xhead .dicon .ic{width:1.2em;height:1.2em;vertical-align:-.22em}
.card .xhead.rot{color:var(--drone)}
.card .xhead.grp{color:var(--acc2)}

.chips{display:flex;flex-wrap:wrap;align-items:center;gap:6px;flex:1 1 100%}
.chlbl{font-size:12px;color:var(--dim);margin-right:2px}
.fchip{background:var(--panel);color:var(--txt);border:2px solid var(--line);
  border-radius:14px;padding:3px 10px;font-size:12.5px;font-weight:700;cursor:pointer}
.fchip.on{background:var(--acc);color:var(--line);border-color:var(--line);font-weight:900}
.fchip .chn{opacity:.7;font-size:11px}
.fchip.on .chn{opacity:.9}
.qchip{background:var(--panel);color:var(--acc2);border:2px dashed var(--line2);
  border-radius:14px;padding:3px 10px;font-size:12.5px;font-weight:700;cursor:pointer}
.qchip:hover{border-color:var(--line);background:var(--panelw)}

.cgh{font-size:12px;color:var(--dim);margin:14px 0 7px;letter-spacing:.4px;
  text-transform:uppercase}
.ctabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.ctab{flex:1 1 130px;min-width:0;text-align:center;
  background:var(--panel);color:var(--txt);border:2px solid var(--line);
  border-radius:9px;padding:8px 10px;font-size:12.5px;font-weight:700;cursor:pointer;
  box-shadow:2px 2px 0 var(--sh)}
.ctab .cty{color:var(--dim);font-size:11px;margin-right:5px}
.ctab .dicon{margin-right:6px}
.ctab .dicon .ic{width:1.15em;height:1.15em;vertical-align:-.22em}
.ctab.act{background:var(--acc);border-color:var(--line);color:#181206;
  font-weight:900}
.ctab.act .cty{color:#5c4a10}
.card{background:var(--panel);border:2.5px solid var(--line);border-radius:12px;
  padding:12px 13px;margin:8px 0;box-shadow:3px 3px 0 var(--sh)}
.card .why{color:var(--acc);font-size:12.5px;font-weight:700;margin-bottom:4px}
.chip{display:inline-block;background:var(--panel);border:1px solid var(--line);
  border-radius:7px;padding:3px 9px;margin:3px 5px 3px 0;font-size:12.5px}
.chip .lyr{font-weight:800;margin-right:5px;font-size:10px}
.chip .lyr.w{color:var(--wifi)} .chip .lyr.b{color:var(--ble)}

.ecl{display:inline-block;border:1px solid;border-radius:6px;padding:0 6px;
  margin-left:5px;font-size:10.5px;font-weight:700;letter-spacing:.3px;
  text-transform:uppercase;vertical-align:middle}

.cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));
  gap:9px;margin-bottom:10px}
/* Cluster result card â€” fixed size, mirrors the Wi-Fi/BLE .dcard look:
   colored left bar, type icon + name + scan-type badge, MAC + small icons. */
.ctile{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;
  gap:5px;height:98px;min-width:0;text-align:left;background:var(--panel);color:var(--txt);
  border:2.5px solid var(--line);border-left:7px solid var(--cat,var(--line));
  border-radius:11px;padding:9px 11px;cursor:pointer;box-shadow:3px 3px 0 var(--sh)}
.ctile.k-wifi{--cat:var(--wifi)} .ctile.k-ble{--cat:var(--ble)}
.ctile:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--sh)}
.cthd{display:flex;align-items:center;gap:6px;min-width:0}
.cthd .dicon{flex:none}
.cthd .dicon .ic{width:1.25em;height:1.25em}
.ctname{flex:1;min-width:0;font-size:13.5px;font-weight:700;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ctkind{flex:none;font-size:9px;font-weight:800;letter-spacing:.4px;
  text-transform:uppercase;color:var(--cat,var(--dim));
  border:1px solid var(--cat,var(--line));border-radius:5px;padding:1px 5px}
.ctmac{font-size:11px;color:var(--dim);overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.ctico{display:flex;gap:5px;align-items:center;margin-top:auto;color:var(--dim)}
.ctico .ic{width:14px;height:14px}
.ctile.open{outline:2px solid var(--acc2);outline-offset:2px}
/* .cdet is now a hidden data holder â€” its content is cloned into the modal. */
.cdet{display:none}
/* Cluster detail popup (reuses the summary-sheet overlay pattern). */
#clov{position:fixed;inset:0;z-index:42;background:rgba(0,0,0,.5);
  display:flex;align-items:flex-end;justify-content:center}
#clov[hidden]{display:none}
@media(min-width:560px){#clov{align-items:center}}
#clsheet{width:100%;max-width:520px;max-height:88vh;overflow:auto;
  background:var(--panel);border:3px solid var(--line);border-radius:14px 14px 0 0;
  box-shadow:0 -4px 0 var(--sh);padding:0 15px 15px}
@media(min-width:560px){#clsheet{border-radius:14px;box-shadow:5px 5px 0 var(--sh)}}
.clhd{display:flex;align-items:center;justify-content:space-between;gap:10px;
  position:sticky;top:0;background:var(--panel);padding:14px 0 8px;z-index:1;
  border-bottom:1px solid var(--line);margin-bottom:10px}
.clhd h3{margin:0;font-size:16px;min-width:0;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.clx{flex:none;width:32px;height:32px;border:2px solid var(--line);
  background:var(--panel);color:var(--txt);border-radius:9px;font-size:14px;
  font-weight:900;cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.clx:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
/* Cluster member cards inside the popup â€” uniform, tappable result cards that
   mirror the Wi-Fi/BLE .dcard look and ARE the link to the full result. */
.mgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));
  gap:8px;margin:9px 0}
.mcard{display:flex;flex-direction:column;gap:5px;min-height:60px;width:100%;
  text-align:left;font:inherit;background:var(--panelw);color:var(--txt);
  border:2px solid var(--line);border-left:6px solid var(--cat,var(--line));
  border-radius:10px;padding:8px 10px;box-shadow:2px 2px 0 var(--sh)}
button.mcard{cursor:pointer}
button.mcard:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.mcard.k-wifi{--cat:var(--wifi)} .mcard.k-ble{--cat:var(--ble)}
.mchd{display:flex;align-items:center;gap:6px;min-width:0}
.mchd .lyr{flex:none;font-weight:800;font-size:10px}
.mchd .lyr.w{color:var(--wifi)} .mchd .lyr.b{color:var(--ble)}
.mcname{flex:1;min-width:0;font-size:13px;font-weight:700;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mcsig{flex:none;display:flex;align-items:center;gap:3px;color:var(--dim);
  font-size:11px;font-variant-numeric:tabular-nums}
.mcsig .ic{width:14px;height:14px}
.mchd .dicon{flex:none} .mchd .dicon .ic{width:15px;height:15px}
.mcbody{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  font-size:11.5px;color:var(--dim)}
.mcbody .mmac{color:var(--txt)}
.mctag{flex:none;font-size:9px;font-weight:800;letter-spacing:.4px;
  text-transform:uppercase;color:var(--cat,var(--dim));
  border:1px solid var(--cat,var(--line));border-radius:4px;padding:0 4px}

.ctab .tn{color:var(--acc);font-weight:800;margin-left:6px}
.ctab.act .tn{color:#5c4a10}
.pexp{font-size:13px;line-height:1.5;color:var(--dim);background:var(--panel);
  border:2px solid var(--line);border-left:6px solid var(--cat,var(--acc));
  border-radius:11px;padding:11px 13px;margin:0 0 11px;box-shadow:2px 2px 0 var(--sh)}
.pchips{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 12px}
.pchip{background:var(--panel);border:2px solid var(--line);border-radius:9px;
  padding:6px 11px;font-size:12.5px;color:var(--dim);font-weight:700}
.pchip b{color:var(--acc2);font-weight:900;margin-left:6px}
.plist{display:grid;grid-template-columns:1fr;gap:8px}
@media(min-width:760px){
  .plist{grid-template-columns:repeat(auto-fill,minmax(330px,1fr))}
}
.prow{background:var(--panel);border:2.5px solid var(--line);
  border-left:7px solid var(--cat,var(--line));border-radius:11px;
  padding:10px 12px;box-shadow:3px 3px 0 var(--sh)}
.prow .pt{font-size:14px;font-weight:700;word-break:break-all;display:flex;
  justify-content:space-between;gap:8px;align-items:flex-start}
.prow .pt .hid{color:var(--dim);font-weight:500;font-style:italic}
.prow .pm{margin-top:7px;font-size:12px;color:var(--dim);display:flex;
  flex-wrap:wrap;gap:4px 14px}
.prow .pm b{color:var(--acc);opacity:.8;font-weight:600;margin-right:4px}
.prow.acked{opacity:.6}
.pill.done{background:var(--safe);color:var(--onacc,#173);border:0}
/* per-device privacy actions: watch / locate / mark reviewed */
.prow .pact{margin-top:9px;display:flex;flex-wrap:wrap;gap:6px}
.pa{border:2px solid var(--line2);background:var(--panelw);color:var(--txt);
  border-radius:9px;padding:5px 10px;font:inherit;font-size:11.5px;font-weight:700;
  cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.pa:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.pa.on{border-color:var(--acc);color:var(--acc)}
.pa.done{border-color:var(--safe);color:var(--safe)}
/* "what you can do" guidance strip + triage toolbar */
.pguide{font-size:12.5px;line-height:1.5;color:var(--txt);background:var(--panelw);
  border:2px solid var(--line2);border-left:5px solid var(--acc2);border-radius:9px;
  padding:9px 11px;margin-bottom:9px}
.pguide b{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;
  color:var(--acc2);margin-bottom:2px}
.ptoolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:10px}
.ptoolbar .small{color:var(--dim)}
/* Guided locate sheet */
#locov{position:fixed;inset:0;z-index:44;background:rgba(0,0,0,.5);
  display:flex;align-items:flex-end;justify-content:center}
#locov[hidden]{display:none}
@media(min-width:560px){#locov{align-items:center}}
#locsheet{width:100%;max-width:440px;max-height:90vh;overflow:auto;background:var(--panel);
  border:3px solid var(--line);border-radius:16px 16px 0 0;padding:16px}
@media(min-width:560px){#locsheet{border-radius:16px;box-shadow:5px 5px 0 var(--sh)}}
.lochd{display:flex;justify-content:space-between;align-items:center;gap:8px;
  font-size:16px;margin-bottom:12px}
.locx{border:2px solid var(--line2);background:var(--panel);color:var(--txt);
  border-radius:9px;width:34px;height:34px;font:inherit;font-weight:800;cursor:pointer}
.locsig{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.locbar{flex:1;height:16px;background:var(--panelw);border:2px solid var(--line2);
  border-radius:9px;overflow:hidden}
.locbar i{display:block;height:100%;background:var(--safe);
  transition:width .3s ease}
.locsig.weak .locbar i{background:var(--avoid)}
.locdbm{flex:none;font-weight:800;font-size:15px;min-width:74px;text-align:right;font-variant-numeric:tabular-nums}
.loctemp{text-align:center;font-size:22px;font-weight:900;letter-spacing:1px;
  padding:10px;border-radius:12px;margin-bottom:10px}
.loctemp.twarm{background:var(--safe);color:var(--onacc,#173)}
.loctemp.tcold{background:var(--avoid);color:#fff}
.loctemp.thold{background:var(--panelw);color:var(--dim)}
.locclose{text-align:center;font-weight:800;color:var(--safe);margin-bottom:10px}
.locwarn{background:var(--panelw);border:2px solid var(--avoid);border-radius:10px;
  padding:10px 12px;font-size:12.5px;line-height:1.45;margin-bottom:10px}
.locstep{font-size:12.5px;color:var(--dim);margin-bottom:8px;line-height:1.4}
.locdirs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.locdir{border:2px solid var(--line2);background:var(--panel);color:var(--txt);
  border-radius:11px;padding:12px;font:inherit;font-weight:800;font-size:14px;cursor:pointer;
  box-shadow:2px 2px 0 var(--sh);display:flex;justify-content:center;align-items:baseline;gap:6px}
.locdir:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
.locdir.done{border-color:var(--acc)}
.locdir .dv{font-size:11px;color:var(--dim);font-weight:700}
.locbest{background:var(--panelw);border:2px solid var(--acc);border-radius:10px;
  padding:9px 11px;font-size:13px;margin-top:2px}
.locbest .locre{margin-left:6px;border:2px solid var(--line2);background:var(--panel);
  color:var(--txt);border-radius:8px;padding:2px 8px;font:inherit;font-size:11px;cursor:pointer}
.locfoot{font-size:11px;color:var(--dim);line-height:1.4;margin:10px 0}
.locact{display:flex;margin-top:4px}
.locact .prim{flex:1;border:2.5px solid var(--line);background:var(--acc);
  color:var(--onacc,#3f2a14);border-radius:11px;padding:11px;font:inherit;font-weight:800;
  cursor:pointer;box-shadow:2px 2px 0 var(--sh)}
.locact .prim:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
#toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,14px);z-index:60;
  max-width:min(92vw,460px);background:var(--panel);color:var(--txt);
  border:2.5px solid var(--line);border-radius:12px;padding:11px 15px;font-size:13px;
  font-weight:600;line-height:1.4;box-shadow:4px 4px 0 var(--sh);opacity:0;
  pointer-events:none;transition:opacity .18s,transform .18s}
#toast.show{opacity:1;transform:translate(-50%,0)}

.rrec{margin:8px 0;border:2.5px solid var(--line);border-radius:8px;overflow:hidden;
  box-shadow:3px 3px 0 var(--sh)}
.rh{display:flex;gap:10px;align-items:center;padding:6px 10px;background:var(--panelw);
  border-bottom:2px solid var(--line)}
.rt{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;
  color:var(--acc)}
.rt.wifi{color:var(--wifi)} .rt.ble{color:var(--ble)}
.rt.track{color:var(--track)} .rt.drone{color:var(--drone)}
.rs{font-size:12.5px;color:var(--txt);font-weight:600;word-break:break-all}
pre{background:var(--code);margin:0;padding:9px 11px;overflow:auto;font-size:12px;
  line-height:1.5;white-space:pre-wrap;word-break:break-word;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.jk{color:var(--acc)}
.js{color:var(--safe)}
.jnum{color:var(--wifi)}
.jl{color:var(--drone)}
.note{color:var(--dim);font-size:12px;margin:6px 0}
.sibcav{margin:6px 0;padding:6px 9px;font-size:12px;line-height:1.4;
  border:1.5px solid var(--caution);border-radius:8px;color:var(--txt);
  background:color-mix(in srgb,var(--caution) 12%,transparent)}
.sibcav b{color:var(--caution)}
details>summary{cursor:pointer;color:var(--acc);font-weight:700;font-size:13px}
#app{display:none}
#rcov{position:fixed;inset:0;z-index:30;display:none;align-items:center;
  justify-content:center;padding:20px;background:rgba(20,14,6,.92)}
#rcov.on{display:flex}
#rcbox{background:var(--panel);border:3px solid var(--line);border-radius:14px;
  box-shadow:4px 4px 0 var(--sh);max-width:360px;width:100%;padding:20px 18px;
  text-align:center;color:var(--txt)}
#rcbox h3{margin:0 0 6px;font-size:16px;color:var(--acc)}
#rcbox .rcmsg{color:var(--dim);font-size:13px;line-height:1.4;margin:0 0 14px}
#rcnum{font-size:40px;font-weight:900;line-height:1;margin:6px 0;color:var(--txt)}
#rcbar{height:9px;background:var(--trk);border:2px solid var(--line);
  border-radius:5px;overflow:hidden;margin:12px 0}
#rcbar i{display:block;height:100%;width:0;background:var(--acc);
  transition:width .9s linear}
#rcbtn{display:block;width:100%;box-sizing:border-box;margin:14px 0 0;padding:11px;
  border:2px solid var(--line);border-radius:9px;font-size:15px;font-weight:800;
  cursor:not-allowed;background:var(--trk);color:var(--dim);
  box-shadow:3px 3px 0 var(--sh)}
#rcbtn.ready{cursor:pointer;background:var(--safe);color:#0c2a16}
#rcbtn.ready:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--sh)}
</style>
</head>
<body>
<script>

const SC_VARS=["bg","panel","panelw","band","line","line2","txt","dim","acc",
  "acc2","onacc","purple","sh","trk","code","wifi","ble","track","drone",
  "safe","ok","caution","avoid"];
const SC_THEMES={
 "sniffcheck":{label:"SniffCheck Yellow",dark:false,vars:{}},
 "sniffcheck-dark":{label:"SniffCheck Dark",dark:true,vars:{}},
 "dracula":{label:"Dracula",dark:true,vars:{bg:"#282a36",panel:"#343746",
  panelw:"#44475a",band:"#44475a",line:"#bd93f9",line2:"#6272a4",txt:"#f8f8f2",
  dim:"#9ba3cf",acc:"#ff79c6",acc2:"#bd93f9",onacc:"#282a36",purple:"#bd93f9",
  sh:"#191a21",trk:"#191a21",code:"#21222c",wifi:"#8be9fd",ble:"#bd93f9",
  track:"#ffb86c",drone:"#ff79c6",safe:"#50fa7b",ok:"#f1fa8c",caution:"#ffb86c",
  avoid:"#ff5555"}},
 "nord":{label:"Nord",dark:true,vars:{bg:"#2e3440",panel:"#3b4252",
  panelw:"#434c5e",band:"#4c566a",line:"#88c0d0",line2:"#4c566a",txt:"#eceff4",
  dim:"#a9b6c9",acc:"#88c0d0",acc2:"#81a1c1",onacc:"#2e3440",purple:"#b48ead",
  sh:"#232831",trk:"#232831",code:"#272c36",wifi:"#81a1c1",ble:"#b48ead",
  track:"#d08770",drone:"#b48ead",safe:"#a3be8c",ok:"#ebcb8b",caution:"#d08770",
  avoid:"#bf616a"}},
 "gruvbox-dark":{label:"Gruvbox Dark",dark:true,vars:{bg:"#282828",
  panel:"#32302f",panelw:"#3c3836",band:"#504945",line:"#d79921",line2:"#665c54",
  txt:"#ebdbb2",dim:"#a89984",acc:"#fabd2f",acc2:"#fe8019",onacc:"#282828",
  purple:"#d3869b",sh:"#1d2021",trk:"#1d2021",code:"#1d2021",wifi:"#83a598",
  ble:"#d3869b",track:"#fe8019",drone:"#d3869b",safe:"#b8bb26",ok:"#fabd2f",
  caution:"#fe8019",avoid:"#fb4934"}},
 "solarized-light":{label:"Solarized Light",dark:false,vars:{bg:"#fdf6e3",
  panel:"#eee8d5",panelw:"#e4dcc3",band:"#d9d2b9",line:"#586e75",line2:"#93a1a1",
  txt:"#073642",dim:"#657b83",acc:"#b58900",acc2:"#cb4b16",onacc:"#fdf6e3",
  purple:"#6c71c4",sh:"#93a1a1",trk:"#ffffff",code:"#f5efdc",wifi:"#268bd2",
  ble:"#6c71c4",track:"#cb4b16",drone:"#d33682",safe:"#859900",ok:"#b58900",
  caution:"#cb4b16",avoid:"#dc322f"}},
 "tokyo-night":{label:"Tokyo Night",dark:true,vars:{bg:"#1a1b26",
  panel:"#24283b",panelw:"#292e42",band:"#2f344d",line:"#7aa2f7",line2:"#3b4261",
  txt:"#c0caf5",dim:"#9aa5ce",acc:"#7aa2f7",acc2:"#bb9af7",onacc:"#1a1b26",
  purple:"#bb9af7",sh:"#0f101a",trk:"#0f101a",code:"#16161e",wifi:"#7dcfff",
  ble:"#bb9af7",track:"#ff9e64",drone:"#f7768e",safe:"#9ece6a",ok:"#e0af68",
  caution:"#ff9e64",avoid:"#f7768e"}},
 "monokai":{label:"Monokai",dark:true,vars:{bg:"#272822",panel:"#34352d",
  panelw:"#3e3d32",band:"#49483e",line:"#e6db74",line2:"#75715e",txt:"#f8f8f2",
  dim:"#a59f85",acc:"#fd971f",acc2:"#e6db74",onacc:"#272822",purple:"#ae81ff",
  sh:"#1b1c17",trk:"#1b1c17",code:"#1e1f1c",wifi:"#66d9ef",ble:"#ae81ff",
  track:"#fd971f",drone:"#f92672",safe:"#a6e22e",ok:"#e6db74",caution:"#fd971f",
  avoid:"#f92672"}},
